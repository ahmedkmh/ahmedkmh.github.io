0633\u064a\u0645 \u0634\u0627\u062a\u0633\u0643\u064a\u062e. \u0648\u0627\u0633\u062a\u0646\u062f \u062a\u0631\u0634\u064a\u062d \u0627\u0644\u062c\u0627\u0628\u0631 \u0648\u0627\u0644\u0645\u0646\u062a\u0634\u0631\u064a \u0625\u0644\u0649 \u0645\u0633\u0627\u0647\u0645\u062a\u0647\u0645\u0627 \u0641\u064a \u062a\u0623\u0647\u0644 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0625\u0644\u0649 \u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 2006\u060c \u0648\u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u0631\u0627\u0628\u0639\u0629 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a\u060c \u0641\u0636\u0644\u064b\u0627 \u0639\u0646 \u0625\u0646\u062c\u0627\u0632\u0627\u062a\u0647\u0645\u0627 \u0645\u0639 \u0646\u0627\u062f\u064a\u064a\u0647\u0645\u0627. \u0648\u062e\u0644\u0627\u0644 2005 \u062a\u0648\u0650\u0651\u062c \u0627\u0644\u062c\u0627\u0628\u0631 \u0645\u0639 \u0627\u0644\u0647\u0644\u0627\u0644 \u0628\u062b\u0646\u0627\u0626\u064a\u0629 \u0627\u0644\u062f\u0648\u0631\u064a \u0648\u0643\u0623\u0633 \u0648\u0644\u064a \u0627\u0644\u0639\u0647\u062f\u060c \u0641\u064a\u0645\u0627 \u062d\u0642\u0642 \u0627\u0644\u0645\u0646\u062a\u0634\u0631\u064a \u0628\u0631\u0641\u0642\u0629 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0644\u0642\u0628\u064a \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0627\u0644\u0639\u0631\u0628 \u0648\u0622\u0633\u064a\u0627. \u0623\u0645\u0651\u0627 \u0634\u0627\u062a\u0633\u0643\u064a\u062e \u0641\u0633\u0627\u0647\u0645 \u0641\u064a \u062d\u0635\u0648\u0644 \u0641\u0631\u064a\u0642\u0647 \u062f\u064a\u0646\u0627\u0645\u0648 \u0643\u064a\u064a\u0641 \u0639\u0644\u0649 \u0644\u0642\u0628 \u0643\u0623\u0633 \u0623\u0648\u0643\u0631\u0627\u0646\u064a\u0627\u060c \u0648\u0648\u0635\u0627\u0641\u0629 \u062f\u0648\u0631\u064a 2004\u06402005\u060c \u0648\u062a\u0635\u062f\u0631 \u062c\u062f\u0648\u0644 \u0627\u0644\u0628\u0637\u0648\u0644\u0629 \u0630\u0627\u062a\u0647\u062