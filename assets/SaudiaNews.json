A8%D8%AF%D8%B9%D9%85-%D8%B3%D8%B9%D9%88%D8%AF%D9%8A-%D8%AA%D9%88%D8%B2%D9%8A%D8%B9-25-%D8%A3%D9%84%D9%81-%D9%88%D8%AC%D8%A8%D8%A9-%D8%BA%D8%B0%D8%A7%D8%A6%D9%8A%D8%A9-%D9%81%D9%8A-%D9%82%D8%B7%D8%A7%D8%B9-%D8%BA%D8%B2%D8%A9", "title": "\u0628\u062f\u0639\u0645 \u0633\u0639\u0648\u062f\u064a.. \u062a\u0648\u0632\u064a\u0639 25 \u0627\u0654\u0644\u0641 \u0648\u062c\u0628\u0629 \u063a\u0630\u0627\u064a\u0654\u064a\u0629 \u0641\u064a \u0642\u0637\u0627\u0639 \u063a\u0632\u0629", "description": "\u0648\u0632\u0639 \u0627\u0644\u0645\u0637\u0628\u062e \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u062a\u0627\u0628\u0639 \u0644<a href=\"https://www.alyaum.com/articles/6678351/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D9%85%D9%84%D9%83-%D8%B3%D9%84%D9%85%D8%A7%D9%86-%D9%84%D9%84%D8%A5%D8%BA%D8%A7%D8%AB%D8%A9-%D9%8A%D9%88%D9%82%D8%B9-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%8A%D9%86-%D9%84%D8%AF%D8%B9%D9%85-%D8%A7%D9%84%D8%A3%D9%8A%D8%AA%D8%A7%D9%85-%D9%88%D8%A7%D9%84%D8%A3%D8%B3%D8%B1-%D8%A7%D9%84%D8%B2%D8%B1%D8%A7%D8%B9%D9%8A%D8%A9-%D9%81%D9%8A-%D8%BA%D8%B2%D8%A9\">\u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u0644\u0643 \u0633\u0644\u0645\u0627\u0646 \u0644\u0644\u0627\u0655\u063a\u0627\u062b\u0629</a> \u0648\u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644 \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a\u0629 \u0627\u0654\u0645\u0633 \u0627\u0644\u0627\u0654\u0648\u0644 (25,000) <a href=\"https://www.alyaum.com/articles/6678347/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%85%D8%B1%D9%83%D8%B2-%D8%A7%D9%84%D9%85%D9%84%D9%83-%D8%B3%D9%84%D9%85%D8%A7%D9%86-%D9%84%D9%84%D8%A5%D8%BA%D8%A7%D8%AB%D8%A9-%D9%8A%D9%88%D8%B2%D8%B9-245-%D8%A3%D9%84%D9%81-%D9%88%D8%AC%D8%A8%D8%A9-%D8%B3%D8%A7%D8%AE%D9%86%D8%A9-%D9%81%D9%8A-%D8%BA%D8%B2%D8%A9\">\u0648\u062c\u0628\u0629 \u063a\u0630\u0627\u064a\u0654\u064a\u0629</a> \u0633\u0627\u062e\u0646\u0629 \u0648\u0633\u0637 \u0648\u062c\u0646\u0648\u0628 <a href=\"https://www.alyaum.com/articles/6678224/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%B4%D9%87%D8%AF%D8%A7%D8%A1-%D8%B9%D8%AF%D9%88%D8%A7%D9%86-%D8%A7%D9%84%D8%A7%D8%AD%D8%AA%D9%84%D8%A7%D9%84-%D8%B9%D9%84%D9%89-%D9%82%D8%B7%D8%A7%D8%B9-%D8%BA%D8%B2%D8%A9-%D8%A5%D9%84%D9%89-73391\">\u0642\u0637\u0627\u0639 \u063a\u0632\u0629</a>.<br /><br />\u0648\u0627\u0633\u062a\u0641\u0627\u062f \u0645\u0646\u0647\u0627 (25,000) \u0641\u0631\u062f\u060c \u0648\u0630\u0644\u0643 \u0636\u0645\u0646 \u0627\u0644\u062d\u0645\u0644\u0629 \u0627\u0644\u0634\u0639\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0627\u0655\u063a\u0627\u062b\u0629 \u0627\u0644\u0634\u0639\u0628 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a \u0627\u0644\u0634\u0642\u064a\u0642 \u0641\u064a \u0627\u0644\u0642\u0637\u0627\u0639.<br /><br /> <h2>\u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0627\u062a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u063a\u0632\u0629</h2>\u0648\u062a\u0627\u0654\u062a\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0627\u062a \u0641\u064a \u0627\u0655\u0637\u0627\u0631 \u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0627\u0635\u0644\u0629 \u0644\u0644\u0645\u0645\u0644\u0643\u0629 \u0645\u0645\u062b\u0644\u0629 \u0628\u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u0644\u0643 \u0633\u0644\u0645\u0627\u0646 \u0644\u0644\u0627\u0655\u063a\u0627\u062b\u0629.<br /><br />\u0648\u062a\u0633\u062a\u0647\u062f\u0641 \u062a\u0644\u0628\u064a\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0627\u0654\u0633\u0627\u0633\u064a\u0629 \u0644\u0644\u0627\u0654\u0633\u0631 \u0627\u0644\u0645\u062a\u0636\u0631\u0631\u0629 \u0648\u062f\u0639\u0645 \u0642\u062f\