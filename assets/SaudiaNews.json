 \u0627\u0655\u0636\u0627\u0641\u064a \u0641\u064a \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u0648\u0627\u0644\u062a\u064a \u0627\u0654\u062b\u0631\u062a \u0633\u0644\u0628\u064b\u0627 \u0639\u0644\u0649 <a href=\"https://www.alyaum.com/articles/6680812/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A7%D9%84%D8%B7%D8%A7%D9%82%D8%A9/%D8%A3%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D8%BA%D8%A7%D8%B2-%D8%A7%D9%84%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D9%8A-%D8%AA%D8%B3%D8%AC%D9%84-%D8%A3%D8%B9%D9%84%D9%89-%D9%85%D8%B3%D8%AA%D9%88%D9%89-%D9%85%D9%86%D8%B0-2023-%D9%85%D8%B9-%D8%A7%D9%82%D8%AA%D8%B1%D8%A7%D8%A8-%D9%81%D8%B5%D9%84-%D8%A7%D9%84%D8%B4%D8%AA%D8%A7%D8%A1\" target=\"_blank\">\u0627\u0644\u0627\u0654\u0633\u0639\u0627\u0631 </a>\u064a\u0648\u0645 \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621.<br /><br />\u0648\u062d\u0642\u0642\u062a \u062c\u0645\u064a\u0639 <a href=\"https://www.alyaum.com/articles/6680830/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%AE%D8%A7%D9%85-%D8%A7%D9%84%D8%AD%D8%AF%D9%8A%D8%AF-%D9%8A%D9%86%D8%AE%D9%81%D8%B6-%D9%84%D8%A3%D8%AF%D9%86%D9%89-%D9%85%D8%B3%D8%AA%D9%88%D9%89-%D9%81%D9%8A-%D8%B4%D9%87%D8%B1-%D9%88%D8%B3%D8%B7-%D8%AA%D9%88%D9%82%D8%B9%D8%A7%D8%AA-%D8%A8%D8%B2%D9%8A%D8%A7%D8%AF%D8%A9-%D8%A7%D9%84%D9%85%D8%B9%D8%B1%D9%88%D8%B6\" target=\"_blank\">\u0627\u0644\u0645\u0639\u0627\u062f\u0646 </a>\u0627\u0644\u0627\u0654\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u0633\u062a\u0629 \u0627\u0644\u0631\u064a\u0654\u064a\u0633\u064a\u0629 \u0627\u0644\u0645\u062a\u062f\u0627\u0648\u0644\u0629 \u0641\u064a \u0628\u0648\u0631\u0635\u0629 \u0644\u0646\u062f\u0646 \u0644\u0644\u0645\u0639\u0627\u062f\u0646 \u0645\u0643\u0627\u0633\u0628\u060c \u0648\u0643\u0627\u0646 \u0627\u0644\u0632\u0646\u0643 \u0645\u0646 \u0628\u064a\u0646 \u0627\u0654\u0628\u0631\u0632\u0647\u0627\u060c \u062d\u064a\u062b \u0627\u0654\u062f\u062a \u0627\u0644\u063a\u0627\u0631\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0639\u0644\u0649 \u0627\u0654\u0647\u062f\u0627\u0641 \u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629 - \u0648\u0631\u062f \u0637\u0647\u0631\u0627\u0646 \u0639\u0644\u064a\u0647\u0627 - \u0627\u0655\u0644\u0649 \u0627\u0655\u0642\u0628\u0627\u0644 \u0643\u0628\u064a\u0631 \u0639\u0644\u0649 \u0627\u0644\u0627\u0654\u0635\u0648\u0644 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0631\u060c \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u0645\u0639 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0646\u0641\u0637 \u0627\u0644\u062e\u0627\u0645.<br /><br />\u0648\u0645\u0639 \u0630\u0644\u0643\u060c \u0639\u0646\u062f\u0645\u0627 \u0633\u064f\u064a\u0654\u0644 \u062a\u0631\u0627\u0645\u0628 \u0639\u0646 \u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u0633\u062a\u0645\u0631 \u0641\u064a\u0647\u0627 \u062d\u0645\u0644\u0629 \u0627\u0644\u0642\u0635\u0641 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\u060c \u0642\u0627\u0644: \"\u0644\u0627 \u0627\u0654\u0639\u062a\u0642\u062f \u0627\u0654\u0646\u0647\u0627 \u0633\u062a\u0637\u0648\u0644\".<br /><br />\u0648\u0634\u0647\u062f\u062a \u0627\u0644\u0645\u0639\u0627\u062f\u0646 \u0627\u0644\u0627\u0654\u0633\u0627\u0633\u064a\u0629 \u0627\u0631\u062a\u0641\u0627\u0639\u064b\u0627 \u0645\u0644\u062d\u0648\u0638\u064b\u0627 \u0641\u064a \u0627\u0654\u063a\u0633\u0637\u0633 \u0627\u0644\u0645\u0627\u0636\u064a \u0648\u0633\u0637 \u0645\u0648\u0654\u0634\u0631\u0627\u062a \u0639\u0644\u0649 \u0634\u062d\u0651 \u0627\u0644\u0627\u0655\u0645\u062f\u0627\u062f\u0627\u062a\u060c \u062d\u064a\u062b \u0633\u062c\u0644 \u0627\u0644\u0646\u062d\u0627\u0633 \u0645\u0633\u062a\u0648\u0649 \u0627\u0655\u063a\u0644\u0627\u0642 \u0642\u064a\u0627\u0633\u064a\u064b\u0627 \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a\u060c \u0648\u0633\u062c\u0644 \u0627\u0644\u0632\u0646\u0643 \u0645\u0643\u0627\u0633\u0628 \u0644\u0644\u0634\u0647\u0631 \u0627\u0644\u062e\u0627\u0645\u0633 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a. \u0648\u0645\u0639 \u0630\u0644\u0643\u060c \u0644\u0627 \u064a\u0632\u0627\u0644 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u0648\u0646 \u0645\u062a\u062e\u0648\u0641\u064a\u0646 \u0628\u0634\u0627\u0654\u0646 \u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u062a\u0636\u062e\u0645 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u060c \u0648\u0627\u062d\u062a\u0645\u0627\u0644\u064a\u0629 \u0631\u0641\u0639 \u0645\u062c\u0644\u0633 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0627\u0644\u0641\u064a\u062f\u0631\u0627\u0644\u064a \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a \u0644\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0641\u0627\u064a\u0654\u062f\u0629.<br /><br />\u0648\u0627\u0631\u062a\u0641\u0639 \u0633\u0639\u0631 \u0627\u0644\u0632\u0646\u0643 \u0628\u0646\u0633\u0628\u0629 0.5% \u0644\u064a\u0635\u0644 \u0627\u0655\u0644\u0649 3882.50 \u062f\u0648\u0644\u0627\u0631 \u0644\u0644\u0637\u0646 \u0641\u064a \u0628\u0648\u0631\u0635\u0629 \u0644\u0646\u062f\u0646 \u0644\u0644\u0645\u0639\u0627\u062f\u0646 \u0639\u0646\u062f \u0627\u0644\u0633\u0627\u0639\u0629 10:54 \u0635\u0628\u0627\u062d\u064b\u0627 \u0628\u062a\u0648\u0642\u064a\u062a \u0634\u0646\u063a\u0647\u0627\u064a.<br /><br />\u0648\u0645\u0646 \u0628\u064a\u0646 \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0627\u0654\u062e\u0631\u0649\u060c \u0627\u0631\u062a\u0641\u0639 \u0633\u0639\u0631 <a href=\"https://www.alyaum.com/articles/6680813/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A3%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D9%86%D8%AD%D8%A7%D8%B3-%D8%AA%D8%AA%D8%B1%D8%A7%D8%AC%D8%B9-%D9%84%D8%A3%D9%82%D9%84-%D9%85%D8%B3%D8%AA%D9%88%D9%89-%D9%81%D9%8A-%D8%B4%D9%87%D8%B1-%D9%88%D8%B3%D8%B7-%D9%85%D8%AE%D8%A7%D9%88%D9%81-%D9%85%D9%86-%D8%B6%D8%B9%D9%81-%D8