{"status": "success", "totalResults": 4291, "results": [{"article_id": "709aac5c226b36da0212131e679444e7", "link": "https://www.alyaum.com/articles/6678461/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A5%D9%8A%D8%B1%D8%A7%D9%86-%D8%AA%D9%85%D9%86%D8%B9-%D8%AF%D8%A8%D9%84%D9%88%D9%85%D8%A7%D8%B3%D9%8A%D9%8A%D9%86-%D9%81%D8%B1%D9%86%D8%B3%D9%8A%D9%8A%D9%86-%D9%85%D9%86-%D8%A7%D9%84%D8%B9%D9%88%D8%AF%D8%A9-%D8%A5%D9%84%D9%89-%D8%A3%D8%B1%D8%A7%D8%B6%D9%8A%D9%87%D8%A7-%D9%85%D8%A7-%D8%A7%D9%84%D9%82%D8%B5%D8%A9", "title": "\u0627\u0655\u064a\u0631\u0627\u0646 \u062a\u0645\u0646\u0639 \u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u064a\u0646 \u0641\u0631\u0646\u0633\u064a\u064a\u0646 \u0645\u0646 \u0627\u0644\u0639\u0648\u062f\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0631\u0627\u0636\u064a\u0647\u0627.. \u0645\u0627 \u0627\u0644\u0642\u0635\u0629\u061f", "description": "\u0627\u0654\u0639\u0644\u0646\u062a <a href=\"https://www.alyaum.com/articles/6675079/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D9%87%D9%84-%D8%B9%D8%A7%D8%AF%D8%AA-%D8%A7%D9%84%D9%85%D9%81%D8%A7%D9%88%D8%B6%D8%A7%D8%AA-%D8%A8%D9%8A%D9%86-%D8%B7%D9%87%D8%B1%D8%A7%D9%86-%D9%88%D9%88%D8%A7%D8%B4%D9%86%D8%B7%D9%86-%D8%A7%D9%84%D8%AE%D8%A7%D8%B1%D8%AC%D9%8A%D8%A9-%D8%A7%D9%84%D8%A5%D9%8A%D8%B1%D8%A7%D9%86%D9%8A%D8%A9-%D8%AA%D9%88%D8%B6%D8%AD\" target=\"_blank\">\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629</a> \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u0627\u0654\u0646 \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u064e\u0651\u064a\u0652\u0646 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u064e\u0651\u064a\u0652\u0646 \u0627\u0644\u0644\u0630\u064a\u0646 \u0627\u062d\u062a\u064f\u062c\u0632\u0627 \u0644\u0641\u062a\u0631\u0629 \u0648\u062c\u064a\u0632\u0629 \u0641\u064a \u064a\u0648\u0644\u064a\u0648 \u0642\u0628\u0644 \u0627\u0654\u0646 \u064a\u063a\u0627\u062f\u0631\u0627 \u0627\u0644\u0628\u0644\u0627\u062f\u060c \u0645\u064f\u0646\u0639\u0627 \u0645\u0646 \u0627\u0644\u0639\u0648\u062f\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0631\u0627\u0636\u064a\u0647\u0627.<br /><br />\u0648\u0642\u0627\u0644 \u0627\u0644\u0645\u062a\u062d\u062f\u062b \u0628\u0627\u0633\u0645 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 <a href=\"https://www.alyaum.com/articles/6669944/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A7%D9%84%D8%B1%D8%A6%D9%8A%D8%B3-%D8%A7%D9%84%D8%A5%D9%8A%D8%B1%D8%A7%D9%86%D9%8A-%D9%85%D9%84%D8%AA%D8%B2%D9%85%D9%88%D9%86-%D8%A8%D9%85%D8%B0%D9%83%D8%B1%D8%A9-%D8%A7%D9%84%D8%AA%D9%81%D8%A7%D9%87%D9%85-%D9%85%D8%B9-%D8%A3%D9%85%D8%B1%D9%8A%D9%83%D8%A7-%D8%A5%D8%B0%D8%A7-%D8%A7%D9%84%D8%AA%D8%B2%D9%85%D8%AA-%D8%A8%D9%87%D8%A7\" target=\"_blank\">\u0627\u0655\u0633\u0645\u0627\u0639\u064a\u0644 \u0628\u0642\u0627\u064a\u0654\u064a</a> \u062e\u0644\u0627\u0644 \u0645\u0648\u0654\u062a\u0645\u0631\u0647 \u0627\u0644\u0635\u062d\u0627\u0641\u064a \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639\u064a \"\u063a\u0627\u062f\u0631 \u0627\u0644\u0634\u062e\u0635\u0627\u0646 \u0627\u0644\u0645\u0639\u0646\u064a\u0627\u0646 \u0627\u0655\u064a\u0631\u0627\u0646. \u0648\u0646\u062d\u0646 \u0627\u0654\u0639\u0644\u0646\u0651\u0627 \u0631\u0633\u0645\u064a\u0627 \u0627\u0654\u064a\u0636\u0627 \u0645\u0646\u0639\u0647\u0645\u0627 \u0645\u0646 \u0627\u0644\u0639\u0648\u062f\u0629 \u0627\u0655\u0644\u064a\u0647\u0627\".<br /><br />\u0648\u0641\u064a 20 \u064a\u0648\u0644\u064a\u0648\u060c \u0646\u062f\u062f <a href=\"https://www.alyaum.com/articles/6672661/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D9%88%D8%B2%D9%8A%D8%B1-%D8%AE%D8%A7%D8%B1%D8%AC%D9%8A%D8%A9-%D9%81%D8%B1%D9%86%D8%B3%D8%A7-%D9%84%D9%86-%D8%AA%D8%B1%D9%81%D8%B9-%D8%A7%D9%84%D8%B9%D9%82%D9%88%D8%A8%D8%A7%D8%AA-%D8%B9%D9%86-%D8%A5%D9%8A%D8%B1%D8%A7%D9%86-%D8%B7%D8%A7%D9%84%D9%85%D8%A7-%D9%84%D9%85-%D8%AA%D8%AA%D8%AE%D9%84-%D8%B9%D9%86-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%D9%87%D8%A7-%D8%A7%D9%84%D9%86%D9%88%D9%88%D9%8A\" target=\"_blank\">\u0648\u0632\u064a\u0631 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a</a> \u062c\u0627\u0646 \u0646\u0648\u064a\u0644 \u0628\u0627\u0631\u0648 \u0628\u0627\u0655\u062e\u0636\u0627\u0639 \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u064a\u0646 \u0644\u0640\"\u0639\u0645\u0644 \u062a\u0631\u0647\u064a\u0628 \u0628\u0627\u0644\u063a \u0627\u0644\u062e\u0637\u0648\u0631\u0629 \u0645\u0646 \u062c\u0627\u0646\u0628 \u0627\u0654\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0654\u0645\u0646 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629\"\u060c \u0645\u0639 \u062a\u0639\u0631\u0651\u0636 \u0627\u0654\u062d\u062f\u0647\u0645\u0627 \"\u0644\u0627\u0639\u062a\u062f\u0627\u0621\".<h2>\u0627\u0644\u0633\u0641\u064a\u0631 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0641\u064a \u0637\u0647\u0631\u0627\u0646</h2>\u0648\u0642\u0627\u0644 \u0628\u0627\u0631\u0648 \u0627\u0655\u0646\u0647\u0645\u0627 \u0627\u0639\u062a\u064f\u0642\u0644\u0627 \"\u0633\u0627\u0639\u0627\u062a \u0639\u062f\u0629 \u0645\u0646 \u062f\u0648\u0646 \u0633\u0628\u0628 \u0648\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u064a\u0642 \u0645\u0639\u0647\u0645\u0627 \u0648\u062a\u0639\u0631\u0651\u0636 \u0627\u0654\u062d\u062f\u0647\u0645\u0627 \u0627\u0655\u0644\u0649 \u0627\u0639\u062a\u062f\u0627\u0621 \u062c\u0633\u062f\u064a\" \u0642\u0628\u0644 \u0627\u0654\u0646 \u064a\u062a\u0645\u0643\u0646\u0627 \u0645\u0646 \u0627\u0644\u0639\u0648\u062f\u0629 \u0627\u0655\u0644\u0649 \u0627\u0644\u0633\u0641\u0627\u0631\u0629.<br /><br />\u0648\u0646\u0641\u062a \u0637\u0647\u0631\u0627\u0646 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u060c \u0645\u0634\u064a\u0631\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646\u0651 \u0627\u0644\u0627\u0654\u062c\u0647\u0632\u0629 \u0627\u0644\u0627\u0645\u0646\u064a\u0629 \"\u0627\u0633\u062a\u062c\u0648\u0628\u062a \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u064e\u0651\u064a\u0652\u0646 \u0644\u0641\u062a\u0631\u0629 \u0648\u062c\u064a\u0632\u0629\" \u0628\u0639\u062f \u0645\u0634\u0627\u0631\u0643\u062a\u0647\u0645\u0627 \u0641\u064a \"\u0627\u062c\u062a\u0645\u0627\u0639 \u0645\u0639 \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0627\u0654\u0634\u062e\u0627\u0635 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u064a\u0646 \u0644\u062f\u0649 \u0627\u0644\u0633\u0644\u0637\u0627\u062a\".<br /><br />\u0648\u0641\u064a \u0627\u0654\u0648\u0627\u062e\u0631 \u064a\u0648\u0644\u064a\u0648\u060c \u0627\u0633\u062a\u062f\u0639\u062a \u0637\u0647\u0631\u0627\u0646 \u0627\u0644\u0633\u0641\u064a\u0631 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0644\u062f\u064a\u0647\u0627 \u0644\u0644\u0627\u062d\u062a\u062c\u0627\u062c \u0639\u0644\u0649 \u0645\u0627 \u0648\u0635\u0641\u062a\u0647 \u0628\u0640\"\u0627\u0644\u062a\u062f\u062e\u0644 \u0641\u064a \u0634\u0648\u0654\u0648\u0646 \u0627\u0655\u064a\u0631\u0627\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629\"\u060c \u0645\u0637\u0627\u0644\u0628\u0629 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0628\u0640\"\u0648\u0636\u0639 \u062d\u062f \u0644\u0647\u0630\u0647 \u0627\u0644\u0645\u0645\u0627\u0631\u0633\u0627\u062a\".", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0627\u0644\u0642\u0635\u0629\u061f", "\u062a\u0645\u0646\u0639", "\u0625\u064a\u0631\u0627\u0646", "\u0623\u0631\u0627\u0636\u064a\u0647\u0627..", "\u0627\u0644\u0639\u0648\u062f\u0629", "\u0645\u0627", "\u0645\u0646", "\u0625\u0644\u0649", "\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u064a\u0646", "\u0641\u0631\u0646\u0633\u064a\u064a\u0646"], "creator": ["\u0623 \u0641 \u0628- \u0637\u0647\u0631\u0627\u