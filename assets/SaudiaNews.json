\u0647\u0649 \u0644\u064a\u0644\u064a\u061f", "description": "\u062a\u062f\u0627\u0648\u0644\u062a \u0645\u0646\u0635\u0627\u062a \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u062e\u0644\u0627\u0644 \u0627\u0644\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0627\u0636\u064a\u0629 \u0627\u0654\u0646\u0628\u0627\u0621\u064b \u062a\u0632\u0639\u0645 \u062a\u0639\u0631\u0636 \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u0635\u0631\u064a\u0629 \u064a\u0627\u0633\u0645\u064a\u0646 \u0639\u0632 \u0644\u062d\u0627\u0644\u0629 \u0627\u0655\u063a\u0645\u0627\u0621 \u0648\u0633\u0631\u0642\u0629 \u062f\u0627\u062e\u0644 \u0627\u0654\u062d\u062f \u0627\u0644\u0645\u0644\u0627\u0647\u064a \u0627\u0644\u0644\u064a\u0644\u064a\u0629\u060c \u0648\u0647\u0648 \u0645\u0627 \u0627\u0654\u062b\u0627\u0631 \u062c\u062f\u0644\u0627\u064b \u0648\u0627\u0633\u0639\u0627\u064b \u064a\u062f\u0648\u0631 \u062d\u0648\u0644 \u0635\u062d\u0629 \u0627\u0644\u0648\u0627\u0642\u0639\u0629 \u0648\u0645\u0643\u0627\u0646 \u062d\u062f\u0648\u062b\u0647\u0627.\u0648\u0644\u0645 \u064a\u062a\u0627\u0654\u062e\u0631 \u0631\u062f \u0645\u0642\u062f\u0645\u0629 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 MBC \u0645\u0635\u0631\u060c \u062d\u064a\u062b \u062e\u0631\u062c\u062a \u0639\u0628\u0631 \u062d\u0633\u0627\u0628\u0627\u062a\u0647\u0627 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0644\u0646\u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0627\u0654\u0646\u0628\u0627\u0621 \u062c\u0645\u0644\u0629 \u0648\u062a\u0641\u0635\u064a\u0644\u0627\u064b\u060c \u0645\u0648\u0654\u0643\u062f\u0629 \u0627\u0654\u0646 \u0627\u0644\u0642\u0635\u0629 \u0627\u062e\u062a\u0644\u0627\u0642 \u0643\u0627\u0645\u0644 \u0644\u0627 \u0627\u0654\u0633\u0627\u0633 \u0644\u0647 \u0645\u0646 \u0627\u0644\u0635\u062d\u0629.\u0648\u0627\u0654\u0648\u0636\u062d\u062a \u064a\u0627\u0633\u0645\u064a\u0646 \u0639\u0632 \u0627\u0654\u0646\u0647\u0627 \u062a\u062a\u0648\u0627\u062c\u062f \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \"\u0645\u0631\u0627\u0633\u064a\" \u0628\u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u0634\u0645\u0627\u0644\u064a \u0644\u0642\u0636\u0627\u0621 \u0639\u0637\u0644\u062a\u0647\u0627 \u0627\u0644\u0635\u064a\u0641\u064a\u0629\u060c \u0645\u0634\u064a\u0631\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0637\u0628\u064a\u0639\u0629 \u062d\u064a\u0627\u062a\u0647\u0627 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u0636\u0628\u0627\u0637 \u0648\u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f \u0639\u0646 \u0627\u0644\u0633\u0647\u0631 \u0648\u0627\u0644\u0627\u0654\u0645\u0627\u0643\u0646 \u0627\u0644\u0645\u0632\u062f\u062d\u0645\u0629. **media[2754033]**\u0648\u0631\u062f\u062a \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0645\u064a\u0629 \u0639\u0644\u0649 \u0627\u0655\u062d\u062f\u0649 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0627\u062a \u0642\u0627\u064a\u0654\u0644\u0629: \"\u0627\u0654\u0646\u0627 \u0644\u0627 \u0627\u0654\u0633\u0647\u0631\u060c \u0648\u0644\u0627 \u0627\u0654\u0634\u0631\u0628\u060c \u0648\u0644\u0627 \u0627\u0654\u062f\u062e\u0646\u060c \u0648\u063a\u064a\u0631 \u0645\u0646\u062a\u0634\u0631\u0629\u060c \u0648\u0627\u0654\u062d\u0633\u0628 \u062e\u0637\u0648\u0627\u062a\u064a \u0628\u0627\u0644\u0645\u0644\u0644\u064a\". \u0648\u0644\u062a\u0627\u0654\u0643\u064a\u062f \u0645\u0648\u0642\u0641\u0647\u0627\u060c \u0646\u0634\u0631\u062a \u0645\u0642\u0627\u0637\u0639 \u0645\u0635\u0648\u0631\u0629 \u062a\u0638\u0647\u0631 \u0641\u064a\u0647\u0627 \u0648\u0633\u0637 \u062c\u0645\u0647\u0648\u0631\u0647\u0627 \u0628\u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u0634\u0645\u0627\u0644\u064a \u0627\u0654\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u062a\u0630\u0643\u0627\u0631\u064a\u0629.\u0648\u0627\u0654\u0645\u0627\u0645 \u0627\u0646\u062a\u0634\u0627\u0631 \u0645\u0646\u0634\u0648\u0631\u0627\u062a \u0645\u0641\u0628\u0631\u0643\u0629 \u062a\u062d\u0645\u0644 \u0627\u0633\u0645\u0647\u0627 \u0648\u0635\u0648\u0631\u062a\u0647\u0627\u060c \u0627\u0654\u0639\u0644\u0646\u062a \u064a\u0627\u0633\u0645\u064a\u0646 \u0639\u0632 \u0628\u062f\u0621 \u0627\u062a\u062e\u0627\u0630 \u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0636\u062f \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0648\u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u062a\u064a \u0633\u0627\u0647\u0645\u062a \u0641\u064a \u062a\u0631\u0648\u064a\u062c \u0647\u0630\u0647 \u0627\u0644\u0627\u062f\u0639\u0627\u0621\u0627\u062a.\u0648\u0627\u0654\u0643\u062f\u062a \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0645\u064a\u0629 \u0627\u0654\u0646\u0647\u0627 \u0644\u0646 \u062a\u062a\u0647\u0627\u0648\u0646 \u0645\u0639 \u0627\u0654\u064a \u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u0644\u0645\u0633\u0627\u0633 \u0628\u0633\u0645\u0639\u062a\u0647\u0627 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0654\u0648 \u0627\u0644\u0645\u0647\u0646\u064a\u0629\u060c \u0645\u0634\u064a\u0631\u0629 \u0627\u0655\u0644\u0649 \u062a\u0643\u0644\u064a\u0641 \u0641\u0631\u064a\u0642\u0647\u0627 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0628\u0645\u0644\u0627\u062d\u0642\u0629 \u0627\u0644\u0645\u0633\u0648\u0654\u0648\u0644\u064a\u0646 \u0639\u0646 \u062a\u0631\u0643\u064a\u0628 \u0648\u0646\u0634\u0631 \u0627\u0644\u0627\u0654\u062e\u0628\u0627\u0631 \u0627\u0644\u0632\u0627\u064a\u0654\u0641\u0629.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u062b\u0642\u0627\u0641\u0629 \u0648\u0641\u0646"], "creator": ["\u00ab\u0639\u0643\u0627\u0638\u00bb (\u062c\u062f\u0629) okaz_online@"], "language": "arabic", "country": ["saudi arabia"], "category": ["entertainment"], "datatype": "news", "pubDate": "2026-08-22 