%D8%AA%D8%AC%D9%87-%D9%84%D8%A3%D9%81%D8%B6%D9%84-%D8%A3%D8%AF%D8%A7%D8%A1-%D8%A3%D8%B3%D8%A8%D9%88%D8%B9%D9%8A-%D9%81%D9%8A-7-%D8%A3%D8%B4%D9%87%D8%B1", "title": "\u0633\u0639\u0631 \u0627\u0644\u0630\u0647\u0628 \u0627\u0644\u064a\u0648\u0645.. \u0627\u0644\u0645\u0639\u062f\u0646 \u0627\u0644\u0627\u0654\u0635\u0641\u0631 \u064a\u062a\u062c\u0647 \u0644\u0627\u0654\u0641\u0636\u0644 \u0627\u0654\u062f\u0627\u0621 \u0627\u0654\u0633\u0628\u0648\u0639\u064a \u0641\u064a 7 \u0627\u0654\u0634\u0647\u0631", "description": "\u0627\u0631\u062a\u0641\u0639\u062a <a href=\"https://www.alyaum.com/articles/6676884/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A3%D8%AD%D8%AF%D8%AB-%D8%A7%D9%84%D8%A3%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D8%B0%D9%87%D8%A8-%D9%8A%D8%AA%D8%AC%D9%87-%D9%86%D8%AD%D9%88-%D8%A3%D9%81%D8%B6%D9%84-%D9%85%D9%83%D8%A7%D8%B3%D8%A8-%D8%A3%D8%B3%D8%A8%D9%88%D8%B9%D9%8A%D8%A9-%D9%85%D9%86%D8%B0-%D9%8A%D9%86%D8%A7%D9%8A%D8%B1\">\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0630\u0647\u0628</a> \u0627\u0644\u064a\u0648\u0645 \u0627\u0655\u0644\u0649 \u0627\u0654\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0641\u064a \u0633\u0628\u0639\u0629 \u0627\u0654\u0633\u0627\u0628\u064a\u0639\u060c \u0645\u062f\u0639\u0648\u0645\u0629 \u0628\u0636\u0639\u0641 <a href=\"https://www.alyaum.com/articles/6676868/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A8%D8%B9%D8%AF%D9%85%D8%A7-%D8%B3%D8%AC%D9%84-%D8%A3%D8%B9%D9%84%D9%89-%D9%85%D8%B3%D8%AA%D9%88%D9%89-%D8%A7%D9%84%D8%B0%D9%87%D8%A8-%D9%8A%D8%A8%D8%AF%D8%AF-%D9%85%D9%83%D8%A7%D8%B3%D8%A8%D9%87-%D9%88%D9%8A%D8%B3%D8%AA%D9%82%D8%B1-%D9%85%D8%B9-%D8%B5%D8%B9%D9%88%D8%AF-%D8%A7%D9%84%D9%86%D9%81%D8%B7\">\u0628\u064a\u0627\u0646\u0627\u062a \u0633\u0648\u0642 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629</a> \u0648\u062a\u0631\u0627\u062c\u0639 \u062a\u0648\u0642\u0639\u0627\u062a \u0631\u0641\u0639<a href=\"https://www.alyaum.com/articles/6676733/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%B3%D8%B9%D8%B1-%D8%AC%D8%B1%D8%A7%D9%85-%D8%A7%D9%84%D8%B0%D9%87%D8%A8-%D8%B9%D9%8A%D8%A7%D8%B1-21-%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D8%AE%D9%85%D9%8A%D8%B3-%D9%81%D9%8A-%D9%85%D8%B5%D8%B1-%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%AC%D8%AF%D9%8A%D8%AF-%D8%A8%D8%A7%D9%84%D8%A3%D8%B3%D9%88%D8%A7%D9%82\"> \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0641\u0627\u064a\u0654\u062f\u0629</a>.<br /><br />\u0648\u0635\u0639\u062f \u0627\u0644\u0630\u0647\u0628 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 2.6% \u0627\u0655\u0644\u0649 4348.87 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0627\u0654\u0648\u0642\u064a\u0629\u060c \u0645\u062a\u062c\u0647\u064b\u0627 \u0627\u0655\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u0627\u0654\u0641\u0636\u0644 \u0627\u0654\u062f\u0627\u0621 \u0627\u0654\u0633\u0628\u0648\u0639\u064a \u0644\u0647 \u0641\u064a \u0633\u0628\u0639\u0629 \u0627\u0654\u0634\u0647\u0631.<h2>\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0630\u0647\u0628</h2>\u0648\u0627\u0631\u062a\u0641\u0639\u062a \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0627\u0644\u0627\u0653\u062c\u0644\u0629 \u0644\u0644\u0630\u0647\u0628 \u0628\u0646\u0633\u0628\u0629 2.5% \u0627\u0655\u0644\u0649 4408 \u062f\u0648\u0644\u0627\u0631\u0627\u062a.<br /><br /> <br /><br />\u0648\u062c\u0627\u0621 \u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639 \u0628\u0639\u062f \u0627\u0654\u0646 \u0627\u0654\u0638\u0647\u0631\u062a \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u062a\u0631\u0627\u