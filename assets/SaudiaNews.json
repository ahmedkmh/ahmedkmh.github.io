631\u062d\u0644\u0629 \u0627\u0646\u062a\u0642\u0627\u0644\u064a\u0629 \u0641\u064a \u062a\u0627\u0631\u064a\u062e <a href=\"https://www.alyaum.com/articles/928351/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%86%D8%A7%D8%A6%D8%A8-%D9%88%D8%B2%D9%8A%D8%B1-%D8%A7%D9%84%D8%AA%D8%B9%D9%84%D9%8A%D9%85-%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%8A-%D9%8A%D9%81%D8%AA%D8%AA%D8%AD-%D9%85%D9%86%D8%AA%D8%AF%D9%89-%D8%A7%D9%84%D8%B9%D9%85%D8%B1%D8%A7%D9%86-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A-%D8%A7%D9%84%D8%AB%D8%A7%D9%84%D8%AB\" target=\"_blank\">\u0627\u0644\u0639\u0645\u0631\u0627\u0646 \u0627\u0644\u0633\u0639\u0648\u062f\u064a</a>\u060c \u0628\u0648\u0635\u0641\u0647 \u0627\u0654\u0648\u0644 \u0645\u0628\u0646\u0649 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0641\u064a\u0647 \u0627\u0644\u0627\u0655\u0633\u0645\u0646\u062a \u0648\u0627\u0644\u062d\u062f\u064a\u062f \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0648\u0647\u0648 \u0645\u0627 \u064a\u062c\u0639\u0644\u0647 \u0645\u062e\u062a\u0644\u0641\u064b\u0627 \u0639\u0646 \u0628\u064a\u0648\u062a <a href=\"https://www.alyaum.com/articles/6683575/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%85%D8%B3%D9%8A%D8%B1%D8%A9-%D8%B1%D9%8A%D8%A7%D8%B6%D9%8A%D8%A9-%D8%A8%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D9%88%D8%B7%D9%86%D9%8A-%D9%88%D8%AC%D9%88%D9%84%D8%A7%D8%AA-%D9%84%D9%84%D8%AF%D8%B1%D8%A7%D8%AC%D8%A7%D8%AA-%D8%B9%D8%A8%D8%B1-%D9%85%D8%B9%D8%A7%D9%84%D9%85-%D8%AC%D8%AF%D8%A9-%D8%A7%D9%84%D8%AA%D8%A7%D8%B1%D9%8A%D8%AE%D9%8A%D8%A9\" target=\"_blank\">\u201d\u062c\u062f\u0629 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629\u201c</a>\u060c \u0627\u0644\u062a\u064a \u062a\u0645\u062b\u0651\u0644 \u0627\u0644\u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u0633\u0627\u062d\u0644\u064a\u0629 \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629 \u0627\u0644\u0645\u0645\u062a\u062f\u0629 \u0644\u0642\u0631\u0648\u0646.<br /><br />\u0642\u0635\u0629 \u0628\u0646\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0642\u0635\u0631\u060c \u0628\u062f\u0627\u0654\u062a \u0628\u0627\u0654\u0645\u0631 \u0645\u0646 \u0627\u0644\u0645\u0648\u0654\u0633\u0633 \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0628\u0646 \u0639\u0628\u062f\u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0653\u0644 \u0633\u0639\u0648\u062f - \u0637\u064a\u0628 \u0627\u0644\u0644\u0647 \u062b\u0631\u0627\u0647 - \u0639\u0627\u0645 1928\u060c \u0641\u064a\u0645\u0627 \u0627\u0643\u062a\u0645\u0644 \u0628\u0646\u0627\u0648\u0654\u0647 \u0639\u0627\u0645 1932\u060c \u0644\u062a\u0646\u062a\u0642\u0644 \u0627\u0655\u0642\u0627\u0645\u0629 \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632 \u0627\u0655\u0644\u064a\u0647 \u0628\u0639\u062f \u201d\u0628\u064a\u062a \u0646\u0635\u064a\u0641\u201c.<br /><br /> <h2>\u0647\u0648\u064a\u0629 \u0627\u0644\u0639\u0645\u0627\u0631\u0629</h2><br />\u062a\u062a\u062d\u0642\u0642 \u0633\u0645\u0629 \u201d\u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0628\u064a\u064a\u0654\u064a \u0648\u0627\u0644\u062a\u0647\u0648\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062f\u0627\u0645\u0629\u201c \u0645\u0646 \u201d\u0627\u0644\u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u0633\u0627\u062d\u0644\u064a\u0629 \u0627\u0644\u062d\u062c\u0627\u0632\u064a\u0629\u201c\u060c \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u201d\u0642\u0635\u0631 \u062e\u0632\u0627\u0645\u201c\u060c \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0639\u062a\u0645\u0627\u062f\u0647 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0641\u0627\u062a \u0627\u0644\u0648\u0627\u0633\u0639\u0629 \u0648\u0627\u0644\u062f\u0647\u0627\u0644\u064a\u0632 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629 \u0644\u062a\u062e\u0641\u064a\u0641 \u0627\u0644\u0631\u0637\u0648\u0628\u0629 \u0648\u0627\u0644\u062d\u0631\u0627\u0631\u0629\u060c \u0641\u064a \u062d\u064a\u0646 \u062a\u0628\u0631\u0632 \u0633\u0645\u0629 \u201d\u0627\u0644\u0645\u0648\u0627\u062f \u0648\u0627\u0644\u0627\u0654\u0644\u0648\u0627\u0646 \u0627\u0644\u0633\u0627\u064a\u0654\u062f\u0629\u201c \u0645\u0646 \u0647\u0648\u064a\u0629 \u0627\u0644\u0639\u0645\u0627\u0631\u0629\u060c \u0641\u064a \u0627\u0643\u062a\u0633\u0627\u0621 \u0627\u0644\u0642\u0635\u0631 \u0628\u0637\u0644\u0627\u0621 \u201d\u0627\u0644\u062c\u0635 \u0627\u0644\u0627\u0654\u0628\u064a\u0636\u201c \u0644\u062d\u0645\u0627\u064a\u062a\u0647 \u0645\u0646 \u0627\u0644\u0631\u0637\u0648\u0628\u0629\u060c \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0627\u0655\u062f\u062e\u0627\u0644 \u0627\u0644\u062e\u0631\u0633\u0627\u0646\u0629 \u0641\u064a \u0628\u0646\u0627\u064a\u0654\u0647.<br /><br />\u0627\u0654\u0645\u0627 \u0633\u0645\u0629 \u201d\u0627\u0644\u062a\u0642\u0633\u064a\u0645 \u0627\u0644\u0648\u0627\u0636\u062d \u0648\u0627\u0644\u062a\u0645\u0627\u062b\u0644 \u0641\u064a \u0627\u0644\u0648\u0627\u062c\u0647\u0627\u062a\u201c\u060c \u0641\u062a\u062c\u0633\u062f\u0647\u0627 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0642\u0635\u0631 \u0627\u0644\u0634\u0647\u064a\u0631\u0629\u060c \u0628\u0643\u062a\u0644\u062a\u0647\u0627 \u0627\u0644\u0645\u062a\u0645\u0627\u062b\u0644\u0629 \u0648\u0627\u0644\u0648\u0627\u0636\u062d\u0629\u060c \u0645\u0639 \u062a\u0642\u0633\u064a\u0645\u0627\u062a \u0631\u0627\u0654\u0633\u064a\u0629 \u0647\u0646\u062f\u0633\u064a\u0629 \u0645\u0646\u062a\u0638\u0645\u0629\u060c \u0627\u0655\u0630 \u062a\u062a\u0643\u0631\u0631 \u0647\u0630\u0647 \u0627\u0644\u0632\u062e\u0627\u0631\u0641 \u0648\u0627\u0644\u0646\u0642\u0648\u0634 \u0627\u0644\u0645\u0633\u062a\u0648\u062d\u0627\u0629 \u0645\u0646 \u0627\u0644\u0641\u0646\u0648\u0646 \u0627\u0644\u0627\u0655\u0633\u0644\u0627\u0645\u064a\u0629\u060c \u0641\u064a \u0643\u0627\u0645\u0644 \u0628\u0648\u0627\u0628\u0627\u062a \u0627\u0644\u0642\u0635\u0631 \u0648\u062d\u0648\u0627\u0641\u0647 \u0627\u0644\u0639\u0644\u0648\u064a\u0629\u060c \u0644\u062a\u062c\u0633\u062f \u0627\u0654\u064a\u0636\u064b\u0627 \u0633\u0645\u0629 \u201d\u0627\u0644\u0632\u062e\u0627\u0631\u0641 \u0627\u0644\u0647\u0646\u062f\u0633\u064a\u0629 \u0627\u0644\u0645\u0639\u0642\u062f\u0629\u201c.<h2>\u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629</h2><br />\u0648\u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0642\u0635\u0631 \u0639\u0644\u0649 \u0646\u0648\u0627\u0641\u0630 \u0645\u0633\u062a\u0637\u064a\u0644\u0629 \u0645\u0631\u062a\u0641\u0639\u0629\u060c \u062a\u0633\u0645\u062d \u0628\u0645\u0631\u0648\u0631 \u0627\u0644\u0636\u0648\u0621\u060c \u0645\u0639 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0627\u0655\u0636\u0627\u0621\u0629 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0644\u062a\u0638\u0647\u0631 \u0628\u0630\u0644\u0643 \u0633\u0645\u0629 \u201d\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0641\u062a\u062d\u0627\u062a \u0648\u0627\u0644\u0634\u0628\u0627\u0628\u064a\u0643 \u0627\u0644\u0645\u0631\u062a\u0641\u0639\u0629\u201c \u0645\u0646 \u201d\u0627\u0644\u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u0633\u0627\u062d\u0644\u064a\u0629 \u0627\u0644\u062d\u062c\u0627\u0632\u064a\u0629\u201c.<br /><br />\u0648\u0645\u0646 \u062f\u0627\u062e\u0644 \u201d\u0642\u0635\u0631 \u062e\u0632\u0627\u0645\u201c\u060c \u062c\u0631\u0649 \u062a\u0648\u0642\u064a\u0639 \u0627\u0654\u0648\u0644 \u0648\u0627\u0654\u0647\u0645 \u0627\u062a\u0641\u0627\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u0627\u0645\u062a\u064a\u0627\u0632 \u0644\u0644\u062a\u0646\u0642\u064a\u0628 \u0639\u0646 \u0627\u0644\u0628\u062a\u0631\u0648\u0644 \u0639\u0627\u0645 1933 \u0628\u064a\u0646 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u06