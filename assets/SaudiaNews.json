0648\u0627\u0644\u062a\u0633\u0648\u064a\u0642\u060c \u0646\u062a\u064a\u062c\u0629 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0639\u0628\u0631 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u062a\u0648\u0635\u064a\u0644\u060c \u062d\u0633\u0628\u0645\u0627 \u0630\u0643\u0631\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0641\u064a \u0628\u064a\u0627\u0646 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\".<br /><br />\u0648\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0633\u062a\u0629 \u0627\u0654\u0634\u0647\u0631 \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0646\u062e\u0641\u0636 \u0635\u0627\u0641\u064a \u0631\u0628\u062d \u0627\u0644\u0634\u0631\u0643\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 \u0639\u0627\u0645 2026 \u0628\u0646\u0633\u0628\u0629 24.78% \u0644\u064a\u0635\u0644 \u0627\u0655\u0644\u0649 24.59 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u0640 32.7 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642.<br /><br />\u0648\u064a\u0639\u0648\u062f \u0647\u0630\u0627 \u0627\u0644\u0627\u0646\u062e\u0641\u0627\u0636 \u0628\u0635\u0648\u0631\u0629 \u0631\u064a\u0654\u064a\u0633\u0629 \u0627\u0655\u0644\u0649 \u062a\u0627\u0654\u062b\u0631 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u0637\u0644\u0628 \u0628\u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u0634\u0631\u0627\u064a\u0654\u064a\u0629\u060c \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0641\u064a \u0638\u0644 \u0627\u0644\u063