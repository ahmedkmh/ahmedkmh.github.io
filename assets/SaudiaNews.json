-30-%D8%A3%D9%84%D9%81-%D8%AC%D9%86%D8%AF%D9%8A-%D8%A5%D8%B6%D8%A7%D9%81%D9%8A-%D9%85%D9%86-%D9%83%D9%88%D8%B1%D9%8A%D8%A7-%D8%A7%D9%84%D8%B4%D9%85%D8%A7%D9%84%D9%8A%D8%A9\">\u0643\u0648\u0631\u064a\u0627 </a>\u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629 \u0645\u0646 \u0645\u0646\u0637\u0642\u0629 \u0648\u0648\u0646\u0633\u0627\u0646 \u0628\u0627\u062a\u062c\u0627\u0647 \u0628\u062d\u0631 \u0627\u0644\u0634\u0631\u0642\" \u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0627\u0644\u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0643\u0648\u0631\u064a\u0629 \u0644\u0628\u062d\u0631 \u0627\u0644\u064a\u0627\u0628\u0627\u0646.<br /> <br />\u0648\u0630\u0643\u0631\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u064a\u0627\u0628\u0627\u0646\u064a\u0629 \u0639\u0644\u0649 \u0648\u0633\u0627\u064a\u0654\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0627\u0654\u0646<a href=\"https://www.alyaum.com/articles/6671058/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%B5%D9%88%D8%B1-%D8%B2%D8%B9%D9%8A%D9%85-%D9%83%D9%88%D8%B1%D9%8A%D8%A7-%D8%A7%D9%84%D8%B4%D9%85%D8%A7%D9%84%D9%8A%D8%A9-%D9%8A%D8%B4%D8%B1%D9%81-%D8%B9%D9%84%D9%89-%D8%A5%D8%B9%D8%A7%D8%AF%D8%A9-%D8%AA%D8%AF%D8%B4%D9%8A%D9%86-%D8%B3%D9%81%D9%8A%D9%86%D8%A9-%D8%AD%D8%B1%D8%A8%D9%8A%D8%A9-%D8%A7%D9%86%D9%82%D9%84%D8%A8%D8%AA-%D9%82%D8%A8%D9%84-%D8%B9%D8%A7%D9%85\"> \u0627\u0644\u0635\u0627\u0631\u0648\u062e \u0627\u0644\u0628\u0627\u0644\u0633\u062a\u064a</a> \u0633\u0642\u0637\u060c \u0645\u0646 \u062f\u0648\u0646 \u062a\u0642\u062f\u064a\u0645 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0655\u0636\u0627\u0641\u064a\u0629.<h2>\u0645\u0646\u0627\u0648\u0631\u0627\u062a \u0645\u0634\u062a\u0631\u0643\u0629</h2>\u0648\u0645\u0646 \u0627\u0644\u0645\u0642\u0631\u0631 \u0627\u0654\u0646 \u062a\u0646\u0637\u0644\u0642 \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u0645\u0646\u0627\u0648\u0631\u062