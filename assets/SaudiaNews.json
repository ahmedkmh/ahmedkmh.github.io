4%D9%8A%D9%88%D9%85-%D9%81%D9%8A-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D8%A7%D9%86%D8%AE%D9%81%D8%A7%D8%B6-%D8%AC%D8%AF%D9%8A%D8%AF-%D8%A8%D8%A7%D9%84%D8%A3%D8%B3%D9%88%D8%A7%D9%82\" target=\"_blank\">\u0627\u0644\u0630\u0647\u0628 </a>\u0639\u064a\u0627\u0631 21\u060c \u0627\u0644\u0627\u0654\u0643\u062b\u0631 \u062a\u062f\u0627\u0648\u0644\u064b\u0627 \u0628\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u0644\u0643\u064a\u0646\u060c \u0641\u064a \u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0633\u0637 \u062a\u0631\u0642\u0628 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646 \u0648\u0627\u0644\u0645\u0633\u062a\u0647\u0644\u0643\u064a\u0646 \u0644\u062a\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0633\u0648\u0642.<h2>\u0633\u0639\u0631 \u062c\u0631\u0627\u0645 \u0627\u0644\u0630\u0647\u0628 \u0639\u064a\u0627\u0631 21</h2>\u0633\u062c\u0644 \u0633\u0639\u0631 \u062c\u0631\u0627\u0645 \u0627\u0644\u0630\u0647\u0628 <a href=\"https://www.alyaum.com/articles/6678709/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%B3%D8%B9%D8%B1-%D8%AC%D8%B1%D8%A7%D9%85-%D8%A7%D9%84%D8%B0%D9%87%D8%A8-%D8%B9%D9%8A%D8%A7%D8%B1-21-%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D9%81%D9%8A-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D8%A7%D9%84%D8%AA%D9%81%D8%A7%D8%B5%D9%8A%D9%84-%D9%87%D9%86%D8%A7\" target=\"_blank\">\u0639\u064a\u0627\u0631 21</a> \u0641\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621\u060c 789.5 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0628\u0644 490.75 \u0631\u064a\u0627\u0644\u060c \u0627\u0654\u0645\u0633.<h2>\u0633\u0639\u0631 \u062c\u0631\u0627\u0645 \u0627\u0644\u0630\u0647\u0628 \u0639\u064a\u0627\u0631 24</h2>\u0628\u0644\u063a \u0633\u0639\u0631 \u062c\u0631\u0627\u0645 \u0627\u0644\u0630\u0647\u0628 \u06