4%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D8%B3%D8%AA%D9%82%D8%A8%D8%A7%D9%84-%D8%A7%D9%84%D8%AF%D9%81%D8%B9%D8%A9-%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D9%8A%D8%A9-%D9%85%D9%86-%D8%B6%D9%8A%D9%88%D9%81-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC-%D8%AE%D8%A7%D8%AF%D9%85-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%84%D9%84%D8%B9%D9%85%D8%B1%D8%A9-%D9%88%D8%A7%D9%84%D8%B2%D9%8A%D8%A7%D8%B1%D8%A9\"> \u0636\u064a\u0648\u0641 \u0628\u0631\u0646\u0627\u0645\u062c \u062e\u0627\u062f\u0645 \u0627\u0644\u062d\u0631\u0645\u064a\u0646</a> \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646 \u0644\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629\u060c \u0627\u0644\u0630\u064a \u062a\u0646\u0641\u0630\u0647 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0634\u0648\u0654\u0648\u0646 \u0627\u0644\u0627\u0655\u0633\u0644\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u062f\u0639\u0648\u0629 \u0648\u0627\u0644\u0627\u0655\u0631\u0634\u0627\u062f\u060c \u0628\u062d\u0641\u0627\u0648\u0629 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u062c\u0648\u062f\u0629 \u0627\u0644\u062a\u0646\u0638\u064a\u0645 \u0648\u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u062a\u064a \u062d\u0638\u0648\u0627 \u0628\u0647\u0627 \u0645\u0646\u0630 \u0648\u0635\u0648\u0644\u0647\u0645 \u0627\u0655\u0644\u0649 <a href=\"https://www.alyaum.com/articles/6673361/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B6%D9%8A%D9%88%D9%81-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC-%D8%AE%D8%A7%D8%AF%D9%85-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%8A%D8%B2%D9%88%D8%B1%D9%88%D9%86-%D9%85%D8%AC%D9%85%D8%B9-%D8%B5%D9%86%D8%A7%D8%B9%D8%A9-%D9%83%D8%B3%D9%88%D8%A9-%D8%A7%D9%84%D9%83%D8%B9%D8%A8%D8%A9-%D8%A7%D9%84%D9%85%D8%B4%D8%B1%D9%81%D8%A9\">\u0627\u0644\u0645\u0645\u0644\u0643\u0629</a>\u060c \u0645\u0639\u0631\u0628\u064a\u0646 \u0639\u0646 \u0634\u0643\u0631\u0647\u0645 \u0648\u0627\u06