ww.alyaum.com/articles/6676689/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%B3%D8%AD%D8%A7%D8%A8%D8%A9-%D8%AD%D8%B7%D8%A7%D9%85-%D9%88%D9%81%D9%88%D9%87%D8%A9-%D8%AA%D8%AF%D8%A7%D8%B9%D9%8A%D8%A7%D8%AA-%D8%A7%D8%B1%D8%AA%D8%B7%D8%A7%D9%85-%D8%B5%D8%A7%D8%B1%D9%88%D8%AE-%D8%B3%D8%A8%D8%A7%D9%8A%D8%B3-%D8%A5%D9%83%D8%B3-%D8%A8%D8%B3%D8%B7%D8%AD-%D8%A7%D9%84%D9%82%D9%85%D8%B1\">\u0633\u0628\u064a\u0633 \u0627\u0655\u0643\u0633</a>.<br /><br />\u0648\u062d\u0644\u0642\u062a \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0627\u0644\u0641\u0636\u0627\u064a\u0654\u064a\u0629 \"\u062f\u0627\u0646\u0648\u0631\u064a\" \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0645\u0639\u0647\u062f \u0627\u0654\u0628\u062d\u0627\u062b \u0627\u0644\u0641\u0636\u0627\u0621 \u0627\u0644\u0643\u0648\u0631\u064a \u0641\u0648\u0642<a href=\"https://www.alyaum.com/articles/6676652/%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/%D8%AA%D9%83%D9%86%D9%88%D9%84%D9%88%D8%AC%D9%8A%D8%A7/%D8%B5%D8%A7%D8%B1%D9%88%D8%AE-%D8%AA%D8%A7%D8%A8%D8%B9-%D9%84%D8%B4%D8%B1%D9%83%D8%A9-%D8%B3%D8%A8%D8%A7%D9%8A%D8%B3-%D8%A5%D9%83%D8%B3-%D9%8A%D8%B5%D8%B7%D8%AF%D9%85-%D8%A8%D8%B3%D8%B7%D8%AD-%D8%A7%D9%84%D9%82%D9%85%D8%B1-%D9%87%D9%84-%D9%8A%D9%87%D8%AF%D8%AF-%D8%A7%D9%84%D8%A3%D8%B1%D8%B6\"> \u0645\u0648\u0642\u0639 \u0627\u0644\u0627\u0635\u0637\u062f\u0627\u0645</a> \u0628\u0639\u062f \u0641\u062a\u0631\u0629 \u0648\u062c\u064a\u0632\u0629 \u0645\u0646 \u0627\u0635\u0637\u062f\u0627\u0645 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u0639\u0644\u064a\u0627 \u0645\u0646 \u0635\u0627\u0631\u0648\u062e \u0641\u0627\u0644\u0643\u0648\u0646 9 \u0628\u0627\u0644\u0642\u0645\u0631 \u0628\u0634\u0643\u0644 \u063a\u064a\u0631 \u0645\u062a\u0639\u0645\u062f \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621.<br /> <br />\u0648\u0642\u0627\u0645\u062a \u062f\u0627\u0646\u0648\u0631\u064a \u0628\u0639\u062f\u0629 \u062c\u0648\u0644\u0627\u062a \u0648\u0627\u0644\u062a\u0642\u0637