\u0639\u0646 \u062f\u0648\u0631\u060c \u0644\u0643\u0646 \u0644\u064a\u0633 \u0645\u0639\u0642\u0648\u0644\u0627\u064b \u0623\u0646 \u0646\u0633\u0645\u062d \u0628\u0627\u0644\u0645\u0633\u0627\u0633 \u0628\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0627\u0633\u062a\u0642\u0631\u0627\u0631\u0647\u0627\".\u0648\u062c\u062f\u062f \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0645\u0635\u0631\u064a \u0639\u0628\u062f \u0627\u0644\u0641\u062a\u0627\u062d \u0627\u0644\u0633\u064a\u0633\u064a \u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0639\u0644\u0649 \u0623\u0646\u0647 \u0644\u0646 \u064a\u062a\u0645 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062f\u0633\u062a\u0648\u0631\u060c \u0643\u0627\u0634\u0641\u0627 \u0623\u0646 \u0646\u0647\u0627\u064a\u0629 \u0631\u0626\u0627\u0633\u062a\u0647 \u0644\u0645\u0635\u0631 \u0633\u062a\u0643\u0648\u0646 \u0641\u064a \u0639\u0627\u0645 2030.\u0648\u0623\u0639\u0644\u0646 \u0627\u0644\u0633\u064a\u0633\u064a \u0623\u0646 \u0646\u0647\u0627\u064a\u0629 \u0645\u062f\u062a\u0647 \u0641\u064a \u0631\u0626\u0627\u0633\u0629 \u0627\u0644\u0628\u0644\u0627\u062f \u0633\u062a\u0643\u0648\u0646 \u0641\u064a \u0639\u0627\u0645 2030\u060c \u0645\u0636\u064a\u0641\u0627\u064b \"\u0647\u0630\u0627 \u0623\u0645\u0631 \u0645\u062d\u0633\u0648\u0645\"\u060c \u0645\u0634\u064a\u0631\u0627\u064b \u0625\u0644\u0649 \u062a\u0635\u0631\u064a\u062d\u0627\u062a \u0633\u0627\u0628\u0642\u0629 \u0623\u0643\u062f \u0641\u064a\u0647\u0627 \u0623\u0646 \"\u0627\u0644\u062f\u0633\u062a\u0648\u0631 \u0627\u0644\u0645\u0635\u0631\u064a \u0644\u0646 \u064a\u064f\u0645\u0633\". \u0627\u0644\u0634\u0643\u0631 \u0644\u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0648\u0639\u0644\u0649 \u0631\u0623\u0633\u0647\u0645 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u0648\u0623\u0639\u0631\u0628 \u0627\u0644\u0633\u064a\u0633\u064a \u0639\u0646 \u062e\u0627\u0644\u0635 \u0634\u0643\u0631\u0647 \u0648\u062a\u0642\u062f\u064a\u0631\u0647 \u0644\u0644\u0623\u0634\u0642\u0627\u0621 \u0641\u064a \u0627\u0644\u062e\u0644\u064a\u062c\u060c \u0648\u0639\u0644\u0649 \u0631\u0623\u0633\u0647\u0645 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0644\u0645\u0633\u0627\u0646\u062f\u062a\u0647\u0645 \u0645\u0635\u0631 \u0639\u0642\u0628 \u0623\u062d\u062f\u0627\u062b \u0639\u0627\u0645 2013\u060c \u0645\u0624\u0643\u062f\u0627\u064b \u0623\u0646 \u062f\u0639\u0645\u0647\u0645 \u0648\u062c\u0633\u0648\u0631 \u0633\u0641\u0646 \u0627\u0644\u063a\u0627\u0632 \u0628\u062a\u0631\u0648\u0644 \u062c\u0627\u0621\u062a \u062f\u0648\u0646 \u062d\u0633\u0627\u0628\u060c \u0648\u0644\u0648\u0644\u0627 \u0645\u0648\u0642\u0641\u0647\u0645 \u0644\u062e\u0627\u0636\u062a \u0645\u0635\u0631 \u0645\u0633\u0627\u0631\u0627\u064b \u0645\u062c\u0647\u0648\u0644\u0627\u064b.\u0648\u0648\u062c\u0651\u0647 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0633\u064a\u0633\u064a \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0645\u0635\u0631\u064a\u0629 \u0628\u062a\u0642\u062f\u064a\u0645 \u062a\u062d\u064a\u0629 \u0639\u0633\u0643\u0631\u064a\u0629 \u0644\u0644\u0623\u0634\u0642\u0627\u0621 \u0641\u064a \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0648\u0639\u0644\u0649 \u0631\u0623\u0633\u0647\u0627 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u0648\u0627\u0642\u0641\u0647\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0645\u0639 \u0645\u0635\u0631.\u0648\u0642\u0631\u0623 \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0645\u0635\u0631\u064a \u062e\u0644\u0627\u0644 \u0643\u0644\u0645\u062a\u0647\u060c \u0627\u0644\u0645\u0627\u062f\u0629 200 \u0645\u0646 \u0627\u0644\u062f\u0633\u062a\u0648\u0631 \u0627\u0644\u0645\u0635\u0631\u064a \u0648\u0627\u0644\u062a\u064a \u062a\u0646\u0635 \u0639\u0644\u0649 \u0623\u0646 \"\u0627\u0644\u0