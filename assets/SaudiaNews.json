5\u062d\u0645\u062f \u0623\u0628\u0648 \u0645\u0639\u0637\u064a \u0644\u0644\u0645\u0643\u062a\u0628\u0627\u062a\" \u0644\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0646 2026 \u0628\u0646\u0633\u0628\u0629 9% \u0625\u0644\u0649 12.13 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0640 11.13 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0648\u0637\u0628\u0642\u064b\u0627 \u0644\u0625\u0641\u0635\u0627\u062d \u0627\u0644\u0634\u0631\u0643\u0629 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\"\u060c \u064a\u0639\u0648\u062f \u0627\u0631\u062a\u0641\u0627\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0625\u0644\u0649 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062a\u0645\u0648\u064a\u0644 \u0641\u0649 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0623\u0631\u0628\u0627\u062d \u0623\u0628\u0648 \u0645\u0639\u0637\u064a \u0641\u064a 9 \u0623\u0634\u0647\u0631 \u062a\u0631\u0627\u062c\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0641\u064a 30 \u0633\u0628\u062a\u0645\u0628\u0631 2026 (9 \u0623\u0634\u0647\u0631) \u0628\u0646\u0633\u0628\u0629 1.4% \u0625\u0644\u0649 16.37 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0640 16.6 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0648\u064a\u0631\u062c\u0639 \u0630\u0644\u0643 \u0625\u0644\u0649 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\u060c \u0648\u0628\u0627\u0644\u062a\u0627\u0644\u064a \u0627\u0646\u062e\u0641\u0627\u0636 \u0647\u0627\u0645\u0634 \u0627\u0644\u0631\u0628\u062d \u0627\u0644\u0645\u062a\u0623\u062b\u0631 \u0628\u0645\u0632\u064a\u062c \u0627\u0644\u0627\u064a\u0631\u0627\u062f\u0627\u062a\u060c \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0627\u0644\u0627\u0646\u062e\u0641\u0627\u0636 \u0641\u0649 \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0648\u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644\u062a\u0645\u0648\u064a\u0644.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0631\u064a\u0627\u0644", "12.13", "\u00ab\u0623\u0628\u0648", "\u0645\u0644\u064a\u0648\u0646", "\u0645\u0639\u0637\u064a\u00bb", "\u0625\u0644\u0649", "\u0623\u0631\u0628\u0627\u062d", "\u0627\u0644\u0641\u0635\u0644\u064a\u0629", "9%", "\u0627\u0631\u062a\u0641\u0627\u0639"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["business"], "datatype": "news", "pubDate": "2026-11-05 06:32:00", "pubDateTZ": "UTC", "fetched_at": "2026-11-05 10:50:15", "image_url": "https://www.alyaum.com/uploads/images/2026/11/05/3179010.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://i.newsdata.io/alyaum.png", "sentiment": "positive", "sentiment_stats": {"negat