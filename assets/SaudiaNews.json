%B9-%D8%A7%D9%84%D9%81%D9%88%D8%B1%D9%8A-%D8%B9%D9%86-%D9%85%D8%B4%D8%B1%D9%88%D8%B9-E1-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%8A%D8%B7%D8%A7%D9%86%D9%8A", "title": "7 \u062f\u0648\u0644 \u062a\u062f\u0639\u0648 \u0627\u0644\u0627\u062d\u062a\u0644\u0627\u0644 \u0627\u0655\u0644\u0649 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0641\u0648\u0631\u064a \u0639\u0646 \u0645\u0634\u0631\u0648\u0639 E1 \u0627\u0644\u0627\u0633\u062a\u064a\u0637\u0627\u0646\u064a", "description": "\u062f\u0639\u062a<a href=\"https://www.alyaum.com/articles/6677631/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D8%A8%D8%B1%D9%8A%D8%B7%D8%A7%D9%86%D9%8A%D8%A7-%D8%AD%D9%84-%D8%A7%D9%84%D8%AF%D9%88%D9%84%D8%AA%D9%8A%D9%86-%D8%A7%D9%84%D8%B3%D8%A8%D9%8A%D9%84-%D8%A7%D9%84%D9%88%D8%AD%D9%8A%D8%AF-%D9%84%D8%AA%D8%AD%D9%82%D9%8A%D9%82-%D8%B3%D9%84%D8%A7%D9%85-%D9%88%D8%A3%D9%85%D9%86-%D8%AF%D8%A7%D8%A6%D9%85%D9%8A%D9%86\"> \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629</a> \u0648\u0641\u0631\u0646\u0633\u0627 \u0648\u0627\u0654\u0644\u0645\u0627\u0646\u064a\u0627 \u0648\u0627\u0655\u064a\u0637\u0627\u0644\u064a\u0627 \u0648\u0647\u0648\u0644\u0646\u062f\u0627 \u0648\u0643\u0646\u062f\u0627 \u0648\u0627\u0644\u0646\u0631\u0648\u064a\u062c\u060c <a href=\"https://www.alyaum.com/articles/6675503/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A7%D9%84%D8%A3%D9%85%D9%85-%D8%A7%D9%84%D9%85%D8%AA%D8%AD%D8%AF%D8%A9-%D8%AA%D8%AD%D8%B0%D8%B1-%D9%85%D9%86-%D8%AA%D8%B5%D8%A7%D8%B9%D8%AF-%D8%A7%D9%84%D8%B9%D9%86%D9%81-%D9%88%D8%AA%D9%88%D8%B3%D8%B9-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%8A%D8%B7%D8%A7%D9%86-%D9%81%D9%8A-%D8%A7%D9%84%D8%B6%D9%81%D8%A9-%D8%A7%D9%84%D8%BA%D8%B1%D8%A8%D9%8A%D8%A9\">\u0627\u0644\u0627\u062d\u062a\u0644\u0627\u0644 </a>\u0627\u0644\u0627\u0655\u0633\u0631\u0627\u064a\u0654\u064a\u0644\u064a \u0627\u0655\u0644\u0649 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0641\u0648\u0631\u064a \u0639\u0646 \u0642\u0631\u0627\u0631 \u0637\u0631\u062d \u0645\u0646\u0627\u0642\u0635\u0627\u062a \u0628\u0646\u0627\u0621 \u0645\u0634\u0631\u0648\u0639 (E1) \u0627\u0644\u0627\u0633\u062a\u064a\u0637\u0627\u0646\u064a\u060c \u0648\u0648\u0642\u0641 <a href=\"https://www.alyaum.com/articles/6676401/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D8%A7%D9%84%D8%AA%D8%B9%D8%A7%D9%88%D9%86-%D8%A7%D9%84%D8%A5%D8%B3%D9%84%D8%A7%D9%85%D9%8A-%D8%AA%D8%AF%D9%8A%D9%86-%D8%A7%D9%84%D8%AC%D8%B1%D8%A7%D8%A6%D9%85-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A6%D9%8A%D9%84%D9%8A%D8%A9-%D8%A7%D9%84%D9%85%D8%AA%D8%B5%D8%A7%D8%B9%D8%AF%D8%A9-%D9%81%D9%8A-%D9%81%D9%84%D8%B3%D8%B7%D9%8A%D9%86\">\u0627\u0644\u062a\u0648\u0633\u0639 \u0627\u0644\u0627\u0633\u062a\u064a\u0637\u0627\u0646\u064a</a> \u0641\u064a \u0627\u0644\u0636\u0641\u0629 \u0627\u0644\u063a\u0631\u0628\u064a\u0629\u060c \u0645\u0648\u0654\u0643\u062f\u0629\u064b \u0627\u0654\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u064a\u0642\u0648\u0636 \u0641\u0631\u0635 \u062d\u0644 \u0627\u0644\u062f\u0648\u0644\u062a\u064a\u0646 \u0648\u064a\u0645\u0633 \u0628\u0627\u0644\u062a\u0631\u0627\u0628\u0637 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a \u0644\u0644\u0627\u0654\u0631\u0627\u0636\u064a \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a\u0629.<br /><br />\u0648\u0634\u062f\u0651\u062f\u062a \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0633\u0628\u0639\u060c \u0641\u064a \u0628\u064a\u0627\u0646 \u0645\u0634\u062a\u0631\u0643 \u0627\u0644\u062e\u0645\u064a\u0633\u060c \u0639\u0644\u0649 \u0627\u0654\u0646 \u0627\u0644\u0645\u0633\u062a\u0648\u0637\u0646\u0627\u062a \u0627\u0644\u0627\u0655\u0633\u0631\u0627\u064a\u0654\u064a\u0644\u064a\u0629 \u0641\u064a \u0627\u0644\u0636\u0641\u0629 \u0627\u0644\u063a\u0631\u0628\u064a\u0629 \u063a\u064a\u0631 \u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0628\u0645\u0648\u062c\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0