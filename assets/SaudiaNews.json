u0645\u0641\u0642\u0648\u062f\u064a\u0646\u060c \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u0633\u0644\u0637\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0648\u0627\u0644\u0634\u0631\u0637\u0629 \u0627\u0644\u0623\u0648\u0643\u0631\u0627\u0646\u064a\u0629. \u0648\u062a\u0623\u062a\u064a \u0627\u0644\u0636\u0631\u0628\u0627\u062a \u0641\u064a \u0648\u0642\u062a \u062a\u062a\u0648\u0627\u0635\u0644 \u0641\u064a\u0647 \u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u0629 \u0627\u0644\u0631\u0627\u0645\u064a\u0629 \u0625\u0644\u0649 \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u062d\u0631\u0628 \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0627\u0644\u0623\u0648\u0643\u0631\u0627\u0646\u064a\u0629\u060c \u0625\u0630 \u0623\u0639\u0642\u0628\u0647\u0627 \u0627\u062c\u062a\u0645\u0627\u0639 \u0639\u064f\u0642\u062f \u0641\u064a \u0645\u064a\u0627\u0645\u064a \u0628\u0648\u0644\u0627\u064a\u0629 \u0641\u0644\u0648\u0631\u064a\u062f\u0627 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629\u060c \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0633\u0624\u0648\u0644\u064a\u0646 \u0623\u0648\u0643\u0631\u0627\u0646\u064a\u064a\u0646 \u0648\u0622\u062e\u0631\u064a\u0646 \u0645\u0646 \u062f\u0648\u0644 \u0623\u0648\u0631\u0648\u0628\u064a\u0629\u060c \u0644\u0628\u062d\u062b \u0633\u0628\u0644 \u0627\u0644\u062a\u0648\u0635\u0644 \u0625\u0644\u0649 \u062a\u0633\u0648\u064a\u0629 \u0644\u0644\u0646\u0632\u0627\u0639. \u0627\u0631\u062a\u0641\u0627\u0639 \u062d\u0635\u064a\u0644\u0629 \u0627\u0644\u0636\u062d\u0627\u064a\u0627 \u0648\u0642\u0627\u0644 \u0625\u064a\u0641\u0627\u0646 \u0641\u064a\u062f\u0648\u0631\u0648\u0641\u060c \u0631\u0626\u064a\u0633 \u0645\u062c\u0644\u0633 \u0627\u0644\u062f\u0641\u0627\u0639 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0632\u0627\u0628\u0648\u0631\u064a\u062c\u064a\u0627\u060c \u0625\u0646 \u062d\u0635\u064a\u0644\u0629 \u0642\u062a\u0644\u0649 \u0627\u0644\u063a\u0627\u0631\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0631\u062a\u0641\u0639\u062a \u0625\u0644\u0649 \u062b\u0645\u0627\u0646\u064a\u0629 \u0623\u0634\u062e\u0627\u0635\u060c \u0628\u064a\u0646\u0647\u0645 \u062b\u0644\u0627\u062b\u0629 \u0623\u0637\u0641\u0627\u0644\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0625\u0644\u0649 \u0625\u0635\u0627\u0628\u0629 16 \u0634\u062e\u0635\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\u060c \u0648\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u0642\u062f\u0627\u0646 12 \u0634\u062e\u0635\u064b\u0627. \u0648\u0643\u0627\u0646 \u0631\u0626\u064a\u0633 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629\u060c \u0645\u064a\u062e\u0627\u064a\u0644\u0648 \u0633\u064a\u0645\u064a\u0643\u064a\u0646\u060c \u0642\u062f \u0623\u0639\u0644\u0646 \u0641\u064a \u0648\u0642\u062a \u0633\u0627\u0628\u0642 \u0645\u0642\u062a\u0644 \u0633\u0628\u0639\u0629 \u0623\u0634\u062e\u0627\u0635\u060c \u0628\u064a\u0646\u0647\u0645 \u062b\u0644\u0627\u062b\u0629 \u0623\u0637\u0641\u0627\u0644\u060c \u0641\u064a \u0627\u0644\u0647\u062c\u0648\u0645. \u0648\u0623\u0636\u0627\u0641 \u0633\u064a\u0645\u064a\u0643\u064a\u0646\u060c \u0641\u064a \u0645\u0646\u0634\u0648\u0631 \u0639\u0628\u0631 \u062a\u0637\u0628\u064a\u0642 \u062a\u0644\u063a\u0631\u0627\u0645\u060c \u0623\u0646 \u0641\u0631\u0642 \u0627\u0644\u0625\u0646\u0642\u0627\u0630 \u062a\u0648\u0627\u0635\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0623\u0634\u062e\u0627\u0635 \u064a\u064f\u062d\u062a\u0645\u0644 \u0623\u0646 \u064a\u0643\u0648\u0646\u0648\u0627 \u0639\u0627\u0644\u0642\u064a\u0646 \u062a\u062d\u062a \u0627\u0644\u0623\u0646\u0642\u0627\u0636. \u0645\u0628\u0627\u0646\u064d \u0633\u0643\u0646\u064a\u0629 \u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0648\u0623\u0641\u0627\u062f \u0645\u0631\u0627\u0633\u0644 \u0648\u0643\u0627\u0644\u0629 \u0641\u0631\u0627\u0646\u0633 \u0628\u0631\u0633 \u0628\u0648\u0635\u0648\u0644 \u0641\u0631\u0642 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0625\u0644\u0649 \u0645\u0648\u0642\u0639 \u0627\u0644\u0647\u062c\u0648\u0645\u060c \u0644\u0644\u0639\u0645\u0644 \u0639\u0644\u0649 \u0627\u0646\u062a\u0634\u0627\u0644 \u0623\u0634\u062e\u0627\u0635 \u0639\u0627\u0644\u0642\u064a\u0646 \u062a\u062d\u062a \u0627\u0644\u0623\u0646\u0642\u0627\u0636. \u0645\u0646 \u062c\u0647\u062a\u0647\u0627\u060c \u0642\u0627\u0644\u062a \u0627\u0644\u0634\u0631\u0637\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0627\u0644\u0623\u0648\u0643\u0631\u0627\u0646\u064a\u0629 \u0625\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0627\u0633\u062a\u0647\u062f\u0641\u062a \u0623\u062d\u064a\u0627\u0621 \u0633\u0643\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062e\u0645\u0633 \u0642\u0646\u0627\u0628\u0644 \u062c\u0648\u064a\u0629 \u0645\u0648\u062c\u0651\u0647\u0629\u060c \u0645\u0627 \u0623\u062f\u0649 \u0625\u0644\u0649 \u0625\u0635\u0627\u0628\u0629 \u0645\u0628\u0646\u064a\u064a\u0646 \u0633\u0643\u0646\u064a\u064a\u0646. \u0648\u062a\u0642\u0639 \u0632\u0627\u0628\u0648\u0631\u064a\u062c\u064a\u0627 \u0639\u0644\u0649 \u0628\u064f\u0639\u062f \u0639\u0634\u0631\u0627\u062a \u0627\u0644\u0643\u064a\u0644\u0648\u0645\u062a\u0631\u0627\u062a \u0645\u0646 \u062e\u0637\u0648\u0637 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629\u060c \u0641\u064a\u0645\u0627 \u062a\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0642\u0627\u0637\u0639\u0629\u060c \u0628\u0645\u0627 \u0641\u064a\u0647\u0627 \u0639\u0627\u0635\u0645\u062a\u0647\u0627 \u0627\u0644\u062a\u064a \u062a\u062d\u0645\u0644 \u0627\u0644\u0627\u0633\u0645 \u0646\u0641\u0633\u0647\u060c \u0644\u0647\u062c\u0645\u0627\u062a \u0645\u062a\u0643\u0631\u