064a\u0628\u064b\u0627 \u0639\u0646\u062f \u0645\u0633\u062a\u0648\u0649 10,300 \u0646\u0642\u0637\u0629\u060c \u0628\u062a\u062f\u0627\u0648\u0644\u0627\u062a \u0628\u0644\u063a\u062a \u0642\u064a\u0645\u062a\u0647\u0627 \u0646\u062d\u0648 117 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644. \u0648\u0648\u0641\u0642\u064b\u0627 \u0644\u0640 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\"\u060c \u0628\u0644\u063a\u062a \u0643\u0645\u064a\u0629 \u0627\u0644\u0623\u0633\u0647\u0645 \u0627\u0644\u0645\u062a\u062f\u0627\u0648\u0644\u0629 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0628\u0643\u0631\u0629 \u0646\u062d\u0648 8.7 \u0645\u0644\u064a\u0648\u0646 \u0633\u0647\u0645\u060c \u0648\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0633\u0648\u0642\u064a\u0629 \u0644\u0644\u0645\u0624\u0634\u0631 (\u062a\u0627\u0633\u064a) 9.199 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644. \u0627\u0646\u062e\u0641\u0627\u0636 \u0623\u0633\u0647\u0645 259 \u0634\u0631\u0643\u0629 \u0627\u0631\u062a\u0641\u0639\u062a \u0623\u0633\u0647\u0645 198 \u0634\u0631\u0643\u0629 \u0648\u0627\u0646\u062e\u0641\u0636\u062a \u0623\u0633\u0647\u0645 45 \u0634\u0631\u0643\u0629 \u0641\u064a \u0645\u0633\u062a\u0647\u0644 \u0627\u0644\u062c\u0644\u0633\u0629\u060c \u0641\u064a\u0645\u0627 \u0628\u0644\u063a \u0639\u062f\u062f \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u062f\u0631\u062c\u0629 \u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 273 \u0634\u0631\u0643\u0629. \u0648\u0643\u0627\u0646\u062a \u0623\u0633\u0647\u0645 \u0643\u0644 \u0645\u0646: \u062d\u062f\u064a\u062f \u0648\u0637\u0646\u064a\u060c \u0648\u062c\u0631\u064a\u0631\u060c \u0648\u0633\u0627\u0633\u0643\u0648\u060c \u0648\u062f\u0627\u0631 \u0627\u0644\u0645\u0639\u062f\u0627\u062a\u060c \u0648\u0627\u0644\u0641\u062e\u0627\u0631\u064a\u0629 \u0647\u064a \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0631\u062a\u0641\u0627\u0639\u064b\u0627\u060c \u0628\u064a\u0646\u0645\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0623\u0633\u0647\u0645 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0646\u062e\u0641\u0627\u0636\u064b\u0627 \u0644\u0634\u0631\u0643\u0627\u062a: \u0631\u0624\u0648\u0645\u060c \u0648\u0625\u0645 \u0622\u064a \u0633\u064a\u060c \u0648\u0627\u0644\u0639\u0632\u064a\u0632\u064a\u0629 \u0631\u064a\u062a\u060c \u0648\u0627\u0644\u0645\u0648\u0627\u0633\u0627\u0629\u060c \u0648\u062f\u0631\u0627\u064a\u0629 \u0631\u064a\u062a. \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0645\u0648\u0627\u0632\u064a\u0629 \u0627\u0631\u062a\u0641\u0639 \u0645\u0624\u0634\u0631 \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0645\u0648\u0627\u0632\u064a\u0629 (\u0646\u0645\u0648) \u0645\u0633\u062a\u0647\u0644 \u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621 \u0645\u0633\u062c\u0644\u0627\u064b \u0645\u0633\u062a\u0648\u0649 22,002 \u0646\u0642\u0637\u0629\u060c \u0628\u0642\u064a\u0645\u0629 \u0645\u062a\u062f\u0627\u0648\u0644\u0629 \u0628\u0644\u063a\u062a 100 \u0623\u0644\u0641 \u0631\u064a\u0627\u0644 \u062a\u0642\u0631\u064a\u0628\u064b\u0627. \u0648\u0628\u0644\u063a\u062a \u0643\u0645\u064a\u0629 \u0627\u0644\u0623\u0633\u0647\u0645 \u0646\u062d\u0648 100 \u0623\u0644\u0641 \u0633\u0647\u0645\u060c \u0648\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0633\u0648\u0642\u064a\u0629 34.5 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644. \u0648\u0634\u0647\u062f\u062a \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0631\u062a\u0641\u0627\u0639 \u0623\u0633\u0647\u0645 6 \u0634\u0631\u0643\u0627\u062a \u0645\u0642\u0627\u0628\u0644 \u0627\u0646\u062e\u0641\u0627\u0636 \u0623\u0633\u0647\u0645 \u0634\u0631\u0643\u062a\u064a\u0646 \u0645\u0646 \u0623\u0635\u0644 123 \u0634\u0631\u0643\u0629 \u0645\u062f\u0631\u062c\u0629 \u