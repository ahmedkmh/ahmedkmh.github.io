B1%D8%A8-%D9%82%D9%86%D8%A7%D8%A9-%D8%A8%D9%86%D9%85%D8%A7\">\u0642\u0646\u0627\u0629 \u0628\u0646\u0645\u0627</a> \u0627\u0654\u0645\u0633 \u0627\u0644\u062e\u0645\u064a\u0633 \u0627\u0654\u0646\u0647\u0627 \u0633\u062a\u0641\u0631\u0636 \u062d\u062f\u064b\u0627 \u0627\u0654\u0642\u0635\u0649 \u0639\u0644\u0649 \u0639\u062f\u062f<a href=\"https://www.alyaum.com/articles/6657481/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A8%D8%B3%D8%A8%D8%A8-%D8%AD%D8%B1%D8%A8-%D8%A7%D9%84%D8%B4%D8%B1%D9%82-%D8%A7%D9%84%D8%A3%D9%88%D8%B3%D8%B7-%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%AA%D9%83%D8%A7%D9%84%D9%8A%D9%81-%D8%A7%D9%84%D9%85%D8%B1%D9%88%D8%B1-%D8%B9%D8%A8%D8%B1-%D9%82%D9%86%D8%A7%D8%A9-%D8%A8%D9%86%D9%85%D8%A7\"> \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0639\u0628\u0648\u0631</a> \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0627\u0639\u062a\u0628\u0627\u0631\u064b\u0627 \u0645\u0646 \u0627\u0654\u0648\u0627\u064a\u0654\u0644 \u0633\u0628\u062a\u0645\u0628\u0631\u060c \u0645\u0639 \u062a\u0627\u0654\u0647\u0628\u0647\u0627 \u0644\u0645\u0648\u0633\u0645 \u0627\u0654\u0637\u0648\u0644 \u0645\u0646 \u0627\u0644\u0645\u0639\u062a\u0627\u062f \u0644\u0638\u0627\u0647\u0631\u0629 \u0627\u0644\u0646\u064a\u0646\u064a\u0648 \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629 \u0648\u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u0627\u0654\u0646 \u064a\u0648\u0654\u062f\u064a \u0627\u0655\u0644\u0649 \u0627\u0646\u062e\u0641\u0627\u0636 \u0645\u0646\u0633\u0648\u0628 \u0627\u0644\u0645\u064a\u0627\u0647.<br /><br />\u0648\u0628\u0645\u0648\u062c\u0628 \u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062c\u062f\u064a\u062f\u0629\u060c \u0633\u062a\u062d\u062f\u062f \u0627\u0644\u0642\u0646\u0627\u0629 \u0639\u062f\u062f \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0639\u0628\u0648\u0631 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0627\u0639\u062a\u0628\u0627\u0631\u064b\u0627 \u0645\u0646 \u0627\u0644\u063