7 \u0637\u0646\u0627\u064b \u0645\u0646 \u0645\u062e\u062f\u0631 \u0627\u0644\u0647\u064a\u062f\u0631\u0648 \u0627\u0644\u0645\u0637\u062d\u0648\u0646\u060c \u0641\u0636\u0644\u0627\u064b \u0639\u0646 \u0636\u0628\u0637 335 \u0641\u062f\u0627\u0646\u0627\u064b \u0645\u0646 \u0627\u0644\u0632\u0631\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u062e\u062f\u0631\u0629.\u0636\u0628\u0637 \u0628\u0636\u0627\u0626\u0639 \u0645\u0647\u0631\u0628\u0629 \u0648\u0633\u062c\u0627\u0626\u0631 \u0648\u0647\u0648\u0627\u062a\u0641 \u0645\u062d\u0645\u0648\u0644\u0629\u0648\u0641\u064a \u0625\u0637\u0627\u0631 \u0645\u0643\u0627\u0641\u062d\u0629 \u062a\u0647\u0631\u064a\u0628 \u0627\u0644\u0628\u0636\u0627\u0626\u0639 \u063a\u064a\u0631 \u062e\u0627\u0644\u0635\u0629 \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u062c\u0645\u0631\u0643\u064a\u0629\u060c \u062a\u0645\u0643\u0646\u062a \u0627\u0644\u0642\u0648\u0627\u062a \u0645\u0646 \u0636\u0628\u0637 410 \u0648\u0642\u0627\u0626\u0639\u060c \u0634\u0645\u0644\u062a 1.5 \u0645\u0644\u064a\u0648\u0646 \u0642\u0627\u0631\u0648\u0635\u0629 \u0633\u062c\u0627\u0626\u0631\u060c \u064810 \u0622\u0644\u0627\u0641 \u0639\u0628\u0648\u0629 \u062a\u0628\u063a\u060c \u06481250 \u0647\u0627\u062a\u0641\u0627\u064b \u0645\u062d\u0645\u0648\u0644\u0627\u064b\u060c \u064880 \u0623\u0644\u0641 \u0642\u0637\u0639\u0629 \u0645\u0646 \u0627\u0644\u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0646\u0627\u0631\u064a\u0629\u060c \u064812 \u0623\u0644\u0641 \u0644\u062a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0628\u062a\u0631\u0648\u0644\u064a\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0643\u0645\u064a\u0627\u062a \u0643\u0628\u064a\u0631\u0629 \u0645\u0646 \u0627\u0644\u0628\u0636\u0627\u0626\u0639 \u0627\u0644\u0645\u062a\u0646\u0648\u0639\u0629 \u063a\u064a\u0631 \u062e\u0627\u0644\u0635\u0629 \u0627\u0644\u0631\u0633\u0648\u0645 \u0627\u0644\u062c\u0645\u0631\u0643\u064a\u0629.\u0625\u062d\u0628\u0627\u0637 \u0627\u0644\u062a\u0646\u0642\u064a\u0628 \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a \u0639\u0646 \u0627\u0644\u0630\u0647\u0628\u0648\u0641\u064a \u0645\u062c\u0627\u0644 \u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u062a\u0646\u0642\u064a\u0628 \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a \u0639\u0646 \u062e\u0627\u0645 \u0627\u0644\u0630\u0647\u0628\u060c \u0623\u0633\u0641\u0631\u062a \u062c\u0647\u0648\u062f \u0642\u0648\u0627\u062a \u062d\u0631\u0633 \u0627\u0644\u062d\u062f\u0648\u062f \u0639\u0646 \u0636\u0628\u0637 178 \u0648\u0627\u0642\u0639\u0629\u060c \u062c\u0631\u0649 \u062e\u0644\u0627\u0644\u0647\u0627 \u0636\u0628\u0637 350 \u0637\u0646\u0627\u064b \u0645\u0646 \u0627\u0644\u0623\u062d\u062c\u0627\u0631 \u0627\u0644\u0645\u062e\u0644\u0648\u0637\u0629 \u0628\u062e\u0627\u0645 \u0627\u0644\u0630\u0647\u0628\u060c \u0648450 \u0645\u0627\u0643\u064a\u0646\u0629 \u0644\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621\u060c \u0648350 \u062c\u0647\u0627\u0632 \u0647\u064a\u0644\u062a\u064a\u060c \u064853 \u062c\u0647\u0627\u0632\u0627\u064b \u0644\u0644\u0643\u0634\u0641 \u0639\u0646 \u0627\u0644\u0645\u0639\u0627\u062f\u0646.\u0643\u0645\u0627 \u062a\u0645\u0643\u0646\u062a \u0627\u0644\u0642\u0648\u0627\u062a \u0645\u0646 \u0636\u0628\u0637 805 \u0639\u0631\u0628\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629 \u0627\u0644\u0623\u0646\u0648\u0627\u0639\u060c \u0627\u0633\u062a\u064f\u062e\u062f\u0645\u062a \u0641\u064a \u0623\u0639\u0645\u0627\u0644 \u0627\u0644\u062a\u0647\u0631\u064a\u0628 \u0648\u0627\u0644\u062a\u0646\u0642\u064a\u0628 \u0627\u0644\u0639\u0634\u0648\u0627\u0626\u064a \u0639\u0646 \u062e\u0627\u0645 \u0627\u0644\u0630\u0647\u0628.\u0648\u0641\u064a \u0645\u062c\u0627\u0644 \u0636\u0628\u0637 \u0627\u0644\u0639\u0645\u0644\u0627\u062a\u060c \u0623\u0634\u0627\u0631 \u0627\u0644\u0628\u064a\u0627\u0646 \u0625\u0644\u0649 \u0636\u0628\u0637 \u0645\u0627 \u064a\u0642\u0627\u0631\u0628 1