u0636 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0628\u0645\u0642\u062f\u0627\u0631 51,511,835 \u0631\u064a\u0627\u0644\u060c \u0648\u0627\u0644\u0630\u064a \u0642\u0627\u0628\u0644\u0647 \u062c\u0632\u064a\u0654\u064a\u064b\u0627 \u0641\u0642\u0637 \u0627\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0628\u0645\u0642\u062f\u0627\u0631 19,149,255 \u0631\u064a\u0627\u0644 \u060c \u0645\u0645\u0627 \u0627\u0654\u062f\u0649 \u0627\u0655\u0644\u0649 \u062a\u0633\u062c\u064a\u0644 \u062e\u0633\u0627\u0631\u0629 \u0627\u0655\u062c\u0645\u0627\u0644\u064a\u0629 \u0642\u062f\u0631\u0647\u0627 737,402 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u0631\u0628\u062d \u0627\u0655\u062c\u0645\u0627\u0644\u064a \u0642\u062f\u0631\u0647 31,625,178 \u0631\u064a\u0627\u0644\u060c \u0646\u0638\u0631\u064b\u0627 \u0644\u0627\u0654\u0646 \u062c\u0632\u0621\u064b\u0627 \u0643\u0628\u064a\u0631\u064b\u0627 \u0645\u0646 \u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0630\u0627\u062a \u0637\u0628\u064a\u0639\u0629 \u062b\u0627\u0628\u062a\u0629.<br /><br />\u0643\u0645\u0627 \u064a\u0639\u0648\u062f \u0633\u0628\u0628 \u0627\u0644\u062e\u0633\u0627\u064a\u0654\u0631 \u0627\u0655\u0644\u0649 \u0627\u0644\u0627\u0639\u062a\u0631\u0627\u0641 \u0628\u062a\u0643\u0627\u0644\u064a\u0641 \u0645\u0628\u0627\u0634\u0631\u0629 \u0642\u062f\u0631\u0647\u0627 14,197,783 \u0631\u064a\u0627\u0644 \u0645\u062a\u0643\u0628\u062f\u0629 \u0639\u0644\u0649 \u0627\u0654\u0639\u0645\u0627\u0644 \u063a\u064a\u0631 \u0645\u0639\u062a\u0645\u062f\u0629 \u0636\u0645\u0646 \u0645\u0634\u0631\u0648\u0639 \u0639\u0633\u064a\u0631 \u0627\u0644\u0645\u062a\u0646\u0627\u0632\u0639 \u0639\u0644\u064a\u0647\u060c \u0648\u0627\u0655\u062f\u0631\u0627\u062c\u0647\u0627 \u0636\u0645\u0646 \u0628\u0646\u062f \u0627\u0644\u0645\u0635\u0631\u0648\u06