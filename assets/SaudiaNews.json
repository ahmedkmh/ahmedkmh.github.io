\"https://www.alyaum.com/articles/6676979/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B7%D9%82%D8%B3-%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%B6%D8%A8%D8%A7%D8%A8-%D8%AE%D9%81%D9%8A%D9%81-%D9%88%D8%AA%D8%AF%D9%86%D9%8A-%D9%81%D9%8A-%D8%A7%D9%84%D8%B1%D8%A4%D9%8A%D8%A9-%D8%B9%D9%84%D9%89-5-%D9%85%D8%AD%D8%A7%D9%81%D8%B8%D8%A7%D8%AA\">\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0642\u0633</a> \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629\u060c \u0645\u0646\u0628\u0647\u0627 \u0645\u0646 \u0627\u0654\u062c\u0648\u0627\u0621 \u062d\u0627\u0631\u0629 \u0648\u0627\u0654\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 \u0648\u0631\u064a\u0627\u062d \u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u0627\u0654\u062a\u0631\u0628\u0629 \u0639\u0644\u0649 9 \u0645\u0646\u0627\u0637\u0642.<br /><br />\u062d\u0633\u0628 \u0628\u064a\u0627\u0646 \u0627\u0644\u0627\u0654\u0631\u0635\u0627\u062f\u061b \u0644\u0627 \u062a\u0632\u0627\u0644 \u0627\u0644\u0641\u0631\u0635\u0629 \u0645\u0647\u064a\u0627\u0654\u0629 \u0644\u0647\u0637\u0648\u0644 \u0627\u0654<a href=\"https://www.alyaum.com/articles/6676988/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B7%D9%82%D8%B3-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D8%A3%D9%85%D8%B7%D8%A7%D8%B1-%D8%BA%D8%B2%D9%8A%D8%B1%D8%A9-%D8%A5%D9%84%D9%89-%D9%85%D8%AA%D9%88%D8%B3%D8%B7%D8%A9-%D8%B9%D9%84%D9%89-%D9%85%D9%86%D8%B7%D9%82%D8%A9-%D8%AC%D8%A7%D8%B2%D8%A7%D9%86\">\u0645\u0637\u0627\u0631 \u0631\u0639\u062f\u064a\u0629 </a>\u0645\u062a\u0648\u0633\u0637\u0629 \u0627\u0655\u0644\u0649 \u063a\u0632\u064a\u0631\u0629 \u0645\u0635\u062d\u0648\u0628\u0629 \u0628\u0632\u062e\u0627\u062a \u0645\u0646 \u0627\u0644\u0628\u0631\u062f \u0648\u0631\u064a\u0627\u062d \u