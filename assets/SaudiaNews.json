aum.com/articles/6675809/%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6%D8%A9/%D9%83%D8%B1%D8%A9-%D8%B9%D8%A7%D9%84%D9%85%D9%8A%D8%A9/%D9%85%D9%86%D8%AA%D8%AE%D8%A8-%D9%83%D9%88%D8%AA-%D8%AF%D9%8A%D9%81%D9%88%D8%A7%D8%B1-%D9%8A%D8%B9%D9%84%D9%86-%D8%B1%D8%AD%D9%8A%D9%84-%D9%85%D8%AF%D8%B1%D8%A8%D9%87-%D9%81%D8%A7%D9%8A%D9%8A", "title": "\u0645\u0646\u062a\u062e\u0628 \u0643\u0648\u062a \u062f\u064a\u0641\u0648\u0627\u0631 \u064a\u0639\u0644\u0646 \u0631\u062d\u064a\u0644 \u0645\u062f\u0631\u0628\u0647 \u0641\u0627\u064a\u064a", "description": "\u0627\u062e\u062a\u0627\u0631 \u0627\u062a\u062d\u0627\u062f \u0633\u0627\u062d\u0644 \u0627\u0644\u0639\u0627\u062c \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645\u060c \u0639\u062f\u0645 \u062a\u062c\u062f\u064a\u062f \u0639\u0642\u062f \u0645\u062f\u0631\u0628 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0627\u0654\u0648\u0651\u0644 \u0627\u0655\u064a\u0645\u064a\u0631\u0633 \u0641\u0627\u064a\u064a \u0648\u0641\u0642 \u0645\u0627 \u0627\u0654\u0639\u0644\u0646 \u0627\u0644\u062c\u0645\u0639\u0629.<br /><br />\u0648\u0642\u0627\u0644 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0641\u064a \u0628\u064a\u0627\u0646 \"\u0627\u0646\u062a\u0647\u0649 \u0639\u0642\u062f \u0627\u0655\u064a\u0645\u064a\u0631\u0633 \u0641\u0627\u064a\u064a\u060c \u0645\u062f\u0631\u0628 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0627\u0654\u0648\u0644 \u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u0639\u0627\u062c\u060c \u0641\u064a 31 \u062a\u0645\u0648\u0632/\u064a\u0648\u0644\u064a\u0648 2026\u060c \u0648\u0644\u0646 \u064a\u062a\u0645 \u062a\u062c\u062f\u064a\u062f\u0647\".<br /><br />\u0648\u0627\u0654\u0634\u0627\u062f \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0628\u0645\u0633\u0627\u0647\u0645\u0629 \u0641\u0627\u064a\u064a \u0641\u064a \"\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0648\u0637\u0646\u064a \u0648\u0627\u0644\u0646\u062a\u0627\u064a\u0654\u062c \u0627\u0644\u062a\u064a \u062a\u062d\u0642\u0642\u062a \u062a\u062d\u062a \u0642\u064a\u0627\u062f\u062a\u0647\u060c \u0648\u0627\u0644\u062a\u064a \u0633\u062a\u0628\u0642\u0649 \u062c\u0632\u0621\u0627 \u0645\u0647\u0645\u0627 \u0645\u0646 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u062f\u064a\u062b \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0627\u0644\u0627\u0655\u064a\u0641\u0648\u0627\u0631\u064a\u0629\".<br /><br />\u0648\u0631\u0641\u0636 \u0627\u0644\u0645\u062f\u0631\u0628 \u0627\u0644\u0628\u0627\u0644\u063a 42 \u0639\u0627\u0645\u0627 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0627\u0631 \u0639\u0646\u062f \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0647 \u0645\u0646 \u0642\u0628\u0644 \u0648\u0643\u0627\u0644\u0629 \u0641\u0631\u0627\u0646\u0633 \u0628\u0631\u0633.<br /><br />\u0639\u064f\u064a\u0651\u0646 \u0641\u0627\u064a\u064a \u0645\u062f\u0631\u0628\u0627 \u0644\u0645\u0646\u062a\u062e\u0628 \u0633\u0627\u062d\u0644 \u0627\u0644\u0639\u0627\u062c \u0641\u064a \u0643\u0627\u0646\u0648\u0646 \u0627\u0644\u062b\u0627\u0646\u064a/\u064a\u0646\u0627\u0631 2024\u060c \u0639\u0642\u0628 \u0627\u0655\u0642\u0627\u0644\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u062c\u0627\u0646-\u0644\u0648\u064a \u063a\u0627\u0633\u064a\u0647 \u062e\u0644\u0627\u0644 \u0646\u0647\u0627\u064a\u0654\u064a\u0627\u062a \u0643\u0627\u0654\u0633 \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0627\u0655\u0641\u0631\u064a\u0642\u064a\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0636\u0627\u0641\u062a\u0647\u0627 \u0627\u0644\u0628\u0644\u0627\u062f\u060c \u0648\u0630\u0644\u0643 \u0641\u064a \u0627\u0654\u0639\u0642\u0627\u0628 \u0627\u0644\u0647\u0632\u064a\u0645\u0629 \u0627\u0644\u062b\u0642\u064a\u0644\u0629 \u0644\u0640\"\u0627\u0644\u0627\u0654\u0641\u064a\u0627\u0644\" \u0627\u0654\u0645\u0627\u0645 \u063a\u064a\u0646\u064a\u0627 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u064a\u0654\u064a\u0629 4-0 \u0641\u064a \u062f\u0648\u0631 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a.<br /><br />\u0648\u062c\u0627\u0621 \u062a\u0639\u064a\u064a\u0646\u0647 \u0645\u0648\u0654\u0642\u062a\u0627 \u0642\u0628\u0644 \u0627\u0654\u0646 \u064a\u064f\u062b\u0651\u0628\u062a \u0641\u064a \u0645\u0646\u0635\u0628\u0647 \u0641\u064a 20 \u0634\u0628\u0627\u0637/\u0641\u0628\u0631\u0627\u064a\u0631 2024 \u0628\u0639\u062f \u0627\u0654\u0646 \u0642\u0627\u062f \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0639\u0627\u062c\u064a \u0627\u0655\u0644\u0649 \u0627\u0644\u062a\u062a\u0648\u064a\u062c \u0628\u0627\u0644\u0644\u0642\u0628 \u0627\u0644\u0642\u0627\u0631\u064a \u0627\u0655\u062b\u0631 \u0641\u0648\u0632\u0647 \u0639\u0644\u0649 \u0646\u064a\u062c\u064a\u0631\u064a\u0627 2-1 \u0641\u064a \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0646\u0647\u0627\u064a\u0654\u064a\u0629.<br /><br />\u0648\u0628\u0639\u062f \u0630\u0644\u0643 \u0642\u0627\u062f \"\u0627\u0644\u0627\u0654\u0641\u064a\u0627\u0644\" \u0627\u0655\u0644\u0649 \u0627\u0644\u062a\u0627\u0654\u0647\u0644 \u0644\u0643\u0627\u0654\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 2026\u060c \u062d\u064a\u062b \u0628\u0644\u063a \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0641\u064a \u062a\u0627\u0631\u064a\u062e\u0647 \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u062b\u0627\u0646\u064a \u0645\u0646 \u0627\u0644\u0628\u0637\u0648\u0644\u0629\u060c \u0642\u0628\u0644 \u0627\u0654\u0646 \u064a\u062e\u0631\u062c \u0645\u0646 \u062f\u0648\u0631 \u0627\u0644\u064032 \u0628\u062e\u0633\u0627\u0631\u062a\u0647 \u0627\u0654\u0645\u0627\u0645 \u0627\u0644\u0646\u0631\u0648\u062c 2-1.<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0639\u0627\u062c\u064a \u0627\u0654\u0646\u0647 \u0633\u064a\u0639\u0644\u0646 \u0644\u0