84%D8%AF%D9%88%D8%B1%D9%8A-%D8%A7%D9%84%D9%81%D8%B1%D9%86%D8%B3%D9%8A-%D9%84%D9%84%D8%AF%D8%B1%D8%AC%D8%A9-%D8%A7%D9%84%D8%B3%D8%A7%D8%AF%D8%B3%D8%A9", "title": "\u062a\u0623\u0643\u064a\u062f \u0645\u0634\u0627\u0631\u0643\u0629 \u0628\u0648\u0631\u062f\u0648 \u0641\u064a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0644\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0633\u0627\u062f\u0633\u0629", "description": "\u0633\u064a\u062e\u0648\u0636 \u0628\u0648\u0631\u062f\u0648\u060c \u0628\u0637\u0644 \u0641\u0631\u0646\u0633\u0627 \u0633\u062a \u0645\u0631\u0627\u062a\u060c \u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u062d\u0627\u0644\u064a \u0641\u064a \u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0633\u0627\u062f\u0633\u0629 \u0645\u0646 \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629\u060c \u0628\u0639\u062f \u0645\u0639\u0627\u0642\u0628\u062a\u0647 \u0641\u064a \u0627\u0644\u0635\u064a\u0641 \u0628\u0633\u0628\u0628 \u0645\u062e\u0627\u0644\u0641\u0627\u062a \u0645\u0627\u0644\u064a\u0629. \u0648\u0639\u0648\u0642\u0628 \u0628\u0648\u0631\u062f\u0648 \u0644\u0639\u062f\u0645 \u062a\u0648\u0641\u064a\u0631 \u0646\u062d\u0648 10 \u0645\u0644\u0627\u064a\u064a\u0646 \u064a\u0648\u0631\u0648 (11.6 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u064a\u0631\u0643\u064a) \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u062a\u063a\u0637\u064a\u0629 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 2025-2026\u060c \u0648\u0643\u0630\u0644\u0643 2026-2027\u060c \u0648\u0627\u0644\u0648\u0641\u0627\u0621 \u0628\u0633\u062f\u0627\u062f \u0627\u0644\u062f\u064a\u0648\u0646 \u0627\u0644\u0645\u0633\u062a\u062d\u0642\u0629. \u0648\u0643\u0627\u0646 \u0628\u0648\u0631\u062f\u0648\u060c \u0623\u062d\u062f \u0623\u0628\u0631\u0632 \u0627\u0644\u0623\u0646\u062f\u064a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0648\u0627\u0644\u0646\u0627\u062f\u064a \u0627\u0644\u0630\u064a \u0628\u0632\u063a \u0641\u064a\u0647 \u0646\u062c\u0645 \u0627\u0644\u0645\u062f\u0631\u0628 \u0627\u0644\u062c\u062f\u064a\u062f \u0644\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0632\u064a\u0646 \u0627\u0644\u062f\u064a\u0646 \u0632\u064a\u062f\u0627\u0646\u060c \u0642\u062f \u0628\u064a\u0639 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u0627\u0636\u064a \u0645\u0642\u0627\u0628\u0644 \u064a\u0648\u0631\u0648 \u0648\u0627\u062d\u062f \u0631\u0645\u0632\u064a \u0625\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0627\u0644\u0623\u0645\u064a\u0631\u0643\u064a\u0629 \"\u0628\u0627\u0631\u0643 \u0628\u0646\u0634\" \u0627\u0644\u062a\u064a \u0648\u0627\u0641\u0642\u062a \u0639\u0644\u0649 \u062a\u062d\u0645\u0644 \u0627\u0644\u062f\u064a\u0648\u0646 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629. \u0648\u0628\u0639\u062f \u064a\u0648\u0645\u064a\u0646 \u0645\u0646 \u0645\u062b\u0648\u0644\u0647 \u0623\u0645\u0627\u0645 \u0644\u062c\u0646\u0629 \u0627\u0644\u0631\u0642\u0627\u0628\u0629 \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0631\u0627\u0628\u0637\u0629 \u0646\u0648\u0641\u064a\u0644-\u0623\u0643\u064a\u062a\u0627\u0646 \u0627\u0644\u062a\u064a \u0648\u0627\u0641\u0642\u062a \u0639\u0644\u0649 \u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u062a\u0639\u0627\u0641\u064a \u0648\u0623\u0628\u062f\u062a \"\u0631\u0623\u064a\u0627 \u0625\u064a\u062c\u0627\u0628\u064a\u0627 \u0628\u0634\u0623\u0646 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0645\u0634\u0627\u0631\u0643\u062a\u0647 \u0641\u064a \u062f\u0648\u0631\u064a \u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0627\u0644\u0625\u0642\u0644\u064a\u0645\u064a\"\u060c \u062d\u0635\u0644 \u0627\u0644\u0646\u0627\u062f\u064a \u0628\u0627\u0644\u0625\u062c\u0645\u0627\u0639 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0644\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a \u0623\u0639\u0644\u0649 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0629 \u0627\u0644\u0625\u0642\u0644\u064a\u0645\u064a\u0629. \u0648\u0642\u0627\u0644 \u062f\u0648\u0645\u064a\u0646\u064a\u0643 \u062f\u064a\u0644\u0628\u0648\u0631\u060c \u0627\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u062c\u062f\u064a\u062f \u0627\u0644\u0630\u064a \u0627\u062e\u062a\u0627\u0631\u062a\u0647 \u0645\u062c\u0645\u0648\u0639\u0629 \"\u0628\u0627\u0631\u0643 \u0628\u0646\u0634\"\u060c \u0644\u0648\u0643\u0627\u0644\u0629 \u0641\u0631\u0627\u0646\u0633 \u0628\u0631\u0633: \"\u064a\u0645\u0643\u0646 \u0627\u0644\u0622\u0646 \u0623\u0646 \u062a\u0628\u062f\u0623 \u0639\u0645\u0644\u064a\u0629 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0628\u0646\u0627\u0621\". \u0648\u0645\u0646 \u0627\u0644\u0645\u0642\u0631\u0631 \u0623\u0646 \u064a\u0645\u062b\u0644 \u0627\u0644\u0645\u0644\u0627\u0643 \u0627\u0644\u062c\u062f\u062f \u0623\u0645\u0627\u0645 \u0627\u0644\u0645\u062d\u0643\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0641\u064a 20 \u062a\u0634\u0631\u064a\u0646 \u0627\u0644\u0623\u0648\u0644/\u0627\u0643\u062a\u0648\u0628\u0631 \u0644\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0639\u0644\u0649 \u062e\u0637\u0629 \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u064a \u062a\u0645\u062a\u062f \u0627\u0644\u0622\u0646 \u0639\u0644\u0649 \u0645\u062f\u0649 12 \u0639\u0627\u0645\u0627\u060c \u0645\u0639 \u062e\u0641\u0636 \u0627\u0644\u062f\u064a\u0648\u0646 \u0625\u0644\u0649 \u0627\u0644\u0646\u0635\u0641 \u0645\u0646 26 \u0645\u0644\u064a\u0648\u0646\u0627 \u0625\u0644\u0649 13 \u0645\u0644\u064a\u0648\u0646 \u064a\u0648\u0631\u0648. \u0648\u064a\u0636\u0645 \u0627\u0644\u0641\u0631\u064a\u0642 \u0641\u064a \u0645\u0639\u0638\u0645\u0647 \u0644\u0627\u0639\u0628\u064a\u0646 \u0647\u0648\u0627\u0629\u060c \u0645\u0639 \u0627\u0644\u0633\u0645\u0627\u062d \u0644\u0647 \u0628\u0627\u0644\u062a\u0639\u0627\u0642\u062f \u0645\u0639 \u062e\u0645\u0633\u0629 \u0644\u0627\u0639\u0628\u064a\u0646 \u0628\u0639\u0642\u0648\u062f \u0627\u062d\u062a\u0631\u0627\u0641\u064a\u0629\u060c \u0623\u062d\u062f\u0647\u0645 \u0645\u0647\u0627\u062c\u0645 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0627\u0644\u0633\u0627\u0628\u0642 \u0628\u0627\u062a\u064a\u0633\u062a \u063a\u064a\u0648\u0645. \u0648\u0623\u062e\u0631\u062c \u0627\u0644\u0646\u0627\u062f\u064a \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0628\u0627\u0631\u0632\u0629 \u0641\u064a \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629\u060c \u0645\u0646 \u0628\u064a\u0646\u0647\u0645 \u0644\u0627\u0639\u0628\u0627 \u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u0627\u0644\u0646\u0627\u062f\u064a \u0628\u064a\u0643\u0633\u0646\u062a \u0644\u064a\u0632\u0627\u0631\u0627\u0632\u0648 \u0648\u0643\u0631\u064a\u0633\u062a\u0648\u0641 \u062f\u0648\u063a\u0627\u0631\u064a \u0627\u0644\u0644\u0630\u0627\u0646 \u0644\u0639\u0628\u0627 \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0632\u064a\u062f\u0627\u0646 \u0641\u064a \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0627\u0644\u0645\u062a\u0648\u062c \u0628\u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 1998. \u0648\u0642\u0628\u0644 \u0630\u0644\u0643 \u0628\u0639\u0642\u062f\u060c \u0643\u0627\u0646 \u0622\u0644\u0627\u0646 \u062c\u064a\u0631\u064a\u0633 \u0648\u062c\u0627\u0646 \u062a\u064a\u063a\u0627\u0646\u0627 \u0636\u0645\u0646 \u062e\u0637 \u0648\u0633\u0637 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0627\u0644\u0634\u0647\u064a\u0631 \u0627\u0644\