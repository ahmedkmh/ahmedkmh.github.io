062c\u062f \u0627\u0644\u062d\u0631\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639\u064a \u0644\u0627\u0654\u064a\u0654\u0645\u0629 <a href=\"https://www.alyaum.com/articles/6674800/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%B4%D8%A4%D9%88%D9%86-%D8%A7%D9%84%D8%AF%D9%8A%D9%86%D9%8A%D8%A9-%D8%AA%D8%B9%D9%84%D9%86-%D8%AC%D8%AF%D9%88%D9%84-%D8%A3%D8%A6%D9%85%D8%A9-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D8%A7%D9%84%D8%B4%D8%B1%D9%8A%D9%81%D9%8A%D9%86-%D8%AD%D8%AA%D9%89-18-%D8%B5%D9%81%D8%B1\">\u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646</a>\u060c \u0644\u0644\u0641\u062a\u0631\u0629 \u0645\u0646 \u064a\u0648\u0645 \u0627\u0644\u0627\u0654\u062d\u062f 3 \u0631\u0628\u064a\u0639 \u0627\u0644\u0627\u0654\u0648\u0644 \u0627\u0655\u0644\u0649 \u0627\u0644\u0633\u0628\u062a 9 \u0631\u0628\u064a\u0639 \u0627\u0644\u0627\u0654\u0648\u0644 1448\u0647\u0640\u060c \u0645\u062a\u0636\u0645\u0646\u064b\u0627 \u062a\u0648\u0632\u064a\u0639 \u0627\u0655\u0645\u0627\u0645\u0629 <a href=\"https://www.alyaum.com/articles/6671062/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%B4%D8%A4%D9%88%D9%86-%D8%A7%D9%84%D8%AF%D9%8A%D9%86%D9%8A%D8%A9-%D8%AA%D8%B9%D9%84%D9%86-%D8%AC%D8%AF%D9%88%D9%84-%D8%A3%D8%A6%D9%85%D8%A9-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%84%D9%84%D8%A3%D8%B3%D8%A8%D9%88%D8%B9-%D8%A7%D9%84%D8%AB%D8%A7%D9%84%D8%AB-%D9%85%D9%86-%D9%85%D8%AD%D8%B1%D9%85\">\u0627\u0644\u0635\u0644\u0648\u0627\u062a </a>\u0627\u0644\u062e\u0645\u0633 \u0641\u064a \u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u062d\u0631\u0627\u0645 \u0648\u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a.<br /><br />\u0648\u0628