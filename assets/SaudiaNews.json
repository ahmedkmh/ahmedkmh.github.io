4\u0649 \u0627\u0644\u0633\u0627\u062d\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629. \u0648\u064a\u0645\u062b\u0644 \u0648\u062c\u0648\u062f \u0627\u0644\u062d\u0627\u0631\u0633 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0634\u062d\u064a\u0646 \u0644\u062c\u0627\u0626\u0632\u0629 \u00ab\u064a\u0627\u0634\u064a\u0646\u00bb \u0627\u0645\u062a\u062f\u0627\u062f\u064b\u0627 \u0644\u062d\u0636\u0648\u0631\u0647 \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u0628\u0639\u062f\u0645\u0627 \u0631\u0633\u062e \u0645\u0643\u0627\u0646\u062a\u0647 \u0628\u064a\u0646 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0628\u0627\u0631\u0632\u0629 \u0641\u064a \u0645\u0631\u0643\u0632\u0647\u060c \u0645\u0633\u062a\u0641\u064a\u062f\u064b\u0627 \u0645\u0646 \u062e\u0628\u0631\u062a\u0647 \u0648\u0642\u062f\u0631\u062a\u0647 \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0636\u063a\u0648\u0637 \u0641\u064a \u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062d\u0627\u0633\u0645\u0629. \u0648\u0641\u064a \u0627\u0644\u0623\u0647\u0644\u064a\u060c \u0627\u0646\u0636\u0645 \u0645\u064a\u0646\u062f\u064a \u0625\u0644\u0649 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0634\u062d\u064a\u0646 \u0644\u0644\u062c\u0627\u0626\u0632\u0629 \u0630\u0627\u062a\u0647\u0627\u060c \u0645\u0633\u062a\u0646\u062f\u064b\u0627 \u0625\u0644\u0649 \u0625\u0633\u0647\u0627\u0645\u0627\u062a\u0647 \u0641\u064a \u0645\u0648\u0633\u0645 \u0634\u0647\u062f \u062a\u062a\u0648\u064a\u062c \u0627\u0644\u0641\u0631\u064a\u0642 \u0628\u0644\u0642\u0628 \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0622\u0633\u064a\u0627 \u0644\u0644\u0646\u062e\u0628\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u062d\u0636\u0648\u0631\u0647 \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u0641\u0