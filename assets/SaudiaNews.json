46\u064a\u0648\u0645 \u064a\u062d\u0642\u0642 \u0627\u0646\u062a\u0635\u0627\u0631\u0647 \u0627\u0644\u0627\u0654\u0648\u0644 \u0641\u064a \u0631\u0648\u0634\u0646 \u0628\u062b\u0646\u0627\u064a\u0654\u064a\u0629 \u0641\u064a \u0634\u0628\u0627\u0643 \u0627\u0644\u0641\u064a\u062d\u0627\u0621", "description": "\u062d\u0642\u0642 \u0646\u064a\u0648\u0645 \u0641\u0648\u0632\u0627\u064b \u0645\u0633\u062a\u062d\u0642\u0627\u064b\u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u063a\u0644\u0628 \u0639\u0644\u0649 \u0636\u064a\u0641\u0647 \u0627\u0644\u0641\u064a\u062d\u0627\u0621 2-1\u060c \u0641\u064a \u0627\u0644\u0644\u0642\u0627\u0621 \u0627\u0644\u0630\u064a \u062c\u0645\u0639\u0647\u0645\u0627 \u0627\u0644\u062c\u0645\u0639\u0629\u060c \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0644\u0643 \u062e\u0627\u0644\u062f \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0629 \u0628\u062a\u0628\u0648\u0643\u060c \u0644\u062d\u0633\u0627\u0628 \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u062c\u0648\u0644\u0629 \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0644\u062f\u0648\u0631\u064a \u0631\u0648\u0634\u0646 \u0627\u0644\u0633\u0639\u0648\u062f\u064a .<br />\u0633\u062c\u0644 \u062b\u0646\u0627\u064a\u0654\u064a\u0629 \u0646\u064a\u0648\u0645\u060c \u0627\u0644\u0645\u0627\u0644\u064a \u0627\u0654\u0645\u0627\u062f\u0648 \u0643\u0648\u0646\u064a (26) \u0648\u0627\u0644\u062c\u0632\u0627\u064a\u0654\u0631\u064a \u0633\u0639\u064a\u062f \u0628\u0646 \u0631\u062d\u0645\u0629 (36) \u0641\u064a\u0645\u0627 \u0633\u062c\u0644 \u0647\u062f\u0641 \u0627\u0644\u0641\u064a\u062d\u0627\u0621 \u0627\u0644\u0648\u062d\u064a\u062f\u060c \u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644\u064a \u0647\u0648\u063a\u0648 \u0645\u0648\u0631\u0627 (75) .<br />\u0648\u0643\u0627\u0646 \u0646\u064a\u0648\u0645 \u0647\u0648 \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u0627\u0654\u0641\u0636\u0644 \u062e\u0644\u0627\u0644 \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u0627\u0654\u0648\u0644\u060c \u0627\u0644\u0630\u064a \u0627\u0646\u062f\u0641\u0639 \u062e\u0644\u0627\u0644\u0647 \u0644\u0644\u0647\u062c\u0648\u0645\u060c \u0648\u0643\u0627\u062f \u0627\u0654\u0646 \u064a\u0633\u062c\u0644 \u0647\u062f\u0641\u0627\u064b \u0641\u064a \u0627\u0654\u0648\u0644 \u0639\u0634\u0631 \u062f\u0642\u0627\u064a\u0654\u0642\u060c \u0639\u0646\u062f\u0645\u0627 \u0635\u0648\u0628 \u0639\u0628\u062f\u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0639\u064a\u064a\u0631\u064a \u0643\u0631\u0629 \u0642\u0648\u064a\u0629 \u062a\u0635\u062f\u0649 \u0644\u0647\u0627 \u0627\u0644\u062d\u0627\u0631\u0633 \u0627\u0644\u0628\u0646\u0645\u064a \u0627\u0654\u0648\u0631\u0644\u0627\u0646\u062f\u0648 \u0645\u0648\u0633\u0643\u064a\u0631\u0627 \u0648\u0627\u0654\u0646\u0647\u0649 \u062e\u0637\u0648\u0631\u062a\u0647\u0627 (10) \u0627\u0654\u062a\u0628\u0639\u0647 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0627\u0644\u0643\u0633\u0646\u062f\u0631 \u0644\u0627\u0643\u0627\u0632\u064a\u062a \u0628\u062a\u0635\u0648\u064a\u0628\u0629 \u0642\u0648\u064a\u0629 \u0627\u0654\u0645\u0633\u0643\u0647\u0627 \u0645\u0648\u0633\u0643\u064a\u0631\u0627 \u0628\u0628\u0631\u0627\u0639\u0629 (15) \u0648\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0627\u0654\u0641\u0636\u0644\u064a\u0629 \u062a\u0645\u0643\u0646 \u0627\u0644\u0641\u064a\u062d\u0627\u0621 \u0645\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0627\u0628\u0639 \u0627\u0644\u0645\u0627\u0644\u064a \u0627\u0654\u0645\u0627\u062f\u0648 \u0643\u0648\u0646\u064a \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629 \u0648\u0644\u0639\u0628\u0647\u0627 \u0628\u0631\u0627\u0654\u0633\u0647 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0631\u0645\u0649 (26) \u062b\u0645 \u0639\u0632\u0632 \u062a\u0642\u062f\u0645\u0647 \u0628\u0647\u062f\u0641 \u062b\u0627\u0646 \u0639\u0646\u062f\u0645\u0627 \u062a\u0644\u0642\u0649 \u0627\u0644\u062c\u0632\u0627\u064a\u0654\u0631\u064a \u0633\u0639\u064a\u062f \u0628\u0646 \u0631\u062d\u0645\u0629 \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629 \u062f\u0627\u062e\u0644 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u0632\u0627\u0621\u060c \u0644\u0639\u0628\u0647\u0627 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u064a\u0645\u064a\u0646 \u0645\u0648\u0633\u0643\u064a\u0631\u0627 (36) .<br />\u0648\u0641\u064a \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u062b\u0627\u0646\u064a\u060c \u0644\u0627\u062d\u062a \u0641\u0631\u0635\u0629 \u0645\u062d\u0642\u0642\u0629 \u0644\u0644\u0641\u064a\u062d\u0627\u0621 \u0644\u062a\u0630\u0644\u064a\u0644 \u0627\u0644\u0641\u0627\u0631\u0642\u060c \u0644\u0648\u0644\u0627 \u0627\u0644\u0639\u0627\u0631\u0636\u0629 \u0627\u0644\u062a\u064a \u062a\u0635\u062f\u062a \u0644\u0643\u0631\u0629 \u0646\u0648\u0627\u0641 \u0627\u0644\u062d\u0627\u0631\u062b\u064a (57) \u0648\u0627\u0654\u0643\u0645\u0644 \u0646\u064a\u0648\u0645 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0628\u0639\u0634\u0631\u0629 \u0644\u0627\u0639\u0628\u064a\u0646\u060c \u0628\u0639\u062f\u0645\u0627 \u0627\u0634\u0647\u0631 \u0627\u0644\u062d\u0643\u0645 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062d\u0645\u0631\u0627\u0621 \u0639\u0644\u0627\u0621 \u062d\u062c\u064a (62) \u0648\u0645\u0646 \u0631\u0643\u0644\u0629 \u0631\u0643\u0646\u064a\u0629 \u062a\u0645\u0643\u0646 \u0627\u0644\u0641\u064a\u062d\u0627\u0621 \u0645\u0646 \u062a\u0642\u0644\u064a\u0635 \u0627\u0644\u0641\u0627\u0631\u0642\u060c \u0639\u0646\u062f\u0645\u0627 \u0627\u0631\u062a\u0642\u0649 \u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644\u064a \u0647\u0648\u063a\u0648 \u0645\u0648\u0631\u0627 \u0644\u0644\u0643\u0631\u0629 \u0648\u0644\u0639\u0628\u0647\u0627 \u0628\u0631\u0627\u0654\u0633\u0647 \u0639\u0644\u0649 \u064a\u0645\u064a\u0646 \u0627\u0644\u062d\u0627\u0631\u0633 \u0627\u0644\u0628\u0648\u0644\u0646\u062f\u064a \u0645\u0627\u0631\u0633\u064a\u0646 \u0628\u0648\u0644