A7%D8%AA-%D8%A7%D9%84%D9%88%D9%82%D9%88%D8%AF-%D9%81%D9%8A-%D8%A5%D9%8A%D8%B1%D8%A7%D9%86", "title": "\u0628\u0639\u062f \u0627\u0655\u0639\u0644\u0627\u0646 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a\u0629.. \u0637\u0648\u0627\u0628\u064a\u0631 \u0627\u0654\u0645\u0627\u0645 \u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f \u0641\u064a \u0627\u0655\u064a\u0631\u0627\u0646", "description": "\u064a\u0633\u0648\u062f \u0627\u0644\u0642\u0644\u0642 \u0628\u064a\u0646 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u064a\u0646 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621 \u0627\u0655\u0632\u0627\u0621 \u062a\u062f\u0627\u0639\u064a\u0627\u062a <a href=\"https://www.alyaum.com/articles/6679625/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%B3%D9%86%D8%AD%D9%85%D9%8A-%D9%85%D8%B5%D8%A7%D9%84%D8%AD%D9%86%D8%A7-%D8%A8%D8%AD%D8%B2%D9%85-%D8%A7%D9%84%D8%B5%D9%8A%D9%86-%D8%AA%D8%AD%D8%B0%D8%B1-%D9%85%D9%86-%D8%A7%D9%84%D8%AA%D8%B5%D8%B9%D9%8A%D8%AF-%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%D9%8A-%D8%B6%D8%AF-%D8%A5%D9%8A%D8%B1%D8%A7%D9%86\" target=\"_blank\">\u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629</a> \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u064a \u0627\u0654\u0639\u0644\u0646\u062a\u0647\u0627 \u0648\u0627\u0634\u0646\u0637\u0646 \u0645\u062a\u0639\u0647\u062f\u0629 \"\u062e\u0646\u0642 <a href=\"https://www.alyaum.com/articles/6679625/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%B3%D9%86%D8%AD%D9%85%D9%8A-%D9%85%D8%B5%D8%A7%D9%84%D8%AD%D9%86%D8%A7-%D8%A8%D8%AD%D8%B2%D9%85-%D8%A7%D9%84%D8%B5%D9%8A%D9%86-%D8%AA%D8%AD%D8%B0%D8%B1-%D9%85%D9%86-%D8%A7%D9%84%D8%AA%D8%B5%D8%B9%D9%8A%D8%AF-%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%D9%8A-%D8%B6%D8%AF-%D8%A5%D9%8A%D8%B1%D8%A7%D9%86\" target=\"_blank\">\u0627\u0655\u064a\u0631\u0627\u0646 </a>\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0627\"\u060c \u0641\u064a \u0638\u0644 \u062a\u0632\u0627\u064a\u062f \u0645\u0644\u062d\u0648\u0638 \u0641\u064a \u0637\u0648\u0627\u0628\u064a\u0631 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0654\u0645\u0627\u0645 <a href=\"https://www.alyaum.com/articles/6679324/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B9%D8%A7%D8%AC%D9%84-5747-%D9%85%D8%AD%D8%B7%D8%A9-%D9%88%D9%82%D9%88%D8%AF-%D9%81%D9%8A-%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D8%B4%D8%AA%D8%B1%D8%A7%D8%B7%D8%A7%D8%AA-%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9-%D9%84%D8%B1%D9%81%D8%B9-%D8%A7%D9%84%D8%AC%D9%88%D8%AF%D8%A9-%D9%88%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%D8%A9\" target=\"_blank\">\u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f</a>.<br /><br />\u0648\u062d\u0630\u0651\u0631\u062a \u0627\u0644\u0635\u064a\u0646\u060c \u0648\u0647\u064a \u0634\u0631\u064a\u0643 \u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a \u0644\u0637\u0647\u0631\u0627\u0646\u060c \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621 \u0645\u0646 \u0627\u0654\u0646\u0647\u0627 \u0633\u062a\u0628\u0630\u0644 \u0642\u0635\u0627\u0631\u0649 \u062c\u0647\u062f\u0647\u0627 \"\u0644\u0644\u062f\u0641\u0627\u0639 \u0628\u062d\u0632\u0645\" \u0639\u0646 \u0645\u0635\u0627\u0644\u062d\u0647\u0627 \u0639\u0642\u0628 \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0646 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a \u0627\u0644\u0630\u064a \u062a\u0636\u0645\u0646 \u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0644\u0644\u062f\u0648\u0644 \u0627\u0644\u062a\u064a \u062a\u0648\u0627\u0635\u0644 \u062f\u0639\u0645 \u0637\u0647\u0631\u0627\u0646.<br /><br />\u0648\u0642\u0627\u0644 \u0627\u0644\u0645\u062a\u062d\u062f\u062b \u0628\u0627\u0633\u0645 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0635\u064a\u0646\u064a\u0629 \u0644\u064a\u0646 \u062c\u064a\u0627\u0646 \u0641\u064a \u0645\u0648\u0654\u062a\u0645\u0631 \u0635\u062d\u0627\u0641\u064a \u0627\u0655\u0646 \"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0636\u063a\u0648\u0637 \u0627\u0644\u0642\u0635\u0648\u0649 \u0627\u0644\u062a\u064a \u062a\u064f\u0645\u0627\u0631\u0633 \u0641\u064a \u0627\u0655\u0637\u0627\u0631 \u062d\u0631\u0628 \u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0644\u0627 \u062a\u062d\u0644 \u0627\u0654\u064a \u0645\u0634\u0643\u0644\u0629. \u0628\u0644 \u0627\u0655\u0646\u0647\u0627 \u0644\u0627 \u062a\u0648\u0654\u062f\u064a \u0627\u0655\u0644\u0627 \u0627\u0655\u0644\u0649 \u062a\u0627\u0654\u062c\u064a\u062c \u0627\u0644\u062a\u0648\u062a\u0631\u0627\u062a \u0648\u0627\u0644\u0635\u0631\u0627\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0633\u0628\u0628 \u0628\u0627\u0653\u062b\u0627\u0631 \u0645\u0639\u062f\u064a\u0629 \u0648\u0632\u0639\u0632\u0639\u0629 \u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a \u0648\u0627\u0644\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u060c \u0648\u0627\u0644\u0627\u0655\u0636\u0631\u0627\u0631 \u0628\u0627\u0644\u062d\u0642\u0648\u0642 \u0648\u0627\u0644\u0645\u0635\u0627\u0644\u062d \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u0629 \u0644\u0644\u062f\u0648\u0644 \u0627\u0644\u0627\u0654\u062e\u0631\u0649\".<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641 \"\u0633\u062a\u062a\u062e\u0630 \u0627\u0644\u0635\u064a\u0646 \u0643\u0644 \u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u0644\u062f\u0641\u0627\u0639 \u0628\u062d\u0632\u0645 \u0639\u0646 \u062d\u0642\u0648\u0642\u0647\u0627 \u0648\u0645\u0635\u0627\u0644\u062d\u0647\u0627\".<br /> <h2>\u0648\u0632\u064a\u0631 \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a</h2>\u0648\u0639\u0631\u0636 \u0648\u0632\u064a\u0631 \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a \u0633\u0643\u0648\u062a \u0628\u064a\u0633\u0646\u062a \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u0631\u0632\u0645\u0629 \u062c\u062f\u064a\u062f\u0629 \u0645\u0646 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u062a\u0633\u0645\u0649 \"\u062b\u0627\u0646\u0648\u064a\u0629\"\u060c \u0644\u0627 \u062a\u0637\u0627\u0644 \u0627\u0655\u064a\u0631\u0627\u0646 \u0641\u064a \u0634\u0643\u0644 \u0645\u0628\u0627\u0634\u0631 \u0628\u0644 \u0634\u0631\u0643\u0627\u0621\u0647\u0627 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u064a\u0646\u060c \u0648\u062a\u0634\u0645\u0644 \u0627\u0644\u0630\u0647\u0628 \u0648\u0642\u0637\u0627\u0639 \u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u0648\u0627\u0644\u0627\u0654\u0635\u0648\u0644 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0648\u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0648\u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0628\u062d\u0631\u064a.<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641 \"\u0633\u0646\u062d\u0627\u0633\u0628 \u0627\u0644\u062c\u0645\u064a\u0639\u060c \u0648\u0647\u0630\u0647 \u0647\u064a \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0646\u0642 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a \u0627\u0644\u062a\u064a \u0646\u0633\u062a\u0647\u062f\u0641 \u0628\u0647\u0627 \u0647\u0630\u0627 \u0627\u0644\u0646\u0638\u0627\u0645\".<br /><br />\u0644\u0643\u0646 \u0628\u064a\u0633\u0646\u062a \u0644\u0645 \u064a\u062d\u062f\u062f \u0645\u0648\u0639\u062f \u062f\u062e\u0648\u0644 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u062d\u064a\u0632 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0654\u0648 \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u062a\u064a \u0642\u062f \u062a\u062c\u062f \u0646\u0641\u0633\u0647\u0627 \u0641\u064a \u0645\u0631\u0645\u0649 \u0627\u0644\u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a.<br /> <h2>\u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629</h2>\u0648\u0633\u0637 \u062d\u0627\u0644\u0629 \u0645\u0646 \u0639\u062f\u0645 \u0627\u0644\u064a\u0642\u064a\u0646 \u0628\u0634\u0627\u0654\u0646 \u0645\u0627 \u064a\u062e\u0628\u064a\u0654\u0647 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u060c \u062a\u062c\u0645\u0651\u0639 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0633\u0627\u064a\u0654\u0642\u064a \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u062f\u0631\u0627\u062c\u0627\u062a \u0627\u0644\u0646\u0627\u0631\u064a\u0629 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621 \u0641\u064a \u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0648\u0642\u0648\u062f \u0628\u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629 \u0644\u062a\u0632\u0648\u064a\u062f \u0645\u0631\u0643\u0628\u0627\u062a\u0647\u0645.<br /><br />\u0648\u0627\u0654\u0639\u0644\u0646\u062a \u0627\u0644\u0633\u0644\u0637\u0627\u062a \u0639\u0646 \u062e\u0641\u0636 \u0646\u0627\u062f\u0631 \u0644\u062d\u0635\u0635 \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u0627 \u0645\u0646\u0630 \u0641\u062a\u0631\u0629 \u0637\u0648\u064a\u0644\u0629\u060c \u0645\u0639 \u0641\u0631\u0636 \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0654\u0639\u0644\u0649 \u0639\u0644\u0649 \u0645\u0646 \u064a\u0631\u063a\u0628 \u0641\u064a \u062a\u062c\u0627\u0648\u0632 \u062a\u0644\u0643 \u0627\u0644\u062d\u0635\u0635.<br /><br />\u0648\u0634\u0647\u062f\u062a \u0627\u0655\u064a\u0631\u0627\u0646 \u062d\u0631\u0643\u0629 \u0627\u062d\u062a\u062c\u0627\u062c\u064a\u0629 \u0628\u062f\u0627\u0654\u062a \u0641\u064a \u0627\u0654\u0648\u0627\u062e\u0631 \u062f\u064a\u0633\u0645\u0628\u0631 \u0628\u0633\u0628\u0628 \u0627\u0631\u062a\u0641\u0627\u0639 \u062a\u0643\