D8%A7%D8%AC%D8%B9-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85-%D8%A7%D9%84%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D9%8A%D8%A9-%D9%81%D9%8A-%D8%A8%D8%AF%D8%A7%D9%8A%D8%A9-%D8%A7%D9%84%D8%AA%D8%B9%D8%A7%D9%85%D9%84%D8%A7%D8%AA-%D8%A7%D9%84%D9%8A%D9%88%D9%85\">\u0627\u0644\u0627\u0654\u0633\u0647\u0645 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629</a> \u062a\u062f\u0627\u0648\u0644\u0627\u062a\u0647\u0627 \u0627\u0644\u064a\u0648\u0645 \u0639\u0644\u0649 \u0627\u0646\u062e\u0641\u0627\u0636.<br /><br />\u0648\u0627\u0646\u062e\u0641\u0636 \u0645\u0648\u0654\u0634\u0631 (<a href=\"https://www.alyaum.com/articles/6683154/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A3%D8%B3%D9%88%D8%A7%D9%82-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85/%D8%AE%D8%AA%D8%A7%D9%85-%D8%AA%D8%AF%D8%A7%D9%88%D9%84%D8%A7%D8%AA-%D8%A7%D9%84%D8%AE%D9%85%D9%8A%D8%B3-%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85-%D8%A7%D9%84%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D9%8A%D8%A9-%D9%88%D8%A7%D9%86%D8%AE%D9%81%D8%A7%D8%B6-%D8%A8%D9%88%D8%B1%D8%B5%D8%A9-%D9%85%D9%88%D8%B3%D9%83%D9%88\">\u0633\u062a\u0648\u0643\u0633 600</a>) \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a \u0628\u0646\u0633\u0628\u0629 (1.11%)\u060c \u0644\u064a\u0635\u0644 \u0627\u0655\u0644\u0649 (635.46) \u0646\u0642\u0637\u0629.<h2>\u0646\u062a\u0627\u064a\u0654\u062c \u0627\u0644\u0627\u0654\u0633\u0647\u0645 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629</h2>\u0641\u064a\u0645\u0627 \u062a\u0631\u0627\u062c\u0639 <a href=\"https://www.alyaum.com/articles/6682792/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A3%D8%B3%D9%88%D8%A7%D9%82-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85/%D8%AA%D8%B1%D8%A7%D8%AC%D8%B9-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85-%D8%A7%D9%84%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D9%8A%D8%A9-%D9%88%D8%A8%D9%88%D8%B1%D8%B5%D8%A9-%D9%85%D9%88%D8%B3%D9%83%D9%88-%D9%81%D9%8A-%D8%AE%D8%AA%D8%A7%D9%85-%D8%A7%D9%84%D8%AA%D8%B9%D8%A7%D9%85%D9%84%D8%A7%D8%AA\">\u0645\u0648\u0654\u0634\u0631 (\u062f\u0627\u0643\u0633) \u0627\u0644\u0627\u0654\u0644\u0645\u0627\u0646\u064a</a> \u0628\u0646\u0633\u0628\u0629 (1.63%)\u060c \u0644\u064a\u0635\u0644 \u0627\u0655\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 (25,296.44) \u0646\u0642\u0637\u0629.<br /><br /> <br /><br />\u0648\u062a\u0631\u0627\u062c\u0639 \u0645\u0648\u0654\u0634\u0631 (\u0643\u0627\u0643 40) \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0628\u0646\u0633\u0628\u0629 (1.49%)\u060c \u0644\u064a\u0635\u0644 \u0627\u0655\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 (8,065.02) \u0646\u0642\u0637\u0629.<h2>\u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a</h2>\u0642\u0628\u0644 \u0627\u0654\u064a\u0627\u0645 \u0642\u0627\u0644\u062a \u0631\u064a\u0654\u064a\u0633\u0629 \u0627\u0644\u0645\u0641\u0648\u0636\u064a\u0629 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629 \u0627\u0654\u0648\u0631\u0633\u0648\u0644\u0627 \u0641\u0648\u0646 \u062f\u064a\u0631 \u0644\u0627\u064a\u0646 \u0627\u0655\u0646 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a \u0639\u0644\u064a\u0647 \u0627\u0655\u0639\u0627\u062f\u0629 \u0647\u064a\u0643\u0644\u0629 \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0645\u0648\u062d\u062f\u0629 \u0628\u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0645\u0642\u0628\u0644.<br /><br />\u0648\u0639\u0644\u0651\u0642\u062a \u0642\u0627\u064a\u0654\u0644\u0629: \u0644\u064a\u0643\u0648\u0646 \u0627\u0654\u0642\u0648\u0649 \u0641\u064a \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0648\u062a\u062f\u0627\u0639\u064a\u0627\u062a\u0647\u0627 \u0648\u0645\u0646\u0647\u0627 \u0627\u0644\u062d\u0631\u0628 \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0627\u0654\u0648\u0633\u0637.", "content": "ONLY AVAILABLE IN PAID PLANS"