{"status": "success", "totalResults": 4709, "results": [{"article_id": "b42632468bffbf3648a8491da325c32d", "link": "https://www.alyaum.com/articles/6689739/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A3%D8%B3%D9%88%D8%A7%D9%82-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%A3%D8%B1%D8%A8%D8%A7%D8%AD-%D8%A7%D9%84%D8%AA%D8%B9%D8%A7%D9%88%D9%86%D9%8A%D8%A9-74-%D8%A5%D9%84%D9%89-3017-%D9%85%D9%84%D9%8A%D9%88%D9%86-%D8%B1%D9%8A%D8%A7%D9%84-%D8%A8%D8%A7%D9%84%D8%B1%D8%A8%D8%B9-%D8%A7%D9%84%D8%AB%D8%A7%D9%84%D8%AB", "title": "\u0627\u0631\u062a\u0641\u0627\u0639 \u0623\u0631\u0628\u0627\u062d \u00ab\u0627\u0644\u062a\u0639\u0627\u0648\u0646\u064a\u0629\u00bb 74% \u0625\u0644\u0649 301.7 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0628\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b", "description": "\u0627\u0631\u062a\u0641\u0639 \u0635\u0627\u0641\u064a \u0623\u0631\u0628\u0627\u062d \"\u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u062a\u0639\u0627\u0648\u0646\u064a\u0629 \u0644\u0644\u062a\u0623\u0645\u064a\u0646\" \u0644\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 2026 \u0628\u0646\u0633\u0628\u0629 74% \u0625\u0644\u0649 301.7 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0640 173.2 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 2025. \u0648\u0628\u062d\u0633\u0628 \u0628\u064a\u0627\u0646 \u0644\u0644\u0634\u0631\u0643\u0629 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\"\u060c \u064a\u0639\u0648\u062f \u0627\u0631\u062a\u0641\u0627\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0628\u0646\u0633\u0628\u0629 25.89% \u0644\u064a\u0635\u0644 \u0625\u0644\u0649 233.4 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u0640 185.4 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0645\u062f\u0639\u0648\u0645\u0627\u064b \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u062f\u062e\u0644 \u0627\u0644\u0639\u0645\u0648\u0644\u0627\u062a \u0648\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0643\u0627\u0633\u0628 \u0645\u0646 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0627\u062f\u0644\u0629. \u0623\u0631\u0628\u0627\u062d \"\u0627\u0644\u062a\u0639\u0627\u0648\u0646\u064a\u0629\" \u0641\u064a 9 \u0623\u0634\u0647\u0631 \u0633\u062c\u0644\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0635\u0627\u0641\u064a \u0631\u0628\u062d \u0642\u062f\u0631\u0647 911.5 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0641\u064a 30 \u0633\u0628\u062a\u0645\u0628\u0631 2026 (9 \u0623\u0634\u0647\u0631)\u060c \u0628\u0627\u0631\u062a\u0641\u0627\u0639 1% \u0639\u0646 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0648\u064a\u0639\u0648\u062f \u0630\u0644\u0643 \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0628\u0646\u0633\u0628\u0629 17.24% \u0644\u064a\u0628\u0644\u063a 649.5 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u0640 553.9 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0644\u0643\u060c \u0646\u0645\u062a \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 11.37% \u0644\u062a\u0628\u0644\u063a 13.8 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u0640 12.4 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0628\u0627\u0644\u0631\u0628\u0639", "\u0631\u064a\u0627\u0644", "\u00ab\u0627\u0644\u062a\u0639\u0627\u0648\u0646\u064a\u0629\u00bb", "301.7", "\u0625\u0644\u0649", "\u0623\u0631\u0628\u0627\u062d", "\u0627\u0644\u062b\u0627\u0644\u062b", "74%", "\u0645\u0644\u064a\u0648\u0646", "\u0627\u0631\u062a\u0641\u0627\u0639"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["business"], "datatype": "news", "pubDate": "2026-11-05 06:41:00", "pubDateTZ": "UTC", "fetched_at": "2026-11-05 10:50:15", "image_url": "https://www.alyaum.com/uploads/images/2026/11/05/3179015.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://i.newsdata.io/alyaum.png", "sentiment": "positive", "sentiment_stats": {"negative": 0.85, "neutral": 0.73, "positive": 98.42}, "ai_tag": ["insurance", "financial markets"], "ai_region": "ONLY AVAILABLE I