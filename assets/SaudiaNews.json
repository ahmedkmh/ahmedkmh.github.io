: "https://www.i24news.tv", "source_icon": "https://n.bytvi.com/i24news_tv.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}, {"article_id": "4d7dcd4c913acb4440d7c57f9a591b7c", "link": "https://www.okaz.com.sa/politics/na/2262725", "title": "\u0645\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0627\u0655\u0644\u0649 \u0627\u0644\u0644\u062c\u0648\u0621.. \u062a\u0631\u0645\u0628 \u064a\u0647\u062f\u062f \u0628\u0627\u0655\u0644\u063a\u0627\u0621 \u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a 200 \u0627\u0654\u0644\u0641 \u0627\u0654\u062c\u0646\u0628\u064a", "description": "\u062a\u0633\u062a\u0639\u062f \u0627\u0655\u062f\u0627\u0631\u0629 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0645\u0628 \u0644\u0627\u0655\u0644\u063a\u0627\u0621 \u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0644\u0646\u062d\u0648 200 \u0627\u0654\u0644\u0641 \u0627\u0654\u062c\u0646\u0628\u064a \u0633\u0628\u0642 \u0644\u0647\u0645 \u0627\u0644\u062a\u0642\u062f\u0645 \u0628\u0637\u0644\u0628\u0627\u062a \u0644\u062c\u0648\u0621 \u0641\u064a \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0627\u0654\u0648 \u064a\u0633\u0639\u0648\u0646 \u062d\u0627\u0644\u064a\u0627\u064b \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u064a\u0647. \u0647\u0630\u0647 \u0627\u0644\u062e\u0637\u0648\u0629 \u0642\u062f \u062a\u0635\u0628\u062d \u0627\u0654\u0643\u0628\u0631 \u0639\u0645\u0644\u064a\u0629 \u0627\u0655\u0644\u063a\u0627\u0621 \u062c\u0645\u0627\u0639\u064a \u0644\u0644\u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u0641\u064a \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u0644\u0627\u062f.\u0648\u0628\u062d\u0633\u0628 \u0648\u0643\u0627\u0644\u0629 \u00ab\u0627\u0654\u0633\u0648\u0634\u064a\u062a\u062f \u0628\u0631\u0633\u00bb\u060c \u062a\u062e\u0637\u0637 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0654\u0633\u0627\u0628\u064a\u0639 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0644\u0627\u0655\u0644\u063a\u0627\u0621 \u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u00abB1\u00bb \u0648\u00abB2\u00bb \u0627\u0644\u0635\u0627\u062f\u0631\u0629 \u0628\u064a\u0646 2016 \u06482026 \u0644\u062d\u0627\u0645\u0644\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u062a\u0642\u062f\u0645\u0648\u0627 \u0628\u0637\u0644\u0628\u0627\u062a \u0644\u062c\u0648\u0621 \u0627\u0654\u0648 \u064a\u0633\u0639\u0648\u0646 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u0644\u062c\u0648\u0621\u060c \u0648\u0641\u0642 \u0648\u062b\u0627\u064a\u0654\u0642 \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0648\u0645\u0633\u0648\u0654\u0648\u0644\u064a\u0646 \u0627\u0654\u0645\u0631\u064a\u0643\u064a\u064a\u0646\u060c \u0639\u0644\u0649 \u0627\u0654\u0646 \u064a\u062a\u0645 \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621 \u0628\u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0645\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0627\u0654\u0645\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a.\u0648\u0642\u0627\u0644 \u0627\u0644\u0645\u062a\u062d\u062f\u062b \u0628\u0627\u0633\u0645 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u062a\u0648\u0645\u064a \u0628\u064a\u062c\u0648\u062a \u0627\u0655\u0646 \u0648\u0627\u0634\u0646\u0637\u0646 \u062a\u0646\u0633\u0642 \u0645\u0639 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0627\u0654\u0645\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0644\u062a\u062d\u062f\u064a\u062f \u0648\u0627\u0655\u0644\u063a\u0627\u0621 \u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u0647\u0627\u062c\u0631\u064a\u0646 \u0644\u0627\u0654\u062c\u0627\u0646\u0628 \u062f\u062e\u0644\u0648\u0627 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0643\u0632\u0648\u0627\u0631 \u0644\u0641\u062a\u0631\u0627\u062a \u0642\u0635\u064a\u0631\u0629 \u062b\u0645 \u062a\u0642\u062f\u0645\u0648\u0627 \u0628\u0637\u0644\u0628\u0627\u062a \u0644\u062c\u0648\u0621 \u0644\u0644\u0628\u0642\u0627\u0621 \u0641\u064a \u0627\u0644\u0628\u0644\u0627\u062f \u0628\u0635\u0648\u0631\u0629 \u062f\u0627\u064a\u0654\u0645\u0629.\u0648\u0627\u0645\u062a\u0646\u0639 \u0628\u064a\u062c\u0648\u062a \u0639\u0646 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0646\u0647\u0627\u064a\u0654\u064a \u0644\u0644\u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u0633\u064a\u062a\u0645 \u0627\u0655\u0644\u063a\u0627\u0648\u0654\u0647\u0627\u060c \u0645\u0648\u0636\u062d\u0627\u064b \u0627\u0654\u0646 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0633\u062a\u0643\u0648\u0646 \u0645\u0633\u062a\u0645\u0631\u0629 \u0648\u0627\u0654\u0646 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0627\u0655\u0644\u063a\u0627\u0621 \u0633\u062a\u062a\u0645 \u0628\u0635\u0648\u0631\u0629 \u062f\u0648\u0631\u064a\u0629\u060c \u0645\u0627 \u064a\u0639\u0646\u064a \u0627\u0654\u0646 \u0631\u0642\u0645 200 \u0627\u0654\u0644\u0641 \u0647\u0648 \u062a\u0642\u062f\u064a\u0631 \u0644\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u062d\u062a\u0645\u0644 \u0648\u0644\u064a\u0633 \u062d\u0635\u064a\u0644\u0629 \u0646\u0647\u0627\u064a\u0654\u064a\u0629 \u0645\u0648\u0654\u0643\u062f\u0629.\u062a\u0627\u0654\u062a\u064a \u0627\u0644\u062e\u0637\u0648\u0629 \u0636\u0645\u0646 \u062a\u0634\u062f\u064a\u062f \u0627\u0655\u062f\u0627\u0631\u0629 \u062a\u0631\u0645\u0628 \u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a\u0647\u0627 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0645\u0646\u0630 \u0639\u0648\u062f\u062a\u0647 \u0627\u0655\u0644\u0649 \u0627\u0644\u0628\u064a\u062a \u0627\u0644\u0627\u0654\u0628\u064a\u0636 \u0644\u0648\u0644\u0627\u064a\u0629 \u062b\u0627\u0646\u064a\u0629. \u0648\u0633\u0639\u062a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u062f\u0642\u064a\u0642 \u0641\u064a \u062e\u0644\u0641\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u064a\u0646\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0637\u0644\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0655\u0636\u0627\u0641\u064a\u0629 \u0639\u0646 \u0646\u0634\u0627\u0637\u0647\u0645 \u0639\u0644\u0649 \u0648\u0633\u0627\u064a\u0654\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u060c \u0643\u0645\u0627 \u0641\u064f\u0631\u0636\u062a \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0636\u0645\u0627\u0646\u0627\u062a \u0645\u0627\u0644\u064a\u0629 \u0645\u0631\u062a\u0641\u0639\u0629\u060c \u0648\u0648\u064f\u0633\u0639\u062a \u0627\u0644\u0642\u064a\u0648\u062f \u0639\u0644\u0649 \u062f\u062e\u0648\u0644 \u0645\u0648\u0627\u0637\u0646\u064a \u062f\u0648\u0644 \u0645\u062d\u062f\u062f\u0629.\u0648\u062a\u0634\u064a\u0631 \u0648\u062b\u0627\u064a\u0654\u0642 \u062d\u0635\u0644\u062a \u0639\u0644\u064a\u0647\u0627 \u00ab\u0627\u0654\u0633\u0648\u0634\u064a\u062a\u062f \u0628\u0631\u0633\u00bb \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0645\u0631\u0627\u062c\u0639\u0629 \u062d\u0627\u0645\u0644\u064a \u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u00abB1\u00bb \u0648\u00abB2\u00bb \u0628\u062f\u0627\u0654\u062a \u0628\u0639\u062f\u0645\u0627 \u062a\u0644\u0642\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0646 \u062f\u0627\u064a\u0654\u0631\u0629 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0637\u0646\u0629 \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0628\u0634\u0627\u0654\u0646 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0644\u062c\u0648\u0621 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0645\u0646 \u0628\u0639\u0636 \u062d\u0627\u0645\u0644\u064a \u0647\u0630\u0647 \u0627\u0644\u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a.\u062a\u0633\u062a\u062e\u062f\u0645 \u062a\u0627\u0654\u0634\u064a\u0631\u0629 \u00abB1\u00bb \u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u062e\u0635\u0635 \u00abB2\u00bb \u0644\u0644\u0633\u064a\u0627\u062d\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u064a\u0654\u0644\u064a\u0629 \u0648\u0628\u0639\u0636 \u0627\u0644\u0627\u0654\u063a\u0631\u0627\u0636 \u0627\u0644\u0637\u0628\u064a\u0629.\u0648\u064a\u062b\u064a\u0631 \u062a\u0648\u062c\u0647 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u0629 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f \u062a\u0633\u0627\u0648\u0654\u0644\u0627\u062a \u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0628\u0634\u0627\u0654\u0646 \u0645\u062f\u0649 \u0627\u0655\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0655\u0644\u063a\u0627\u0621 \u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u0633\u0628\u0642 \u0627\u0655\u0635\u062f\u0627\u0631\u0647\u0627 \u0644\u0627\u0654\u0634\u062e\u0627\u0635 \u062a\u0642\u062f\u0645\u0648\u0627 \u0644\u0627\u062d\u0642\u0627\u064b \u0628\u0637\u0644\u0628\u0627\u062a \u0644\u062c\u0648\u0621.\u0648\u064a\u0627\u0654\u062a\u064a \u0627\u0644\u062a\u062d\u0631\u0643 \u0627\u0644\u062c\u062f\u064a\u062f \u0628\u0639\u062f \u062d\u0645\u0644\u0629 \u0648\u0627\u0633\u0639\u0629 \u0644\u0627\u0655\u0644\u063a\u0627\u0621 \u0627\u0644\u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a \u062e\u0644\u0627\u0644 \u0627\u0655\u062f\u0627\u0631\u0629 \u062a\u0631\u0645\u0628\u060c \u0627\u0655\u0630 \u0627\u0654\u0639\u0644\u0646\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0641\u064a \u0627\u0654\u063a\u0633\u0637\u0633 \u0627\u0644\u062d\u0627\u0644\u064a \u0627\u0655\u0644\u063a\u0627\u0621 \u0627\u0654\u0643\u062b\u0631 \u0645\u0646 175 \u0627\u0654\u0644\u0641 \u062a\u0627\u0654\u0634\u064a\u0631\u0629 \u0644\u0627\u0654\u062c\u0627\u0646\u0628\u060c \u0648\u0642\u0627\u0644\u062a \u0627\u0655\u0646 \u0645\u0639\u0638\u0645 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0631\u062a\u0628\u0637\u062a \u0628\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0645\u0639 \u0627\u0654\u062c\u0647\u0632\u0629 \u0627\u0655\u0646\u0641\u0627\u0630 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0648\u062c\u0631\u0627\u064a\u0654\u0645 \u0634\u0645\u0644\u062a \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0621 \u0648\u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u062a\u062d\u062a \u062a\u0627\u0654\u062b\u064a\u0631 \u0627\u0644\u0643\u062d\u0648\u0644 \u0648\u0627\u0644\u0633\u0631\u0642\u0629 \u0648\u0627\u0644\u0645\u062e\u062f\u0631\u0627\u062a\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u062d\u0627\u0644\u0627\u062a \u0627\u062d\u062a\u064a\u0627\u0644 \u0648\u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0644\u0644\u0627\u0654\u0645\u0646 \u0627\u0644\u0642\u0648\u0645\u064a \u0648\u0627\u0646\u062a\u0647\u0627\u0643\u0627\u062a \u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u062a\u0627\u0654\u0634\u064a\u0631\u0627\u062a.\u0643\u0645\u0627 \u0643\u062b\u0641\u062a \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u0629 \u0627\u0655\u062c\u0631\u0627\u0621\u0627\