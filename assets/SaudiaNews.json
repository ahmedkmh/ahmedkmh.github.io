%AE%D8%B3%D8%A7%D8%A6%D8%B1-%D9%81%D8%A7%D8%AF%D8%AD%D8%A9-%D9%88%D9%86%D8%B3%D8%AA%D8%B9%D8%AF-%D9%84%D9%84%D9%85%D8%B9%D8%B1%D9%83%D8%A9-%D8%A7%D9%84%D9%81%D8%A7%D8%B5%D9%84%D8%A9", "title": "\u0637\u0627\u0631\u0642 \u0635\u0627\u0644\u062d: \u0627\u0644\u062d\u0648\u062b\u064a\u0648\u0646 \u064a\u062a\u0643\u0628\u062f\u0648\u0646 \u062e\u0633\u0627\u064a\u0654\u0631 \u0641\u0627\u062f\u062d\u0629 \u0648\u0646\u0633\u062a\u0639\u062f \u0644\u0644\u0645\u0639\u0631\u0643\u0629 \u0627\u0644\u0641\u0627\u0635\u0644\u0629", "description": "<p>\u0642\u0627\u0644 \u0646\u0627\u064a\u0654\u0628 \u0631\u064a\u0654\u064a\u0633 <a href=\"https://www.alyaum.com/articles/6664309/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D9%85%D8%AC%D9%84%D8%B3-%D8%A7%D9%84%D9%82%D9%8A%D8%A7%D8%AF%D8%A9-%D8%A7%D9%84%D9%8A%D9%85%D9%86%D9%8A-%D8%AF%D8%B9%D9%85-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF-%D9%84%D9%84%D9%8A%D9%85%D9%86-%D9%8A%D8%AC%D8%B3%D8%AF-%D9%85%D9%88%D9%82%D9%81-%D9%82%D9%8A%D8%A7%D8%AF%D8%AA%D9%87%D8%A7-%D8%A7%D9%84%D9%85%D8%B4%D8%B1%D9%81\" target=\"_blank\">\u0645\u062c\u0644\u0633 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0631\u064a\u0654\u0627\u0633\u064a \u0627\u0644\u064a\u0645\u0646\u064a</a> <a href=\"https://www.alyaum.com/articles/6439768/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D8%A7%D9%84%D8%B9%D9%85%D9%8A%D8%AF-%D8%B5%D8%A7%D9%84%D8%AD-%D9%8A%D8%AF%D8%B9%D9%88-%D9%84%D8%AA%D9%88%D8%AD%D9%8A%D8%AF-%D8%A7%D9%84%D8%AC%D8%A8%D9%87%D8%A9-%D8%A7%D9%84%D9%8A%D9%85%D9%86%D9%8A%D8%A9-%D8%B6%D8%AF-%D9%85%D8%B4%D8%B1%D9%88%D8%B9-%D8%A5%D9%8A%D8%B1%D8%A7%D9%86\" target=\"_blank\">\u0637\u0627\u0631\u0642 \u0635\u0627\u0644\u062d</a>\u060c \u0627\u0655\u0646 \u062c\u0645\u0627\u0639\u0629 <a href=\"https://www.alyaum.com/articles/6678523/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D9%81%D9%8A-%D9%8A%D9%88%D9%85-%D9%88%D8%A7%D8%AD%D8%AF-%D8%A7%D9%84%D9%82%D9%88%D8%A7%D8%AA-%D8%A7%D9%84%D9%8A%D9%85%D9%86%D9%8A%D8%A9-%D8%AA%D8%B9%D9%84%D9%86-%D8%AA%D9%86%D9%81%D9%8A%D8%B0-133-%D8%B9%D9%85%D9%84%D9%8A%D8%A9-%D8%B6%D8%AF-%D8%A7%D9%84%D8%AD%D9%88%D8%AB%D9%8A%D9%8A%D9%86\" target=\"_blank\">\u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646</a> \u062a\u062a\u0643\u0628\u062f \u062e\u0633\u0627\u064a\u0654\u0631 \u0641\u064a \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u062c\u0628\u0647\u0627\u062a\u060c \u0645\u0648\u0654\u0643\u062f\u064b\u0627 \u0627\u0654\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0644\u064a\u0629 \u0644\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u064a\u0645\u0646\u064a\u0629 \u062a\u0633\u062a\u0639\u062f \u0644\u0645\u0639\u0631\u0643\u0629 \u0648\u0635\u0641\u0647\u0627 \u0628\u0627\u0654\u0646\u0647\u0627 \u0633\u062a\u0643\u0648\u0646 \u0627\u0644\u0641\u0627\u0635\u0644\u0629\u060c \u0645\u0639 \u062f\u062e\u0648\u0644 \u0627\u0654\u0633\u0644\u062d\u0629 \u0648\u0642\u062f\u0631\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0627\u0655\u0644\u0649 \u0627\u0644\u062e\u062f\u0645\u0629 \u0642\u0631\u064a\u0628\u064b\u0627.</p><p>\u0648\u0646\u0642\u0644\u062a \u0642\u0646\u0627\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0639\u0646 \u0635\u0627\u0644\u062d \u0642\u0648\u0644\u0647 \u0627\u0655\u0646 \u0627\u0644\u062a\u0635\u0639\u064a\u062f \u0627\u0644\u062d\u0648\u062b\u064a \u062c\u0627\u0621 \u0628\u062a\u0648\u062c\u064a\u0647\u0627\u062a \u0645\u0646 <a href=\"https://www.alyaum.com/articles/6677514/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D8%A7%D9%84%D8%A8%D8%AD%D8%B1%D9%8A%D9%86-%D8%A7%D9%84%D9%85%D8%A4%D8%A8%D8%AF-%D9%84%D9%85%D8%AA%D9%87%D9%85%D9%8A%D9%86-%D8%AA%D8%AE%D8%A7%D8%A8%D8%B1%D8%A7-%D9%85%D8%B9-%D8%A7%D9%84%D8%AD%D8%B1%D8%B3-%D8%A7%D9%84%D8%AB%D9%88%D8%B1%D9%8A-%D8%A7%D9%84%D8%A5%D9%8A%D8%B1%D8%A7%D9%86%D9%8A-%D9%84%D8%AA%D9%86%D9%81%D9%8A%D8%B0-%D8%A3%D8%B9%D9%85%D8%A7%D9%84-%D8%A5%D8%B1%D9%87%D8%A7%D8%A8%D9%8A%D8%A9\" target=\"_blank\">\u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u062b\u0648\u0631\u064a</a> \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u060c \u0648\u0627\u0654\u0646 \u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0627\u0644\u0633\u0641\u0646 \u0627\u0644\u0645\u062f\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0627\u0654\u062d\u0645\u0631 \u064a\u0647\u062f\u0641 \u0627\u0655\u0644\u0649 \u0641\u0631\u0636 \u062d\u0635\u0627\u0631 \u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u0646\u064a\u064a\u0646\u060c \u0648\u0644\u064a\u0633 \u0627\u0655\u0644\u0649 \u062a\u062d\u0642\u064a\u0642 \u0627\u0654\u0647\u062f\u0627\u0641 \u062a\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0643\u0645\u0627 \u062a\u0642\u0648\u0644 \u0627\u0644\u062c\u0645\u0627\u0639\u0629.</p><h2>\u0627\u0644\u062d\u0648\u062b\u064a\u0648\u0646 \u0644\u064a\u0633\u0648\u0627 \u0642\u0627\u062f\u0631\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629</h2><p>\u0648\u0627\u0654\u0648\u0636\u062d \u0635\u0627\u0644\u062d \u0627\u0655\u0646 \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0644\u064a\u0633\u0648\u0627 \u0642\u0627\u062f\u0631\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629\u060c \u0648\u0627\u0655\u0646 \u0642\u0648\u0627\u062a\u0647 \u062a\u0648\u0627\u0635\u0644 \u062a\u0648\u062c\u064a\u0647 \u0636\u0631\u0628\u0627\u062a \u0627\u0655\u0644\u064a\u0647\u0645 \u0639\u0644\u0649 \u062c\u0628\u0647\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u062f\u062e\u0648\u0644 \u0633\u0644\u0627\u062d \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u0645\u064f\u0633\u064a\u0651\u0631 \u0627\u0655\u0644\u0649 \u0627\u0644\u0645\u0639\u0631\u0643\u0629 \u0627\u0654\u0631\u0628\u0643 \u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0648\u0627\u0655\u064a\u0631\u0627\u0646.<br />\u0648\u0627\u0654\u0636\u0627\u0641 \u0627\u0654\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0637\u0648\u0651\u0631\u062a \u0627\u0654\u0633\u0644\u062d\u0629 \u0648\u0642\u062f\u0631\u0627\u062a \u0648\u062a\u062f\u0631\u064a\u0628\u0627\u062a \u062c\u062f\u064a\u062f\u0629\u060c \u0648\u0627\u0654\u0646\u0647\u0627 \u062a\u0644\u0642\u0646 \u0627\u0644\u062d\u0648\u062b\u064a \u062f\u0631\u0648\u0633\u064b\u0627 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0627\u0644\u0627\u0655\u0645\u0643\u0627\u0646\u0627\u062a\u060c \u0645\u062a\u0648\u0639\u062f\u064b\u0627 \u0628\u0627\u0654\u0646 \u0627\u0654\u0633\u0644\u062d\u0629 \u062c\u062f\u064a\u062f\u0629 \u0633\u062a\u062f\u062e\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0642\u0631\u064a\u0628\u064b\u0627\u060c \u062f\u0648\u0646 \u0627\u0644\u0643\u0634\u0641 \u0639\u0646 \u0637\u0628\u064a\u0639\u062a\u0647\u0627.</p><h2>\u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u063a\u0631\u0628\u064a \u0644\u0644\u064a\u0645\u0646</h2><p>\u0648\u0643\u0634\u0641 \u0646\u0627\u064a\u0654\u0628 \u0631\u064a\u0654\u064a\u0633 \u0645\u062c\u0644\u0633 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0631\u064a\u0654\u0627\u0633\u064a \u0627\u0644\u064a\u0645\u0646\u064a \u0639\u0646 \u0627\u0654\u0646 \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0627\u0633\u062a\u0647\u062f\u0641\u0648\u0627 \u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u063a\u0631\u0628\u064a \u0644\u0644\u064a\u0645\u0646\u060c \u0648\u0641\u0642 \u062d\u0635\u064a\u0644\u0629 \u0627\u0654\u0639\u0644\u0646\u0647\u0627\u060c \u0628\u064056 \u0635\u0627\u0631\u0648\u062e\u064b\u0627 \u0628\u0627\u0644\u064a\u0633\u062a\u064a\u064b\u0627 \u064844 \u0637\u0627\u064a\u0654\u0631\u0629 \u0645\u0633\u064a\u0631\u0629\u060c \u0648\u0627\u0654\u0646 \u0635\u0648\u0627\u0631\u064a\u062e \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u0648\u0637\u0627\u064a\u0654\u0631\u0627\u062a\u0647\u0627 \u0627\u0644\u0645\u0633\u064a\u0631\u0629 \u0637\u0627\u0644\u062a \u0627\u0654\u0639\u064a\u0627\u0646\u064b\u0627 \u0645\u062f\u0646\u064a\u0629 \u0648\u0645\u0648\u0627\u0646\u064a \u0641\u064a \u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u063a\u0631\u0628\u064a.<br /> </p><div data-oembed-url=\"https://x.com/AlArabiya/status/2090137660132102151\"><blockquote align=\"center\" class=\"twitter-tweet\" data-dnt=\"true\"><p dir=\"rtl\" lang=\"ar\">\u0637\u0627\u0631\u0642 \u0635\u0627\u0644\u062d: \u0627\u0654\u0633\u0644\u062d\u0629 \u062c\u062f\u064a\u062f\u0629 \u0648\u0645\u0639\u0631\u0643\u0629 \u0641\u0627\u0635\u0644\u0629 \u0641\u064a \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 <a href=\"https://t.co/qcrXpUNmk7\">https://t.co/qcrXpUNmk7</a></p>\u2014 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 (@AlArabiya) <a href=\"https://x.com/AlArabiya/status/2090137660132102151?ref_src=twsrc%5Etfw\">August 19, 2026</a></blockquote> </div><p>\u0648\u0627\u062a\u0647\u0645 \u0635\u0627\u0644\u062d \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u0643\u0627\u0646 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u062e\u0627\u0636\u0639\u0629 \u0644\u0633\u064a\u0637\u0631\u062a\u0647\u0645 \u0641\u064a \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629\u060c \u0642\u0627\u064a\u0654\u0644\u064b\u0627 \u0627\u0655\u0646 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u062a\u0633\u062a\u062f\u0631\u062c \u0627\u0644\u0645\u0648\u0627\u0637\u0646\u064a\u0646 \u0639\u0628\u0631 \u0627\u0644\u0627\u062f\u0639\u0627\u0621 \u0628\u0627\u0654\u0646\u0647\u0627 \u062a\u0642\u0627\u062a\u0644 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0648\u0627\u0655\u0633\u0631\u0627\u064a\u0654\u064a\u0644\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u0639\u0644\u0645 \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u062d\u0643\u0648\u0645\u064a \u0627\u0654\u0646 \u0643\u062b\u064a\u0631\u064b\u0627 \u0645\u0646 \u0633\u0643\u0627\u0646 \u062a\u0644\u0643 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u064a\u0631\u0641\u0636\u0648\u0646 \u0645\u0627 \u062a\u0631\u062a\u0643\u0628\u0647 \u0627\u0644\u062c\u0645\u0627\u0639\u0629 \u0648\u064a\u0634\u0627\u0631\u0643\u0648\u0646 \u062a\u062d\u062a \u0627\u0644\u0636\u063a\u0637.</p><h2>\u0642\u0637\u0639 \u062e\u0637\u0648\u0637 \u0627\u0644\u0627\u0655\u0645\u062f\u0627\u062f \u0648\u0627\u0644\u062a\u0647\u0631\u064a\u0628</h2><p>\u0648\u0627\u0654\u0643\u062f \u0646\u0627\u064a\u0654\u0628 \u0631\u064a\u0654\u064a\u0633 \u0645\u062c\u0644\u0633 \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0631\u064a\u0654\u0627\u0633\u064a \u0627\u0654\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0644\u064a\u0629 \u0644\u0644\u062d\u0643\u0648\u0645\u0629 \u0642\u0637\u0639\u062a \u062e\u0637\u0648\u0637 \u0627\u0644\u0627\u0655\u0645\u062f\u0627\u062f \u0648\u0627\u0644\u062a\u0647\u0631\u064a\u0628 \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0628\u064a\u0646 \u0627\u0655\u064a\u0631\u0627\u0646 \u0648\u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646\u060c \u0645\u0648\u0654\u0643\u062f\u064b\u0627 \u0627\u0654\u0646 \u0630\u0644\u0643 \u062d\u062f\u0651 \u0645\u0646 \u0642\u062f\u0631\u0629 \u0637\u0647\u0631\u0627\u0646 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062c\u0645\u0627\u0639\u0629 \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0648\u0631\u0642\u0629 \u0644\u0644\u0633\u064a\u0637\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0645\u0631\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629.<br />\u0648\u0627\u0654\u0636\u0