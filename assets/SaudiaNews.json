29 \u0628\u0634\u0627\u0654\u0646 \u0645\u0633\u0627\u0631 \u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0646\u0642\u062f\u064a\u0629.\u0648\u0627\u0631\u062a\u0641\u0639 \u0627\u0644\u0630\u0647\u0628 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 0.4% \u0627\u0655\u0644\u0649 4431.09 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0627\u0654\u0648\u0642\u064a\u0629 (\u0627\u0644\u0627\u0654\u0648\u0646\u0635\u0629)\u060c \u0641\u064a\u0645\u0627 \u0635\u0639\u062f\u062a \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0627\u0644\u0627\u0653\u062c\u0644\u0629 \u0644\u0644\u0630\u0647\u0628 \u062a\u0633\u0644\u064a\u0645 \u062f\u064a\u0633\u0645\u0628\u0631 \u0628\u0646\u0633\u0628\u0629 0.3% \u0627\u0655\u0644\u0649 4487.70 \u062f\u0648\u0644\u0627\u0631\u064b\u0627.\u0648\u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0655\u0644\u0649 \u0627\u0644\u0645\u0639\u0627\u062f\u0646 \u0627\u0644\u0646\u0641\u064a\u0633\u0629 \u0627\u0644\u0627\u0654\u062e\u0631\u0649\u060c \u0627\u0631\u062a\u0641\u0639\u062a \u0627\u0644\u0641\u0636\u0629 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 0.8% \u0627\u0655\u0644\u0649 66.33 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0627\u0654\u0648\u0642\u064a\u0629\u060c \u0648\u0635\u0639\u062f \u0627\u0644\u0628\u0644\u0627\u062a\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 0.5% \u0627\u0655\u0644\u0649 1779.50 \u062f\u0648\u0644\u0627\u0631\u064b\u0627\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0633\u062a\u0642\u0631 \u0627\u0644\u0628\u0644\u0627\u062f\u064a\u0648\u0645 \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0639\u0646\u062f 1332.50 \u062f\u0648\u0644\u0627\u0631\u064b\u0627.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0627\u0642\u062a\u0