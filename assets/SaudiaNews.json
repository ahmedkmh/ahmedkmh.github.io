{"status": "success", "totalResults": 4605, "results": [{"article_id": "f978fff3b02e9a12163dfcb830ad02de", "link": "https://www.alyaum.com/articles/6676493/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A3%D8%B3%D9%88%D8%A7%D9%82-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85/4645-%D9%85%D9%84%D9%8A%D9%88%D9%86-%D8%B1%D9%8A%D8%A7%D9%84-%D8%B5%D8%A7%D9%81%D9%8A-%D8%AE%D8%B3%D8%A7%D8%A6%D8%B1-%D9%85%D8%B1%D8%A7%D9%81%D9%82-%D9%81%D9%8A-%D8%A7%D9%84%D8%B1%D8%A8%D8%B9-%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D9%8A-%D9%85%D9%86-2026", "title": "46.45 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0635\u0627\u0641\u064a \u062e\u0633\u0627\u064a\u0654\u0631 \u00ab\u0645\u0631\u0627\u0641\u0642\u00bb \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0646\u064a \u0645\u0646 2026", "description": "\u0633\u062c\u0644\u062a \u0634\u0631\u0643\u0629 \u0645\u0631\u0627\u0641\u0642 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621 \u0648\u0627\u0644\u0645\u064a\u0627\u0647 \u0628\u0627\u0644\u062c\u0628\u064a\u0644 \u0648\u064a\u0646\u0628\u0639 (\u0645\u0631\u0627\u0641\u0642) \u062e\u0633\u0627\u0631\u0629 \u0635\u0627\u0641\u064a\u0629 \u0628\u0645\u0628\u0644\u063a 46.45 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0628\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0646\u064a \u0645\u0646 2026\u060c \u0645\u0642\u0627\u0628\u0644 \u0635\u0627\u0641\u064a \u0631\u0628\u062d \u0628\u0644\u063a 109.6 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642.<br /><br />\u0648\u0628\u062d\u0633\u0628 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\"\u060c \u064a\u0639\u0648\u062f \u0633\u0628\u0628 \u0627\u0644\u062e\u0633\u0627\u0631\u0629 \u0628\u0634\u0643\u0644 \u0631\u064a\u0654\u064a\u0633\u064a \u0627\u0655\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0627\u0655\u0646\u062a\u0627\u062c \u0628\u0645\u0628\u0644\u063a 40 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u062a\u0643\u0627\u0644\u064a\u0641 \u0646\u0642\u0644 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621 \u0628\u0645\u0628\u0644\u063a 15 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0635\u0627\u0641\u064a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0627\u0644\u0627\u0654\u062e\u0631\u0649 \u0628\u0645\u0628\u0644\u063a 15 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0648\u062a\u0639\u062f\u064a\u0644 \u063a\u064a\u0631 \u0645\u062a\u0643\u0631\u0631 \u062a\u0645 \u0627\u0644\u0627\u0639\u062a\u0631\u0627\u0641 \u0628\u0647 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 \u0628\u0645\u0628\u0644\u063a 62 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u062c\u0631\u0627\u0621 \u062a\u0637\u0628\u064a\u0642 \u062a\u0639\u0631\u064a\u0641\u0629 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0643\u062b\u064a\u0641 \u0644\u0644\u0643\u0647\u0631\u0628\u0627\u0621.<br /><br />\u0648\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 2026\u060c \u062a\u0631\u0627\u062c\u0639 \u0635\u0627\u0641\u064a \u0627\u0654\u0631\u0628\u0627\u062d \"\u0645\u0631\u0627\u0641\u0642\" \u0627\u0655\u0644\u0649 81.11 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0628\u0644 227.54 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642.<br /><br />\u0648\u064a\u0639\u0648\u062f \u0630\u0644\u0643 \u0627\u0655\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0627\u0644\u0627\u0655\u0646\u062a\u0627\u062c\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0635\u0627\u0641\u064a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629\u060c \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u0635\u064a\u0627\u0646\u0629\u060c \u0648\u062a\u0643\u0627\u0644\u064a\u0641 \u0646\u0642\u0644 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0631\u064a\u0627\u0644", "\u0645\u0644\u064a\u0648\u0646", "\u0627\u0644\u0631\u0628\u0639", "\u062e\u0633\u0627\u0626\u0631", "\u00ab\u0645\u0631\u0627\u0641\u0642\u00bb", "\u0645\u0646", "\u0627\u0644\u062b\u0627\u0646\u064a", "2026", "\u0641\u064a", "\u0635\u0627\u0641\u064a", "46.45"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["business"], "datatype": "news", "pubDate": "2026-08-05 06:45:00", "pubDateTZ": "UTC", "fetched_at": "2026-08-05 07:50:16", "image_url": "https://www.alyaum.com/uploads/images/2026/08/05/3072958.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://n.bytvi.com/alyaum.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}, {"article_id": "0c6246217a918fa05df63ad72fb45bd3", "link": "https://www.alyaum.com/articles/6676488/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%AF%D9%88%D9%86-%D8%AE%D8%B3%D8%A7%D8%A6%D8%B1-%D8%B2%D9%84%D8%B2%D8%A7%D9%84-%D8%A8%D9%82%D9%88%D8%A9-63-%D8%AF%D8%B1%D8%AC%D8%A7%D8%AA-%D9%8A%D8%B6%D8%B1%D8%A8-%D8%AC%D9%86%D9%88%D8%A8-%D8%A7%D9%84%D9%81%D9%8A%D9%84%D9%8A%D8%A8%D9%8A%D9%86", "title": "\u062f\u0648\u0646 \u062e\u0633\u0627\u064a\u0654\u0631.. \u0632\u0644\u0632\u0627\u0644 \u0628\u0642\u0648\u0629 6,3 \u062f\u0631\u062c\u0627\u062a \u064a\u0636\u0631\u0628 \u062c\u0646\u0648\u0628 \u0627\u0644\u0641\u064a\u0644\u064a\u0628\u064a\u0646", "description": "\u0648\u0642\u0639 <a href=\"https://www.alyaum.com/articles/6628935/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%B2%D9%84%D8%B2%D8%A7%D9%84-%D9%81%D9%8A-%D9%88%D8%B3%D8%B7-%D8%A8%D9%86%D8%AC%D9%84%D8%A7%D8%AF%D8%B4-%D8%A8%D9%82%D9%88%D8%A9-55-%D8%B1%D9%8A%D8%AE%D8%AA%D8%B1-%D9%8A%D9%88%D9%82%D8%B9-%D8%AE%D9%85%D8%B3%D8%A9-%D9%82%D8%AA%D9%84%D9%89-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%A3%D9%82%D9%84\" target=\"_blank\">\u0632\u0644\u0632\u0627\u0644 </a>\u0628\u0642\u0648\u0629 6,3 \u062f\u0631\u062c\u0627\u062a \u0642\u0628\u0627\u0644\u0629 \u0627\u0644\u0633\u0648\u0627\u062d\u0644 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 \u0644\u0644\u0641\u064a\u0644\u064a\u0628\u064a\u0646 \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621\u060c \u0628\u062d\u0633\u0628 \u0645\u0627 \u0627\u0654\u0639\u0644\u0646\u062a <a href=\"https://www.alyaum.com/articles/6625264/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%AF%D9%88%D9%86-%D8%AE%D8%B3%D8%A7%D8%A6%D8%B1-%D8%B2%D9%84%D8%B2%D8%A7%D9%84-%D8%A8%D9%82%D9%88%D8%A9-63-%D8%AF%D8%B1%D8%AC%D8%A7%D8%AA-%D9%8A%D8%B6%D8%B1%D8%A8-%D8%B4%D9%85%D8%A7%D9%84-%D8%A3%D9%81%D8%BA%D8%A7%D9%86%D8%B3%D8%AA%D8%A7%D9%86\" target=\"_blank\">\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0645\u0633\u062d \u0627\u0644\u062c\u064a\u0648\u0644\u0648\u062c\u064a \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a\u0629</a>.<br /><br />\u0648\u0627\u0654\u0641\u0627\u062f\u062a \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0628\u0627\u0654\u0646 \u0645\u0631\u0643\u0632 \u0627\u0644\u0632\u0644\u0632\u0627\u0644 \u0639\u0644\u0649 \u0628\u0639\u062f 32 \u0643\u064a\u0644\u0648\u0645\u062a\u0631\u064b\u0627 \u0627\u0655\u0644\u0649 \u0627\u0644\u062c\u0646\u0648\u0628 \u0627\u0644\u063a\u0631\u0628\u064a \u0645\u0646 \u062c\u0632\u064a\u0631\u0629 \u0633\u0627\u0631\u0627\u0646\u063a\u0627\u0646\u064a \u0627\u0644\u0642\u0631\u064a\u0628\u0629 \u0645\u0646 \u062c\u0632\u064a\u0631\u0629 \u0645\u064a\u062f\u0646\u062f\u0627\u0646\u0627\u0648\u060c \u0648\u0644\u0645 \u064a\u0635\u062f\u0631 \u0628\u0639\u062f \u0627\u0654\u064a \u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u062e\u0637\u0631 \u062a\u0634\u0643\u0651\u0644 <a href=\"https://www.alyaum.com/articles/6626576/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D9%85%D9%88%D8%AC%D8%A7%D8%AA-%D8%AA%D8%B3%D9%88%D9%86%D8%A7%D9%85%D9%8A-%D8%B5%D8%BA%D9%8A%D8%B1%D8%A9-%D9%81%D9%8A-%D8%A7%D9%84%D9%8A%D8%A7%D8%A8%D8%A7%D9%86-%D8%A8%D8%B9%D8%AF-%D8%B2%D9%84%D8%B2%D8%A7%D9%84-%D8%A8%D9%82%D9%88%D8%A9-67-%D8%AF%D8%B1%D8%AC%D8%A7%D8%AA\" target=\"_blank\">\u0645\u0648\u062c\u0627\u062a \u0645\u062f\u0651 \u0628\u062d\u0631\u064a (\u062a\u0633\u0648\u0646\u0627\u0645\u064a)</a>.<br /><br /><br /> <h2>\u062f\u0648\u0646 \u0627\u0654\u0636\u0631\u0627\u0631</h2><br />\u0644\u0645 \u062a\u0631\u062f \u062a\u0642\u0627\u0631\u064a\u0631 \u0641\u0648\u0631\u064a\u0629 \u0639\u0646 \u062a\u0633\u062c\u064a\u0644 \u0627\u0655\u0635\u0627\u0628\u0627\u062a \u0627\u0654\u0648 \u0627\u0654\u0636\u0631\u0627\u0631 \u062c\u0631\u0627\u0621 \u0627\u0644\u0632\u0644\u0632\u0627\u0644 \u0627\u0644\u0630\u064a \u0648\u0642\u0639 \u0639\u0646\u062f \u0627\u0644\u0633\u0627\u0639\u0629 12,14 (04,14 \u0628\u062a\u0648\u0642\u064a\u062a \u063a\u0631\u064a\u0646\u062a\u0634).<br /><br />\u0648\u0642\u0627\u0644 \u0647\u0627\u0631\u0644\u064a \u0633\u0648\u0631\u0648\u060c \u0627\u0654\u062d\u062f \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0627\u0655\u0646\u0642\u0627\u0630 \u0641\u064a \u062c\u0632\u064a\u0631\u0629 \u0633\u0627\u0631\u0627\u0646\u063a\u0627\u0646\u064a\u060c \u0644\u0648\u0643\u0627\u0644\u0629 \u0641\u0631\u0627\u0646\u0633 \u0628\u0631\u0633\u060c \u0627\u0655\u0646 \u0627\u0644\u0632\u0644\u0632\u0627\u0644 \u0648\u0642\u0639 \u0628\u064a\u0646\u0645\u0627 \u0643\u0627\u0646 \u0639\u062f\u062f \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0646\u0627\u0633 \u0645\u062a\u062c\u0645\u0639\u064a\u0646 \u0644\u062a\u0644\u0642\u064a \u0627\u0655\u0639\u0627\u0646\u0629 \u062d\u0643\u0648\u0645\u064a\u0629.<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641 \"\u0643\u0627\u0646\u062a \u0627\u0644\u0647\u0632\u0629 \u0642\u0648\u064a\u0629 \u062c\u062f\u064b\u0627.. \u0631\u0627\u0654\u064a\u062a \u0627\u0644\u0646\u0627\u0633 \u0641\u064a \u062d\u0627\u0644\u0629 \u0630\u0639\u0631.. \u0643\u0627\u0646\u0648\u0627 \u064a\u0631\u0643\u0636\u0648\u0646 \u0648\u064a\u0635\u0631\u062e\u0648\u0646\".<br /><br />\u0648\u062a\u0627\u0628\u0639 \"\u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u062a\u0642\u064a\u064a\u0645\u0646\u0627 \u0648\u062e\u0628\u0631\u062a\u0646\u0627\u060c \u0644\u0627 \u0646\u062a\u0648\u0642\u0639 \u062a\u0633\u062c\u064a\u0644 \u0627\u0655\u0635\u0627\u0628\u0627\u062a \u0627\u0654\u0648 \u0627\u0654\u0636\u0631\u0627\u0631\".<h2>\u0627\u0654\u0645\u0648\u0627\u062c \u062a\u0633\u0648\u0646\u0627\u0645\u064a</h2><br />\u0630\u0643\u0631 \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0645\u0646 \u0627\u0654\u0645\u0648\u0627\u062c \u062a\u0633\u0648\u0646\u0627\u0645\u064a \u0641\u064a \u0627\u0644\u0645\u062d\u064a\u0637 \u0627\u0644\u0647\u0627\u062f\u064a\u0654 \u0627\u0654\u0646 \u0627\u0644\u0632\u0644\u0632\u0627\u0644 \u0627\u0644\u0630\u064a \u0648\u0642\u0639 \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621 \u0643\u0627\u0646 \u0639\u0644\u0649 \u0639\u0645\u0642 62 \u0643\u064a\u0644\u0648\u0645\u062a\u0631\u064b\u0627.<br /><br />\u0648\u064a\u0627\u0654\u062a\u064a \u0647\u0630\u0627 \u0627\u0644\u0632\u0644\u0632\u0627\u0644 \u0639\u0642\u0628 \u0647\u0632\u0629 \u0627\u0654\u0631\u0636\u064a\u0629 \u0642\u0648\u064a\u0629 \u0636\u0631\u0628\u062a \u062c\u0632\u064a\u0631\u0629 \u0645\u064a\u0646\u062f\u0627\u0646\u0627\u0648 \u0627\u0644\u0645\u062c\u0627\u0648\u0631\u0629 \u0641\u064a 8 \u064a\u0648\u0646\u064a\u0648\u060c \u062a\u0633\u0628\u0628\u062a \u0628\u0645\u0642\u062a\u0644 76 \u0634\u062e\u0635\u064b\u0627 \u0648\u0627\u0654\u062f\u062a \u0627\u0655\u0644\u0649 \u0627\u0646\u0647\u064a\u0627\u0631 \u0645\u0628\u0627\u0646 \u0648\u0627\u0646\u0632\u0644\u0627\u0642\u0627\u062a \u062a\u0631\u0628\u0629.<br /><br />\u0648\u0642\u062f \u062a\u0633\u0628\u0628\u062a \u0647\u0630\u0647 \u0627\u0644\u0647\u0632\u0629 \u0627\u0644\u0646\u0627\u062c\u0645\u0629 \u0639\u0646 \u062a\u062d\u0631\u0643 \u062e\u0646\u062f\u0642 \u0643\u0648\u062a\u0627\u0628\u0627\u062a\u0648\u060c \u0641\u064a \u0627\u0631\u062a\u0641\u0627\u0639 \u0642\u0627\u0639 \u0627\u0644\u0628\u062d\u0631 \u0628\u0645\u0642\u062f\u0627\u0631 \u0645\u062a\u0631\u064a\u0646\u060c \u0645\u0645\u0627 \u0627\u0654\u062f\u0649 \u0627\u0655\u0644\u0649 \u0627\u0646\u0643\u0634\u0627\u0641 \u0627\u0644\u0634\u0639\u0627\u0628 \u0627\u0644\u0645\u0631\u062c\u0627\u0646\u064a\u0629 \u0648\u0627\u0655\u0644\u062d\u0627\u0642 \u0627\u0654\u0636\u0631\u0627\u0631 \u0628\u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0629.", "content": "ONLY AVAILABLE IN PA