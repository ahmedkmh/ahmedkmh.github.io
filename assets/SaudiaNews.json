es/6689259/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A3%D8%B3%D9%88%D8%A7%D9%82-%D8%A7%D9%84%D8%A3%D8%B3%D9%87%D9%85/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%A3%D8%B1%D8%A8%D8%A7%D8%AD-%D8%A7%D9%84%D8%A5%D8%B9%D8%A7%D8%AF%D8%A9-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-59-%D8%A5%D9%84%D9%89-326-%D9%85%D9%84%D9%8A%D9%88%D9%86-%D8%B1%D9%8A%D8%A7%D9%84-%D8%A8%D8%A7%D9%84%D8%B1%D8%A8%D8%B9-%D8%A7%D9%84%D8%AB%D8%A7%D9%84%D8%AB", "title": "\u0627\u0631\u062a\u0641\u0627\u0639 \u0623\u0631\u0628\u0627\u062d \u00ab\u0627\u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u00bb 5.9% \u0625\u0644\u0649 32.6 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0628\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b", "description": "\u0627\u0631\u062a\u0641\u0639 \u0635\u0627\u0641\u064a \u0623\u0631\u0628\u0627\u062d \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 (\u0627\u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629) \u0644\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0646 2026 \u0628\u0646\u0633\u0628\u0629 5.9% \u0625\u0644\u0649 32.6 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u062d\u064a\u062b \u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0635\u0627\u0641\u064a \u0631\u0628\u062d \u0642\u062f\u0631\u0647 30.7 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644. \u0648\u0628\u062d\u0633\u0628 \u0628\u064a\u0627\u0646 \u0644\u0644\u0634\u0631\u0643\u0629 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\"\u060c \u064a\u0639\u0648\u062f \u062a\u062d\u0633\u0646 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0625\u064a\u0631\u0627\u062f\u0627\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 77%.\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0628\u0646\u0633\u0628\u0629 54%\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0635\u0627\u0641\u064a \u0645\u0635\u0627\u0631\u064a\u0641 \u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 19%. \u0623\u0631\u0628\u0627\u062d \u0627\u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0641\u064a 30 \u0633\u0628\u062a\u0645\u0628\u0631 2026 (9 \u0623\u0634\u0647\u0631)\u060c \u0628\u0644\u063a \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d 194.1 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0628\u0644 118.7 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0645\u0627 \u064a\u0645\u062b\u0644 \u0627\u0631\u062a\u0641\u0627\u0639\u064b\u0627 \u0628\u0646\u0633\u0628\u0629 63.4%. \u0648\u064a\u0639\u0648\u062f \u0630\u0644\u0643 \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0625\u064a\u0631\u0627\u062f\u0627\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 73%\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644