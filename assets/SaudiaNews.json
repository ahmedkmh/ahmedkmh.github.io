%84%D8%A7%D9%81-%D8%A7%D9%84%D9%87%D9%83%D8%AA%D8%A7%D8%B1%D8%A7%D8%AA-%D9%81%D9%8A-%D8%B5%D8%B1%D8%A8%D9%8A%D8%A7\">\u062d\u0631\u0627\u064a\u0654\u0642 \u0627\u0644\u063a\u0627\u0628\u0627\u062a</a> \u0641\u064a <a href=\"https://www.alyaum.com/articles/6678233/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%AA%D8%B7%D9%88%D8%B1%D8%A7%D8%AA-%D8%AD%D8%B1%D9%8A%D9%82-%D8%A8%D9%84%D8%AC%D9%8A%D9%83%D8%A7-%D9%85%D8%B1%D9%88%D8%AD%D9%8A%D8%A7%D8%AA-%D9%85%D9%86-%D9%85%D8%AE%D8%AA%D9%84%D9%81-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7-%D8%AA%D9%83%D8%A7%D9%81%D8%AD-%D8%A7%D9%84%D9%86%D9%8A%D8%B1%D8%A7%D9%86\">\u0627\u0654\u0648\u0631\u0648\u0628\u0627</a>.<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u062a\u064a \u0646\u0634\u0631\u062a \u0641\u064a \u062f\u0648\u0631\u064a\u0629 \"\u062c\u0644\u0648\u0628\u0627\u0644 \u062a\u0634\u064a\u0646\u062c \u0628\u064a\u0648\u0644\u0648\u062c\u064a\" \u0627\u0654\u0646 \u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0633\u0646\u0648\u064a\u0629 \u0627\u0644\u0645\u062a\u0636\u0631\u0631\u0629 \u0645\u0646 <a href=\"https://www.alyaum.com/articles/6678621/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%AE%D9%84%D8%A7%D9%84-%D9%8A%D9%88%D9%84%D9%8A%D9%88-%D8%AD%D8%B1%D8%A7%D8%A6%D9%82-%D8%A7%D9%84%D8%BA%D8%A7%D8%A8%D8%A7%D8%AA-%D9%81%D9%8A-%D8%A5%D9%86%D8%AF%D9%88%D9%86%D9%8A%D8%B3%D9%8A%D8%A7-%D8%AA%D8%AF%D9%85%D8%B1-235-%D8%A3%D9%84%D9%81-%D9%81%D8%AF%D8%A7%D9%86\">\u0627\u0644\u062d\u0631\u0627\u064a\u0654\u0642 </a>\u0642\u062f \u062a\u0631\u062a\u0641\u0639 \u0628\u062d\u0644\u0648\u0644 \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062c\u0627\u0631\u064a\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0631\u0627\u0647\u0646 \u0628\u0646\u0633\u0628\u0629 39%\u060c \u0648\u0642\u062f \u062a\u0635\u0644 \u0647\u0630\u0647 \u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0655\u0644\u0649 192%\u060c \u0648\u0641\u0642\u064b\u0627 \u0644\u0645\u062f\u0649 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0631 \u0627\u0644\u0639\u0627\u0644\u0645\u064a.<br /> <h2>\u062d\u0631\u0627\u064a\u0654\u0642 \u0627\u0644\u063a\u0627\u0628\u0627\u062a</h2>\u0648\u0646\u0648\u0647 \u0641\u0631\u064a\u0642 \u0627\u0644\u0628\u062d\u062b \u0628\u0648\u062c\u0648\u062f \u0639\u0648\u0627\u0645\u0644 \u0627\u0654\u062e\u0631\u0649 \u0645\u0647\u0645\u0629 \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u062a\u063a\u064a\u0631 \u0627\u0644\u0645\u0646\u0627\u062e \u0645\u062b\u0644 \u0637\u0631\u064a\u0642\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0627\u0654\u0631\u0627\u0636\u064a \u0648\u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0648\u0627\u0644\u0643\u0634\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0639\u0646 \u0627\u0644\u062d\u0631\u0627\u064a\u0654\u0642.<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d \u0627\u0644\u0628\u0627\u062d\u062b\u0648\u0646 \u0627\u0654\u0646 \u062d\u0631\u0627\u064a\u0654\u0642 \u0627\u0644\u063a\u0637\u0627\u0621 \u0627\u0644\u0646\u0628\u0627\u062a\u064a \u0647\u064a \u0639\u0645\u0644\u064a\u0627\u062a \u0637\u0628\u064a\u0639\u064a\u0629 \u0648\u0645\u0647\u0645\u0629 \u0644\u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u0629 \u0627\u0644\u062a\u0646\u0648\u0639 \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a \u0648\u0627\u0644\u0646\u0638\u0645 \u0627\u0644\u0628\u064a\u064a\u0654\u064a\u0629\u060c \u0644\u0643\u0646\u0647\u0645 \u0646\u0628\u0647\u0648\u0627 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0646\u0634\u0627\u0637 \u0647\u0630\u0647 \u0627\u0644\u062d\u0631\u0627\u064a\u0654\u0642 \u064a\u0634\u0647\u062f \u062d\u0627\u0644\u064a\u064b\u0627 \u062a\u0632\u0627\u064a\u062f\u064b\u0627\u060c \u0644\u0627\u0641\u062a\u064a\u0646 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \"\u062a\u063a\u064a\u0631 \u0627\u0644\u0645\u06