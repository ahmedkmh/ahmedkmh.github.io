D8%A7%D8%AB%D9%8A%D8%A9-%D9%85%D8%B9-%D8%A7%D9%84%D8%B1%D8%A6%D9%8A%D8%B3-%D8%A7%D9%84%D8%B5%D9%8A%D9%86%D9%8A\"> \u0641\u0644\u0627\u062f\u064a\u0645\u064a\u0631 \u0628\u0648\u062a\u064a\u0646</a> \u0627\u0644\u062c\u0645\u0639\u0629 \u0645\u0646 \u0627\u0654\u0646 \u0646\u0634\u0631 \u0642\u0648\u0627\u062a \u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629 \u0641\u064a \u0627\u0654\u0648\u0643\u0631\u0627\u0646\u064a\u0627 \"\u064a\u0639\u0646\u064a \u062d\u0631\u0628\u0627 \u0636\u062f <a href=\"https://www.alyaum.com/articles/6681812/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%AE%D9%84%D8%A7%D9%84-%D8%A7%D9%84%D9%84%D9%8A%D9%84-%D8%B1%D9%88%D8%B3%D9%8A%D8%A7-%D8%AA%D8%B3%D9%82%D8%B7-596-%D9%85%D8%B3%D9%8A%D8%B1%D8%A9-%D8%A3%D9%88%D9%83%D8%B1%D8%A7%D9%86%D9%8A%D8%A9\">\u0631\u0648\u0633\u064a\u0627</a>\"\u060c \u0645\u0639\u062a\u0628\u0631\u0627 \u0627\u0654\u0646 \u0645\u0648\u0633\u0643\u0648 \"\u0644\u0627 \u062a\u0634\u0643\u0651\u0644 \u062a\u0647\u062f\u064a\u062f\u0627\" \u0644\u0644\u062f\u0648\u0644 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629.<br /><br />\u0648\u0646\u0642\u0644\u062a \u0648\u0643\u0627\u0644\u0627\u062a \u0627\u0644\u0627\u0654\u0646\u0628\u0627\u0621 \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0639\u0646 <a href=\"https://www.alyaum.com/articles/6681726/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A7%D9%84%D9%83%D8%B1%D9%85%D9%84%D9%8A%D9%86-%D8%A8%D9%88%D8%AA%D9%8A%D9%86-%D8%A3%D8%A8%D9%84%D8%BA-%D8%AA%D8%B1%D8%A7%D9%85%D8%A8-%D8%A8%D8%B9%D8%AF%D9%85-%D9%88%D8%AC%D9%88%D8%AF-%D8%AE%D8%B7%D8%B7-%D8%B9%D8%AF%D8%A7%D8%A6%D9%8A%D8%A9-%D8%AD%D9%8A%D8%A7%D9%84-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7\">\u0628\u0648\u062a\u064a\u0646 </a>\u0642\u0648\u0644\u0647 \u0645\u0646 \u0646\u064a\u0648\u062f\u0644\u0647\u064a \u062d\u064a\u062b \u062a\u064f\u0639\u0642\u062f \u0642\u0645\u0629 \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0628\u0631\u064a\u0643\u0633 \"\u064a\u0642\u0648\u0644\u0648\u0646 (\u0627\u0644\u0642\u0627\u062f\u0629 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0648\u0646) \u062d\u0627\u0644\u064a\u0627 \u0627\u0655\u0646\u0647\u0645 \u064a\u0628\u062d\u062b\u0648\u0646 \u0641\u064a \u0633\u0628\u0644 \u0627\u0655\u0631\u0633\u0627\u0644 \u0642\u0648\u0627\u062a \u0627\u0655\u0644\u0649 \u0627\u0644\u0627\u0654\u0631\u0627\u0636\u064a \u0627\u0644\u0627\u0654\u0648\u0643\u0631\u0627\u0646\u064a\u0629. \u0648\u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u062d\u0631\u0628\u0627 \u0636\u062f \u0631\u0648\u0633\u064a\u0627\".<h2>\u0635\u0631\u0627\u0639 \u0645\u0639 \u0627\u0654\u0648\u0631\u0648\u0628\u0627</h2>\u0648\u0627\u0654\u0636\u0627\u0641: \"\u0646\u062d\u0646 \u0644\u0627 \u0646\u0647\u062f\u062f \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629\u060c \u0648\u0644\u0627 \u0646\u0639\u062a\u0632\u0645 \u062a\u0647\u062f\u064a\u062f\u0647\u0627. \u0644\u0645\u0627\u0630\u0627 \u0646\u0641\u0639\u0644 \u0630\u0644\u0643 \u0627\u0654\u0635\u0644\u0627\u061f \u0644\u0627 \u0627\u0654\u062d\u062f \u064a\u062f\u0631\u0643 \u062d\u062a\u0649 \u0627\u0654\u0644\u0627 \u0633\u0628\u0628 \u0644\u062f\u064a\u0646\u0627 \u0644\u0644\u062f\u062e\u0648\u0644 \u0641\u064a \u0635\u0631\u0627\u0639 \u0645\u0639 \u0627\u0654\u0648\u0631\u0648\u0628\u0627\".<br /> <br />\u0648\u0631\u0627\u0654\u0649 \u0628\u0648\u062a\u064a\u0646 \u0627\u0654\u0646 \u0627\u0644\u0642\u0627\u062f\u0629 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u064a\u0646 \"\u064a\u064f\u062e\u064a\u0641\u0648\u0646 \u0634\u0639\u0648\u0628\u0647\u0645 \u0628\u062a\u0647\u062f\u064a\u062f \u0648\u0647\u0645\u064a \u0645\u0646 \u0631\u0648\u0633\u064a\u0627\"\u060c \u0645\u0636\u064a\u0641\u0627 \u0627\u0654\u0646 \"\u0647\u0630\u0627 \u0627\u0644\u062a\u0647\u062f\u064a\u062f \u063a\u064a\u0631 \u0645\u0648\u062c\u0648\u062f \u0648\u0644\u0645 \u064a\u0643\u0646 \u0645\u0648\u062c\u0648\u062f\u0627 \u064a\u0648\u0645\u0627\".<h2>\u062a\u0648\u0633\u0639 \u062d\u0644\u0641 \u0634\u0645\u0627\u0644 \u0627\u0644\u0627\u0654\u0637\u0644\u0633\u064a</h2>\u0644\u0637\u0627\u0644\u0645\u0627 \u0627\u0639\u062a\u0628\u0631\u062a \u0631\u0648\u0633\u064a\u0627 \u0627\u0644\u062a\u064a \u062a\u0634\u0646 \u062d\u0631\u0628\u0627 \u0639\u0644\u0649 \u0627\u0654\u0648\u0643\u0631\u0627\u0646\u064a\u0627 \u0645\u0646\u0630 \u0641\u0628\u0631\u0627\u064a\u0631 2022\u060c \u0627\u0654\u0646\u0651 \u0646\u0634\u0631 \u0642\u0648\u0627\u062a \u063a\u0631\u0628\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0627\u0654\u0631\u0627\u0636\u064a \u0627\u0644\u0627\u0654\u0648\u0643\u0631\u0627\u0646\u064a\u0629 \u062e\u0637 \u0627\u0654\u062d\u0645\u0631 \u064a\u0646\u0628\u063a\u064a \u0639\u062f\u0645 \u062a\u062c\u0627\u0648\u0632\u0647.<br /><br />\u0648\u0643\u0627\u0646\u062a \u0647\u0630\u0647 \u0627\u0644\u0641\u0643\u0631\u0629 \u0645\u0648\u0636\u0639 \u0646\u0642\u0627\u0634 \u0628\u064a\u0646 \u0627\u0644\u0642\u0627\u062f\u0629 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u064a\u0646 \u0644\u0633\u0646\u0648\u0627\u062a\u060c \u0645\u0646 \u062f\u0648\u0646 \u0627\u0654\u0646 \u064a\u062a\u0645 \u062a\u0646\u0641\u064a\u0630\u0647\u0627.<br /><br />\u0648\u062a\u0633\u062a\u0646\u062f \u0631\u0648\u0633\u064a\u0627 \u0641\u064a \u062a\u0628\u0631\u064a\u0631 \u062d\u0631\u0628\u0647\u0627 \u0639\u0644\u0649 \u0627\u0654\u0648\u0643\u0631\u0627\u0646\u064a\u0627 \u0627\u0655\u0644\u0649 \u0645\u0627 \u062a\u0639\u062a\u0628\u0631\u0647 \u062a\u0647\u062f\u064a\u062f\u0627 \u0646\u0627\u062c\u0645\u0627 \u0639\u0646 \u062a\u0648\u0633\u0639 \u062d\u0644\u0641 \u0634\u0645\u0627\u0644 \u0627\u0644\u0627\u0654\u0637\u0644\u0633\u064a (\u0646\u0627\u062a\u0648) \u0628\u0627\u062a\u062c\u0627\u0647 \u062d\u062f\u0648\u062f\u0647\u0627\u060c \u0641\u064a \u0648\u0642\u062a \u062a\u0633\u0639\u0649 \u0643\u064a\u064a\u0641 \u0644\u0644\u0627\u0646