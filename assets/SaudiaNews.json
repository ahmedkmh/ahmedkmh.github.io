 "https://www.alyaum.com/articles/6679156/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D9%84%D8%B5%D9%8A%D9%86-%D8%AA%D8%B2%D9%8A%D8%AF-%D8%AF%D8%B9%D9%85%D9%87%D8%A7-%D8%A7%D9%84%D9%85%D8%A7%D9%84%D9%8A-%D9%84%D8%AA%D8%AD%D9%81%D9%8A%D8%B2-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%87%D9%84%D8%A7%D9%83-%D8%A7%D9%84%D9%85%D8%AD%D9%84%D9%8A", "title": "\u0627\u0644\u0635\u064a\u0646 \u062a\u0632\u064a\u062f \u062f\u0639\u0645\u0647\u0627 \u0627\u0644\u0645\u0627\u0644\u064a \u0644\u062a\u062d\u0641\u064a\u0632 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u062d\u0644\u064a", "description": "<div style=\"text-align: justify;\">\u0632\u0627\u062f\u062a<a href=\"https://www.alyaum.com/articles/6678398/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%AA%D8%A8%D8%A7%D8%B7%D8%A4-%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF-%D8%A7%D9%84%D8%B5%D9%8A%D9%86%D9%8A-%D8%A8%D8%A3%D8%B3%D8%B1%D8%B9-%D9%88%D8%AA%D9%8A%D8%B1%D8%A9-%D9%85%D9%86%D8%B0-2022-%D9%88%D8%B3%D8%B7-%D8%A7%D9%86%D9%83%D9%85%D8%A7%D8%B4-%D8%B4%D8%A7%D9%85%D9%84-%D8%A8%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%AB%D9%85%D8%A7%D8%B1\" target=\"_blank\"> \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u0635\u064a\u0646\u064a\u0629</a> \u062f\u0639\u0645\u0647\u0627 \u0627\u0644\u0645\u0627\u0644\u064a \u0644\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643\u060c \u0641\u064a \u0627\u0655\u0637\u0627\u0631 \u062c\u0647\u0648\u062f \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0655\u0644\u0649 \u062a\u0648\u0633\u064a\u0639 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u062d\u0644\u064a \u0648\u062a\u062d\u0641\u064a\u0632 \u0627\u0644\u0627\u0655\u0646\u0641\u0627\u0642 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643\u064a.<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d \u0646\u0627\u064a\u0654\u0628 \u0648\u0632\u064a\u0631 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u0635\u064a\u0646\u064a \u0644\u064a\u0627\u0648 \u0645\u064a\u0646\u060c \u062e\u0644\u0627\u0644 \u0645\u0648\u0654\u062a\u0645\u0631 \u0635\u062d\u0641\u064a\u060c \u0627\u0654\u0646 \u0627\u0644\u0648\u0632\u0627\u0631\u0629 \u062e\u0635\u0635\u062a \u0645\u0646\u0630 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0639\u0627\u0645 187.5 \u0645\u0644\u064a\u0627\u0631 \u064a\u0648\u0627\u0646 (\u0646\u062d\u0648 27.65 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631) \u0644\u062f\u0639\u0645 \u0628\u0631\u0627\u0645\u062c \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0627\u0644\u0633\u0644\u0639 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643\u064a\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0628\u0627\u0654\u062e\u0631\u0649 \u062c\u062f\u064a\u062f\u0629, \u0645\u0628\u064a\u0646\u064b\u0627 \u0627\u0654\u0646 \u0647\u0630\u0647 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0654\u0633\u0647\u0645\u062a \u0641\u064a \u0627\u0655\u062a\u0645\u0627\u0645 178 \u0645\u0644\u064a\u0648\u0646 \u0639\u0645\u0644\u064a\u0629 \u0634\u0631\u0627\u0621\u060c \u0628\u0627\u0655\u062c\u0645\u0627\u0644\u064a \u0645\u0628\u064a\u0639\u0627\u062a \u0628\u0644\u063a \u0646\u062d\u0648 1.32 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u064a\u0648\u0627\u0646.<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641 \u0644\u064a\u0627\u0648 \u0627\u0654\u0646 \u0627\u0644\u0648\u0632\u0627\u0631\u0629 \u0637\u0628\u0642\u062a \u0643\u0630\u0644\u0643 <a href=\"https://www.alyaum.com/articles/6673040/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF-%D8%A7%D9%84%D8%B5%D9%8A%D9%86%D9%8A-%D9%8A%D9%86%D9%85%D9%88-%D8%A8%D8%A3%D8%A8%D8%B7%D8%A3-%D9%88%D8%AA%D9%8A%D8%B1%D8%A9-%D9%81%D9%8A-3-%D8%B3%D9%86%D9%88%D8%A7%D8%AA-%D8%AE%D9%84%D8%A7%D9%84-%D8%A7%D9%84%D8%B1%D8%A8%D8%B9-%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D