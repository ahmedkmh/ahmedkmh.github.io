84%D8%A7\">\u0641\u064a\u0636\u0627\u0646\u0627\u062a</a> \u0648\u0627\u0646\u0647\u064a\u0627\u0631 \u0627\u0654\u0631\u0636\u064a \u062c\u0631\u0627\u0621 \u0627\u0654\u0645\u0637\u0627\u0631 \u063a\u0632\u064a\u0631\u0629 \u0634\u0647\u062f\u0647\u0627 \u0634\u0645\u0627\u0644 \u063a\u0631\u0628 <a href=\"https://www.alyaum.com/articles/6678177/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%B2%D9%84%D8%B2%D8%A7%D9%84-%D9%8A%D8%B6%D8%B1%D8%A8-%D8%A5%D8%B3%D8%A8%D8%A7%D9%86%D9%8A%D8%A7-%D9%88%D8%A7%D9%84%D8%B3%D9%84%D8%B7%D8%A7%D8%AA-%D8%AA%D8%B9%D9%84%D9%86-%D8%AD%D8%A7%D9%84%D8%A9-%D8%B7%D9%88%D8%A7%D8%B1%D8%A6\">\u0627\u0655\u0633\u0628\u0627\u0646\u064a\u0627</a> \u0627\u0655\u0644\u0649 \u0645\u0635\u0631\u0639 \u0627\u0645\u0631\u0627\u0654\u062a\u064a\u0646 \u0648\u0627\u0655\u0635\u0627\u0628\u0629 \u0637\u0641\u0644\u064a\u0646\u060c \u0648\u0641\u0642 \u0645\u0627 \u0627\u0654\u0641\u0627\u062f\u062a \u0627\u0644\u0633\u0644\u0637\u0627\u062a \u0627\u0644\u0633\u0628\u062a.<br /><br />\u0648\u0630\u0643\u0631\u062a<a href=\"https://www.alyaum.com/articles/6677811/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%B8%D9%84%D8%A7%D9%85-%D8%AF%D8%A7%D9%85%D8%B3-%D9%81%D9%8A-%D9%88%D8%B6%D8%AD-%D8%A7%D9%84%D9%86%D9%87%D8%A7%D8%B1-%D9%83%D8%B3%D9%88%D9%81-%D9%83%D9%84%D9%8A-%D9%86%D8%A7%D8%AF%D8%B1-%D9%84%D9%84%D8%B4%D9%85%D8%B3-%D9%81%D9%8A-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7\"> \u0627\u0654\u062c\u0647\u0632\u0629 \u0627\u0644\u0637\u0648\u0627\u0631\u064a\u0654</a> \u0641\u064a \u0627\u0655\u0642\u0644\u064a\u0645 \u0643\u0627\u0633\u062a\u064a\u0627 \u0648\u0644\u064a\u0648\u0646 \u0639\u0642\u0628 \u0627\u0644\u0643\u0627\u0631\u062b\u0629 \u0627\u0644\u062a\u064a \u0648\u0642\u0639\u062a \u0641\u064a \u0642\u0631\u064a\u0629 \u0645\u0627\u0646\u062b\u0627\u0646\u064a\u062f\u0648 \u062f\u064a \u0641\u0627\u0644\u062f\u0648\u064a\u0632\u0627 \u0627\u0644\u0635\u063a\u064a\u0631\u0629\u060c \u0627\u0654\u0646\u0647 \"\u062a\u0645 \u062a\u0627\u0654\u0643\u064a\u062f \u0648\u0641\u0627\u0629 \u0627\u0645\u0631\u0627\u0654\u062a\u064a\u0646\u060c \u062a\u0628\u0644\u063a \u0627\u0655\u062d\u062f\u0627\u0647\u0645\u0627 \u0646\u062d\u0648 60 \u0639\u0627\u0645\u0627 \u0648\u0627\u0644\u0627\u0654\u062e\u0631\u0649 \u0646\u062d\u0648 80 \u0639\u0627\u0645\u0627\".<h2>\u0641\u064a\u0636\u0627\u0646\u0627\u062a \u0641\u064a \u0627\u0655\u0633\u0628\u0627\u0646\u064a\u0627</h2>\u0648\u0627\u0654\u0636\u0627\u0641\u062a \u0627\u0654\u0646 \u0631\u0636\u064a\u0639\u064a\u0646 \u062a\u0644\u0642\u064a\u0627 \u0627\u0644\u0639\u0644\u0627\u062c \u0627\u0655\u062b\u0631 \u0627\u0655\u0635\u0627\u0628\u062a\u0647\u0645\u0627 \u0628\u0643\u062f\u0645\u0627\u062a\u060c \u0648\u0627\u0654\u0646 \u0634\u062e\u0635\u0627 \u062b\u0627\u0644\u062b\u0627 \u0643\u0627\u0646 \u0642\u062f \u0627\u064f\u0654\u0628\u0644\u063a \u0639\u0646 \u0641\u0642\u062f\u0627\u0646\u0647\u060c \u0648\u0647\u0648 \u0631\u062c\u0644 \u0641\u064a \u0627\u0644\u062b\u0645\u0627\u0646\u064a\u0646\u0627\u062a \u0645\u0646 \u0639\u0645\u0631\u0647\u060c \"\u0639\u064f\u062b\u0631 \u0639\u0644\u064a\u0647 \u0633\u0627\u0644\u0645\u0627\".<br /> <br />\u0648\u0647\u0631\u0639\u062a \u0641\u0631\u0642 \u0627\u0644\u0627\u0655\u0637\u0641\u0627\u0621 \u0648\u0627\u0644\u0634\u0631\u0637\u0629 \u0648\u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0627\u0655\u0633\u0639\u0627\u0641 \u0648\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u0645\u062f\u0646\u064a \u0627\u0655\u0644\u0649 \u0645\u0648\u0642\u0639 \u0627\u0644\u062d\u0627\u062f\u062b \u0627\u0644\u0630\u064a \u0627\u0654\u0638\u0647\u0631\u062a \u0645\u0634\u0627\u0647\u062f \u0627\u0644\u062a\u064f\u0642\u0637\u062a \u0645\u0646 \u0645\u0631\u0648\u062d\u064a\u0629 \u0627\u0655\u0646\u0642\u0627\u0630 \u0627\u0654\u0646\u0647 \u0645\u062d\u0627\u0637 \u0628\u062a\u0636\u0627\u0631\u064a\u0633 \u062c\u0628\u0644\u064a\u0629 \u062a\u063a\u0637\u064a\u0647\u0627 \u0627\u0644\u063a\u0627\u0628\u0627\u062a.<br /><br />\u0648\u0646\u0634\u0631\u062a \u0648\u0633\u0627\u064a\u0654\u0644 \u0627\u0655\u0639\u0644\u0627\u0645 \u0645\u062d\u0644\u064a\u0629 \u0644\u0642\u0637\u0627\u062a \u062a\u0638\u0647\u0631 \u0643\u062a\u0644\u0629 \u0631\u0645\u0627\u062f\u064a\u0629 \u0645\u0646 \u0627\u0644\u062d\u062c\u0627\u0631\u0629 \u0648\u0627\u0644\u0637\u064a\u0646 \u0627\u062c\u062a\u0627\u062d\u062a \u0627\u0644\u0642\u0631\u064a\u0629 \u0648\u0633\u062d\u0642\u062a \u0627\u0655\u062d\u062f\u0649 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a.<h2>\u0639\u0648\u0627\u0635\u0641 \u0639\u0627\u062a\u064a\u0629</h2>\u0648\u0635\u0631\u062d \u0645\u0627\u0631\u0643\u0648 \u0645\u0648\u0631\u0627\u0644\u0627\u060c \u0631\u064a\u0654\u064a\u0633 \u0628\u0644\u062f\u064a\u0629 \u0628\u0648\u0646\u0641\u064a\u0631\u0627\u062f\u0627 \u0627\u0644\u0645\u062c\u0627\u0648\u0631\u0629\u060c \u0644\u0644\u0635\u062d\u0627\u0641\u064a\u064a\u0646 \u0628\u0627\u0654\u0646 \"\u0639\u0648\u0627\u0635\u0641 \u0639\u0627\u062a\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u0644\u0627\u0644 \u062a\u0633\u0628\u0628\u062a \u0641\u064a \u0633\u064a\u0644 \u0645\u0646 \u0627\u0644\u062d\u062c\u0627\u0631\u0629 \u0648\u0627\u0644\u0637\u064a\u0646 \u0648\u0627\u0644\u0631\u0648\u0627\u0633\u0628\"\u060c \u0645\u0627 \u0627\u0654\u062f\u0649 \u0627\u0655\u0644\u0649 \u0648\u0642\u0648\u0639 \u0648\u0641\u064a\u0627\u062a.<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641 \u0627\u0654\u0646 \u0627\u0644\u0643\u0627\u0631\u062b\u0629 \u062a\u0633\u0628\u0628\u062a \u0627\u0654\u064a\u0636\u0627 \u0628\u0627\u0654\u0636\u0631\u0627\u0631 \u0645\u0627\u062f\u064a\u0629 \u0641\u064a \u0642\u0631\u064a\u0629 \u0628\u0648\u0632\u0627\u0633 \u0627\u0644\u0645\u062c\u0627\u0648\u0631\u0629.<br /><br />\u0648\u062a\u0627\u0654\u062a\u064a \u0647\u0630\u0647 \u0627\u0644\u0641\u064a\u0636\u0627\u0646\u0627\u062a \u064