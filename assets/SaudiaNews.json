u064a\u0637\u0627\u0646\u064a\u0627\u060c \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0639\u0627\u062f\u0629 \u0628\u0637\u0642\u0633\u0647\u0627 \u0627\u0644\u0645\u0627\u0637\u0631 \u0648\u0627\u0644\u0645\u062a\u0642\u0644\u0651\u0628\u060c \u062d\u0627\u0644\u0629 \u062c\u0641\u0627\u0641 \u062e\u0644\u0627\u0644 5 \u0633\u0646\u0648\u0627\u062a.<br />\u0648\u0643\u0627\u0646\u062a \u0627\u0644\u0633\u0644\u0637\u0627\u062a \u0627\u0654\u0639\u0644\u0646\u062a \u0645\u0639 \u0646\u0647\u0627\u064a\u0629 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 \u0627\u0654\u0646 \u0627\u0644\u062c\u0641\u0627\u0641 \u064a\u0636\u0631\u0628 \u0627\u0654\u0643\u062b\u0631 \u0645\u0646 50% \u0645\u0646 \u0645\u0633\u0627\u062d\u0629 \u0627\u0655\u0646\u062c\u0644\u062a\u0631\u0627.<h2>\u0645\u0648\u062c\u0629 \u0627\u0644\u062d\u0631 \u0627\u0644\u062e\u0627\u0645\u0633\u0629</h2>\u0648\u062a\u0634\u0647\u062f \u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0627 \u0645\u0648\u062c\u0629 \u0627\u0644\u062d\u0631 \u0627\u0644\u062e\u0627\u0645\u0633\u0629 \u0641\u064a \u0635\u064a\u0641 2026 \u0627\u0644\u0630\u064a \u0634\u0647\u062f \u062a\u062d\u0637\u064a\u0645 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0627\u0654\u0631\u0642\u0627\u0645 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 \u0644\u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629.<br />\u0648\u0641\u064a \u062d\u064a\u0646 \u062a\u062a\u0647\u064a\u0651\u0627\u0654 \u0627\u0654\u062c\u0632\u0627\u0621 \u0643\u0628\u064a\u0631\u0629 \u0645\u0646 \u0627\u0654\u0648\u0631\u0648\u0628\u0627 \u0644\u0645\u0648\u062c\u0629 \u062d\u0631 \u062c\u062f\u064a\u062f\u0629 \u0648\u0644\u0638\u0631\u0648\u0641 \u062c\u0641\u0627\u0641 \u0645\u0637\u0648\u0651\u0644\u0629\u060c \u064a\u062d\u0630\u0651\u0631 \u0639\u0644\u0645\u0627\u0621 \u0645\u0646 \u0627\u0654\u0646 \u0627\u0644\u062a\u063a\u064a\u0651\u0631 \u0627\u0644\u0645\u0646\u0627\u062e\u064a \u064a\u0632\u064a\u062