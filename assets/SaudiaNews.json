{"status": "success", "totalResults": 2884, "results": [{"article_id": "60a72651dd599692fda52a6c9a020d2a", "link": "https://www.al-monitor.com/originals/2026/10/trump-will-not-win-years-nobel-peace-prize-he-may-influence-who-does-say-experts", "title": "Trump will not win this year's Nobel Peace Prize, but he may influence who does, say experts", "description": "OSLO, Oct 1 (Reuters) - US President Donald Trump will not win this year's Nobel Peace Prize as he wages war with Iran, but his influence will still be felt by the awarding body that picks the laureate, according to experts. Last year's award, to Venezuela's Maria Corina Machado, was unique in the prize's 125-year history, coming amid repeated lobbying by Trump to get the award. Weeks later, Machado gave her gold Nobel medal to Trump, in a bid to win support for her efforts for a democratic Venezuela.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": null, "creator": null, "language": "english", "country": ["turkey", "iraq", "palestine", "saudi arabia", "syria", "israel", "egypt", "jordan", "united arab emirates", "lebanon", "iran"], "category": ["world", "politics"], "datatype": "news", "pubDate": "2026-10-01 06:46:31", "pubDateTZ": "UTC", "fetched_at": "2026-10-01 07:04:31", "image_url": "https://www.al-monitor.com/sites/default/files/styles/social_media_share/public/2026-10/2026-10-01T062338Z_1_LYNXMPEM902EG_RTROPTP_3_USA-TRUMP.JPG?h=c9f93661&itok=bVGYKQSa", "video_url": null, "source_id": "almonitor", "source_name": "Palestine \u2013 Al-monitor", "source_priority": 21626, "source_url": "https://www.al-monitor.com", "source_icon": "https://i.newsdata.io/almonitor.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN P