%AF%D8%AB%D8%A7%D8%AA-%D9%81%D8%AA%D8%AD-%D9%85%D8%B6%D9%8A%D9%82-%D9%87%D8%B1%D9%85%D8%B2\">\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0646\u0641\u0637</a> \u0627\u0644\u064a\u0648\u0645 \u0642\u0631\u0628 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0655\u063a\u0644\u0627\u0642 \u0627\u0644\u062c\u0645\u0639\u0629\u060c \u0628\u0639\u062f \u062a\u0631\u0627\u062c\u0639 \u0645\u0643\u0627\u0633\u0628\u0647\u0627 \u0627\u0644\u0645\u0628\u0643\u0631\u0629\u060c \u0648\u0633\u0637 \u062a\u0631\u0642\u0628 \u062a\u0637\u0648\u0631\u0627\u062a \u0627\u0655\u0639\u0627\u062f\u0629 \u0641\u062a\u062d <a href=\"https://www.alyaum.com/articles/6677347/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D8%B3%D8%AA%D9%82%D8%B1%D8%A7%D8%B1-%D8%A3%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D8%B0%D9%87%D8%A8-%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D8%A5%D8%AB%D9%86%D9%8A%D9%86-%D9%88%D8%B3%D8%B7-%D8%AA%D8%B1%D9%82%D8%A8-%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA-%D8%A7%D9%84%D8%AA%D8%B6%D8%AE%D9%85-%D8%A7%D9%84%D8%A3%D9%85%D8%B1%D9%8A%D9%83%D9%8A%D8%A9\">\u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632</a>.<br /><br />\u0648\u0633\u062c\u0644\u062a \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0627\u0653\u062c\u0644\u0629 \u0644<a href=\"https://www.alyaum.com/articles/6677317/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%A7%D9%84%D8%B7%D8%A7%D9%82%D8%A9/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%A3%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D9%86%D9%81%D8%B7-%D9%85%D8%B9-%D8%A7%D8%B3%D8%AA%D9%85%D8%B1%D8%A7%D8%B1-%D8%AD%D8%A7%D9%84%D8%A9-%D8%A7%D9%84%D8%B6%D8%A8%D8%A7%D8%A8%D9%8A%D8%A9-%D8%A7%D9%84%D8%AC%D9%8A%D9%88%D8%B3%D9%8A%D8%A7%D8%B3%D9%8A%D8%A9\">\u062e\u0627\u0645 \u0628\u0631\u0646\u062a</a> 83.53 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0628\u0631\u0645\u064a\u0644\u060c \u0641\u064a\u0645\u0627 \u0628\u0644\u063a \u062e\u0627\u0645 \u063a\u0631\u0628 \u062a\u0643\u0633\u0627\u0633 \u0627\u0644\u0648\u0633\u064a\u0637 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a 78.02 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0628\u0631\u0645\u064a\u0644\u060c \u0628\u0639\u062f \u0627\u0654\u0646 \u062a\u062c\u0627\u0648\u0632\u062a \u0645\u0643\u0627\u0633\u0628\u0647\u0645\u0627 1% \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0628\u0643\u0631\u0629.<h2>\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0646\u0641\u0637 \u0627\u0644\u064a\u0648\u0645</h2>\u0648\u0643\u0627\u0646 \u0627\u0644\u062e\u0627\u0645\u0627\u0646 \u0642\u062f \u062e\u0633\u0631\u0627 \u0627\u0654\u0643\u062b\u0631 \u0645\u0646 7% \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a\u060c \u0645\u0639 \u062a\u0632\u0627\u064a\u062f \u0627\u0644\u0627\u0653\u0645\u0627\u0644 \u0641\u064a \u0627\u0655\u062d\u0631\u0627\u0632 \u062a\u0642\u062f\u0645 \u0628\u0634\u0627\u0654\u0646 \u0627\u0655\u0639\u0627\u062f\u0629 \u0641\u062a\u062d \u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632 \u0627\u0654\u0645\u0627\u0645 \u0627\u0644\u0645\u0644\u0627\u062d\u0629.<br /><br /> <br /><br />\u0648\u0641\u064a \u0627\u0654\u0633\u0648\u0627\u0642 \u0627\u0644\u0645\u0639\u0627\u062f\u0646 \u0627\u0644\u0646\u0641\u064a\u0633\u0629\u060c \u0627\u0631\u062a\u0641\u0639 \u0627\u0644\u0630\u0647\u0628 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 0.13% \u0627\u0655\u0644\u0649 4348.04 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0627\u0654\u0648\u0642\u064a\u0629\u060c \u0645\u062d\u0627\u0641\u0638\u064b\u0627 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u0647 \u0642\u0631\u0628 \u0627\u0654\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0641\u064a \u0633\u0628\u0639\u0629 \u0627\u0654\u0633\u0627\u0628\u064a\u0639.<h2>\u0627\u0654\u0633\u0648\u0627\u0642 \u0627\u06