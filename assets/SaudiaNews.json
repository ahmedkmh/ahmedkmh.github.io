%D8%B1-%D9%82%D9%88%D9%8A-%D8%AF%D8%A7%D8%AE%D9%84-%D9%85%D8%B5%D9%81%D8%A7%D8%A9-%D8%A7%D9%84%D8%B2%D8%A7%D9%88%D9%8A%D8%A9-%D8%A7%D9%84%D9%86%D9%81%D8%B7%D9%8A%D8%A9-%D9%81%D9%8A-%D8%BA%D8%B1%D8%A8-%D9%84%D9%8A%D8%A8%D9%8A%D8%A7", "title": "\u0641\u064a\u062f\u064a\u0648.. \u0627\u0646\u0641\u062c\u0627\u0631 \u0642\u0648\u064a \u062f\u0627\u062e\u0644 \u0645\u0635\u0641\u0627\u0629 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0646\u0641\u0637\u064a\u0629 \u0641\u064a \u063a\u0631\u0628 \u0644\u064a\u0628\u064a\u0627", "description": "<p>\u0648\u0642\u0639 <a href=\"https://www.alyaum.com/articles/6677106/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A8%D9%84%D8%BA%D8%A7%D8%B1%D9%8A%D8%A7-%D8%AA%D8%B3%D8%AA%D8%AF%D8%B9%D9%8A-%D8%B3%D9%81%D9%8A%D8%B1%D8%A9-%D8%A3%D9%88%D9%83%D8%B1%D8%A7%D9%86%D9%8A%D8%A7-%D8%A5%D8%AB%D8%B1-%D8%A7%D9%86%D9%81%D8%AC%D8%A7%D8%B1-%D9%85%D8%B3%D9%8A%D8%B1%D8%A9-%D9%81%D9%8A-%D8%A3%D8%B1%D8%A7%D8%B6%D9%8A%D9%87%D8%A7\" target=\"_blank\">\u0627\u0646\u0641\u062c\u0627\u0631</a> \u0642\u0648\u064a \u062f\u0627\u062e\u0644 \u0645\u0635\u0641\u0627\u0629 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0646\u0641\u0637\u064a\u0629 \u0641\u064a \u063a\u0631\u0628 <a href=\"https://www.alyaum.com/articles/6670835/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%B1%D8%A8/%D9%82%D8%A7%D8%AF%D9%85%D9%88%D9%86-%D9%85%D9%86-%D8%AA%D8%B4%D8%A7%D8%AF-%D8%A5%D8%AD%D8%A8%D8%A7%D8%B7-%D8%AA%D8%B3%D9%84%D9%84-74-%D9%85%D9%87%D8%A7%D8%AC%D8%B1%D8%A7-%D8%BA%D9%8A%D8%B1-%D8%B4%D8%B1%D8%B9%D9%8A-%D8%AC%D9%86%D9%88%D8%A8-%D9%84%D9%8A%D8%A8%D9%8A%D8%A7\" target=\"_blank\">\u0644\u064a\u0628\u064a\u0627</a> \u064a\u0648\u0645 \u0627\u0644\u0627\u062b\u0646\u064a\u0646\u060c \u0627\u0654\u0639\u0642\u0628\u0647 \u0627\u0646\u062f\u0644\u0627\u0639 \u062d\u0631\u064a\u0642 \u0641\u064a \u0627\u0654\u062d\u062f \u062e\u0632\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0635\u0641\u0627\u0629\u060c \u0641\u064a\u0645\u0627 \u0644\u0645 \u064a\u062a\u0636\u062d \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631 \u0633\u0628\u0628 \u0627\u0644\u0627\u0646\u0641\u062c\u0627\u0631 \u0627\u0654\u0648 \u062d\u062c\u0645 \u0627\u0644\u0627\u0654\u0636\u0631\u0627\u0631 \u0627\u0644\u0646\u0627\u062c\u0645\u0629 \u0639\u0646\u0647.</p><p>\u0648\u0627\u0654\u0638\u0647\u0631\u062a \u0644\u0642\u0637\u0627\u062a \u0645\u0635\u0648\u0631\u0629 \u062a\u062f\u0627\u0648\u0644\u062a\u0647\u0627 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u060c \u0644\u062d\u0638\u0629 \u0627\u0646\u0641\u062c\u0627\u0631 \u0627\u0654\u062d\u062f \u062e\u0632\u0627\u0646\u0627\u062a <a href=\"https://www.alyaum.com/articles/6645098/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A7%D9%86%D8%AF%D9%84%D8%A7%D8%B9-%D8%AD%D8%B1%D9%8A%D9%82-%D8%A8%D9%85%D8%B5%D9%81%D8%A7%D8%A9-%D8%A7%D9%84%D9%86%D9%81%D8%B7-%D9%81%D9%8A-%D9%87%D8%A7%D9%81%D8%A7%D9%86%D8%A7-%D8%A8%D8%AE%D9%84%D9%8A%D8%AC-%D8%A7%D9%84%D8%B9%D8%A7%D8%B5%D9%85%D8%A9-%D8%A7%D9%84%D9%83%D9%88%D8%A8%D9%8A%D8%A9\" target=\"_blank\">\u0627\u0644\u0646\u0641\u0637</a>\u060c \u0627\u0655\u0630 \u0634\u0648\u0647\u062f \u062a\u0635\u0627\u0639\u062f \u0643\u062b\u064a\u0641 \u0644\u0644\u062f\u062e\u0627\u0646 \u0648\u0627\u0654\u0644\u0633\u0646\u0629 \u0627\u0644\u0644\u0647\u0628 \u0641\u064a \u0645\u062d\u064a\u0637 \u0627\u0644\u0645\u0635\u0641\u0627\u0629 \u0648\u0641\u064a \u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u062f\u064a\u0646\u0629.</p><h2>\u0636\u0631\u0648\u0631\u0629 \u0648\u0642\u0641 \u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644 \u0627\u0644\u0642\u062a\u0627\u0644\u064a\u0629</h2><p>\u0648\u0627\u0654\u0639\u0644\u0646\u062a <a href=\"https://www.alyaum.com/articles/6209984/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A5%D8%AC%D9%84%D8%A7%D8%A1-%D9%85%D9%88%D8%B8%D9%81%D9%8A-%D8%B4%D8%B1%D9%83%D8%A9-%D9%86%D9%81%D8%B7-%D9%84%D9%8A%D8%A8%D9%8A%D8%A9-%D8%A8%D8%B9%D8%AF-%D9%82%D8%B5%D9%81-%D9%85%D8%B7%D8%A7%D8%B1-%D9%85%D8%B9%D9%8A%D8%AA%D9%8A%D9%82%D8%A9\" target=\"_blank\">\u0634\u0631\u0643\u0629 \u0627\u0644\u0628\u0631\u064a\u0642\u0629</a> \u0644\u062a\u0633\u0648\u064a\u0642 \u0627\u0644\u0646\u0641\u0637 \u064a\u0648\u0645 \u0627\u0644\u0627\u062b\u0646\u064a\u0646\u060c \u0627\u0646\u062f\u0644\u0627\u0639 \u062d\u0631\u064a\u0642 \u0641\u064a \u0627\u0654\u062d\u062f \u062e\u0632\u0627\u0646\u0627\u062a \u0648\u0642\u0648\u062f \u0627\u0644\u0628\u0646\u0632\u064a\u0646 \u0628\u0645\u0633\u062a\u0648\u062f\u0639 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0646\u0641\u0637\u064a\u060c \u0645\u0648\u0654\u0643\u062f\u0629 \u0627\u0654\u0646 \u0627\u0654\u0633\u0628\u0627\u0628 \u0627\u0644\u062d\u0631\u064a\u0642 \u0644\u0627 \u062a\u0632\u0627\u0644 \u0645\u062c\u0647\u0648\u0644\u0629 \u062d\u062a\u0649 \u0627\u0644\u0627\u0653\u0646.</p><p>\u0648\u0627\u0654\u0648\u0636\u062d\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0654\u0646 \u0641\u0631\u0642 \u0627\u0644\u0627\u0655\u0637\u0641\u0627\u0621 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0628\u0627\u0634\u0631\u062a \u0639\u0645\u0644\u064a\u0627\u062a \u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u062d\u0631\u064a\u0642\u060c \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u0645\u0639 \u062a\u0628\u0631\u064a\u062f \u0627\u0644\u062e\u0632\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062c\u0627\u0648\u0631\u0629\u060c \u0641\u064a \u0645\u0633\u0639\u0649 \u0644\u0645\u0646\u0639 \u0627\u0645\u062a\u062f\u0627\u062f \u0627\u0644\u0646\u064a\u0631\u0627\u0646 \u0627\u0655\u0644\u0649 \u0628\u0627\u0642\u064a \u0627\u0654\u062c\u0632\u0627\u0621 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639.</p><p>\u0643\u0645\u0627 \u0646\u0627\u0634\u062f\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u0654\u0637\u0631\u0627\u0641 \u0636\u0631\u0648\u0631\u0629 \u0648\u0642\u0641 \u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644 \u0627\u0644\u0642\u062a\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f \u0628\u0634\u0643\u0644 \u0639\u0627\u062c\u0644 \u0639\u0646 \u0627\u0644\u0645\u0646\u0634\u0627\u0653\u062a \u0648\u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639\u0627\u062a \u0627\u0644\u0646\u0641\u0637\u064a\u0629\u060c \u0645\u062d\u0630\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062a\u064a \u0642\u062f \u062a\u0646\u062c\u0645 \u0639\u0646 \u0627\u0654\u064a \u0627\u0654\u0639\u0645\u0627\u0644 \u0628\u0627\u0644\u0642\u0631\u0628 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u0627\u0641\u0642 \u0627\u0644\u062d\u064a\u0648\u064a\u0629.</p><p>\u0648\u0627\u0654\u0643\u062f\u062a \u0627\u0654\u0646 \u0627\u0644\u0645\u0646\u0634\u0627\u0653\u062a \u0627\u0644\u0646\u0641\u0637\u064a\u0629 \u062a\u0645\u062b\u0644 \u0645\u0631\u0627\u0641\u0642 \u062d\u064a\u0648\u064a\u0629 \u0648\u0645\u0644\u0643\u064b\u0627 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0644\u064a\u0628\u064a\u064a\u0646\u060c \u0645\u0634\u062f\u062f\u0629 \u0639\u0644\u0649 \u0627\u0654\u0646 \u062d\u0645\u0627\u064a\u062a\u0647\u0627 \u0645\u0633\u0648\u0654\u0648\u0644\u064a\u0629 \u0648\u0637\u0646\u064a\u0629 \u0644\u0627 \u062a\u062d\u062a\u0645\u0644 \u0627\u0654\u064a \u062a\u0647\u0627\u0648\u0646.<br /> </p><div data-oembed-url=\"https://x.com/AlArabiya/status/2086899162142953676\"><blockquote align=\"center\" class=\"twitter-tweet\" data-dnt=\"true\"><p dir=\"rtl\" lang=\"ar\">\u0645\u0634\u0627\u0647\u062f \u062e\u0627\u0635\u0629 \u0644\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0648\u062b\u0642 \u0644\u062d\u0638\u0629 \u062a\u0635\u0627\u0639\u062f \u0627\u0644\u0646\u064a\u0631\u0627\u0646 \u0645\u0646 \u0645\u0635\u0641\u0627\u0629 \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0641\u064a \u0