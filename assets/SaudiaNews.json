48\u0627\u0644\u0632\u0631\u0627\u0639\u0629 \u0628\u0645\u0646\u0637\u0642\u0629 \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 10 <a href=\"https://www.alyaum.com/articles/6574695/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%A3%D8%AD%D8%B3%D8%A7%D8%A127-%D9%85%D8%B4%D8%B1%D9%88%D8%B9%D8%A7-%D8%B2%D8%B1%D8%A7%D8%B9%D9%8A%D8%A7-%D8%B3%D9%85%D9%83%D9%8A%D8%A7-%D9%8A%D9%86%D8%AA%D8%AC-2000-%D8%B7%D9%86-%D8%A3%D8%B3%D9%85%D8%A7%D9%83-%D8%B3%D9%86%D9%88%D9%8A%D8%A7\" target=\"_blank\">\u0645\u0632\u0627\u0631\u0639 \u0633\u0645\u0643\u064a\u0629</a> \u062a\u0639\u0645\u0644 \u062f\u0648\u0646 \u062a\u0631\u0627\u062e\u064a\u0635 \u0646\u0638\u0627\u0645\u064a\u0629\u060c \u0627\u0655\u062b\u0631 22 \u062c\u0648\u0644\u0629 \u0631\u0642\u0627\u0628\u064a\u0629 \u0645\u064a\u062f\u0627\u0646\u064a\u0629 \u0646\u0641\u0630\u0647\u0627 \u062e\u0644\u0627\u0644 \u0634\u0647\u0631\u064a \u064a\u0648\u0646\u064a\u0648 \u0648\u064a\u0648\u0644\u064a\u0648 2026\u0645\u060c \u0628\u0647\u062f\u0641 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0627\u0645\u062a\u062b\u0627\u0644 \u0644\u0644\u0627\u0654\u0646\u0638\u0645\u0629.<br /><br />\u0648\u0627\u0654\u0633\u0641\u0631\u062a \u0627\u0644\u062c\u0648\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0647\u062f\u0641\u062a 22 \u0645\u0646\u0634\u0627\u0654\u0629\u060c \u0639\u0646 \u0631\u0635\u062f \u0645\u0632\u0627\u0631\u0639 \u0645\u062e\u0627\u0644\u0641\u0629 \u062a\u062a\u062e\u0635\u0635 \u0641\u064a \u0627\u0633\u062a\u0632\u0631\u0627\u0639 \u0627\u0654\u0633\u0645\u0627\u0643 \u00ab\u0627\u0644\u0628\u0644\u0637\u064a \u0627\u0644\u0646\u064a\u0644\u064a\u00bb \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0639\u0630\u0628\u0629. \u0648\u062a\u0641\u0627\u0648\u062a\u062a \u0643\u0645\u064a\u0627\u062a \u0627\u0644\u0627\u0655\u0646\u062a\u0627\u062c \u0627\u0644\u0645\u0631\u0635\u0648\u062f\u0629 \u0628\u062d\u0633\u0628 <a href=\"https://www.alyaum.com/articles/6351975/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D9%85%D9%86%D9%88%D8%B9%D8%A7%D8%AA/%D8%AC%D8%A7%D8%B2%D8%A7%D9%86-%D8%B9%D9%86%D8%B5%D8%B1-%D9%81%D8%A7%D8%B9%D9%84-%D9%81%D9%8A-%D8%AA%D8%AD%D9%82%D9%8A%D9%82-%D8%A7%D9%84%D8%A3%D9%85%D9%86-%D8%A7%D9%84%D8%BA%D8%B0%D8%A7%D8%A6%D9%8A-%D9%84%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9\" target=\"_blank\">\u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0627\u0655\u0646\u062a\u0627\u062c\u064a\u0629</a> \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643\u0644 \u0645\u0632\u0631\u0639\u0629.<br /> <h2>\u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645\u064a\u0629 \u0628\u062d\u0642 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0627\u062a</h2>\u0648\u0634\u0645\u0644\u062a \u0627\u0644\u062a\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0631\u0642\u0627\u0628\u064a\u0629 \u0645\u062d\u0627\u0641\u0638\u0627\u062a \u062c\u062f\u0629\u060c \u0648\u0628\u062d\u0631\u0629\u060c \u0648\u0627\u0644\u062c\u0645\u0648\u0645\u060c \u0648\u062e\u0644\u064a\u0635. \u0648\u0627\u062a\u062e\u0630\u062a \u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u062d\u0642 \u0627\u0644\u0645\u0646\u0634\u0627\u0653\u062a \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629\u060c \u0645\u0639 \u062a\u0648\u062c\u064a\u0647 \u0645\u0644\u0627\u0643\u0647\u0627 \u0628\u0636\u0631\u0648\u0631\u0629 <a href=\"https://www.alyaum.com/articles/6262442/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/540-%D8%B7%D9%86%D8%A7-%D8%B1%D9%88%D8%A8%D9%8A%D8%A7%D9%86-%D9%88%D9%83%D9%81%D9%8A%D8%A7%D8%B1-%D8%B3%D9%86%D9%88%D9%8A%D8%A7-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%B2%D8%B1%D8%A7%D8%B9-%D8%A7%D9%84%D8%B3%D9%85%D9%83%D9%8A-%D8%A8%D8%A7%D9%84%D8%B4