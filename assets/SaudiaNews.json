a\u0627\u0631 \u0646\u0641\u0642 <a href=\"https://www.alyaum.com/articles/6608152/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/5-%D9%82%D8%AA%D9%84%D9%89-%D8%A7%D9%84%D8%B9%D8%AB%D9%88%D8%B1-%D8%B9%D9%84%D9%89-%D8%AC%D8%AB%D8%AB-%D8%A7%D9%84%D8%B9%D9%85%D8%A7%D9%84-%D8%A7%D9%84%D9%85%D9%81%D9%82%D9%88%D8%AF%D9%8A%D9%86-%D9%81%D9%8A-%D8%A7%D9%86%D9%87%D9%8A%D8%A7%D8%B1-%D9%86%D9%81%D9%82-%D9%85%D9%86%D8%AC%D9%85-%D8%AA%D8%B4%D9%8A%D9%84%D9%8A\" target=\"_blank\">\u062a\u062d\u062a \u0627\u0644\u0627\u0655\u0646\u0634\u0627\u0621</a> \u0641\u064a \u0645\u0634\u0631\u0648\u0639 \u0644\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0643\u0647\u0631\u0648\u0645\u0627\u064a\u0654\u064a\u0629 \u0628\u0648\u0644\u0627\u064a\u0629 \"\u0627\u0654\u0648\u062a\u0627\u0631\u0627\u062e\u0627\u0646\u062f\" \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0634\u0645\u0627\u0644 \u0627\u0644\u0647\u0646\u062f\u060c \u062d\u0633\u0628\u0645\u0627 \u0630\u0643\u0631 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629\u060c \u0631\u064a\u0654\u064a\u0633 \u0648\u0632\u0631\u0627\u0621 \u0648\u0644\u0627\u064a\u0629 \"\u0627\u0654\u0648\u062a\u0627\u0631\u0627\u062e\u0627\u0646\u062f\"\u060c \u0628\u0648\u0634\u0643\u0627\u0631 \u0633\u064a\u0646\u062c \u062f\u0647\u0627\u0645\u064a.<br />\u0648\u0627\u0654\u0636\u0627\u0641\u060c \"\u062a\u0645 \u0627\u0655\u0637\u0644\u0627\u0642 \u0639\u0645\u0644\u064a\u0629 \u0627\u0655\u0646\u0642\u0627\u0630 \u0628\u0639\u062f <a href=\"https://www.alyaum.com/articles/6490231/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%B2%D9%8A%D9%85%D8%A8%D8%A7%D8%A8%D9%88%D9%8A-%D9%85%D9%82%D8%AA%D9%84-13-%D8%B4%D8%AE%D8%B5%D8%A7-%D8%AC%D8%B1%D8%A7%D8%A1-%D8%AD%D8%A7%D8%AF%D8%AB-%D9%81%D9%8A-%D9%85%D9%86%D8%AC%D9%85-%D8%B0%D9%87%D8%A8-%D8%BA%D9%8A%D8%B1-%D9%82%D8%A7%D9%86%D9%88%D9%86%D9%8A\" target=\"_blank\">\u062a\u062f\u0641\u0642 \u0645\u0641\u0627\u062c\u064a\u0654 \u0644\