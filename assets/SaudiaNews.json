ticles/6673731/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%B5%D9%86%D8%A7%D8%B9%D8%A9-%D8%AA%D9%84%D8%B2%D9%85-%D9%85%D8%B5%D8%A7%D9%86%D8%B9-%D8%B5%D9%87%D8%B1-%D8%A7%D9%84%D8%AD%D8%AF%D9%8A%D8%AF-%D8%A8%D8%AA%D8%B1%D9%83%D9%8A%D8%A8-%D8%A8%D9%88%D8%A7%D8%A8%D8%A7%D8%AA-%D9%84%D9%84%D9%83%D8%B4%D9%81-%D8%A7%D9%84%D8%A5%D8%B4%D8%B9%D8%A7%D8%B9%D9%8A\" target=\"_blank\">\u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u0635\u0644\u0628</a>\u060c \u0628\u0646\u0633\u0628\u0629 \u062a\u0635\u0644 \u0627\u0655\u0644\u0649 1.9% \u0644\u062a\u0635\u0644 \u0627\u0655\u0644\u0649 94.10 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0637\u0646 \u0641\u064a \u0633\u0646\u063a\u0627\u0641\u0648\u0631\u0629\u060c \u0648\u0647\u0648 \u0627\u0654\u062f\u0646\u0649 \u0645\u0633\u062a\u0648\u0649 \u0644\u0647\u0627 \u062e\u0644\u0627\u0644 \u0627\u0644\u064a\u0648\u0645 \u0645\u0646\u0630 \u0627\u0654\u0648\u0627\u064a\u0654\u0644 \u064a\u0648\u0644\u064a\u0648 2025. \u0648\u0641\u064a \u0628\u0648\u0631\u0635\u0629 \u062f\u0627\u0644\u064a\u0627\u0646 \u0644\u0644\u0633\u0644\u0639 \u0627\u0646\u062e\u0641\u0636 \u0627\u0644\u0639\u0642\u062f \u0627\u0644\u0627\u0654\u0643\u062b\u0631 \u062a\u062f\u0627\u0648\u0644\u064b\u0627 \u0628\u0646\u0633\u0628\u0629 \u062a\u0642\u0627\u0631\u0628 3%.<br /><br />\u0648\u0643\u0627\u0646 <a href=\"https://www.alyaum.com/articles/6673704/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%B9%D9%82%D8%A7%D8%B1%D8%A7%D8%AA/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%A3%D8%B3%D8%B9%D8%A7%D8%B1-%D8%A7%D9%84%D8%AD%D8%AF%D9%8A%D8%AF-%D9%81%D9%8A-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D8%AE%D9%84%D8%A7%D9%84-%D8%B4%D9%87%D8%B1-%D8%A8%D8%A7%D8%B3%D8%AA%D8%AB%D9%86%D8%A7%D8%A1-%D9%81%D8%A6%D8%A9-%D9%88%D8%A7%D8%AD%D8%AF%D8%A9\" target=\"_blank\">\u062e\u0627\u0645 \u0627\u0644\u062d\u062f\u064a\u062f</a> \u0642\u062f \u0648\u0627\u062c\u0647 \u0628\u0627\u0644\u0641\u0639\u0644 \u0636\u063a\u0648\u0637\u064b\u0627 \u0628\u0633\u0628\u0628 \u0627\u0644\u0645\u062e\u0627\u0648\u0641 \u0628\u0634\u0627\u0654\u0646 \u062a\u062f\u0647\u0648\u0631 \u0627\u0654\u0633\u0627\u0633\u064a\u0627\u062a \u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u0635\u0644\u0628\u060c \u062d\u064a\u062b \u062a\u0631\u0627\u062c\u0639\u062a \u0647\u0648\u0627\u0645\u0634 \u0627\u0654\u0631\u0628\u0627\u062d \u0645\u0635\u0627\u0646\u0639 \u0627\u0644\u0635\u0644\u0628 \u0627\u0644\u0635\u064a\u0646\u064a\u0629 \u0628\u0634\u0643\u0644 \u0627\u0654\u0643\u0628\u0631 \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0627\u0636\u064a\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0646\u062e\u0641\u0636 \u0627\u0655\u0646\u062a\u0627\u062c \u0627\u0644\u062d\u062f\u064a\u062f \u0627\u0644\u062e\u0627\u0645 \u0644\u0644\u0627\u0654\u0633\u0628\u0648\u0639 \u0627\u0644\u0631\u0627\u0628\u0639 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a.<br /><br />\u0648\u0641\u064a \u0627\u0654\u0643\u0628\u0631 \u0627\u0642\u062a\u0635\u0627\u062f \u0641\u064a \u0627\u0653\u0633\u064a\u0627\u060c \u0627\u0646\u062e\u0641\u0636 <a href=\"https://www.alyaum.com/articles/6671549/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D8%B9%D9%82%D8%A7%D8%B1%D8%A7%D8%AA/%D9%82%D8%B7%D8%A7%D8%B9-%D8%A7%D9%84%D8%A8%D9%86%D8%A7%D8%A1-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A-%D9%8A%D8%B3%D8%AC%D9%84-%D8%A3%D8%B9%D9%84%D9%89-%D9%86%D8%B4%D8%A7%D8%B7-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%A5%D8%B7%D9%84%D8%A7%D9%82-%D9%81%D9%8A-%D9%8A%D9%88%D9%86%D9%8A%D9%88\" target=\"_blank\">\u0642\u0637\u0627\u0639 \u0627\u0644\u0628\u0646\u0627\u0621</a> \u0627\u0655\u0644\u0649 \u0627\u0654\u062f\u0646\u0649 \u0645\u0633\u062a\u0648\u0649 \u0644\u0647 \u0645\u0646\u0630 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062c\u0627\u064a\u0654\u062d\u0629\u060c \u0641\u064a \u062d\u064a\u0646 \u0627\u0646\u0643\u0645\u0634 \u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0635\u0646\u0627\u0639\u064a \u0641\u064a \u064a\u0648\u0644\u064a\u0648 \u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0645\u0646\u0630 5 \u0627\u0654\u0634\u0647\u0631.<br /><br />\u0648\u0627\u0646\u062e\u0641\u0636\u062a \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0627\u0653\u062c\u0644\u0629 \u0627\u0644\u0642\u064a\u0627\u0633\u064a\u0629 \u0644\u062e\u0627\u0645 \u0627\u0644\u062d\u062f\u064a\u062f \u0628\u0646\u0633\u0628\u0629 61% \u0628\u0646\u0633\u0628\u0629 1.6% \u0627\u0655\u0644\u0649 94.35 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u0637\u0646\u060c \u0628\u0639\u062f \u0633\u0644\u0633\u0644\u0629 \u0645\u0646 \u0627\u0644\u062e\u0633\u0627\u064a\u0654\u0631 \u0627\u0644\u0634\u0647\u0631\u064a\u0629 \u0644\u062b\u0644\u0627\u062b\u0629 \u0627\u0654\u0634\u0647\u0631 \u0645\u062a\u062a\u0627\u0644\u064a\u0629\u060c \u0648\u0647\u064a \u0627\u0654\u0637\u0648\u0644 \u0633\u0644\u0633\u0644\u0629 \u0645\u0646 \u0646\u0648\u0639\u0647\u0627 \u0645\u0646\u0630 \u0627\u0654\u0643\u062b\u0631 \u0645\u0646 \u0639\u0627\u0645. \u0643\u0645\u0627 \u0627\u0646\u062e\u0641\u0636\u062a \u0639\u0642\u0648\u062f \u0627\u0644\u0635\u0644\u0628 \u0627\u0644\u0645\u0642\u0648\u0645\u0629 \u0628\u0627\u0644\u064a\u0648\u0627\u0646 \u0641\u064a \u0628\u0648\u0631\u0635\u0629 \u0634\u0646\u063a\u0647\u0627\u064a.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u062a\u0631\u0627\u062c\u0639", "\u0623\u0633\u0639\u0627\u0631", "\u0627\u0644\u0623\u0631\u0628\u0627\u062d", "\u0644\u0623\u062f\u0646\u0649", "\u0639\u0627\u0645", "\u0645\u0639", "\u0641\u064a", "\u062a\u0647\u0628\u0637", "\u0627\u0644\u0635\u064a\u0646", "\u0645\u0633\u062a\u0648\u0649", "\u0627\u0644\u062d\u062f\u064a\u062f", "\u062e\u0627\u0645"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["business"], "datatype": "news", "pubD