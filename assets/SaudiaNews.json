8%D8%A7%D9%84%D9%85-%D9%88%D9%84%D8%AC%D9%86%D8%A9-%D9%84%D9%87%D9%86%D8%AF%D8%B3%D8%A9-%D8%A7%D9%84%D8%A5%D8%AC%D8%B1%D8%A7%D8%A1%D8%A7%D8%AA-%D8%A7%D9%84%D9%82%D8%B6%D8%A7%D8%A6%D9%8A%D8%A9\"> \u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0645\u0638\u0627\u0644\u0645</a> \u0641\u064a \u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u060c \u0628\u062d\u0636\u0648\u0631 \u0627\u0654\u0639\u0636\u0627\u0621 \u0627\u0644\u0645\u062c\u0644\u0633.<br /><br />\u0648\u0627\u0654\u0641\u0627\u062f \u0627\u0644\u0627\u0654\u0645\u064a\u0646 \u0627\u0644\u0639\u0627\u0645 \u0644\u0645\u062c\u0644\u0633 <a href=\"https://www.alyaum.com/articles/6672576/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%88%D8%B2%D9%8A%D8%B1-%D8%A7%D9%84%D8%B9%D8%AF%D9%84-%D9%88%D8%B1%D8%A6%D9%8A%D8%B3-%D8%AF%D9%8A%D9%88%D8%A7%D9%86-%D8%A7%D9%84%D9%85%D8%B8%D8%A7%D9%84%D9%85-%D9%8A%D8%B3%D8%AA%D8%B9%D8%B1%D8%B6%D8%A7%D9%86-%D8%A7%D9%84%D8%AA%D8%B9%D8%A7%D9%88%D9%86-%D9%88%D9%81%D8%B1%D8%B5-%D8%A7%D9%84%D8%AA%D8%B7%D9%88%D9%8A%D8%B1\">\u0627\u0644\u0642\u0636\u0627\u0621 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u064a</a> \u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u062c\u0644\u0627\u0646 \u0627\u0654\u0646 \u0627\u0644\u0645\u062c\u0644\u0633 \u0627\u0654\u0634\u0627\u062f \u0641\u064a \u0645\u0633\u062a\u0647\u0644 \u0627\u0644\u062c\u0644\u0633\u0629 \u0628\u0645\u0646\u062c\u0632\u0627\u062a \u0645\u062d\u0627\u0643\u0645 \u0627\u0644\u0627\u0633\u062a\u064a\u0654\u0646\u0627\u0641 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u062d\u0627\u0643\u0645 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u064a\u0629 \u0648\u0645\u062d\u0643\u0645\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u064a\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0635 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 \u0627