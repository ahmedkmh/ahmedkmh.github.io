7%D8%B1%D8%A7%D8%AA-%D8%B9%D9%84%D8%A7%D8%AC-%D8%B3%D8%B1%D8%B7%D8%A7%D9%86-%D8%A7%D9%84%D8%AB%D8%AF%D9%8A\" target=\"_blank\">\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062f\u0627\u0644\u0639\u0632\u064a\u0632</a>\u060c \u0645\u0639\u0633\u0643\u0631\u0627\u064b \u0644\u062a\u0627\u0654\u0647\u064a\u0644 18 \u0634\u0631\u0643\u0629 \u0646\u0627\u0634\u064a\u0654\u0629\u060c \u0628\u0647\u062f\u0641 \u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0641\u064a 10 \u0634\u0631\u0643\u0627\u062a \u0645\u062e\u062a\u0627\u0631\u0629\u060c \u0628\u0648\u0627\u0642\u0639 100 \u0627\u0654\u0644\u0641 \u0631\u064a\u0627\u0644 \u0644\u0643\u0644 \u0634\u0631\u0643\u0629\u060c \u0644\u0631\u0641\u0639 \u062c\u0627\u0647\u0632\u064a\u062a\u0647\u0627 \u0644\u0644\u0646\u0645\u0648.<br /><br />\u0648\u064a\u0642\u0627\u0645 \u0627\u0644\u0645\u0639\u0633\u0643\u0631 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0645\u0646 6 \u0627\u0655\u0644\u0649 9 \u0627\u0654\u063a\u0633\u0637\u0633 \u0627\u0644\u062c\u0627\u0631\u064a\u060c <a href=\"https://www.alyaum.com/articles/6642917/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A8%D8%A7%D9%84%D9%81%D9%8A%D8%AF%D9%8A%D9%88-%D8%AA%D8%AF%D8%B4%D9%8A%D9%86-%D9%85%D9%86%D8%B7%D9%82%D8%A9-%D8%A7%D9%84%D8%A7%D8%A8%D8%AA%D9%83%D8%A7%D8%B1-%D9%88%D8%B1%D9%8A%D8%A7%D8%AF%D8%A9-%D8%A7%D9%84%D8%A3%D8%B9%D9%85%D8%A7%D9%84-%D9%81%D9%8A-%D9%88%D8%A7%D8%AF%D9%8A-%D8%AC%D8%AF%D8%A9\" target=\"_blank\">\u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0634\u0631\u0643\u0627\u062a</a> \u062a\u0639\u0645\u0644 \u0641\u064a \u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0648\u0627\u0644\u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u0635\u062d\u064a\u0629 \u0648\u0627\u0644\u062d\u064a\u0648\u064a\u0629\u060c \u0648\u0627\u0644\u063a\u0630\u0627\u0621\u060c \u0648\u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0630\u0643\u064a\u0629\u060c \u0648\u0627\u0644\u0627\u0633\u062a\u062f\u0627\u0645\u0629.<br /> <h2>\u0648\u0631\u0634 \u0639\u0645\u0644 \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u062e\u0628\u0631\u0627\u0621</h2>\u0648\u064a\u062c\u0645\u0639 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0628\u0646\u062e\u0628\u0629 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646 \u0648\u0627\u0644\u062e\u0628\u0631\u0627\u0621 \u0639\u0628\u0631 \u0648\u0631\u0634 \u0639\u0645\u0644 \u062a\u0637\u0628\u064a\u0642\u064a\u0629 \u0648\u062c\u0644\u0633\u0627\u062a \u0627\u0655\u0631\u0634\u0627\u062f \u0641\u0631\u062f\u064a\u0629. \u0643\u0645\u0627 \u064a\u062a\u0636\u0645\u0646 \u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0645\u062a\u062e\u0635\u0635\u0629 \u0648\u0627\u0655\u0639\u062f\u0627\u062f\u0627\u064b \u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u0627\u062a \u0627\u0654\u0645\u0627\u0645 \u0644\u062c\u0627\u0646 \u0627\u0633\u062a\u062b\u0645\u0627\u0631\u064a\u0629.<br /><br />\u0648\u064a\u0631\u0643\u0632 \u0627\u0644\u0645\u0639\u0633\u0643\u0631 \u0639\u0644\u0649 \u0627\u062e\u062a\u0628\u0627\u0631 \u062c\u062f\u0648\u0649 \u0627\u0644\u062d\u0644\u0648\u0644 <a href=\"https://www.alyaum.com/articles/6645691/%D9%81%D9%8A%D8%AF%D9%8A%D9%88/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D9%81%D9%8A%D8%AF%D9%8A%D9%88-%D9%88%D8%A7%D8%AF%D9%8A-%D8%AC%D8%AF%D8%A9-%D9%84%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D9%86%D9%85%D8%AA%D9%84%D9%83-%D9%85%D8%B3%D8%A7%D8%B1%D8%B9%D8%A7-%D8%B0%D8%B1%D9%8A%D8%A7-%D9%84%D8%A5%D9%86%D8%AA%D8%A7%D8%AC-%D8%A7%D9%84%D9%85%D9%88%D8%A7%D8%AF-%D8%A7%D9%84%D9%85%D8%B4%D8%B9%D8%A9-%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%A9-%D8%B9%D8%A7%D9%84%D9%8A%D8%A9-%D8%A7%D9%84%D8%AA%D8%B9%D9%82%D9%8A%D8%AF\" target=\"_blank\">\u0648\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a</a> \u0648\u062a\u062d\u0633\u064a\u0646 \u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644. \u0648\u064a\u062d\u0627\u0643\u064a \u0645\u0631\u0627\u062d\u0644 \u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646 \u0644\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0648\u0654\u0633\u0633\u064a\u0646 \u0645\u0646 \u062a\u0637\u0648\u064a\u0631 \u0639\u0631\u0648\u0636\u0647\u0645 \u0648\u0628\u0646\u0627\u0621 \u062e\u0637\u0637 \u0644\u0644\u0648\u0635\u0648\u0644 \u0627\u0655\u0644\u0649 \u0627\u0644\u0627\u0654\u0633\u0648\u0627\u0642.<br /><br />\u0648\u0641\u064a \u062e\u062a\u0627\u0645 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c\u060c \u062a\u0639\u062a\u0632\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u062e\u062a\u064a\u0627\u0631 10 \u0634\u0631\u0643\u0627\u062a \u0646\u0627\u0634\u064a\u0654\u0629 \u0644\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0627\u0655\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062d\u0627\u0636\u0646\u0629. \u0648\u0633\u062a\u0642\u062f\u0645 \u0644\u0647\u0627 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0627\u062d\u062a\u0636\u0627\u0646 \u0648\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u062e\u0644\u0627\u0644 \u0645\u0631\u0627\u062d\u0644 \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644 \u0628\u062c\u0627\u0646\u0628 \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0642\u0631\u0631.<br /><br />\u0648\u064a\u0627\u0654\u062a\u064a \u0627\u0644\u062a\u0646\u0638\u064a\u0645 \u0636\u0645\u0646 \u062c\u0647\u0648\u062f \u0627\u0644\u0634\u0631\u0643\u0629 \u0644\u0628\u0646\u0627\u0621 \u0645\u0646\u0638\u0648\u0645\u0629 \u062a\u062f\u0639\u0645 \u0631\u064a\u0627\u062f\u0629 \u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644\u060c \u0648