u0639\u064a\u0646\u0627\u062a \u0648\u062f\u0642\u0629 \u0627\u0644\u0646\u062a\u0627\u064a\u0654\u062c.<br /><br />\u0648\u0628\u064a\u0651\u0646\u062a \u0627\u0654\u0646 \u0627\u0644\u0639\u064a\u0646\u0627\u062a \u062e\u0636\u0639\u062a \u0644\u062a\u062d\u0644\u064a\u0644 \u0645\u062e\u0628\u0631\u064a \u0634\u0627\u0645\u0644\u060c \u062d\u064a\u062b \u062a\u0645 \u062a\u062d\u0644\u064a\u0644 \u0645\u0627 \u0644\u0627 \u064a\u0642\u0644 \u0639\u0646 \u062b\u0644\u0627\u062b \u0639\u064a\u0646\u0627\u062a \u0644\u0643\u0644 \u0637\u0628\u0642\u060c \u0648\u062a\u0642\u062f\u064a\u0631 49 \u0639\u0646\u0635\u0631\u064b\u0627 \u063a\u0630\u0627\u064a\u0654\u064a\u064b\u0627 \u0641\u064a \u0643\u0644 \u0645\u0646\u0647\u0627\u060c \u0644\u064a\u0635\u0644 \u0627\u0655\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u062d\u0627\u0644\u064a\u0644 \u0627\u0644\u0645\u062e\u0628\u0631\u064a\u0629 \u0627\u0644\u0645\u0646\u0641\u0630\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0643\u062b\u0631 \u0645\u0646 19 \u0627\u0654\u0644\u0641 \u062a\u062d\u0644\u064a\u0644\u060c \u0628\u0645\u0627 \u064a\u0636\u0645\u0646 \u062a\u0648\u0641\u064a\u0631 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0644\u0645\u064a\u0629 \u0645\u0648\u062b\u0648\u0642\u0629 \u062d\u0648\u0644 \u0627\u0644\u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u063a\u0630\u0627\u064a\u0654\u064a \u0644\u0644\u0627\u0654\u0637\u0628\u0627\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629.<br /> <h2>\u0645\u0631\u062c\u0639 \u0639\u0644\u0645\u064a \u0648\u0637\u0646\u064a</h2>\u0648\u0627\u0654\u0636\u0627\u0641\u062a \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0654\u0646 \u0645\u0631\u062d\u0644\u0629 \u0645\u0631\u0627\u062c\u0639\u0629 \u0648\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062a\u0636\u0645\u0646\u062a \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0646\u062a\u0627\u064a\u0654\u062c \u0627\u0644\u0645\u062e\u0628\u0631\u064a\u0629 \u0627\u0644\u062e\u0627\u0645 \u0627\u0655\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0646\u0638\u0645\u0629 \u0648\u0645\u0647\u064a\u0627\u0654\u0629\u060c \u0645\u0639 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062f\u0642\u062a\u0647\u0627 \u0648\u0627\u062a\u0633\u0627\u0642\u0647\u0627\u060c \u0648\u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0646\u0627\u0642\u0635\u0629 \u0627\u0654\u0648 \u063a\u064a\u0631 \u0627\u0644\u0645\u0643\u062a\u0634\u0641\u0629 \u0648\u0641\u0642 \u0645\u0646\u0647\u062c\u064a\u0627\u062a \u0639\u0644\u0645\u064a\u0629 \u0645\u0639\u062a\u0645\u062f\u0629\u060c \u0644\u0636\u0645\u0627\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0648\u0627\u0631\u062f\u0629 \u0641\u064a \u0627\u0644\u0643\u062a\u0627\u0628.<br /><br />\u0648\u0627\u0654\u0634\u0627\u0631\u062a \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u062c\u062f\u0627\u0648\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u062a\u0639\u0631\u0636 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u063a\u0630\u0627\u064a\u0654\u064a\u0629 \u0628\u0635\u064a\u063a\u062a\u064a\u0646\u061b \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0644\u0643\u0644 100 \u063a\u0631\u0627\u0645 \u0645\u0646 \u0627\u0644\u063a\u0630\u0627\u0621\u060c \u0648\u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0644\u0644\u0648\u0635\u0641\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0645\u062d\u0633\u0648\u0628\u0629 \u0631\u064a\u0627\u0636\u064a\u064b\u0627 \u0628\u0645\u0627 \u064a\u0643\u0641\u064a \u0627\u0654\u0631\u0628\u0639\u0629 \u0627\u0654\u0634\u062e\u0627\u0635\u060c \u0628\u0645\u0627 \u064a\u062a\u064a\u062d \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646\u0647\u0627 \u0641\u064a \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0628\u062d\u062b\u064a\u0629 \u0648\u0627\u0644\u063a\u0630\u0627\u064a\u0654\u064a\u06