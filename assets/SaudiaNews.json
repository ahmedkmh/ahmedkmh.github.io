u0627\u0646 \u0628\u062b\u0644\u0627\u062b\u064a\u0629 \u0648\u064a\u0635\u0639\u062f \u0644\u0646\u0635\u0641 \u0646\u0647\u0627\u0626\u064a \u062e\u0644\u064a\u062c\u064a27", "description": "\u062d\u062c\u0632 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0645\u0642\u0639\u062f\u0647 \u0641\u064a \u0627\u0644\u062f\u0648\u0631 \u0646\u0635\u0641 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u060c \u0644\u0628\u0637\u0648\u0644\u0629 \u00ab\u062e\u0644\u064a\u062c\u064a 27\u00bb\u060c \u0643\u0623\u0648\u0644 \u0627\u0644\u0645\u062a\u0623\u0647\u0644\u064a\u0646 \u0644\u0647\u0630\u0627 \u0627\u0644\u062f\u0648\u0631\u060c \u0639\u0642\u0628 \u0641\u0648\u0632\u0647 \u0627\u0644\u0635\u0631\u064a\u062d \u0639\u0644\u0649 \u0646\u0638\u064a\u0631\u0647 \u0627\u0644\u0639\u0645\u0627\u0646\u064a (3-0) \u0641\u064a \u0627\u0644\u0644\u0642\u0627\u0621 \u0627\u0644\u0630\u064a \u062c\u0645\u0639\u0647\u0645\u0627 \u0627\u0644\u0633\u0628\u062a\u060c \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \u0627\u0644\u0625\u0646\u0645\u0627\u0621 \u0628\u062c\u062f\u0629\u060c \u0641\u064a \u062e\u062a\u0627\u0645 \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u062c\u0648\u0644\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629\u060c \u0644\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 . \u0633\u062c\u0644 \u062b\u0644\u0627\u062b\u064a\u0629 \u0627\u0644\u0623\u062e\u0636\u0631\u060c \u0641\u0631\u0627\u0633 \u0627\u0644\u0628\u0631\u064a\u0643\u0627\u0646 (11 \u0648 34) \u0648\u062d\u0633\u0646 \u0643\u0627\u062f\u0634 (18) . \u0648\u062d\u0627\u0641\u0638 \u0627\u0644\u0623\u062e\u0636\u0631 \u0628\u0647\u0630\u0627 \u0627\u0644\u0641\u0648\u0632 \u0639\u0644\u0649 \u0635\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0628\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u00ab6 \u0646\u0642\u0627\u0637\u00bb\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062d\u062a\u0644 \u0627\u0644\u0639\u0631\u0627\u0642 \u0627\u0644\u0645\u0631\u062a\u0628\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0628\u0631\u0635\u064a\u062f \u00ab4 \u0646\u0642\u0627\u0637\u00bb . \u0648\u0641\u0631\u0636 \u0627\u0644\u0623\u062e\u0636\u0631 \u0625\u064a\u0642\u0627\u0639\u0647 \u0639\u0644\u0649 \u0645\u062c\u0631\u064a\u0627\u062a \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u0623\u0648\u0644\u060c \u0648\u0646\u062c\u062d \u0641\u064a \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0628\u0639\u062f \u0645\u0631\u0648\u0631 \u0639\u0634\u0631 \u062f\u0642\u0627\u0626\u0642\u060c \u0639\u0646\u062f\u0645\u0627 \u062a\u0627\u0628\u0639 \u0641\u0631\u0627\u0633 \u0627\u0644\u0628\u0631\u064a\u0643\u0627\u0646 \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629\u060c \u0644\u0639\u0628\u0647\u0627 \u0628\u0631\u0623\u0633\u0647 \u0639\u0644\u0649 \u064a\u0645\u064a\u0646 \u0625\u0628\u0631\u0627\u0647\u064a\u0645 \u0627\u0644\u0645\u062e\u064a\u0646\u064a (11) \u0648\u0645\u0646 \u0631\u0643\u0644\u0629 \u0631\u0643\u0646\u064a\u0629 \u0639\u0632\u0632 \u0627\u0644\u0623\u062e\u0636\u0631 \u062a\u0642\u062f\u0645\u0647 \u0628\u0647\u062f\u0641 \u062b\u0627\u0646\u060c \u0639\u0646\u062f\u0645\u0627 \u0627\u0631\u062a\u0642\u0649 \u062d\u0633\u0646 \u0643\u0627\u062f\u0634 \u0644\u0644\u0643\u0631\u0629 \u0648\u0644\u0639\u0628\u0647\u0627 \u0642\u0648\u064a\u0629 \u0639\u0644\u0649 \u064a\u0633\u0627\u0631 \u0627\u0644\u0645\u062e\u064a\u0646\u064a (18) \u0648\u0631\u063a\u0645 \u0627\u0644\u062a\u0642\u062f\u0645 \u0628\u0647\u062f\u0641\u064a\u0646\u060c \u0625\u0644\u0627 \u0623\u0646\u0647 \u0648\u0627\u0635\u0644 \u0628\u062d\u062b\u0647 \u0639\u0646 \u0647\u062f\u0641 \u062b\u0627\u0644\u062b \u0648\u062a\u0645\u0643\u0646 \u0645\u0646 \u0630\u0644\u0643 \u0639\u0646\u062f\u0645\u0627 \u062a\u0628\u0627\u062f\u0644 \u0641\u0631\u0627\u0633 \u0627\u0644\u0628\u0631\u064a\u0643\u0627\u0646 \u0627\u0644\u0643\u0631\u0629 \u0645\u0639 \u0633\u0644\u0637\u0627\u0646 \u0645\u0646\u062f\u0634\u060c \u0642\u0628\u0644 \u0623\u0646 \u064a\u0635\u0648\u0628\u0647\u0627 \u0627\u0644\u0623\u0648\u0644 \u0642\u0648\u064a\u0629 \u0639\u0644\u0649 \u064a\u0633\u0627\u0631 \u0627\u0644\u0645\u062e\u064a\u0646\u064a (34) \u0648\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062d\u062a\u0633\u0628 \u0628\u062f\u0644 \u0627\u0644\u0636\u0627\u0626\u0639 \u062a\u062f\u062e\u0644 \u0627\u0644\u0642\u0627\u0626\u0645 \u0648\u062d\u0631\u0645 \u0627\u0644\u0623\u062e\u0636\u0631 \u0645\u0646 \u0647\u062f\u0641 \u0631\u0627\u0628\u0639 \u0639\u0646\u062f\u0645\u0627 \u062a\u0635\u062f\u0649 \u0644\u0643\u0631\u0629 \u0639\u0644\u0627\u0621 \u062d\u062c\u064a \u0642\u0628\u0644 \u0623\u0646 \u062a\u0639\u0648\u062f \u0648\u064a\u0628\u0639\u062f\u0647\u0627 \u0627\u0644\u0645\u062e\u064a\u0646\u064a \u0628\u0642\u064a\u0636\u062a\u0647 \u0639\u0646 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062e\u0637\u0631 . \u0648\u0645\u0639 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u062b\u0627\u0646\u064a \u0648\u0645\u0646 \u0647\u0641\u0648\u0629 \u062f\u0641\u0627\u0639\u064a\u0629 \u0643\u0627\u062f \u0639\u0645\u0627\u0646 \u0623\u0646 \u064a\u0642\u0644\u0635 \u0627\u0644\u0642\u0627\u0626\u0645\u060c \u0644\u0643\u0646 \u0643\u0631\u0629 \u0633\u0644\u0637\u0627\u0646 \u0627\u0644\u0645\u0631\u0632\u0648\u0642 \u0627\u0631\u062a\u0637\u0645\u062a \u0628\u0627\u0644\u0642\u0627\u0626\u0645 \u0648\u0623\u062e\u0630\u062a \u0637\u0631\u064a\u0642\u0647\u0627 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0644\u0639\u0628 (47) \u0631\u062f \u0639\u0644\u064a\u0647 \u0627\u0644\u0623\u062e\u0636\u0631 \u0628\u062a\u0635\u0648\u064a\u0628\u0629 \u0642\u0648\u064a\u0629 \u0645\u0646 \u0647\u0645\u0627\u0645 \u0627\u0644\u0647\u0645\u0627\u0645\u064a\u060c \u062a\u0635\u062f\u0649 \u0644\u0647\u0627 \u0627\u0644\u0645\u062e\u064a\u0646\u064a \u0648\u0639\u0627\u062f\u062a \u0644\u064a\u0634\u062a\u062a\u0647\u0627 \u0627\u0644\u062f\u0641\u0627\u0639 (48) \u0648\u0644\u0627\u062d\u062a \u0641\u0631\u0635\u0629 \u0623\u062e\u0631\u0649 \u0644\u0639\u0645\u0627\u0646 \u0639\u0646\u062f\u0645\u0627 \u0635\u0648\u0628 \u0639\u0635\u0627\u0645 \u0627\u0644\u0635\u0628\u062d\u064a \u0643\u0631\u0629 \u0642\u0648\u064a\u0629\u060c \u062a\u0635\u062f\u0649 \u0644\u0647\u0627 \u0645\u062d\u0645\u062f \u0627\u0644\u0639\u0648\u064a\u0633 \u0628\u0628\u0631\u0627\u0639\u0629 \u0648\u0627\u0646\u0647\u0649 \u062e\u0637\u0648\u0631\u062a\u0647\u0627 (55) \u0648\u0623\u0636\u0627\u0639 \u0627\u0644\u0623\u062e\u0636\u0631 \u0647\u062f\u0641\u0627\u064b \u0631\u0627\u0628\u0639\u0627\u064b \u0639\u0646\u062f\u0645\u0627 \u0627\u0633\u062a\u0642\u0628\u0644 \u0645\u0646\u062f\u0634 \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629 \u0648\u0627\u062c\u0647 \u0639\u0644\u0649 \u0625\u062b\u0631\u0647\u0627 \u0627\u0644\u0645\u0631\u0645\u0649 \u0644\u0643\u0646\u0647 \u0644\u0639\u0628\u0647\u0627 \u0628\u062c\u0648\u0627\u0631 \u0627\u0644\u0642\u0627\u0626\u0645 (71) \u0642\u0628\u0644 \u0623\u0646 \u064a\u0647\u062f\u0631 \u0641\u0631\u0635\u0629 \u0645\u062d\u0642\u0642\u0629 \u0639\u0646\u062f\u0645\u0627 \u062a\u0644\u0642\u0649 \u0645\u062d\u0645\u062f \u0645\u062d\u0632\u0631\u064a \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629 \u0644\u0639\u0628\u0647\u0627 \u0641\u0648\u0642 \u0627\u0644\u0639\u0627\u0631\u0636\u0629 (83) \u0648\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062d\u062a\u0633\u0628 \u0628\u062f\u0644 \u0627\u0644\u0636\u0627\u0626\u0639 \u0627\u0646\u0642\u0630 \u0627\u0644\u0645\u062e\u064a\u0646\u064a \u0645\u0631\u0645\u0627\u0647 \u0645\u0646 \u0647\u062f\u0641 \u0645\u062d\u0642\u0642 \u0639\u0646\u062f\u0645\u0627 \u062a\u0635\u062f\u0649 \u0644\u0643\u0631\u0629 \u0632\u064a\u0627\u062f \u0627\u0644\u062c\u0647\u0646\u064a \u0648\u062d\u0648\u0644\u0647\u0627 \u0644\u0644\u0631\u0643\u0646\u064a\u