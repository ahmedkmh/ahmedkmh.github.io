\u064a\u0631\u0627\u0646 \u062a\u0628\u062d\u062b \u0633\u064a\u0646\u0627\u0631\u064a\u0648\u0647\u0627\u062a \u0645\u062d\u062a\u0645\u0644\u0629 \u0644\u0644\u0631\u062f \u0639\u0644\u0649 \u0627\u0654\u064a \u062a\u0635\u0639\u064a\u062f \u0639\u0633\u0643\u0631\u064a \u062c\u062f\u064a\u062f \u0642\u062f \u062a\u0642\u0648\u062f\u0647 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0636\u062f\u0647\u0627\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0645\u0635\u0627\u0644\u062d \u0648\u0645\u0646\u0634\u0627\u0653\u062a \u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0641\u064a \u062c\u0646\u0648\u0628 \u0634\u0631\u0642 \u0627\u0654\u0648\u0631\u0648\u0628\u0627\u060c \u0641\u064a \u062d\u0627\u0644 \u0642\u0631\u0631 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0645\u0628 \u062a\u0648\u0633\u064a\u0639 \u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629 \u0645\u0639 \u0637\u0647\u0631\u0627\u0646.\u0648\u0646\u0642\u0644\u062a \u0627\u0644\u0635\u062d\u064a\u0641\u0629 \u0639\u0646 \u0627\u0654\u0634\u062e\u0627\u0635 \u0645\u0637\u0644\u0639\u064a\u0646 \u0639\u0644\u0649 \u062f\u0648\u0627\u064a\u0654\u0631 \u0635\u064f\u0646\u0639 \u0627\u0644\u0642\u0631\u0627\u0631 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a \u0627\u0654\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629 \u062f\u0631\u0633\u062a \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0644\u0631\u0641\u0639 \u0643\u0644\u0641\u0629 \u0627\u0654\u064a \u0647\u062c\u0648\u0645 \u0627\u0654\u0645\u0631\u064a\u0643\u064a \u0645\u062d\u062a\u0645\u0644\u060c \u0645\u0634\u064a\u0631\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0628\u0639\u0636 \u0647\u0630\u0647 \u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648\u0647\u0627\u062a \u064a\u062a\u062c\u0627\u0648\u0632 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0627\u0654\u0648\u0633\u0637. \u0628\u0644\u063a\u0627\u0631\u064a\u0627 \u0648\u0642\u0628\u0631\u0635 \u0636\u0645\u0646 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0648\u0628\u062d\u0633\u0628 \u0627\u0644\u062a\u0642\u0631\u064a\u0631\u060c \u0634\u0645\u0644\u062a \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629 \u0645\u0648\u0627\u0642\u0639 \u0639\u0633\u0643\u0631\u064a\u0629 \u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0641\u064a \u062c\u0646\u0648\u0628 \u0634\u0631\u0642 \u0627\u0654\u0648\u0631\u0648\u0628\u0627\u061b \u0645\u0646 \u0628\u064a\u0646\u0647\u0627 \u0645\u0646\u0634\u0627\u0653\u062a \u0641\u064a \u0628\u0644\u063a\u0627\u0631\u064a\u0627\u060c \u0628\u0639\u062f\u0645\u0627 \u0633\u0645\u062d\u062a \u0635\u0648\u0641\u064a\u0627\u060c \u0645\u0648\u0654\u062e\u0631\u064b\u0627\u060c \u0644\u0637\u0627\u064a\u0654\u0631\u0627\u062a \u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0645\u062e\u0635\u0635\u0629 \u0644\u0627\u0655\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0632\u0648\u062f \u0628\u0627\u0644\u0648\u0642\u0648\u062f \u0628\u0627\u0644\u0639\u0645\u0644 \u0627\u0646\u0637\u0644\u0627\u0642\u064b\u0627 \u0645\u0646 \u0642\u0627\u0639\u062f\u0629 (\u0628\u064a\u0632\u0645\u064a\u0631) \u0627\u0644\u062c\u0648\u064a\u0629\u060c \u0627\u0644\u0627\u0654\u0645\u0631 \u0627\u0644\u0630\u064a \u0642\u062f \u064a\u0632\u064a\u062f \u0645\u0646 \u0627\u0654\u0647\u0645\u064a\u062a\u0647\u0627 \u0627\u0644\u0627\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629.\u0643\u0645\u0627 \u062a\u062f\u0631\u0633 \u0637\u0647\u0631\u0627\u0646\u060c \u0648\u0641\u0642 \u0627\u0654\u062d\u062f \u0627\u0644\u0627\u0654\u0634\u062e\u0627\u0635 \u0627\u0644\u0645\u0637\u0644\u0639\u064a\u0646 \u0639\u0644\u0649 \u0645\u062f\u0627\u0648\u0644\u0627\u062a \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629\u060c \u0627\u0655\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0645\u0648\u0627\u0642\u0639 \u0641\u064a \u0642\u0628\u0631\u0635 \u0627\u0655\u0630\u0627 \u0642\u0631\u0631\u062a \u0648\u0627\u0634\u0646\u0637\u0646 \u0634\u0646\u0651 \u0639\u0645\u0644\u064a\u0629 \u0639\u0633\u0643\u0631\u064a\u0629 \u062c\u062f\u064a\u062f\u0629 \u0648\u0627\u0633\u0639\u0629 \u0636\u062f \u0627\u0655\u064a\u0631\u0627\u0646.\u0648\u062a\u0633\u062a\u0636\u064a\u0641 \u0642\u0628\u0631\u0635 \u0645\u0646\u0634\u0627\u0653\u062a \u0639\u0633\u0643\u0631\u064a\u0629 \u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0629\u060c \u0643\u0627\u0646 \u0627\u0654\u062d\u062f\u0647\u0627 \u0647\u062f\u0641\u064b\u0627 \u0644\u0647\u062c\u0648\u0645 \u0628\u0637\u0627\u064a\u0654\u0631\u0629 \u0645\u0633\u064a\u0631\u0629 \u0641\u064a \u0648\u0642\u062a \u0633\u0627\u0628\u0642 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u062c\u0627\u0631\u064a. \u0643\u0627\u0628\u0644\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u062a\u062d\u062a \u0627\u0644\u0645\u064a\u0627\u0647 \u0648\u0644\u0627 \u062a\u0642\u062a\u0635\u0631 \u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648\u0647\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0628\u062d\u062b\u0647\u0627 \u0627\u0655\u064a\u0631\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0634\u0627\u0653\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0627\u0655\u0630 \u062a\u0634\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0627\u0644\u0645\u062e\u0637\u0637\u064a\u0646 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u064a\u0646 \u062f\u0631\u0633\u0648\u0627 \u0627\u0654\u064a\u0636\u064b\u0627 \u0633\u0628\u0644 \u062a\u0639\u0637\u064a\u0644 \u0643\u0627\u0628\u0644\u0627\u062a \u0627\u0644\u0627\u0654\u0644\u064a\u0627\u0641 \u0627\u0644\u0636\u0648\u064a\u0654\u064a\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0645\u0631 \u0639\u0628\u0631 \u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632.\u0648\u064a\u064f\u0639\u062f \u0627\u0644\u0645\u0636\u064a\u0642 \u0627\u0654\u062d\u062f \u0627\u0654\u0647\u0645 \u0627\u0644\u0645\u0645\u0631\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u060c \u0648\u062a\u0639\u062a\u0645\u062f \u0639\u0644\u064a\u0647 \u062d\u0631\u0643\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0648\u0627\u0644\u0637\u0627\u0642\u0629\u060c \u0641\u064a\u0645\u0627 \u062a\u0645\u0631 \u0639\u0628\u0631\u0647 \u0627\u0654\u064a\u0636\u064b\u0627 \u0628\u0646\u064a\u0629 \u062a\u062d\u062a\u064a\u0629 \u0644\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u064a\u0645\u0643\u0646 \u0627\u0654\u0646 \u062a\u062a\u0627\u0654\u062b\u0631 \u0628\u0634\u062f\u0629 \u0641\u064a \u062d\u0627\u0644 \u062a\u0639\u0631\u0636 \u0627\u0644\u0643\u0627\u0628\u0644\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0644\u0627\u0654\u0636\u0631\u0627\u0631. \u0637\u0647\u0631\u0627\u0646 \u062a\u0631\u0628\u0637 \u0627\u0644\u0631\u062f\u064e\u0651 \u0628\u062d\u062c\u0645 \u0627\u0644\u0647\u062c\u0648\u0645 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a \u0648\u062a\u0627\u0654\u062a\u064a \u0647\u0630\u0647 \u0627\u0644\u0627\u0633\u062a\u0639\u062f\u0627\u062f\u0627\u062a \u0641\u064a \u0648\u0642\u062a \u062a\u062f\u0631\u0633 \u0641\u064a\u0647 \u0627\u0655\u064a\u0631\u0627\u0646 \u0643\u064a\u0641\u064a\u0629 \u0632\u064a\u0627\u062f\u0629 \u0643\u0644\u0641\u0629 \u0627\u0654\u064a \u062a\u062f\u062e\u0644 \u0627\u0654\u0645\u0631\u064a\u0643\u064a \u0627\u0655\u0636\u0627\u0641\u064a\u060c \u0648\u0633\u0637 \u062a\u0627\u0654\u0643\u064a\u062f \u0645\u0635\u0627\u062f\u0631 \u0645\u0637\u0644\u0639\u0629 \u0627\u0654\u0646 \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0631\u062f \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a \u0648\u062d\u062c\u0645\u0647 \u0633\u064a\u0639\u062a\u0645\u062f\u0627\u0646 \u0628\u062f\u0631\u062c\u0629 \u0643\u0628\u064a\u0631\u0629 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u062d\u0631\u0643 \u0627\u0644\u0630\u064a \u0633\u062a\u0642\u062f\u0645 \u0639\u0644\u064a\u0647 \u0648\u0627\u0634\u0646\u0637\u0646.\u0648\u0628\u062d\u0633\u0628 \u0627\u0644\u062a\u0642\u0631\u064a\u0631\u060c \u062a\u0639\u0645\u0644 \u0637\u0647\u0631\u0627\u0646 \u0639\u0644\u0649 \u0627\u0655\u0639\u062f\u0627\u062f \u062e\u064a\u0627\u0631\u0627\u062a \u0644\u062a\u0648\u0633\u064a\u0639 \u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0655\u0630\u0627 \u0646\u0641\u0630 \u062a\u0631\u0645\u0628 \u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0633\u0627\u0628\u0642\u0629 \u0628\u0636\u0631\u0628 \u0645\u0646\u0634\u0627\u0653\u062a \u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629\u060c \u062e\u0635\u0648\u0635\u064b\u0627 \u0641\u064a \u0638\u0644 \u0627\u0644\u062a\u0648\u062a\u0631 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u0647\u062c\u0645\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0641\u064a \u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632.\u0643\u0645\u0627 \u0627\u0654\u0634\u0627\u0631 \u0645\u0635\u062f\u0631 \u0627\u0653\u062e\u0631 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0627\u0655\u064a\u0631\u0627\u0646 \u0642\u062f \u062a\u0648\u0633\u0639 \u0646\u0637\u0627\u0642 \u0631\u062f\u0647\u0627 \u0627\u0655\u0644\u0649 \u062e\u0627\u0631\u062c \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0627\u0654\u0648\u0633\u0637 \u0627\u0655\u0630\u0627 \u0648\u0627\u062c\u0647\u062a \u0647\u062c\u0648\u0645\u064b\u0627 \u0627\u0654\u0645\u0631\u064a\u0643\u064a\u064b\u0627 \u062c\u062f\u064a\u062f\u064b\u0627 \u0648\u0627\u0633\u0639 \u0627\u0644\u0646\u0637\u0627\u0642. \u062a\u0635\u0639\u064a\u062f \u0645\u062d\u062a\u0645\u0644 \u064a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0627\u0654\u0648\u0633\u0637 \u0648\u062a\u0639\u0643\u0633 \u0647\u0630\u0647 \u0627\u0644\u062a\u0642\u062f\u064a\u0631\u0627\u062a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629\u061b \u0648\u0641\u0642 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0646\u062f \u0627\u0655\u0644\u064a\u0647\u0627 \u0627\u0644\u062a\u0642\u0631\u064a\u0631\u060c \u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0637\u0647\u0631\u0627\u0646 \u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0627\u0654\u0643\u062b\u0631 \u0627\u062a\u0633\u0627\u0639\u064b\u0627 \u0644\u0644\u0635\u0631\u0627\u0639\u060c \u0628\u062d\u064a\u062b \u0644\u0627 \u062a\u0642\u062a\u0635\u0631 \u062a\u062f\u0627\u0639\u064a\u0627\u062a\u0647 \u0639\u0644\u0649 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0648\u0627\u0644\u0645\u0635\u0627\u0644\u062d \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0646\u0637\u0642\u0629.\u0648\u0645\u0639 \u0630\u0644\u0643\u060c \u0634\u062f\u062f\u062a \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0639\u0644\u0649 \u0627\u0654\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0637\u0631\u0648\u062d\u0629 \u0644\u0627 \u062a\u0639\u0646\u064a \u0628\u0627\u0644\u0636\u0631\u0648\u0631\u0629 \u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631 \u062