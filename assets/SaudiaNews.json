D8%A7%D9%84%D8%A7%D9%86%D8%AA%D8%AE%D8%A7%D8%A8%D8%A7%D8%AA-%D9%81%D9%8A-%D9%85%D9%88%D8%B2%D9%85%D8%A8%D9%8A%D9%82\" target=\"_blank\">\u062d\u0643\u0648\u0645\u0629 \u0645\u0648\u0632\u0645\u0628\u064a\u0642</a> \u0645\u0646 \u0627\u0654\u0646 52 \u0627\u0655\u0642\u0644\u064a\u0645\u064b\u0627 \u0642\u062f \u062a\u0648\u0627\u062c\u0647 \u0645\u062e\u0627\u0637\u0631 \u0645\u062a\u0641\u0627\u0648\u062a\u0629 \u0645\u0646 \u0627\u0644\u062c\u0641\u0627\u0641 \u062e\u0644\u0627\u0644 <a href=\"https://www.alyaum.com/articles/6670366/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D9%85%D9%86%D8%B0-%D8%A8%D8%AF%D8%A1-%D9%85%D9%88%D8%B3%D9%85-%D8%A7%D9%84%D8%A3%D9%85%D8%B7%D8%A7%D8%B1-59-%D9%82%D8%AA%D9%8A%D9%84%D8%A7-%D8%A5%D8%AB%D8%B1-%D8%A7%D9%84%D9%81%D9%8A%D8%B6%D8%A7%D9%86%D8%A7%D8%AA-%D9%81%D9%8A-%D8%B3%D8%A7%D8%AD%D9%84-%D8%A7%D9%84%D8%B9%D8%A7%D8%AC\" target=\"_blank\">\u0645\u0648\u0633\u0645 \u0627\u0644\u0627\u0654\u0645\u0637\u0627\u0631</a> 2026-2027\u060c \u0628\u0641\u0639\u0644 \u0627\u0644\u062a\u0627\u0654\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0644\u0638\u0627\u0647\u0631\u0629 \"\u0627\u0655\u0644 \u0646\u064a\u0646\u064a\u0648\".<br /><br />\u0648\u064a\u0627\u0654\u062a\u064a \u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u0630\u064a\u0631 \u0641\u064a \u0648\u0642\u062a \u064a\u062a\u0648\u0642\u0639 \u0641\u064a\u0647 \u062e\u0628\u0631\u0627\u0621 \u0627\u0644\u0627\u0654\u0631\u0635\u0627\u062f \u0627\u0644\u062c\u0648\u064a\u0629 \u0627\u0654\u0646 \u062a\u0643\u0648\u0646 <a href=\"https://www.alyaum.com/articles/6675828/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D9%85%D9%86%D9%88%D8%B9%D8%A7%D8%AA/%D8%AC%D9%81%D8%A7%D9%81-%D9%88%D9%81%D9%8A%D8%B6%D8%A7%D9%86%D8%A7%D8%AA-%D9%88%D8%AD%D8%B1%D8%A7%D8%A6%D9%82-%D8%BA%D8%A7%D8%A8%D8%A7%D8%AA-%D8%A7%D9%84%D8%A3%D8%B1%D8%B5%D8%A7%D8%AF-%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85%D9%8A%D8%A9-%D8%AA%D8%AD%D8%B0%D8%B1-%D9%85%D9%86-%D8%A7%D9%84%D9%86%D9%8A%D9%86%D9%8A%D9%88\" target=\"_blank\">\u0638\u0627\u0647\u0631\u0629 \"\u0627\u0655\u0644 \u0646\u064a\u0646\u064a\u0648\"</a> \u0642\u0648\u064a\u0629 \u062e\u0644\u0627\u0644 \u0645\u0648\u0633\u0645 \u0627\u0644\u0627\u0654\u0645\u0637\u0627\u0631 \u0627\u0644\u0645\u0642\u0628\u0644\u060c \u0645\u0639 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0644\u0645\u0639\u0647\u062f \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0627\u0654\u0631\u0635\u0627\u062f \u0627\u0644\u062c\u0648\u064a\u0629 \u0641\u064a \u0645\u0631\u0627\u0642\u0628\u0629 \u062a\u0637\u0648\u0631 \u0627\u0644\u0638\u0627\u0647\u0631\u0629 \u0648\u062a\u062d\u064a\u064a\u0646 \u062a\u0648\u0642\u0639\u0627\u062a\u0647.<br /><br /> <h2>\u062a\u0648\u0642\u0639\u0627\u062a \u0645\u0646\u0627\u062e\u064a\u0629</h2><br />\u062a\u0634\u064a\u0631 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629 \u0627\u0655\u0644\u0649 \u0627\u062d\u062a\u0645\u0627\u0644 \u062a\u0633\u062c\u064a\u0644 \u062a\u0633\u0627\u0642\u0637\u0627\u062a \u0627\u0654\u0642\u0644 \u0645\u0646 \u0627\u0644\u0645\u0639\u062f\u0644 \u0648\u063a\u064a\u0631 \u0645\u0646\u062a\u0638\u0645\u0629 \u0641\u064a \u0627\u0654\u062c\u0632\u0627\u0621 \u0645\u0646 \u062c\u0646\u0648\u0628 \u0648\u0648\u0633\u0637 \u0627\u0644\u0645\u0648\u0632\u0645\u0628\u064a\u0642\u060c \u0627\u0644\u0627\u0654\u0645\u0631 \u0627\u0644\u0630\u064a \u0642\u062f \u064a\u0648\u0654\u062f\u064a \u0627\u0655\u0644\u0649 \u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0645\u0627\u064a\u0654\u064a\u0629 \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062c\u0641\u0627\u0641 \u0627\u0644\u0632\u0631\u0627\u0639\u064a\u060c \u062e\u0627\u0635\u0629 \u0628\u0639\u062f \u0645\u0648\u0633\u0645 \u0627\u062a\u0633\u0645 \u0628\u062a\u0642\u0644\u0628\u0627\u062a \u0645\u0646\u0627\u062e\u064a\u0629 \u062d\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0628\u0644\u0627\u062f.<br /><br />\u064a\u064f\u0630\u0643\u0631 \u0627\u0654\u0646 \u0638\u0627\u0647\u0631\u0629 \"\u0627\u0655\u0644 \u0646\u064a\u0646\u064a\u0648\" \u0647\u064a \u062a\u063a\u064a\u0631 \u0645\u0646\u0627\u062e\u064a \u0637\u0628\u064a\u0639\u064a \u062a\u0635\u0628\u062d \u0641\u064a\u0647 \u0645\u064a\u0627\u0647 \u0627\u0644\u0633\u0637\u062d \u0641\u064a \u0648\u0633\u0637 \u0648\u0634\u0631\u0642 \u0627\u0644\u0645\u062d\u064a\u0637 \u0627\u0644\u0647\u0627\u062f\u064a\u0654 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u064a\u0654\u064a \u062f\u0627\u0641\u064a\u0654\u0629 \u062c\u062f\u064b\u0627\u060c \u0645\u0645\u0627 \u064a\u0648\u0654\u062f\u064a \u0627\u0655\u0644\u0649 \u0636\u0639\u0641 \u0627\u0644\u0631\u064a\u0627\u062d \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u062a\u063a\u064a\u0631 \u0627\u0654\u0646\u0645\u0627\u0637 \u0627\u0644\u0645\u0646\u0627\u062e \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u060c \u0648\u0647\u0648 \u0645\u0627 \u064a\u0633\u0628\u0628 \u062c\u0641\u0627\u0641\u064b\u0627 \u0641\u064a \u0645\u0646\u0627\u0637\u0642 \u0648\u0641\u064a\u0636\u0627\u0646\u0627\u062a \u0641\u064a \u0627\u0654\u062e\u0631\u0649\u060c \u0648\u064a\u0631\u0641\u0639 \u062f\u0631\u062c\u0629 \u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0627\u0654\u0631\u0636 \u0627\u0644\u0645\u0648\u0654\u0642\u062a\u0629.<br /><br /> <h2>\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062c\u0641\u0627\u0641 \u0627\u0644\u0632\u0631\u0627\u0639\u064a</h2><br />\u0643\u0645\u0627 \u0643\u0627\u0646\u062a \u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0644\u0644\u0627\u0654\u063a\u0630\u064a\u0629 \u0648\u0627\u0644\u0632\u0631\u0627\u0639\u0629 (\u0641\u0627\u0648) \u0642\u062f \u062d\u0630\u0631\u062a \u0641\u064a \u0648\u0642\u062a \u0633\u0627\u0628\u0642 \u0645\u0646 \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u062e