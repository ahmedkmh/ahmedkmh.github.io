"\u0648\u0642\u0651\u0639 \u0627\u0644\u0645\u0647\u0627\u062c\u0645 \u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644\u064a \u062c\u0648\u0627\u0648 \u0628\u064a\u062f\u0631\u0648 \u0639\u0642\u062f\u0627 \u062c\u062f\u064a\u062f\u0627 \u0645\u0639 \u0646\u0627\u062f\u064a \u062a\u0634\u0644\u0633\u064a \u0627\u0644\u0627\u0655\u0646\u0643\u0644\u064a\u0632\u064a \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645\u060c \u064a\u0628\u0642\u064a\u0647 \u0641\u064a \u0635\u0641\u0648\u0641 \u0627\u0644\u0646\u0627\u062f\u064a \u0627\u0644\u0644\u0646\u062f\u0646\u064a \u062d\u062a\u0649 \u0639\u0627\u0645 2032 \u0645\u0639 \u062e\u064a\u0627\u0631 \u0627\u0644\u062a\u0645\u062f\u064a\u062f \u0644\u0639\u0627\u0645\u064a\u0646 \u0627\u0655\u0636\u0627\u0641\u064a\u064a\u0646.<br /><br />\u0648\u0643\u0627\u0646 \u0639\u0642\u062f \u0628\u064a\u062f\u0648\u0631 (24 \u0639\u0627\u0645\u0627) \u0627\u0644\u0630\u064a \u0648\u0642\u0651\u0639\u0647 \u0639\u0646\u062f \u0627\u0646\u062a\u0642\u0627\u0644\u0647 \u0645\u0646 \u0628\u0631\u0627\u064a\u062a\u0648\u0646 \u0645\u0642\u0627\u0628\u0644 60 \u0645\u0644\u064a\u0648\u0646 \u062c\u0646\u064a\u0647 \u0627\u0655\u0633\u062a\u0631\u0644\u064a\u0646\u064a (82 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631) \u0642\u0628\u0644 \u0639\u0627\u0645\u060c \u064a\u0645\u062a\u062f \u062d\u062a\u0649 \u0639\u0627\u0645 2032 \u0645\u0639 \u062e\u064a\u0627\u0631 \u0627\u0644\u062a\u0645\u062f\u064a\u062f \u0644\u0639\u0627\u0645 \u0627\u0655\u0636\u0627\u0641\u064a.<br /><br />\u0648\u064a\u0627\u0654\u062a\u064a \u062a\u0645\u062f\u064a\u062f \u0627\u0644\u0639\u0642\u062f \u0628\u0639\u062f \u0645\u0648\u0633\u0645 \u0627\u0654\u0648\u0644 \u0645\u0645\u064a\u0632 \u0644\u0628\u064a\u062f\u0631\u0648 \u0645\u0639 \u0627\u0644\u0640\"\u0628\u0644\u0648\u0632\"\u060c \u0633\u062c\u0651\u0644 \u062e\u0644\u0627\u0644\u0647 20 \u0647\u062f\u0641\u0627.<br /><br />\u0648\u0642\u0627\u0644 \u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0646\u0627\u062f\u064a \"\u0627\u0654\u0646\u0627 \u0633\u0639\u064a\u062f \u062c\u062f\u0627 \u0628\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0639\u0644\u0649 \u0639\u0642\u062f \u062c\u062f\u064a\u062f \u0645\u0639 \u062a\u0634\u0644\u0633\u064a. \u0644\u0637\u0627\u0644\u0645\u0627 \u062d\u0644\u0645\u062a \u0628\u0627\u0644\u0644\u0639\u0628 \u0644\u0646\u0627\u062f \u0643\u0628\u064a\u0631\u060c \u0648\u064a\u0639\u0646\u064a \u0644\u064a \u0627\u0644\u0643\u062b\u064a\u0631 \u0627\u0654\u0646 \u0627\u0654\u0648\u0654\u0643\u062f \u0627\u0644\u062a\u0632\u0627\u0645\u064a \u0637\u0648\u064a\u0644 \u0627\u0644\u0627\u0654\u0645\u062f \u062a\u062c\u0627\u0647 \u0647\u0630\u0627 \u0627\u0644\u0646\u0627\u062f\u064a. \u064a\u0645\u062a\u0644\u0643 \u062a\u0634\u0644\u0633\u064a \u062a\u0642\u0627\u0644\u064a\u062f \u0639\u0631\u064a\u0642\u0629 \u0641\u064a \u0627\u0644\u0641\u0648\u0632 \u0648\u0637\u0645\u0648\u062d\u0627\u062a \u0643\u0628\u064a\u0631\u0629 \u0644\u0644\u0645\u0633\u062a\u0642\u0628\u0644\".<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641 \"\u0644\u062f\u064a\u0651 \u0639\u0644\u0627\u0642\u0629 \u062c\u064a\u062f\u0629 \u062c\u062f\u0627 \u0645\u0639 \u0627\u0644\u062c\u0645\u064a\u0639 \u0647\u0646\u0627 \u0641\u064a \u0627\u0644\u0646\u0627\u062f\u064a\u060c \u0648\u0642\u062f \u0634\u0639\u0631\u062a \u0628\u0627\u0654\u0646\u0646\u064a \u0641\u064a \u0645\u0646\u0632\u0644\u064a \u0647\u0646\u0627 \u0641\u064a \u0644\u0646\u062f\u0646 \u0645\u0646\u0630 \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u062a\u064a \u0627\u0646\u0636\u0645\u0645\u062a \u0641\u064a\u0647\u0627\".<br /><br />\u0648\u0643\u0627\u0646 \u0628\u064a\u062f\u0631\u0648 \u0627\u0644\u0630\u064a \u0627\u0633\u062a\u064f\u0628\u0639\u062f \u0628\u0634\u0643\u0644 \u0645\u0641\u0627\u062c\u064a\u0654 \u0645\u0646 \u062a\u0634\u0643\u064a\u0644\u0629 \u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a \u0643\u0627\u0654\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 \u0647\u0630\u0627 \u0627\u0644\u0639\u0627\u0645\u060c \u0645\u062d\u0637 \u0627\u0647\u062a\u0645\u0627\u0645 \u0628\u0631\u0634\u0644\u0648\u0646\u0629 \u0627\u0644\u0627\u0655\u0633\u0628\u0627\u0646\u064a \u0628\u062d\u0633\u0628 \u062a\u0642\u0627\u0631\u064a\u0631.<br /><br />\u0648\u064a\u0641\u062a\u062a\u062d \u062a\u0634\u0644\u0633\u064a\u060c \u0628\u0642\u064a\u0627\u062f\u0629 \u0645\u062f\u0631\u0628\u0647 \u0627\u0644\u062c\u062f\u064a\u062f \u0627\u0644\u0627\u0655\u0633\u0628\u0627\u0646\u064a \u0634\u0627\u0628\u064a \u0627\u0654\u0644\u0648\u0646\u0633\u0648\u060c \u0645\u0634\u0648\u0627\u0631\u0647 \u0641\u064a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0627\u0655\u0646\u0643\u0644\u064a\u0632\u064a \u0628\u0645\u0648\u0627\u062c\u0647\u0629 \u062e\u0627\u0631\u062c \u0627\u0654\u0631\u0636\u0647 \u0627\u0654\u0645\u0627\u0645 \u062c\u0627\u0631\u0647 \u0627\u0644\u0644\u0646\u062f\u0646\u064a \u0641\u0648\u0644\u0647\u0627\u0645 \u0627\u0644\u0627\u0655\u062b\u0646\u064a\u0646.<br /><br /><br />", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u064a\u0628\u0642\u0649", "\u0641\u064a", "\u062d\u062a\u0649", "\u0628\u064a\u062f\u0631\u0648", "\u062a\u0634\u064a\u0644\u0633\u064a", "2032", "\u0635\u0641\u0648\u0641"], "creator": ["\u0627\u0644\u064a\u0648\u0645- \u0644\u0646\u062f\u0646"], "language": "arabic", "country": ["saudi arabia"], "category": ["sports"], "datatype": "news", "pubDate": "2026-08-22 16:42:00", "pubDateTZ": "UTC", "fetched_at": "2026-08-22 16:49:25", "image_url": "https://www.alyaum.com/uploads/images/2026/08/22/3093488.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://n.bytvi.com/alyaum.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE