u0627\u0647 \u0648\u0627\u0644\u0632\u0631\u0627\u0639\u0629\u060c \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0645) \u0648\u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u063a\u0630\u0627\u0621 \u0648\u0627\u0644\u062f\u0648\u0627\u0621\u060c \u0648\u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u061b \u0628\u0647\u062f\u0641 \u0631\u0641\u0639 \u0627\u0644\u0648\u0639\u064a \u0627\u0644\u063a\u0630\u0627\u064a\u0654\u064a \u0644\u062f\u0649 \u0627\u0654\u0641\u0631\u0627\u062f \u0627\u0644\u0645\u062c\u062a\u0645\u0639\u060c \u0648\u062a\u0645\u0643\u064a\u0646\u0647\u0645 \u0645\u0646 \u0627\u062a\u062e\u0627\u0630 \u062e\u064a\u0627\u0631\u0627\u062a \u063a\u0630\u0627\u064a\u0654\u064a\u0629 \u0627\u0654\u0643\u062b\u0631 \u0648\u0639\u064a\u0627\u064b \u0648\u062a\u0648\u0627\u0632\u0646\u0627\u064b\u060c \u0628\u0645\u0627 \u064a\u062f\u0639\u0645 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0648\u0642\u0627\u064a\u0654\u064a\u0629\u060c \u0648\u064a\u062d\u0633\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u062d\u064a\u0627\u0629.\u0641\u064a \u0633\u064a\u0627\u0642 \u0645\u062a\u0635\u0644\u060c \u062a\u0631\u0643\u0632 \u0627\u0644\u062d\u0645\u0644\u0629 \u0639\u0644\u0649 \u0645\u0645\u0627\u0631\u0633\u0627\u062a \u063a\u0630\u0627\u064a\u0654\u064a\u0629 \u064a\u0648\u0645\u064a\u0629\u060c \u0645\u062b\u0644 \u0627\u0644\u062a\u0648\u0639\u064a\u0629 \u0628\u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u062a\u0648\u0627\u0632\u0646 \u0644\u0644\u0633\u0643\u0631\u060c \u0648\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0633\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0645\u0636\u0627\u0641\u0629 \u0641\u064a \u0627\u0644\u0627\u0654\u063a\u0630\u064a\u0629 \u0648\u0627\u0644\u0645\u0634\u0631\u0648\u0628\u0627\u062a\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u062a\u0639\u0632\u064a\u0632 \u0627\u0654\u0647\