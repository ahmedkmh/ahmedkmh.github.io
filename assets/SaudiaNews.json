B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B6%D9%8A%D9%88%D9%81-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC-%D8%AE%D8%A7%D8%AF%D9%85-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%8A%D8%AB%D9%85%D9%86%D9%88%D9%86-%D8%B9%D9%86%D8%A7%D9%8A%D8%A9-%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A8%D8%B6%D9%8A%D9%88%D9%81-%D8%A7%D9%84%D8%B1%D8%AD%D9%85%D9%86\" target=\"_blank\">\u0636\u064a\u0648\u0641 \u0627\u0644\u0631\u062d\u0645\u0646</a> \u0648\u0627\u0644\u0645\u062c\u0627\u0648\u0631\u064a\u0646\u060c \u0628\u0634\u0631\u0627\u0643\u0629 \u0635\u062d\u064a\u0629 \u0648\u0645\u062c\u062a\u0645\u0639\u064a\u0629 \u0645\u0646 <a href=\"https://www.alyaum.com/articles/6676900/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%88%D9%84%D9%8A-%D8%A7%D9%84%D8%B9%D9%87%D8%AF-%D9%8A%D9%84%D8%AA%D9%82%D9%8A-%D8%B1%D8%A6%D9%8A%D8%B3-%D9%88%D8%B2%D8%B1%D8%A7%D8%A1-%D8%A8%D8%A7%D9%83%D8%B3%D8%AA%D8%A7%D9%86-%D9%81%D9%8A-%D9%85%D9%83%D8%A9-%D8%A7%D9%84%D9%85%D9%83%D8%B1%D9%85%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85\" target=\"_blank\">\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629</a>\u061b \u0628\u0647\u062f\u0641 \u0639\u0644\u0627\u062c \u0648\u0627\u0655\u062c\u0631\u0627\u0621 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0628\u064a\u0636\u0627\u0621\u060c \u0648\u062a\u062d\u0633\u064a\u0646 \u062c\u0648\u062f\u0629 \u062d\u064a\u0627\u0629 \u0627\u0644\u0645\u0633\u062a\u0641\u064a\u062f\u064a\u0646\u060c \u0648\u0628\u0646\u0627\u0621 \u0646\u0645\u0648\u0630\u062c \u0645\u062a\u0643\u0627\u0645\u0644 \u064a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0648\u0627\u0644\u0627\u0654\u062b\u0631 \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a.<br /><br />\u062a\u0645\u062a \u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0629 \u0628\u0634\u0631\u0627\u0643\u0629 \u0645\u062c\u062a\u0645\u0639\u064a\u0629 \u0646\u0648\u0639\u064a\u0629 \u062a\u062c\u0645\u0639 <a href=\"https://www.alyaum.com/articles/6675397/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%BA%D9%8A%D8%B1-%D8%A7%D9%84%D8%B1%D8%A8%D8%AD%D9%8A-%D9%8A%D8%B5%D8%AF%D8%B1-%D8%A5%D8%AF%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D9%85%D8%B9%D8%B1%D9%81%D8%A9-%D9%84%D8%AD%D9%85%D8%A7%D9%8A%D8%A9-%D8%A7%D9%84%D8%AE%D8%A8%D8%B1%D8%A7%D8%AA-%D9%88%D8%AA%D8%B9%D8%B2%D9%8A%D8%B2-%D8%A7%D9%84%D8%AD%D9%88%D9%83%D9%85%D8%A9-%D9%88%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%AF%D8%A7%D9%85%D8%A9\" target=\"_blank\">\u0627\u0644\u0642\u0637\u0627\u0639 \u063a\u064a\u0631 \u0627\u0644\u0631\u0628\u062d\u064a </a>\u0645\u0639 \u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u062d\u0643\u0648\u0645\u064a \u0648\u0627\u0644\u0642\u0637\u0627\u0639 \u0648\u0627\u0644\u062e\u0627\u0635\u060c \u0648\u0630\u0644\u0643 \u0628\u0645\u0642\u0631 \u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u062d\u0627\u062c \u0648\u0627\u0644\u0645\u0639\u062a\u0645\u0631 \u0641\u064a \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629\u060c \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u0645\u0639 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0644\u0627\u0654\u0637\u0628\u0627\u0621 \u0627\u0644\u0639\u064a\u0648\u0646.<h2>\u0631\u0648\u0654\u064a\u0629 \u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0629</h2><br />\u0634\u0647\u062f \u062d\u0641\u0644 \u0627\u0644\u062a\u062f\u0634\u064a\u0646 \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0628\u0631\u0648\u0654\u064a\u0629 \u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0629 \u0648\u0645\u0633\u062a\u0647\u062f\u0641\u0647\u0627 \u0627\u0644\u0646\u0647\u0627\u064a\u0654\u064a \u0627\u0644\u0628\u0627\u0644\u063a 1000 \u0645\u0633\u062a\u0641\u064a\u062f\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u