u0627\u0655\u0637\u0627\u0631 \u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u0645\u0633\u062a\u0645\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0628\u0630\u0644\u0647\u0627 \u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0632\u0643\u0627\u0629 \u0648\u0627\u0644\u0636\u0631\u064a\u0628\u0629 \u0648\u0627\u0644\u062c\u0645\u0627\u0631\u0643 (\u0632\u0627\u062a\u0643\u0627) \u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0627\u0654\u0645\u0646\u064a \u0648\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0645\u0646 \u0627\u0644\u0645\u0645\u0646\u0648\u0639\u0627\u062a \u0628\u0645\u062e\u062a\u0644\u0641 \u0627\u0654\u0646\u0648\u0627\u0639\u0647\u0627 \u0648\u0627\u0654\u0634\u0643\u0627\u0644\u0647\u0627.\u0648\u0634\u0645\u0644\u062a \u0627\u0644\u0627\u0654\u0635\u0646\u0627\u0641 \u0627\u0644\u0645\u0636\u0628\u0648\u0637\u0629 58 \u0635\u0646\u0641\u064b\u0627 \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0645\u062e\u062f\u0631\u0629\u060c \u0645\u062b\u0644 \u0627\u0644\u062d\u0634\u064a\u0634\u060c \u0627\u0644\u0643\u0648\u0643\u0627\u064a\u064a\u0646\u060c \u0627\u0644\u0647\u064a\u0631\u0648\u064a\u0646\u060c \u0627\u0644\u0634\u0628\u0648\u060c \u062d\u0628\u0648\u0628 \u0627\u0644\u0643\u0628\u062a\u0627\u062c\u0648\u0646 \u0648\u063a\u064a\u0631\u0647\u0627\u060c \u0627\u0655\u0636\u0627\u0641\u0629\u064b \u0627\u0655\u0644\u0649 212 \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0645\u062d\u0638\u0648\u0631\u0629\u060c \u0648\u0634\u0647\u062f\u062a \u0627\u0644\u0645\u0646\u0627\u0641\u0630 \u0627\u0644\u062c\u0645\u0631\u0643\u064a\u0629 \u0627\u0655\u062d\u0628\u0627\u0637 850 \u0645\u0646 \u0627\u0644\u062a\u0628\u063a \u0648\u0645\u0634\u062a\u0642\u0627\u062a\u0647\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 14 \u0635\u0646\u0641\u064b\u0627 \u0644\u0645\u0628\u0627\u0644\u063a \u0645\u0627\u0644\u064a\u0629\u060c \u06483 \u0627\u065