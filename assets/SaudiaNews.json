%D8%AB", "title": "\u0627\u0631\u062a\u0641\u0627\u0639 \u0623\u0631\u0628\u0627\u062d \u00ab\u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0639\u0631\u0628\u064a\u00bb 1.7% \u0625\u0644\u0649 1.58 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 \u0628\u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b", "description": "\u062d\u0642\u0642 \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0639\u0631\u0628\u064a \u0627\u0644\u0648\u0637\u0646\u064a \u0635\u0627\u0641\u064a \u0631\u0628\u062d \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0644\u062b \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 2026 \u0628\u0644\u063a 1.58 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0640 1.55 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u0646\u0633\u0628\u062a\u0647 1.7%. \u0648\u0628\u062d\u0633\u0628 \u0628\u064a\u0627\u0646 \u0644\u0644\u0628\u0646\u0643 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\"\u060c \u064a\u0639\u0632\u0649 \u0647\u0630\u0627 \u0628\u0634\u0643\u0644 \u0631\u0626\u064a\u0633\u064a \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0639\u0645\u0648\u0644\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629\u060c \u0635\u0627\u0641\u064a \u0623\u0631\u0628\u0627\u062d \u062a\u062d\u0648\u064a\u0644 \u0639\u0645\u0644\u0627\u062a \u0623\u062c\u0646\u0628\u064a\u0629 \u0648\u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0645\u062a\u0627\u062c\u0631\u0629. \u0645\u0639 \u0627\u0644\u0625\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0648\u0625\u0637\u0641\u0627\u0621 \u0648\u0645\u0635\u0627\u0631\u064a\u0641 \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0645\u0628\u0627\u0646\u064a. \u0648\u0642\u0627\u0628\u0644 \u0630\u0644\u0643 \u0627\u0631\u062a\u0641\u0627\u0639 \u0641\u064a \u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641 \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0639\u062f\u0645 \u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u0623\u062b\u0631 \u0627\u0644\u0645\u0633\u062c\u0644 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0645\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u0639\u0643\u0633 \u0641\u064a \u0645\u062e\u0635\u0635 \u0627\u0646\u062e\u0641\u0627\u0636 \u0642\u064a\u0645\u0629 \u0639\u0642\u0627\u0631\u0627\u062a \u0623\u062e\u0631\u0649 \u0645\u0645\u0644\u0648\u0643\u0629\u060c \u0648\u0645\u0635\u0627\u0631\u064a\u0641 \u0639\u0645\u0648\u0645\u064a\u0629 \u0648\u0625\u062f\u0627\u0631\u064a\u0629 \u0623\u062e\u0631\u0649\u060c \u0648\u0635\u0627\u0641\u064a \u0645\u062e\u0635\u0635 \u062e\u0633\u0627\u0626\u0631 \u0627\u0626\u062a\u0645\u0627\u0646 \u0645\u062a\u0648\u0642\u0639\u0629 \u0648\u0645\u062e\u0635\u0635\u0627\u062a \u0623\u062e\u0631\u0649\u060c \u0648\u0631\u0648\u0627\u062a\u0628 \u0648\u0645\u0635\u0627\u0631\u064a\u0641 \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646. \u0648\u0623\u0648\u0636\u062d \u0627\u0644\u0628\u0646\u0643 \u0623\u0646\u0647 \u0633\u062c\u0644 \u0627\u0646\u062e\u0641\u0627\u0636\u064b\u0627 \u0645\u0646 \u0646\u0627\u062d\u064a\u0629 \u0623\u062e\u0631\u0649 \u0641\u064a \u0635\u0627\u0641\u064a \u0645\u0643\u0627\u0633\u0628/ (\u062e\u0633\u0627\u0626\u0631) \u0645\u0646 \u0623\u062f\u0648\u0627\u062a \u0645\u0627\u0644\u064a\u0629 \u0645\u062f\u0631\u062c\u0629 \u0642\u064a\u0645\u062a\u0647\u0627 \u0627\u0644\u0639\u0627\u062f\u0644\u0629 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062f\u062e\u0644\u060c \u0635\u0627\u0641\u064a \u0627\u0644\u0623\u062a\u0639\u0627\u0628 \u0648\u0627\u0644\u0639\u0645\u0648\u0644\u0627\u062a\u060c \u062a\u0648\u0632\u064a\u0639\u0627\u062a \u0623\u0631\u0628\u0627\u062d\u060c \u0635\u0627\u0641\u064a \u0645\u0643\u0627\u0633\u0628/ (\u062e\u0633\u0627\u0626\u0631) \u0645\u0646 \u0628\u064a\u0639 \u0627\u0633\u062a\u062b\u0645\u0627\u0631\u0627\u062a \u0645\u0642\u062a\u0646\u0627\u0629 \u0644\u063a\u064a\u0631 \u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u0645\u062a\u0627\u062c\u0631\u0629 \u0648\u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649. \u0623\u0631\u0628\u0627\u062d \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0639\u0631\u0628\u064a \u0627\u0644\u0648\u0637\u0646\u064a \u0641\u064a 9 \u0623\u0634\u0647\u0631 \u0648\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0641\u064a 30 \u0633\u0628\u062a\u0645\u0628\u0631 2026 (9 \u0623\u0634\u0647\u0631)\u060c \u0627\u0631\u062a\u0641\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0628\u0646\u0633\u0628\u0629 4% \u0625\u0644\u0649 4.13 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 \u0648\u0627\u0644\u062a\u064a \u0628\u0644\u063a \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0641\u064a\u0647\u0627 3.97 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644. \u0648\u064a\u0639\u0632\u0649 \u0647\u0630\u0627 \u0628\u0634\u0643\u0644 \u0631\u0626\u064a\u0633\u064a \u0627\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0639\u0645\u0648\u0644\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629\u060c \u0635\u0627\u0641\u064a \u0645\u0643\u0627\u0633\u0628/ (\u062e\u0633\u0627\u0626\u0631) \u0645\u0646 \u0628\u064a\u0639 \u0627\u0633\u062a\u062b\u0645\u0627\u0631\u0627\u062a \u0645\u0642\u062a\u0646\u0627\u0629 \u0644\u063a\u064a\u0631 \u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u0645\u062a\u0627\u062c\u0631\u0629\u060c \u0635\u0627\u0641\u064a \u0623\u0631\u0628\u0627\u062d \u062a\u062d\u0648\u064a\u0644 \u0639\u0645\u0644\u0627\u062a \u0623\u062c\u0646\u0628\u064a\u0629\u060c \u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0648\u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u0645\u062a\u0627\u062c\u0631\u0629. \u0645\u0639 \u0627\u0644\u0625\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u0635\u0627\u0641\u064a \u0645\u062e\u0635\u0635 \u062e\u0633\u0627\u0626\u0631 \u0627\u0626\u062a\u0645\u0627\u0646 \u0645\u062a\u0648\u0642\u0639\u0629 \u0648\u0645\u062e\u0635\u0635\u0627\u062a \u0623\u062e\u0631\u0649.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0625\u0644\u0649", "\u0628\u0627\u0644\u0631\u0628\u0639", "\u0631\u064a\u0627\u0644", "\u0627\u0644\u0639\u0631\u0628\u064a\u00bb", "\u0645\u0644\u064a\u0627\u0631", "\u00ab\u0627\u0644\u0628\u0646\u0643", "\u0627\u0631\u062a\u0641\u0627\u0639", "1.7%", "\u0623\u0631\u0628\u0627\u062d", "\u0627\u0644\u062b\u0627\u0644\u062b", "1.58"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["business"], "datatype": "news", "pubDate": "2026-10-21 06:21:00", "pubDateTZ": "UTC", "fetched_at": "2026-10-21 13:49:23", "image_url": "https://www.alyaum.com/uploads/images/2026/10/21/3163632.png", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://i.newsdata.io/alyaum.png", "sentiment": "positive", "sentiment_stats": {"negative": 0.02, "neutral": 2.43, "positive": 97.55}, "ai_tag": ["banking and finance", "financial markets"], "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}], "nextPage": "1792563660617538005"}