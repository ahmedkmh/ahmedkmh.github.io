2a\u064a\u0646\u060c \u0627\u0644\u0623\u0648\u0644\u0649 1996\u060c \u0648\u0627\u0644\u062b\u0627\u0646\u064a\u0629 2005. \u0648\u062d\u0633\u0628 \u0645\u0648\u0642\u0639 \u0645\u0624\u0633\u0633\u0629 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u00abRSSSF\u00bb \u0634\u0645\u0644\u062a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0634\u062d\u064a\u0646 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0644\u0646\u0633\u062e\u0629 1996 \u0627\u0633\u0645\u064a\u0651 \u064a\u0648\u0633\u0641 \u0627\u0644\u062b\u0646\u064a\u0627\u0646 \u0648\u0645\u062d\u0645\u062f \u0627\u0644\u062f\u0639\u064a\u0639\u060c \u062b\u0646\u0627\u0626\u064a \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u064a\u0646 \u062e\u062f\u0627\u062f\u0627\u062f \u0639\u0632\u064a\u0632\u064a \u0648\u0639\u0644\u064a \u062f\u0627\u0626\u064a\u060c \u0648\u0627\u0644\u0643\u0648\u0631\u064a \u0627\u0644\u062c\u0646\u0648\u0628\u064a \u0643\u0648 \u062c\u064a\u0648\u0646\u062c \u0648\u0648\u0646. \u0648\u0627\u0643\u062a\u0633\u0628\u062a \u062a\u0644\u0643 \u0627\u0644\u062a\u0631\u0634\u064a\u062d\u0627\u062a \u0633\u064a\u0627\u0642\u0647\u0627 \u0645\u0646 \u0646\u062a\u0627\u0626\u062c \u0643\u0623\u0633 \u0622\u0633\u064a\u0627\u060c \u0627\u0644\u062a\u064a \u062d\u0635\u0644 \u0639\u0644\u064a\u0647\u0627 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0648\u0634\u0647\u062f\u062a \u0641\u0648\u0632\u0647 \u0641\u064a \u0646\u0635\u0641 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0639\u0644\u0649 \u0625\u064a\u0631\u0627\u0646\u060c \u0627\u0644\u062a\u064a \u0647\u0632\u0645\u062a \u0643\u0648\u0631\u064a\u0627 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 \u0636\u0645\u0646 \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u062f\u0648\u0631 \u0627\u0644