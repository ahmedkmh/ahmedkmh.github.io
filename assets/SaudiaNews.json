\u0633 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u062e\u0644\u064a\u062c\u064a \u0645\u0646 \u0645\u062e\u0627\u0637\u0631 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u062c\u0627\u0626\u0631 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629.\u0648\u0623\u0634\u0627\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u0634\u0628\u0627\u0628 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u062a\u062e\u062f\u0645\u0648\u0646\u0647\u0627 \u0623\u0643\u062b\u0631 \u0639\u0631\u0636\u0629 \u0628\u0646\u062d\u0648 \u062b\u0644\u0627\u062b\u0629 \u0623\u0636\u0639\u0627\u0641 \u0644\u062a\u062f\u062e\u064a\u0646 \u0627\u0644\u0633\u062c\u0627\u0626\u0631 \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629 \u0644\u0627\u062d\u0642\u0627\u064b\u060c \u0648\u0641\u0642\u0627\u064b \u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629\u060c \u0627\u0644\u062a\u064a \u0642\u062f\u0651\u0631\u062a \u0641\u064a \u062a\u0642\u0631\u064a\u0631 \u0635\u062f\u0631 \u0639\u0627\u0645 2024 \u0639\u062f\u062f \u0645\u0633\u062a\u062e\u062f\u0645\u064a \u0627\u0644\u062a\u0628\u063a \u0639\u0627\u0644\u0645\u064a\u0627\u064b \u0645\u0646 \u0627\u0644\u0641\u0626\u0629 \u0627\u0644\u0639\u0645\u0631\u064a\u0629 13\u201315 \u0639\u0627\u0645\u0627\u064b \u0628\u0646\u062d\u0648 37 \u0645\u0644\u064a\u0648\u0646\u0627\u064b.\u0648\u064a\u0648\u0627\u0635\u0644 \u0627\u0644\u0645\u062c\u0644\u0633 \u062d\u0645\u0644\u062a\u0647 \u0627\u0644\u062a\u0648\u0639\u0648\u064a\u0629 (\u0627\u0644\u064a\u0648\u0645 \u0642\u0628\u0644 \u0628\u0643\u0631\u0629) \u0625\u0635\u062f\u0627\u0631 \u062f\u0644\u064a\u0644 \u062a\u0648\u0639\u0648\u064a \u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0634\u0628\u0627\u0628 \u0641\u064a \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0645\u0646 \u0631\u0641\u0636 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u062a\u062f\u062e\u064a\u0646 \u063a\u064a\u0631 \u0627\u0644\u062a\u0642\u0644\u064a\u062f\u064a\u0629\u060c \u0648\u062a\u0639\u0632\u064a\u0632 \u0642\u062f\u0631\u062a\u0647\u0645 \u0639\u0644\u0649 \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0636\u063a\u0648\u0637 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0648\u0627\u062a\u062e\u0627\u0630 \u0642\u0631\u0627\u0631\u0627\u062a \u0635\u062d\u064a\u0629 \u0648\u0627\u0639\u064a\u0629. \u0648\u064a\u0648\u0636\u062d \u0627\u0644\u062f\u0644\u064a\u0644 \u0623\u0646 \u0647\u0630\u0647 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0644\u064a\u0633\u062a \u0622\u0645\u0646\u0629\u060c \u0645\u0633\u0644\u0637\u0627\u064b \u0627\u0644\u0636\u0648\u0621 \u0639\u0644\u0649 \u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0646\u064a\u0643\u0648\u062a\u064a\u0646 \u0641\u064a \u0646\u0645\u0648 \u0627\u0644\u062f\u0645\u0627\u063a \u0648\u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647 \u0648\u0627\u0644\u062a\u0639\u0644\u0645 \u0648\u0627\u0644\u0645\u0632\u0627\u062c \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0627\u0646\u062f\u0641\u0627\u0639\u0627\u062a \u062d\u062a\u0649 \u0633\u0646 25 \u0639\u0627\u0645\u0627\u064b\u060c \u0641\u0636\u0644\u0627\u064b \u0639\u0646 \u0627\u0631\u062a\u0628\u0627\u0637 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u062c\u0627\u0626\u0631 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0628\u0623\u0639\u0631\u0627\u0636 \u0627\u0644\u0642\u0644\u0642 \u0648\u0627\u0644\u0627\u0643\u062a\u0626\u0627\u0628\u060c \u0648\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0633\u0627\u0645\u0629 \u0648\u0627\u0644\u0645\u0633\u0631\u0637\u0646\u0629. \u0643\u0645\u0627 \u064a\u0633\u062a\u0639\u0631\u0636 \u0622\u062b\u0627\u0631 \u0627\u0644\u062a\u0