%D9%8A%D8%A9-%D9%88%D8%AF%D8%B1%D8%AC%D8%A7%D8%AA-%D8%A7%D9%84%D8%AD%D8%B1%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D9%85%D8%B1%D8%AA%D9%81%D8%B9%D8%A9\" target=\"_blank\">\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0642\u0633</a> \u0645\u0646 <a href=\"https://www.alyaum.com/articles/6678542/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%AD%D8%AA%D9%89-%D8%A7%D9%84-5-%D9%85%D8%B3%D8%A7%D8%A1-%D9%85%D9%88%D8%AC%D8%A9-%D8%AD%D8%A7%D8%B1%D8%A9-%D8%A8%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%AA%D8%B5%D9%84-%D9%84-48-%D9%85%D8%A6%D9%88%D9%8A%D8%A9\" target=\"_blank\">\u0645\u0648\u062c\u0629 \u062d\u0627\u0631\u0629</a> \u0648<a href=\"https://www.alyaum.com/articles/6678563/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%A3%D8%B1%D8%B5%D8%A7%D8%AF-%D8%B1%D9%8A%D8%A7%D8%AD-%D9%86%D8%B4%D8%B7%D8%A9-%D8%AA%D8%B4%D9%85%D9%84-%D8%A7%D9%84%D9%85%D9%86%D8%A7%D8%B7%D9%82-%D8%A7%D9%84%D9%85%D9%81%D8%AA%D9%88%D8%AD%D8%A9-%D8%B9%D9%84%D9%89-%D9%85%D9%86%D8%B7%D9%82%D8%AA%D9%8A-%D8%AA%D8%A8%D9%88%D9%83-%D9%88%D8%AD%D8%A7%D8%A6%D9%84\" target=\"_blank\">\u0631\u064a\u0627\u062d</a> \u0646\u0634\u0637\u0629 \u0648<a href=\"https://www.alyaum.com/articles/6678529/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%A3%D9%85%D8%A7%D9%83%D9%86-%D9%88%D8%A7%D9%84%D9%85%D9%88%D8%A7%D8%B9%D9%8A%D8%AF-%D9%85%D9%88%D8%AC%D8%A9-%D8%AD%D8%A7%D8%B1%D8%A9-%D9%88%D8%A3%D8%AA%D8%B1%D8%A8%D8%A9-%D8%B9%D9%84%D9%89-%D9%85%D9%86%D8%B7%D9%82%D8%A9-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6\" target=\"_blank\">\u0627\u0654\u062a\u0631\u0628\u0629</a> \u0645\u062b\u0627\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621.<br />\u062a\u0633\u062a\u0645\u0631 \u0627\u0644\u0645\u0648\u062c\u0629 \u0627\u0644\u062d\u0627\u0631\u0629 6 \u0633\u0627\u0639\u0627\u062a \u0645\u0646 11 \u0635\u0628\u0627\u062d\u064b\u0627 \u062d\u062a\u0649 5 \u0645\u0633\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0627\u0654\u062d\u0633\u0627\u0621 \u0648\u0627\u0644\u0639\u062f\u064a\u062f \u0648\u0628\u0642\u064a\u0642 \u0648\u0627\u0644\u062e\u0641\u062c\u064a.<br />\u0648\u064a\u0635\u0627\u062d\u0628\u0647\u0627: \u0627\u0631\u062a\u0641\u0627\u0639 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0645\u0646 (47 \u2013 48) \u062f\u0631\u062c\u0629 \u0645\u064a\u0654\u0648\u064a\u0629.<h2>\u0631\u064a\u0627\u062d \u0648\u0627\u0654\u062a\u0631\u0628\u0629</h2>\u0628\u064a\u0646\u0645\u0627 \u062a\u0634\u0647\u062f \u0627\u0644\u062c\u0628\u064a\u0644 \u0648\u0627\u0644\u062e\u0628\u0631 \u0648\u0627\u0644\u062f\u0645\u0627\u0645 \u0648\u0627\u0644\u0642\u0637\u064a\u0641 \u0648\u0631\u0627\u0654\u0633 \u062a\u0646\u0648\u0631\u0629 \u0631\u064a\u0627\u062d\u064b\u0627 \u0646\u0634\u0637\u0629\u060c \u0645\u0646 9 \u0635\u0628\u0627\u062d\u064b\u0627 \u062d\u062a\u0649 7 \u0645\u0633\u0627\u0621.<br />\u0648\u062a\u062a\u0645\u062b\u0644 \u0627\u0644\u062a\u0627\u0654\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629 \u0641\u064a: \u062a\u062f\u0646\u064a \u0645\u062f\u0649 \u0627\u0644\u0631\u0648\u0654\u064a\u0629 \u0627\u0644\u0627\u0654\u0641\u0642\u064a\u0629\u060c \u0648\u0631\u064a\u0627\u062d \u062a\u0635\u0644 \u0633\u0631\u0639\u062a\u0647\u0627 \u0627\u0655\u0644\u0649 (40 \u2013 49) \u0643\u064a\u0644\u0648\u0645\u062a\u0631\u064b\u0627/\u0633\u0627\u0639\u0629.<br />\u0648\u064a\u064f\u062a\u0648\u0642\u0639 \u0627\u0654\u0646 \u062a\u0634\u0647\u062f \u0627\u0654\u062c\u0632\u0627\u0621 \u0645\u0646 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0654\u062a\u0631\u0628\u0629 \u0645\u062b\u0627\u0631\u0629\u060c \u062a\u0628\u062f\u0627\u06