4 \u0639\u0646\u0648\u0627\u0646 \u00ab\u062d\u0628 \u063a\u064a\u0631 \u0645\u0634\u0631\u0648\u0637\u00bb (Unconditional Love)\u060c \u0644\u062a\u062a\u062d\u0648\u0644 \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u0628\u0633\u064a\u0637\u0629 \u0625\u0644\u0649 \u062d\u0648\u0627\u0631 \u0645\u0641\u062a\u0648\u062d \u0648\u0635\u0631\u064a\u062d\u060c \u0645\u0627\u0632\u062d\u062a \u0641\u064a\u0647 \u0627\u0644\u0646\u062c\u0645\u0629 \u0627\u0644\u062d\u0636\u0648\u0631 \u0642\u0627\u0626\u0644\u0629 \u0628\u0639\u0641\u0648\u064a\u062a\u0647\u0627 \u0627\u0644\u0645\u0639\u0647\u0648\u062f\u0629: \u00ab\u0646\u0627\u0642\u0635\u0646\u064a \u0634\u0648\u064a\u0651\u0629 \u062d\u0628\u0651\u00bb.\u0648\u0641\u064a \u0631\u062f\u0647\u0627 \u0639\u0644\u0649 \u0633\u0624\u0627\u0644 \u062d\u0648\u0644 \u0645\u062f\u0649 \u062a\u0637\u0627\u0628\u0642 \u0635\u0648\u0631\u062a\u0647\u0627 \u0627\u0644\u0625\u0639\u0644\u0627\u0645\u064a\u0629 \u0645\u0639 \u0634\u062e\u0635\u064a\u062a\u0647\u0627 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629\u060c \u0643\u0634\u0641\u062a \u0645\u0627\u064a\u0627 \u062f\u064a\u0627\u0628 \u0645\u0641\u0627\u062c\u0623\u0629 \u0644\u0644\u062c\u0645\u0647\u0648\u0631 \u0628\u0642\u0648\u0644\u0647\u0627: \u00ab\u0623\u0646\u0627 \u062c\u0631\u064a\u0626\u0629 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0645\u0648\u0627\u0642\u0641\u060c \u0644\u0643\u0646\u0646\u064a \u0644\u0633\u062a \u0643\u0630\u0644\u0643 \u0641\u064a \u0645\u0648\u0627\u0642\u0641 \u0623\u062e\u0631\u0649 \u0643\u062b\u064a\u0631\u0629. \u0623\u062d\u064a\u0627\u0646\u0627\u064b \u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u062e\u062c\u0644\u060c \u0648\u0623\u062c\u062f \u0635\u0639\u0648\u0628\u0629 \u0641\u064a \u0642\u0648\u0644 \u0645\u0627 \u0623\u0631\u064a\u062f \u0642\u0648\u0644\u0647\u060c \u0648\u0642\u062f \u0623\u0641\u0643\u0651\u0631 \u0641\u064a \u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0639\u0646 \u0623\u0645\u0631 \u0645\u0627\u060c \u0644\u0643\u0646\u0646\u064a \u0644\u0627 \u0623\u0642\u0648\u0644\u0647 \u0641\u064a \u0627\u0644\u0646\u0647\u0627\u064a\u0629. \u0644\u0630\u0644\u0643\u060c \u0623\u0646\u0627 \u0644\u0633\u062a \u062c\u0631\u064a\u0626\u0629 \u062f\u0627\u0626\u0645\u0627\u064b\u060c \u0643\u0645\u0627 \u0642\u062f \u064a\u0639\u062a\u0642\u062f \u0627\u0644\u0628\u0639\u0636\u00bb.\u0648\u0639\u0646 \u0646\u0638\u0631\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u0639\u0631\u0628\u064a \u0644\u062c\u0631\u0623\u0629 \u0627\u0644\u0645\u0631\u0623\u0629\u060c \u0627\u0639\u062a\u0628\u0631\u062a \u0645\u0627\u064a\u0627 \u0623\u0646 \u0627\u0644\u0645\u0631\u0623\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0644\u0627 \u062a\u0632\u0627\u0644 \u062a\u062f\u0641\u0639 \u062b\u0645\u0646\u0627\u064b \u0628\u0627\u0647\u0638\u0627\u064b \u0644\u062c\u0631\u0623\u062a\u0647\u0627\u060c \u0645\u0631\u062c\u0639\u0629 \u0630\u0644\u0643 \u0625\u0644\u0649 \u0645\u062c\u062a\u0645\u0639\u0627\u062a \u0644\u0627 \u062a\u0632\u0627\u0644 \u062a\u062d\u0643\u0645 \u0639\u0644\u0649 \u0627\u0644\u0645\u0631\u0623\u0629 \u0645\u0646 \u0634\u0643\u0644\u0647\u0627 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u060c \u0648\u0648\u0635\u0641\u062a \u0647\u0630\u0627 \u0627\u0644\u0648\u0627\u0642\u0639 \u0628\u0640\u00ab\u0627\u0644\u0622\u0641\u0629 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u0629\u00bb \u0627\u0644\u062a\u064a \u062a\u062d\u062f\u0651 \u0645\u0646 \u062d\u0631\u064a\u062a\u0647\u0627 \u0648\u0631\u0627\u062d\u062a\u0647\u0627 \u0627\u0644\u0646\u0641\u0633\u064a\u0629. \u0623\u0645\u0627 \u0639\u0646 \u0625\u0637\u0644\u0627\u0644\u0627\u062a\u0647\u0627 \u0627\u0644\u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u062c\u062f\u0644\u060c \u0641\u0623\u0643\u062f\u062a \u0623\u0646\u0647\u0627 \u0644\u0627 \u062a\u062d\u0645\u0644 \u0623\u0628\u0639\u0627\u062f\u0627\u064b \u0641\u0644\u0633\u0641\u064a\u0629 \u0645\u0639\u0642\u062f\u0629 \u0628\u06