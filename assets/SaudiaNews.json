629 \u0627\u0644\u0642\u062f\u0645\u060c \u0648\u0645\u062f\u0627\u0641\u0639\u0647 \u0627\u0644\u062a\u0631\u0643\u064a \u0645\u0631\u064a\u062d \u062f\u064a\u0645\u064a\u0631\u0627\u0644 \u0639\u0646 \u062d\u0632\u0646\u0647\u0645\u0627 \u0627\u0644\u0628\u0627\u0644\u063a \u0625\u0632\u0627\u0621 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0651\u0636\u062a \u0644\u0647\u0627 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u0623\u0628\u062f\u064a\u0627 \u062a\u0636\u0627\u0645\u0646\u0647\u0645\u0627 \u0645\u0639 \u0623\u0633\u0631 \u0627\u0644\u0636\u062d\u0627\u064a\u0627 \u0648\u0627\u0644\u0645\u0635\u0627\u0628\u064a\u0646. \u0648\u062e\u0644\u0627\u0644 \u0645\u0624\u062a\u0645\u0631 \u0635\u062d\u0627\u0641\u064a\u060c \u0627\u0644\u0623\u062d\u062f \u0641\u064a \u0645\u062f\u064a\u0646\u0629 \u062f\u0628\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\u0629\u060c \u0642\u0627\u0644 \u0628\u0648\u0633\u064a\u062a\u0634: \u00ab\u0623\u0639\u0631\u0628 \u0639\u0646 \u062d\u0632\u0646\u064a \u0627\u0644\u0639\u0645\u064a\u0642 \u0625\u0632\u0627\u0621 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0639\u0631\u0651\u0636\u062a \u0644\u0647\u0627 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u0623\u062a\u0645\u0646\u0649 \u0627\u0644\u0634\u0641\u0627\u0621 \u0627\u0644\u0639\u0627\u062c\u0644 \u0644\u0644\u0645\u0635\u0627\u0628\u064a\u0646\u00bb. \u0648\u0635\u0631\u0651\u062d \u062f\u064a\u0645\u064a\u0631\u0627\u0644 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u064a\u062c\u0644\u0633 \u0628\u062c\u0648\u0627\u0631 \u0645\u062f\u0631\u0650\u0651\u0628\u0647: \u00ab\u0623\u0639\u0631\u0628 \u0639\u0646 \u062a\u0639\u0627\u0637\u0641\u064a \u0645\u0639 \u0623\u0633\u0631 \u0627\u0644\u0636\u062d\u0627\u064a\u0627 \u0627\u0644\u0630\u064a\u0646 \u0633\u0642\u0637\u0648\u0627 \u062c\u0631\u0627\u0621 \u0627\u0644\u0627\u0639\u062a\u062f\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u064a \u0634\u0647\u062f\u062a\u0647\u0627 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u0623\u062a\u0645\u0646\u0649 \u0627\u0644\u0634\u0641\u0627\u0621 \u0627\u0644\u0639\u0627\u062c\u0644 \u0644\u0644\u0645\u0635\u0627\u0628\u064a\u0646\u00bb. \u0648\u0623\u0643\u0645\u0644: \u00ab\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0647\u064a \u0628\u0644\u062f\u064a \u0627\u0644\u062b\u0627\u0646\u064a\u060c \u0648\u0644\u0630\u0644\u0643 \u0623\u0634\u0639\u0631 \u0628\u062d\u0632\u0646 \u0628\u0627\u0644\u063a \u0625\u0632\u0627\u0621 \u0645\u0627 \u062d\u062f\u062b\u060c \u0648\u0623\u062a\u0636\u0627\u0645\u0646 \u0645\u0639 \u0627\u0644\u062c\u0645\u064a\u0639 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0638\u0631\u0648\u0641\u00bb. \u0648\u0639\u0646 \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0648\u0635\u0644 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\u060c \u0627\u0644\u0625\u062b\u0646\u064a\u0646 \u0636\u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u063a\u0631\u0628 \u0645\u0646 \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0622\u0633\u064a\u0627 \u0644\u0644\u0646\u062e\u0628\u0629\u060c \u0648\u0635\u0641 \u0628\u0648\u0633\u064a\u062a\u0634 \u0627\u0644\u0645\u0646\u0627\u0641\u0633 \u0628\u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0642\u0648\u064a\u060c \u062e\u0627\u0635\u0629\u064b \u0639\u0644\u0649 \u0623\u0631\u0636\u0647. \u0648\u062a\u0639\u0647\u0651\u062f \u0628\u0627\u0644\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u0645\u0628\u0627\u0631\u0627\u0629 \u062c\u064a\u062f\u0629 \u0648\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0645\u0631\u062c\u0648\u0651\u0629. \u0648\u0623\u0648\u0636\u062d: \u00ab\u0648\u0635\u0644\u0646\u0627 \u0625\u0644\u0649 \u0647\u0646\u0627 \u0642\u0628\u0644 \u064a\u0648\u0645\u064a\u0646 \u0645\u0646 \u0623\u062c\u0644 \u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u062a\u062d\u0636\u064a\u0631\u0627\u062a\u0646\u0627 \u0644\u0644\u0645\u0648\u0627\u062c\u0647\u0629\u060c \u0648\u0646\u0633\u0639\u0649 \u0625\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062a\u0627\u062d \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0623\u0639\u0644\u0649 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062c\u0627\u0647\u0632\u064a\u0629\u00bb. \u0648\u062a\u0637\u0644\u064e\u0651\u0639 \u0627\u0644\u0647\u0648\u0644\u0646\u062f\u064a \u0625\u0644\u0649 \u0645\u0648\u0627\u0635\u0644\u0629 \u0641\u0631\u064a\u0642\u0647 \u0627\u0644\u0623\u062f\u0627\u0621 \u0627\u0644\u0642\u0648\u064a\u060c \u0628\u0639\u062f \u0627\u0644\u0641\u0648\u0632 4\u06400 \u0639\u0644\u0649 \u0627\u0644\u0641\u062a\u062d\u060c \u0627\u0644\u062c\u0645\u0639\u0629 \u0641\u064a \u0627\u0644\u0623\u062d\u0633\u0627\u0621\u060c \u0636\u0645\u0646 \u062b\u0627\u0645\u0646 \u062c\u0648\u0644\u0627\u062a \u062f\u0648\u0631\u064a \u0631\u0648\u0634\u0646 \u0627\u0644\u0633\u0639\u0648\u062f\u064a. \u0648\u0642\u0627\u0644: \u00ab\u0643\u0644 \u0645\u0628\u0627\u0631\u0627\u0629 \u0644\u0647\u0627 \u0638\u0631\u0648\u0641\u0647\u0627 \u0648\u062d\u0633\u0627\u0628\u0627\u062a\u0647\u0627 \u0627\u0644\u062e\u0627\u0635\u0629\u060c \u0648\u0646\u062d\u0646 \u0646\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0643\u0644 \u0645\u0648\u0627\u062c\u0647\u0629 \u0639\u0644\u0649 \u062d\u062f\u0629\u060c \u0648\u0646\u0641\u0643\u0631 \u062f\u0627\u0626\u0645\u064b\u0627 \u0641\u064a \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0645\u0642\u0628\u0644\u0629\u00bb. \u0648\u062a\u0637\u0631\u0651\u0642 \u0625\u0644\u0649 \u0636\u063a\u0637 \u0627\u0644\u0631\u0648\u0632\u0646\u0627\u0645\u0629\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0625\u0644\u0649 \u062e\u0648\u0636 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0645\u062a\u062a\u0627\u0644\u064a\u0629 \u062e\u0644\u0627\u0644 \u0641\u062a\u0631\u0629 \u0632\u0645\u0646\u064a\u0629 \u0642\u0635\u064a\u0631\u0629. \u0648\u0627\u0633\u062a\u062f\u0631\u0643: \u00ab\u0644\u0643\u0646 \u062a\u0631\u0643\u064a\u0632\u0646\u0627 \u062d\u0627\u0644\u064a\u064b\u0627 \u0645\u0646\u0635\u0628 \u0639\u0644\u0649 \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u063a\u062f \u0623\u0645\u0627\u0645 \u0627\u0644\u0648\u0635\u0644\u060c \u0648\u0646\u0633\u0639\u0649 \u0625\u0644\u0649 \u0623\u0646 \u0646\u0643\u0648\u0646 \u0641\u064a \u0643\u0627\u0645\u0644 \u062c\u0627\u0647\u0632\u064a\u062a\u0646\u0627\u00bb. \u0648\u0623\u0643\u062f \u0627\u0644\u0645\u062f\u0631\u0628 \u0625\u062f\u0631\u0627\u0643\u0647 \u0642\u064a\u0645\u0629 \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0622\u0633\u064a\u0627 \u0644\u0644\u0646\u062e\u0628\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0625\u0644\u0649 \u0646\u0627\u062f\u064a\u0647\u060c \u0628\u0637\u0644 \u0627\u0644\u0646\u0633\u062e\u062a\u064a\u0646 \u0627\u0644\u0645\u0627\u0636\u064a\u062a\u064a\u0646. \u0648\u062a\u0639\u0647\u0651\u062f \u0642\u0627\u0626\u0644\u064b\u0627: \u00ab\u0633\u0646\u0642\u0627\u062a\u0644 \u0628\u0643\u0644 \u0642\u0648\u0629 \u0645\u0646 \u0623\u062c\u0644 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0644\u0642\u0628 \u0648\u0645\u0648\u0627\u0635\u0644\u0629 \u0627\u0644\u0645\u0634\u0648\u0627\u0631 \u0646\u062d\u0648 \u062a\u062d\u0642\u064a\u0642 \u0623\u0647\u062f\u0627\u0641\u0646\u0627\u00bb. \u0628\u062f\u0648\u0631\u0647\u060c \u0642\u0627\u0644 \u062f\u064a\u0645\u064a\u0631\u0627\u0644: \u00ab\u0646\u062d\u0646 \u062c\u0627\u0647\u0632\u0648\u0646 \u0644\u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u063a\u062f\u060c \u0648\u0646\u062f\u062e\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0628\u062b\u0642\u0629 \u0643\u0628\u064a\u0631\u0629 \u0628\u0635\u0641\u062a\u0646\u