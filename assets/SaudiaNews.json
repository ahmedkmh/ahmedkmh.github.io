33\u0643\u0631\u064a\u064a\u0646\u060c \u0648\u0627\u0655\u0644\u062d\u0627\u0642 \u0627\u0654\u0636\u0631\u0627\u0631 \u0628\u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0645\u064a\u0646\u0627\u0621.\u0648\u0642\u0627\u0644 \u063a\u0631\u0648\u0646\u062f\u0628\u0631\u063a \u0641\u064a \u0645\u0646\u0634\u0648\u0631 \u0639\u0644\u0649 \u00ab\u0627\u0655\u0643\u0633\u00bb\u060c \u0627\u0644\u064a\u0648\u0645 (\u0627\u0644\u0627\u0655\u062b\u0646\u064a\u0646)\u060c \u0627\u0655\u0646 \u0647\u0630\u0647 \u0627\u0644\u0647\u062c\u0645\u0627\u062a \u062a\u0627\u0654\u062a\u064a \u0641\u064a \u0638\u0644 \u062a\u0635\u0639\u064a\u062f \u0639\u0633\u0643\u0631\u064a \u063a\u064a\u0631 \u0645\u0633\u0628\u0648\u0642 \u0644\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0645\u0646\u0630 \u0627\u0644\u0647\u062f\u0646\u0629 \u0627\u0644\u062a\u064a \u062a\u0648\u0633\u0637\u062a \u0641\u064a\u0647\u0627 \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0639\u0627\u0645 2022\u060c \u0645\u0627 \u064a\u0632\u064a\u062f \u0628\u0634\u0643\u0644 \u062d\u0627\u062f \u0645\u0646 \u062e\u0637\u0631 \u0639\u0648\u062f\u0629 \u0646\u0632\u0627\u0639 \u0648\u0627\u0633\u0639 \u0627\u0644\u0646\u0637\u0627\u0642 \u0641\u064a \u0627\u0644\u064a\u0645\u0646.\u0648\u0627\u0654\u0643\u062f \u0627\u0654\u0646 \u0647\u062c\u0645\u0627\u062a \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0627\u0644\u0627\u0654\u062e\u064a\u0631\u0629 \u0639\u0631\u0651\u0636\u062a \u0627\u0644\u0645\u062f\u0646\u064a\u064a\u0646 \u0644\u062e\u0637\u0631 \u062c\u0633\u064a\u0645 \u0641\u064a \u0627\u0644\u0645\u062e\u0627 \u0648\u0645\u0627\u0654\u0631\u0628 \u0648\u0645\u0646\u0627\u0637\u0642 \u0627\u0654\u062e\u0631\u0649\u060c \u0645\u0634\u062f\u062f\u0627\u064b \u0639\u0644\u0649 \u0636\u0631\u0648\u0631\u0629 \u0648\u064