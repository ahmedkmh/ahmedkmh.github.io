ription": "<br />\u064a\u062f\u062e\u0644 \u0627\u0644\u0646\u0635\u0631 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u062c\u062f\u064a\u062f \u0648\u0633\u0637 \u062d\u0627\u0644\u0629 \u0645\u0646 \u0627\u0644\u0642\u0644\u0642 \u0628\u0634\u0627\u0654\u0646 \u0627\u0643\u062a\u0645\u0627\u0644 \u0642\u0627\u064a\u0654\u0645\u062a\u0647\u060c \u0628\u0639\u062f\u0645\u0627 \u0627\u0643\u062a\u0641\u0649 \u062d\u062a\u0649 \u0627\u0644\u0627\u0653\u0646 \u0628\u0635\u0641\u0642\u0629 \u0648\u0627\u062d\u062f\u0629 \u062e\u0644\u0627\u0644 \u0641\u062a\u0631\u0629 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0635\u064a\u0641\u064a\u0629\u060c \u0631\u063a\u0645 \u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0627\u0644\u0641\u0631\u064a\u0642 \u0644\u0644\u0645\u0646\u0627\u0641\u0633\u0629 \u0639\u0644\u0649 \u062f\u0648\u0631\u064a \u0631\u0648\u0634\u0646 \u0648\u0643\u0627\u0654\u0633 \u0627\u0644\u0645\u0644\u0643 \u0648\u062f\u0648\u0631\u064a \u0627\u0654\u0628\u0637\u0627\u0644 \u0627\u0653\u0633\u064a\u0627 \u0644\u0644\u0646\u062e\u0628\u0629.<br /><br />\u0648\u062a\u0639\u0627\u0642\u062f \u00ab\u0627\u0644\u0639\u0627\u0644\u0645\u064a\u00bb \u0645\u0639 \u0627\u0644\u0628\u0631\u062a\u063a\u0627\u0644\u064a \u0633\u0627\u0645\u0648 \u0643\u0648\u0633\u062a\u0627 \u0642\u0627\u062f\u0645\u064b\u0627 \u0645\u0646 \u0631\u064a\u0627\u0644 \u0645\u0627\u064a\u0648\u0631\u0643\u0627 \u0627\u0644\u0627\u0655\u0633\u0628\u0627\u0646\u064a\u060c \u0644\u062a\u0639\u0648\u064a\u0636 \u0631\u062d\u064a\u0644 \u0627\u0644\u0643\u0631\u0648\u0627\u062a\u064a \u0645\u0627\u0631\u0633\u064a\u0644\u0648 \u0628\u0631\u0648\u0632\u0648\u0641\u064a\u062a\u0634\u060c \u0641\u064a \u0635\u0641\u0642\u0629 \u0639\u0627\u0644\u062c\u062a \u0627\u0654\u062d\u062f \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0641\u0631\u064a\u0642\u060c \u0644\u0643\u0646\u0647\u0627 \u0644\u0645 \u06