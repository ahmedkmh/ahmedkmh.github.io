34\u0627\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0637\u064a\u0641 \u0627\u0644\u062a\u0648\u062d\u062f", "description": "\u0623\u0643\u062f \u0627\u0644\u0645\u0631\u0634\u062f \u0627\u0644\u0623\u0633\u0631\u064a \u0628\u062c\u0645\u0639\u064a\u0629 \u0623\u0633\u0631 \u0627\u0644\u062a\u0648\u062d\u062f \u0628\u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0642\u0627\u0633\u0645 \u0627\u0644\u0628\u0631\u064a\u0647\u060c \u0623\u0647\u0645\u064a\u0629 \u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0637\u064a\u0641 \u0627\u0644\u062a\u0648\u062d\u062f\u060c \u0645\u0634\u064a\u0631\u0627\u064b \u0625\u0644\u0649 \u0636\u0631\u0648\u0631\u0629 \u0627\u0646\u062a\u0642\u0627\u0644 \u0633\u0648\u0642 \u0627\u0644\u0639\u0645\u0644 \u0645\u0646 \u0645\u0641\u0647\u0648\u0645 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0625\u0644\u0649 \u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0645\u0635\u0627\u0628\u064a\u0646 \u0648\u062f\u0645\u062c\u0647\u0645 \u0644\u062a\u0639\u0632\u064a\u0632 \u0627\u0633\u062a\u0642\u0644\u0627\u0644\u064a\u062a\u0647\u0645. \u0648\u0623\u0648\u0636\u062d \u0639\u0636\u0648 \u0627\u0644\u062c\u0645\u0639\u064a\u0629 \u0642\u0627\u0633\u0645 \u0646\u0627\u0635\u0631 \u0627\u0644\u0628\u0631\u064a\u0647 \u0644\u0640 \u201d\u0627\u0644\u064a\u0648\u0645\u201c\u060c \u0623\u0646 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0628\u0643\u0631\u0629 \u062a\u0634\u0645\u0644 \u063a\u064a\u0627\u0628 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0628\u0635\u0631\u064a\u060c \u0648\u0636\u0639\u0641 \u0627\u0644\u062a\u0641\u0627\u0639\u0644 \u0648\u0627\u0644\u0625\u064a\u0645\u0627\u0621\u0627\u062a\u060c \u0648\u062a\u0623\u062e\u0631 \u0627\u0644\u0643\u0644\u0627\u0645\u060c \u0645\u0628\u064a\u0646\u0627\u064b \u0638\u0647\u0648\u0631 \u0627\u0633\u062a\u062c\u0627\u0628\u0627\u062a \u062d\u0633\u064a\u0629 \u063a\u064a\u0631 \u0645\u0639\u062a\u0627\u062f\u0629 \u0644\u0644\u0623\u0635\u0648\u0627\u062a \u0648\u0627\u0644\u0631\u0648\u0627\u0626\u062d \u0648\u0627\u0644\u0625\u0636\u0627\u0621\u0629\u060c \u0648\u0623\u0646\u0645\u0627\u0637 \u0633\u0644\u0648\u0643\u064a\u0629 \u0645\u062a\u0643\u0631\u0631\u0629. \u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0644\u0644\u062a\u0648\u062d\u062f \u0648\u0634\u062f\u062f \"\u0627\u0644\u0628\u0631\u064a\u0647\" \u0639\u0644\u0649 \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u062a\u0648\u062c\u0647 \u0644\u0644\u0639\u064a\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629 \u0639\u0646\u062f \u0638\u0647\u0648\u0631 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a\u060c \u0645\u062d\u0630\u0631\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0639\u0644\u0627\u0645\u0629 \u0648\u0627\u062d\u062f\u0629. \u0644\u0627\u0641\u062a\u0627\u064b \u0625\u0644\u0649 \u0623\u0646 \u062a\u0623\u062e\u0631 \u0627\u0644\u0623\u0633\u0631\u0629 \u0641\u064a \u0637\u0644\u0628 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u064a\u0642\u0644\u0635 \u0641\u0631\u0635 \u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0648\u064a\u0636\u0627\u0639\u0641 \u0627\u0644\u0622\u062b\u0627\u0631 \u0627\u0644\u0646\u0641\u0633\u064a\u0629 \u0648\u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629. \u0648\u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u062a\u062f\u062e\u0644 \u0627\u0644\u0645\u0628\u0643\u0631 \u0644\u064a\u0633 \u0639\u0644\u0627\u062c\u0627\u064b \u0646\u0647\u0627\u0626\u064a\u0627\u064b\u060c \u0628\u0644 \u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0644\u062a\u0637\u0648\u064a\u0631 \u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u0637\u0641\u0644 \u0627\u0644\u0644\u063a\u0648\u064a\u0629 \u0648\u0627\u0644\u0633\u0644\u0648\u0643\u064a\u0629. \u0645\u0634\u064a\u0631\u0627\u064b \u0625\u0644\u0649 \u0646\u062c\u0627\u062d \u0628\u0631\u0627\u0645\u062c \u00ab\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0633\u0644\u0648\u0643 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u064a\u00bb\u060c \u0648\u0645\u0624\u0643\u062f\u0627\u064b \u0623\u0647\u0645\u064a\u0629 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u062a\u062f\u062e\u0644 \u0641\u0631\u062f\u064a\u0627\u064b \u0628\u0623\u0647\u062f\u0627\u0641 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u064a\u0627\u0633. \u0648\u062d\u0630\u0631 \u0627\u0644\u0645\u0631\u0634\u062f \u0627\u0644\u0623\u0633\u0631\u064a \u0645\u0646 \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0637\u0641\u0644 \u0628\u063a\u064a\u0631\u0647 \u062a\u062c\u0646\u0628\u0627\u064b \u0644\u0644\u0625\u062d\u0628\u0627\u0637\u060c \u0646\u0627\u0641\u064a\u0627\u064b \u0623\u0646 \u064a\u0643\u0648\u0646 \u062a\u0623\u062e\u0631 \u0627\u0644\u0643\u0644\u0627\u0645 \u0639\u0627\u0626\u0642\u0627\u064b \u0623\u0645\u0627\u0645 \u0627\u0644\u062a\u0637\u0648\u0631. \u0645\u0636\u064a\u0641\u0627\u064b \u0623\u0646 \u0627\u0644\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u0623\u0647\u064a\u0644\u064a\u0629 \u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0646\u0637\u0642 \u0644\u062a\u0634\u0645\u0644 \u062a\u062d\u0633\u064a\u0646 \u062c\u0648\u062f\u0629 \u0627\u0644\u062d\u064a\u0627\u0629 \u0648\u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u0642\u0644\u0627\u0644\u064a\u0629. \u0627\u0643\u062a\u0634\u0627\u0641 \u0642\u062f\u0631\u0627\u062a \u0630\u0648\u064a \u0627\u0644\u062a\u0648\u062d\u062f \u0648\u0623\u0628\u0627\u0646 \u0623\u0646 \u0627\u0644\u062c\u0645\u0639\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629 \u062a\u0644\u0639\u0628 \u062f\u0648\u0631\u0627\u064b \u0645\u062d\u0648\u0631\u064a\u0627\u064b \u0641\u064a \u062a\u0648\u0639\u064a\u0629 \u0627\u0644\u0623\u0633\u0631 \u0648\u062a\u0635\u062d\u064a\u062d \u0627\u0644\u0645\u0641\u0627\u0647\u064a\u0645. \u0648\u0644\u0641\u062a \u0625\u0644\u0649 \u0623\u0647\u0645\u064a\u0629 \u062f\u0648\u0631 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0628\u062a\u0648\u0641\u064a\u0631 \u062e\u0637\u0637 \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0641\u0631\u062f\u064a\u0629 \u0644\u062a\u0637\u0648\u064a\u0631 \u0646\u0642\u0627\u0637 \u0627\u0644\u0642\u0648\u0629\u060c \u0648\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0641\u064a \u0625\u062a\u0627\u062d\u0629 \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629. \u0648\u062e\u0644\u0635 \u0627\u0644\u0628\u0631\u064a\u0647 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u062a\u0645\u0643\u064a\u0646 \u064a\u0628\u062f\u0623 \u0628\u0645\u0646\u0638\u0648\u0645\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0645\u0646 \u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0648\u0635\u0648\u0644\u0627\u064b \u0644\u062f\u0639\u0645 \u0627\u0644\u0623\u0633\u0631\u0629 \u0648\u0627\u0644\u0645\u062c\u062a\u0645\u0639. \u0645\u0634\u062f\u062f\u0627\u064b \u0639\u0644\u0649 \u062d\u0627\u062c\u0629 \u0633\u0648\u0642 \u0627\u0644\u0639\u0645\u0644 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0642\u062f\u0631\u0627\u062a \u0630\u0648\u064a \u0627\u0644\u062a\u0648\u062d\u062f \u0648\u0641\u062a\u062d \u0641\u0631\u0635 \u062d\u0642\u064a\u0642\u064a\u0629 \u0644\u0644\u0625\u0646\u062a\u0627\u062c.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u201d\u0627\u0644\u064a\u0648\u0645\u201c", "\u0637\u064a\u0641", "\u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641", "\u0644\u0639\u0644\u0627\u0645\u0627\u062a", "\u0627\u0644\u062a\u0648\u062d\u062f", "\u064a\u0643\u0634\u0641", "\u0645\u0631\u0634\u062f", "\u0623\u0633\u0631\u064a", "\u0627\u0644\u0645\u0628\u0643\u0631", "\u0623\u0647