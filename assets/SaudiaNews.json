644 \u0627\u0644\u0627\u0633\u062a\u0628\u0627\u0642\u064a \u0639\u0646\u062f \u0645\u0635\u062f\u0631 \u0627\u0644\u062e\u0637\u0631.\u0648\u062c\u0627\u0621 \u0627\u0644\u0639\u0631\u0636 \u0636\u0645\u0646 \u0645\u0644\u062a\u0642\u0649 \u00ab\u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0654\u0644\u064a\u0641 \u0644\u0633\u0644\u0627\u0645\u0629 \u0628\u064a\u064a\u0654\u064a\u0629 \u0644\u0645\u062c\u062a\u0645\u0639 \u0645\u062a\u0643\u0627\u0645\u0644\u00bb\u060c \u0627\u0644\u0630\u064a \u0646\u0638\u0645\u062a\u0647 \u0627\u0644\u062c\u0645\u0639\u064a\u0629 \u0627\u0644\u062a\u0639\u0627\u0648\u0646\u064a\u0629 \u0644\u0644\u062b\u0631\u0648\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0627\u0654\u062d\u0633\u0627\u0621 \u0628\u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0645\u0639 \u0645\u0643\u062a\u0628 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0628\u064a\u064a\u0654\u0629 \u0648\u0627\u0644\u0645\u064a\u0627\u0647 \u0648\u0627\u0644\u0632\u0631\u0627\u0639\u0629.\u062e\u0631\u064a\u0637\u0629 \u0644\u0644\u062e\u0637\u0631\u062f\u0639\u0627 \u0627\u0644\u0639\u0631\u0636 \u0627\u0655\u0644\u0649 \u0627\u0655\u0646\u0634\u0627\u0621 \u062e\u0631\u064a\u0637\u0629 \u062e\u0637\u0631 \u0631\u0642\u0645\u064a\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0646\u0638\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0629 GIS\u060c \u062a\u062c\u0645\u0639 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0643\u0644\u0627\u0628 \u0627\u0644\u062d\u0631\u0629 \u0648\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0639\u0636 \u0648\u062a\u062c\u0645\u0639\u0627\u062a \u0627\u0644\u0642\u0645\u0627\u0645\u0629 \u0648\u0627\u0644\u0645\u0633\u0627\u0644\u062e \u0648\u0627\u0644\u0645\u062f\u0627\u0631\u0633 \u0648\u0627\u0644\u0639\u064a\u0627\u062f\u0627\u062a\u060c \u0628\u0647\u062f\u0641 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0628\u0648\u0654\u0631 \u0627\u0644\u0633\u0627\u062e\u0646\u0629 \u0648\u062a\u0648\u062c\u064a\u0647 \u0641\u0631\u0642 \u0627\u0644\u062a\u0637\u0639\u064a\u0645 \u0627\u0655\u0644\u064a\u0647\u0627 \u0628\u062f\u0644 \u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u062c\u0647\u0648\u062f \u062f\u0648\u0646 \u062a\u062d\u062f\u064a\u062f \u0645\u0633\u0628\u0642 \u0644\u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u062e\u0637\u0648\u0631\u0629.\u0648\u064a\u0627\u0654\u062a\u064a \u0630\u0644\u0643 \u0636\u0645\u0646 \u062a\u0648\u062c\u0647 \u0644\u0644\u062a\u062d\u0648\u0644 \u0645\u0646 \u0645\u062c\u0631\u062f \u0627\u0655\u0639\u0637\u0627\u0621 \u0627\u0644\u0644\u0642\u0627\u062d\u0627\u062a \u0627\u0655\u0644\u0649 \u062a\u062d\u0642\u064a\u0642 \u0645\u0633\u062a\u0648\u0649 \u0627\u0654\u0648\u0633\u0639 \u0645\u0646 \u0627\u0644\u0645\u0646\u0627\u0639\u0629 \u0628\u064a\u0646 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u0639\u0631\u0636\u0629 \u0644\u0644\u062e\u0637\u0631.\u0627\u0655\u0646\u0630\u0627\u0631 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u0637\u0631\u062d \u0627\u0644\u0639\u0631\u0636 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0628\u0646\u0627\u0621 \u0646\u0638\u0627\u0645 \u0627\u0655\u0646\u0630\u0627\u0631 \u0645\u0628\u0643\u0631\u060c \u0645\u0646 \u062e\u0644\u0627\u0644 \u062f\u0645\u062c \u0628\u064a\u0627\u0646\u0627\u062a \u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0639\u0636 \u0648\u0627\u0644\u062a\u0637\u0639\u064a\u0645 \u0648\u0643\u062b\u0627\u0641\u0629 \u0627\u0644\u0643\u0644\u0627\u0628 \u0648\u0627\u0644\u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u0628\u064a\u064a\u0654\u064a\u0629\u060c \u0648\u062a\u0