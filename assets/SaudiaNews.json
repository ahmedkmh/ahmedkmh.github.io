0627\u0644\u0627\u0654\u0641\u0642\u064a\u0629\u060c \u0648\u062a\u0633\u0627\u0642\u0637 \u0627\u0644\u0628\u0631\u062f\u060c \u0648\u062c\u0631\u064a\u0627\u0646 \u0627\u0644\u0633\u064a\u0648\u0644\u060c \u0648\u0635\u0648\u0627\u0639\u0642 \u0631\u0639\u062f\u064a\u0629\u060c \u0639\u0644\u0649 \u0645\u062f\u064a\u0646\u0629 \u062c\u0627\u0632\u0627\u0646 \u0648\u0645\u062d\u0627\u0641\u0638\u0627\u062a \u0627\u0644\u062d\u0631\u062b\u060c \u0648\u0627\u0644\u062f\u0627\u064a\u0654\u0631 (\u0628\u0646\u064a \u0645\u0627\u0644\u0643)\u060c \u0648\u0627\u0644\u0631\u064a\u062b\u060c \u0648\u0627\u0644\u0639\u0627\u0631\u0636\u0629\u060c \u0648\u0627\u0644\u0639\u064a\u062f\u0627\u0628\u064a\u060c \u0648\u0641\u064a\u0641\u0627\u060c \u0648\u0647\u0631\u0648\u0628\u060c \u0648\u0627\u0644\u0637\u0648\u0627\u0644\u060c \u0648\u0635\u0627\u0645\u0637\u0629\u060c \u0648\u0627\u0654\u062d\u062f \u0627\u0644\u0645\u0633\u0627\u0631\u062d\u0629\u060c \u0648\u0627\u0654\u0628\u0648 \u0639\u0631\u064a\u0634\u060c \u0648\u0636\u0645\u062f\u060c \u0648\u0635\u0628\u064a\u0627\u060c \u0648\u0628\u064a\u0634\u060c \u0648\u0627\u0644\u062f\u0631\u0628\u060c \u0648\u0645\u0631\u0643\u0632 \u0627\u0644\u0641\u0637\u064a\u062d\u0629\u060c \u0648\u062c\u0632\u064a\u0631\u0629 \u0641\u0631\u0633\u0627\u0646.\u0648\u0628\u064a\u0651\u0646 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0654\u0646 \u0627\u0644\u062d\u0627\u0644\u0629 \u062a\u0633\u062a\u0645\u0631 -\u0628\u0645\u0634\u064a\u064a\u0654\u0629 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649- \u062d\u062a\u0649 \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062a\u0627\u0633\u0639\u0629 \u0645\u0633\u0627\u0621\u064b.\u0646\u0628\u0651\u0647 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0644\u0627\u0654\u0631\u0635\u0627\u062f\u060c \u0627\u0644\u064a\u0648\u0645 (\u0627\u0644\u0633\u0628\u062a)\u060c \u0645\u0646 \u0647\u0637\u0648\u0644 \u0627\u0654\u0645\u0637\u0627\u0631 \u0