\u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646\u060c \u0648\u0642\u0627\u0628\u0644 \u0630\u0644\u0643 \u0627\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u0645\u0635\u0631\u0648\u0641 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643. \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u062e\u0635\u0635 \u062e\u0633\u0627\u0626\u0631 \u0627\u0644\u0627\u0626\u062a\u0645\u0627\u0646 \u0645\u0646 570 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0627\u0644\u0649 852 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644 \u0628\u0646\u0633\u0628\u0629 49.5%. \u0623\u0631\u0628\u0627\u062d \u0645\u0635\u0631\u0641 \u0627\u0644\u0631\u0627\u062c\u062d\u064a \u0641\u064a 9 \u0623\u0634\u0647\u0631 \u0648\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0641\u064a 30 \u0633\u0628\u062a\u0645\u0628\u0631 2026 (9 \u0623\u0634\u0647\u0631)\u060c \u0627\u0631\u062a\u0641\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0628\u0646\u0633\u0628\u0629 13.3% \u0625\u0644\u0649 20.87 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644\u060c \u0645\u0642\u0627\u0628\u0644 18.41 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0648\u0627\u0631\u062a\u0641\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u0644\u0647\u0630\u0647 \u0627\u0644\u0641\u062a\u0631\u0629 \u0646\u062a\u064a\u062c\u0629 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u062c\u0645\u0627\u0644\u064a \u062f\u062e\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0628\u0646\u0633\u0628\u0629 13.4% \u0648\u064a\u0639\u0648\u062f \u0630\u0644\u0643 \u0628\u0634\u0643\u0644 \u0631\u0626\u064a\u0633\u064a \u0627\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0641\u064a \u0635\u0627\u0641\u064a \u062f\u062e\u0644 \u0627\u0644\u062a\u0645\u0648\u064a\u0644 \u0648\u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0648\u0631\u0633\u0648\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0628\u0646\u0643\u064a\u0629 \u0648\u0627\u0644\u062f\u062e\u0644 \u0645\u0646 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u0629. \u0648\u0642\u0627\u0628\u0644 \u0630\u0644\u0643 \u0627\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u0627\u0644\u062f\u062e\u0644 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649. \u0648\u0641\u064a \u0627\u0644\u0645\u0642\u0627\u0628\u0644 \u0627\u0631\u062a\u0641\u0639 \u0627\u062c\u0645\u0627\u0644\u064a \u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0634\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0635\u0635 \u062e\u0633\u0627\u0626\u0631 \u0627\u0644\u0627\u0626\u062a\u0645\u0627\u0646 \u0628\u0646\u0633\u0628\u0629 17.6% \u0646\u062a\u064a\u062c\u0629 \u0627\u0631\u062a\u0641\u0627\u0639 \u0641\u064a \u0627\u0644\u0645\u0635\u0627\u0631\u064a\u0641 \u0627\u0644\u0639\u0645\u0648\u0645\u064a\u0629 \u0648\u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0648\u0645\u0635\u0627\u0631\u064a\u0641 \u0631\u0648\u0627\u062a\u0628 \u0648\u0645\u0632\u0627\u064a\u0627 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0648\u0642\u0627\u0628\u0644 \u0630\u0644\u0643 \u0627\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u0645\u0635\u0631\u0648\u0641 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643. \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u062e\u0635\u0635 \u062e\u0633\u0627\u0626\u0631 \u0627\u0644\u0627\u0626\u062a\u0645\u0627\u0646 \u0645\u0646 1,695 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u06