627\u0653\u0646 \u0641\u064a \u0627\u0644\u062f\u0648\u0631\u064a\u060c \u0627\u0655\u0644\u0649 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u062b\u0627\u0644\u062b \u0641\u064a \u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0628\u062a\u0633\u0639 \u0646\u0642\u0627\u0637\u064d\u060c \u0628\u064a\u0646\u0645\u0627 \u0628\u0642\u064a \u00ab\u0627\u0644\u0628\u0644\u0648\u0632\u00bb \u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0633\u0627\u0628\u0639 \u0645\u0648\u0654\u0642\u062a\u064b\u0627 \u0628\u0633\u0628\u0639 \u0646\u0642\u0627\u0637\u064d. \u0648\u0643\u0627\u062f \u062a\u0634\u064a\u0644\u0633\u064a \u0627\u0654\u0646 \u064a\u0633\u062c\u0644 \u0641\u064a \u0648\u0642\u062a\u064d \u0645\u0628\u0643\u0650\u0651\u0631\u064d \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u062a\u063a\u0627\u0644\u064a \u0628\u064a\u062f\u0631\u0648 \u0646\u064a\u062a\u0648 \u0627\u0644\u0630\u064a \u0627\u0654\u0637\u0644\u0642 \u062a\u0633\u062f\u064a\u062f\u0629\u064b \u0645\u062a\u0642\u0646\u0629\u064b\u060c \u0644\u0643\u0646\u064e\u0651 \u0627\u0644\u062d\u0627\u0631\u0633 \u0643\u0648\u064a\u0645\u064a\u0646 \u0643\u064a\u0644\u064a\u0631 \u062a\u0635\u062f\u064e\u0651\u0649 \u0644\u0647\u0627. \u0648\u0627\u0642\u062a\u0631\u0628 \u0643\u0648\u0644 \u0628\u0627\u0644\u0645\u0631 \u0645\u0646 \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0634\u0628\u0627\u0643 \u0641\u064a \u0645\u0646\u0627\u0633\u0628\u062a\u064a\u0646\u060c \u0644\u0643\u0646\u064e\u0651 \u062f\u0641\u0627\u0639 \u0628\u0631\u064a\u0646\u062a\u0641\u0648\u0631\u062f \u0642\u0644\u064e\u0651\u0644\u0648\u0627 \u0645\u0646 \u062e\u0637\u0648\u0631\u062a\u0647. \u0648\u0627\u0641\u062a\u0642\u062f \u062a\u0634\u064a\u0644\u0633\u064a \u0641\u064a \u0627\u0644\u0644\u0642\u0627\u0621 \u062c\u0647\u0648\u062f \u0627\u0644\u0645\u0647\u0627\u062c\u0645 \u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644\u064a \u062c\u0648\u0627\u0648 \u0628\u064a\u062f\u0631\u0648 \u0628\u0633\u0628\u0628 \u06