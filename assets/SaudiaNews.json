.wp.com/asiatimes.com/wp-content/uploads/2026/08/Iran-Turkey-Saudi-Arabia.jpg?fit=1200%2C800&ssl=1", "video_url": null, "source_id": "asiatimes", "source_name": "Asia Times", "source_priority": 36028, "source_url": "https://asiatimes.com", "source_icon": "https://n.bytvi.com/asiatimes.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}, {"article_id": "6c71fbed0e93fac674b9581d7720d237", "link": "https://www.okaz.com.sa/local/na/2260594", "title": "\u0648\u0632\u064a\u0631 \u0627\u0644\u062b\u0642\u0627\u0641\u0629: \u0627\u0633\u062a\u0636\u0627\u0641\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0645\u0646\u062a\u062f\u0649 \u0627\u0644\u064a\u0648\u0646\u0633\u0643\u0648 \u064a\u062c\u0633\u062f \u0645\u0643\u0627\u0646\u062a\u0647\u0627 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0639\u0627\u0644\u0645\u064a\u0627\u064b", "description": "\u0627\u0654\u0643\u062f \u0648\u0632\u064a\u0631 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u062a\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0648\u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0627\u0654\u0645\u064a\u0631 \u0628\u062f\u0631 \u0628\u0646 \u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0628\u0646 \u0641\u0631\u062d\u0627\u0646 \u0627\u0654\u0646 \u0627\u0633\u062a\u0636\u0627\u0641\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0631\u0627\u0628\u0639\u0629 \u0645\u0646 \u0645\u0646\u062a\u062f\u0649 \u0627\u0644\u064a\u0648\u0646\u0633\u0643\u0648 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0644\u0627\u0654\u062e\u0644\u0627\u0642\u064a\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a 2026 \u062a\u062c\u0633\u062f \u0627\u0644\u0645\u0643\u0627\u0646\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0627\u0644\u062a\u064a \u0628\u0627\u062a\u062a \u062a\u062a\u0628\u0648\u0627\u0654\u0647\u0627 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0639\u0644\u0649 \u0627\u0644\u0633\u0627\u062d\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0641\u064a \u062f\u0639\u0645 \u0627\u0644\u062d\u0648\u0627\u0631 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u062d\u0648\u0644 \u0627\u0644\u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u0646\u0627\u0634\u064a\u0654\u0629\u060c \u0648\u062a\u0639\u0643\u0633 \u0627\u0644\u062a\u0632\u0627\u0645\u0647\u0627 \u0627\u0644\u0631\u0627\u0633\u062e \u0628\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0633\u0648\u0654\u0648\u0644 \u0648\u0627\u0644\u0627\u0654\u062e\u0644\u0627\u0642\u064a \u0644\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0628\u0645\u0627 \u064a\u062e\u062f\u0645 \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646 \u0648\u0627\u0644\u062a\u0646\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062f\u0627\u0645\u0629. \u0646\u0645\u0648\u0630\u062c \u0645\u062a\u0643\u0627\u0645\u0644\u0648\u0627\u0654\u0648\u0636\u062d \u0648\u0632\u064a\u0631 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0654\u0646 \u0627\u0644\u0634\u0631\u0627\u0643\u0629 \u0628\u064a\u0646 \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a (\u0633\u062f\u0627\u064a\u0627) \u0648\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0644\u0644\u062a\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u0629 (\u0627\u0644\u064a\u0648\u0646\u0633\u0643\u0648)\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0645\u0639 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u062f\u0648\u0644\u064a \u0644\u0627\u0654\u0628\u062d\u0627\u062b \u0648\u0627\u0654\u062e\u0644\u0627\u0642\u064a\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a (ICAIRE)\u060c \u062a\u0645\u062b\u0644 \u0646\u0645\u0648\u0630\u062c\u064b\u0627 \u0644\u0644\u062a\u0643\u0627\u0645\u0644 \u0627\u0644\u062f\u0648\u0644\u064a \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0633\u064a\u0627\u0633\u0627\u062a \u0648\u0627\u0644\u0645\u0645\u0627\u0631\u0633\u0627\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0654\u062e\u0644\u0627\u0642\u064a\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0648\u062a\u0639\u0632\u0632 \u062a\u0628\u0627\u062f\u0644 \u0627\u0644\u062e\u0628\u0631\u0627\u062a \u0648\u0628\u0646\u0627\u0621 \u0627\u0644\u0642\u062f\u0631\u0627\u062a \u0628\u064a\u0646 \u0645\u062e\u062a\u0644\u0641 \u0627\u0644\u062f\u0648\u0644.\u0648\u0627\u0654\u0641\u0627\u062f \u0628\u0627\u0654\u0646 \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u062a\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0648\u0627\u0644\u0639\u0644\u0648\u0645 \u062a\u062d\u0631\u0635 \u0639\u0644\u0649 \u062f\u0639\u0645 \u0627\u0644\u0645\u0628\u0627\u062f\u0631\u0627\u062a \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u0632\u0632 \u062d\u0636\u0648\u0631 \u0627\u0644\u