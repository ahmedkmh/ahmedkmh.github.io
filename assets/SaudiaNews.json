u064b\u0627 \u0628\u0627\u0654\u0646 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062d\u0627\u0644\u064a \u0642\u0628\u0644 \u0627\u0644\u0645\u062e\u0635\u0635\u0627\u062a \u0627\u0644\u0627\u0655\u0636\u0627\u0641\u064a\u0629 \u0628\u0644\u063a 3.3 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644.<br /><br />\u0648\u064a\u0639\u0648\u062f \u0633\u0628\u0628 \u062a\u0633\u062c\u064a\u0644 \u062e\u0633\u0627\u064a\u0654\u0631 \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062d\u0627\u0644\u064a \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u062a\u062d\u0642\u064a\u0642 \u0627\u0654\u0631\u0628\u0627\u062d \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0633\u0627\u0628\u0642 \u0627\u0655\u0644\u0649 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0655\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0631\u0628\u062d \u0627\u0644\u0646\u0627\u062a\u062c \u0639\u0646 \u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648 \u062a\u0643\u0648\u064a\u0646 \u0645\u062e\u0635\u0635\u0627\u062a \u0627\u0655\u0636\u0627\u0641\u064a\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062d\u0627\u0644\u064a.<br /><br />\u0648\u0628\u062d\u0633\u0628 \u0627\u0644\u0628\u064a\u0627\u0646\u060c \u064a\u0639\u0648\u062f \u0633\u0628\u0628 \u0627\u0646\u062e\u0641\u0627\u0636 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 2026\u060c \u0645\u0642\u0627\u0631\u0646\u0629\u064b \u0628\u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 \u0627\u0655\u0644\u0649 \u0627\u0644\u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u062a\u0627\u0644\u064a\u0629:<br /><br />- \u0627\u0646\u062e\u0