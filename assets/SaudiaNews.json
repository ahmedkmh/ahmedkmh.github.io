r />\u0648\u0627\u0654\u0634\u0627\u0631\u062a \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0641\u064a \u062a\u0635\u0631\u064a\u062d\u0627\u062a \u062e\u0627\u0635\u0629 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0645\u0633\u0648\u0654\u0648\u0644\u064a \u0646\u0627\u062f\u064a \u0627\u0644\u0641\u062a\u062d \u0642\u062f \u0627\u0633\u062a\u0643\u0645\u0644\u0648\u0627 \u0643\u0627\u0641\u0629 \u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0635\u0641\u0642\u0629\u060c \u0644\u064a\u0643\u0648\u0646 \u0627\u0654\u062d\u062f \u062a\u062f\u0639\u064a\u0645\u0627\u062a \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0633\u062a\u0639\u062f\u0627\u062f\u064b\u0627 \u0644\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u062c\u062f\u064a\u062f.<br /><br />\u0627\u0644\u0644\u0627\u0639\u0628 \u0635\u0627\u062d\u0628 \u0627\u0644\u0640 (25) \u0639\u0627\u0645\u064b\u0627 \u0634\u0627\u0631\u0643 \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u0645\u0627\u0636\u064a \u0645\u0639 \u0646\u0627\u062f\u064a \u0627\u0641 \u0633\u064a \u0627\u0633 \u0628\u064a \u0627\u0644\u0631\u0648\u0645\u0627\u0646\u064a \u0628\u0640 (45) \u0645\u0628\u0627\u0631\u0627\u0629 \u0633\u062c\u0644 \u062e\u0644\u0627\u0644\u0647\u0627 (4) \u0627\u0654\u0647\u062f\u0627\u0641 \u0648\u0635\u0646\u0639 (3) \u0644\u0632\u0645\u0644\u0627\u064a\u0654\u0647 \u062e\u0644\u0627\u0644 (2780) \u062f\u0642\u064a\u0642\u0629 \u0644\u0639\u0628.<br /><br />\u064a\u0630\u0643\u0631 \u0627\u0654\u0646 \u0646\u0627\u062f\u064a \u0627\u0644\u0641\u062a\u062d \u0642\u062f \u0627\u0654\u0646\u0647\u0649 \u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u0645\u0627\u0636\u064a \u0645\u0646 \u062f\u0648\u0631\u064a \u0631\u0648\u0634\u0646 \u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u062d\u0627\u062f\u064a \u0639\u0634\u0631 \u0628\u0631\u06