4\u0633\u0639\u0648\u062f\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 4.9% \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 2026 \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 (\u064a\u0648\u0644\u064a\u0648 2025).<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d\u062a \"\u0627\u0644\u0627\u0655\u062d\u0635\u0627\u0621\" \u0627\u0654\u0646 \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0642\u064a\u0627\u0633\u064a \u0644\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0644\u0629 \u0642\u062f \u0627\u0631\u062a\u0641\u0639 \u0628\u0646\u0633\u0628\u0629 1.2% \u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0634\u0647\u0631\u064a \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0634\u0647\u0631 \u064a\u0648\u0646\u064a\u0648 2026.<h2>\u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 2026</h2>\u0627\u0654\u0638\u0647\u0631\u062a \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0635\u0627\u062f\u0631\u0629 \u0639\u0646 \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0627\u0655\u062d\u0635\u0627\u0621 \u0627\u0654\u0646 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 4.9% \u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0633\u0646\u0648\u064a \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648\u060c \u062c\u0627\u0621 \u0645\u062f\u0639\u0648\u0645\u064b\u0627 \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 13.5%\u060c \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u062c\u0645\u0644\u0629 \u0648\u0627\u0644\u062a\u062c\u0632\u064a\u0654\u0629 \u0648\u0627\u0655\u0635\u0644\u0627\u062d \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0628\u0646\u0633\u0628\u0629 0.8%\u060c \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0634\u064a\u064a\u062f \u0628\u0646\u0633\u0628\u0629 %1.6\u060c \u0648\u0643\u0630\u0644\u0643 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0627\u0654\u0645\u064a\u0646 \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0628\u0646\u0633\u0628\u062a\u064a 9% \u06486.5% \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a.<br /><br />\u0648\u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0634\u0647\u0631\u064a \u0633\u062c\u0644 \u0645\u0648\u0654\u0634\u0631 \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0642\u064a\u0627\u0633\u064a \u0644\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0627\u0631\u062a\u0641\u0627\u0639\u0627 \u0628\u0646\u0633\u0628\u0629 %1.2\u060c \u0645\u062f\u0639\u0648\u0645\u0627 \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 0.8%\u060c \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0646 \u0648\u0627\u0633\u062a\u063a\u0644\u0627\u0644 \u0627\u0644\u0645\u062d\u0627\u062c\u0631 \u0627\u0644\u062a\u064a \u0627\u0631\u062a\u0641\u0639\u062a \u0628\u0646\u0633\u0628\u0629 6.4%\u060c \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0634\u064a\u064a\u062f \u0628\u0646\u0633\u0628\u0629 0.1%. \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0643\u0644 \u0645\u0646 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0627\u0655\u0642\u0627\u0645\u0629 \u0648\u0627\u0644\u0637\u0639\u0627\u0645 \u0628\u0646\u0633\u0628\u0629 3.7% 0.6% \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a.<h2>\u062a\u0639\u0648\u064a\u0636\u0627\u062a \u0627\u0644\u0645\u0634\u062a\u063a\u0644\u064a\u0646</h2> <br />\u0628\u062d\u0633\u0628 \u0627\u0655\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0648\u0654\u0634\u0631 \u0627\u0644\u0627\u0654\u0639\u0645\u0627\u0644 \u0642\u0635\u064a\u0631\u0629 \u0627\u0644\u0645\u062f\u0649 \u0644\u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 2026\u060c \u0627\u0631\u062a\u0641\u0639 \u0645\u0648\u0654\u0634\u0631 \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0642\u064a\u0627\u0633\u064a \u0644\u062a\u0639\u0648\u064a\u0636\u0627\u062a \u0627\u0644\u0645\u0634\u062a\u063a\u0644\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 7.4% \u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0633\u0646\u0648\u064a\u060c \u0645\u062f\u0639\u0648\u0645\u064b\u0627 \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 10.3%\u060c \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0634\u064a\u064a\u062f \u0627\u0644\u062a\u064a \u0627\u0631\u062a\u0641\u0639\u062a \u0628\u0646\u0633\u0628\u0629 4.6%\u060c \u0648\u0643\u0630\u0644\u0643 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 <a href=\"https://www.alyaum.com/articles/6680287/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D8%B1%D8%AA%D9%81%D8%A7%D8%B9-%D8%A5%D9%8A%D8%B1%D8%A7%D8%AF%D8%A7%D8%AA-%D8%AA%D8%AC%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D8%AC%D9%85%D9%84%D8%A9-%D9%88%D8%A7%D9%84%D8%AA%D8%AC%D8%B2%D8%A6%D8%A9-32-%D9%81%D9%8A-%D8%A7%D9%84%D8%B1%D8%A8%D8%B9-%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D9%8A-%D9%85%D9%86-2026\" target=\"_blank\">\u062a\u062c\u0627\u0631\u0629 \u0627\u0644\u062c\u0645\u0644\u0629 \u0648\u0627\u0644\u062a\u062c\u0632\u064a\u0654\u0629</a> \u0648\u0627\u0655\u0635\u0644\u0627\u062d \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0628\u0646\u0633\u0628\u0629 6.2%\u060c \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0646 \u0648\u0627\u0633\u062a\u063a\u0644\u0627\u0644 \u0627\u0644\u0645\u062d\u0627\u062c\u0631 \u0648\u0627\u0644\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0648\u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0627\u0654\u0645\u064a\u0646 \u0628\u0646\u0633\u0628\u0629 2.7% \u06486.4% \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a.<br /><br />\u0648\u0639\u0644\u0649 \u0635\u0639\u064a\u062f \u0627\u0644\u0627\u0654\u062f\u0627\u0621 \u0627\u0644\u0634\u0647\u0631\u064a \u0644\u0645\u0648\u0654\u0634\u0631 \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0642\u064a\u0627\u0633\u064a \u0644\u062a\u0639\u0648\u064a\u0636\u0627\u062a \u0627\u0644\u0645\u0634\u062a\u063a\u0644\u064a\u0646 \u064a\u0644\u0627\u062d\u0638 \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u062f\u0627\u0621 \u0627\u0644\u0645\u0648\u0654\u0634\u0631 \u0628\u0646\u0633\u0628\u0629 0.3% \u0645\u062f\u0639\u0648\u0645\u064b\u0627 \u0628\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0639\u062f\u064a\u0646 \u0648\u0627\u0633\u062a\u063a\u0644\u0627\u0644 \u0627\u0644\u0645\u062d\u0627\u062c\u063