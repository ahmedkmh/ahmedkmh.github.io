{"status": "success", "totalResults": 5142, "results": [{"article_id": "ca6f83a1a464edaf5d1ad4120090b33e", "link": "https://www.alyaum.com/articles/6676683/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D8%B3%D8%AA%D9%82%D8%A8%D8%A7%D9%84-%D8%A7%D9%84%D8%AF%D9%81%D8%B9%D8%A9-%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D9%8A%D8%A9-%D9%85%D9%86-%D8%B6%D9%8A%D9%88%D9%81-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC-%D8%AE%D8%A7%D8%AF%D9%85-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%84%D9%84%D8%B9%D9%85%D8%B1%D8%A9-%D9%88%D8%A7%D9%84%D8%B2%D9%8A%D8%A7%D8%B1%D8%A9", "title": "\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0645\u0646 \u0636\u064a\u0648\u0641 \u0628\u0631\u0646\u0627\u0645\u062c \u062e\u0627\u062f\u0645 \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0644\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629", "description": "\u0627\u0633\u062a\u0642\u0628\u0644\u062a <a href=\"https://www.alyaum.com/articles/6675081/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D9%88%D8%B3%D9%8A%D8%B1%D8%A7%D9%84%D9%8A%D9%88%D9%86-%D8%AA%D8%A8%D8%AD%D8%AB%D8%A7%D9%86-%D8%AA%D8%B9%D8%B2%D9%8A%D8%B2-%D8%A7%D9%84%D8%AA%D8%B9%D8%A7%D9%88%D9%86-%D9%81%D9%8A-%D8%A7%D9%84%D9%85%D8%AC%D8%A7%D9%84%D8%A7%D8%AA-%D8%A7%D9%84%D8%A5%D8%B3%D9%84%D8%A7%D9%85%D9%8A%D8%A9-%D9%88%D8%A7%D9%84%D8%AF%D8%B9%D9%88%D9%8A%D8%A9\">\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0634\u0648\u0654\u0648\u0646 \u0627\u0644\u0627\u0655\u0633\u0644\u0627\u0645\u064a\u0629</a> \u0648\u0627\u0644\u062f\u0639\u0648\u0629 \u0648\u0627\u0644\u0627\u0655\u0631\u0634\u0627\u062f \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621 \u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0645\u0646 \u0636\u064a\u0648\u0641 <a href=\"https://www.alyaum.com/articles/6673810/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B5%D9%88%D8%B1-%D8%B6%D9%8A%D9%88%D9%81-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC-%D8%AE%D8%A7%D8%AF%D9%85-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%8A%D9%88%D8%AF%D8%B9%D9%88%D9%86-%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D9%85%D8%AB%D9%85%D9%86%D9%8A%D9%86-%D8%B1%D8%B9%D8%A7%D9%8A%D8%A9-%D8%A7%D9%84%D9%82%D9%8A%D8%A7%D8%AF%D8%A9\">\u0628\u0631\u0646\u0627\u0645\u062c \u062e\u0627\u062f\u0645 \u0627\u0644\u062d\u0631\u0645\u064a\u0646 \u0627\u0644\u0634\u0631\u064a\u0641\u064a\u0646</a> \u0644\u0644\u0639\u0645\u0631\u0629 \u0648\u0627\u0644\u0632\u064a\u0627\u0631\u0629 \u0644\u0639\u0627\u0645 1448\u0647\u0640\u060c \u0644\u062f\u0649 \u0648\u0635\u0648\u0644\u0647\u0645 \u0627\u0655\u0644\u0649 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060c \u062a\u0645\u0647\u064a\u062f\u064b\u0627 \u0644\u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a \u0648\u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0644\u0645 \u0627\u0644\u0627\u0655\u0633\u0644\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629\u060c \u0642\u0628\u0644 \u0627\u0646\u062a\u0642\u0627\u0644\u0647\u0645 \u0627\u0655\u0644\u0649 \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0644\u0627\u0654\u062f\u0627\u0621 \u0645\u0646\u0627\u0633\u0643 \u0627\u0644\u0639\u0645\u0631\u0629.<br /><br />\u0648\u0643\u0627\u0646 \u0636\u064a\u0648\u0641 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0646 \u0627\u0644\u062c\u0645\u0647\u0648\u0631\u064a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 \u0648\u0627\u0644\u062c\u0645\u0647\u0648\u0631\u064a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0648\u0631\u064a\u0629 \u0641\u064a \u0645\u0642\u062f\u0645\u0629 \u0627\u0644\u0648\u0627\u0635\u0644\u064a\u0646.<br /> <br />\u0648\u062a\u0636\u0645 \u0627\u0644\u062f\u0641\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 (250) \u0645\u0639\u062a\u0645\u0631\u064b\u0627 \u0648\u0645\u0639\u062a\u0645\u0631\u0629 \u064a\u0645\u062b\u0644\u0648\u0646 (23) \u062f\u0648\u0644\u0629 \u0645\u0646 \u0642\u0627\u0631\u062a\u064a \u0627\u0654\u0648\u0631\u0648\u0628\u0627 \u0648\u0627\u0653\u0633\u064a\u0627\u060c \u0647\u064a: \u0627\u0654\u0644\u0628\u0627\u0646\u064a\u0627\u060c \u0648\u0627\u0654\u0644\u0645\u0627\u0646\u064a\u0627\u060c \u0648\u0627\u0655\u0633\u0628\u0627\u0646\u064a\u0627\u060c \u0648\u0627\u0655\u0633\u062a\u0648\u0646\u064a\u0627\u060c \u0648\u0627\u0644\u0627\u0654\u0631\u062f\u0646\u060c \u0648\u0627\u0644\u0628\u0648\u0633\u0646\u0629 \u0648\u0627\u0644\u0647\u0631\u0633\u0643\u060c \u0648\u0627\u0644\u062c\u0628\u0644 \u0627\u0644\u0627\u0654\u0633\u0648\u062f\u060c \u0648\u0627\u0644\u0639\u0631\u0627\u0642\u060c \u0648\u0627\u0644\u064a\u0648\u0646\u0627\u0646\u060c \u0648\u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0627\u060c \u0648\u0628\u0644\u063a\u0627\u0631\u064a\u0627\u060c \u0648\u0628\u0648\u0644\u0646\u062f\u0627\u060c \u0648\u0631\u0648\u0645\u0627\u0646\u064a\u0627\u060c \u0648\u0633\u0644\u0648\u0641\u0627\u0643\u064a\u0627\u060c \u0648\u0633\u0644\u0648\u0641\u064a\u0646\u064a\u0627\u060c \u0648\u0633\u0648\u0631\u064a\u0627\u060c \u0648\u0633\u0648\u064a\u0633\u0631\u0627\u060c \u0648\u0635\u0631\u0628\u064a\u0627\u060c \u0648\u0641\u0631\u0646\u0633\u0627\u060c \u0648\u0643\u0648\u0633\u0648\u0641\u0648\u060c \u0648\u0645\u0642\u062f\u0648\u0646\u064a\u0627\u060c \u0648\u0645\u0648\u0644\u062f\u0648\u0641\u0627\u060c \u0648\u0627\u0644\u0646\u0645\u0633\u0627.<br /> <h2>\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u062a\u0643\u0627\u0645\u0644</h2>\u0648\u0627\u0654\u0639\u062f\u062a \u0627\u0644\u0648\u0632\u0627\u0631\u0629 \u0628\u0631\u0646\u0627\u0645\u062c\u064b\u0627 \u0645\u062a\u0643\u0627\u0645\u0644\u064b\u0627 \u0644\u0644\u0645\u0633\u062a\u0636\u0627\u0641\u064a\u0646 \u062e\u0644\u0627\u0644 \u0627\u0655\u0642\u0627\u0645\u062a\u0647\u0645 \u0641\u064a<a href=\"https://www.alyaum.com/articles/6673361/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B6%D9%8A%D9%88%D9%81-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC-%D8%AE%D8%A7%D8%AF%D9%85-%D8%A7%D9%84%D8%AD%D8%B1%D9%85%D9%8A%D9%86-%D9%8A%D8%B2%D9%88%D8%B1%D9%88%D9%86-%D9%85%D8%AC%D9%85%D8%B9-%D8%B5%D9%86%D8%A7%D8%B9%D8%A9-%D9%83%D8%B3%D9%88%D8%A9-%D8%A7%D9%84%D9%83%D8%B9%D8%A8%D8%A9-%D8%A7%D9%84%D9%85%D8%B4%D8%B1%D9%81%D8%A9\"> \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629</a>\u060c \u064a\u0634\u0645\u0644 \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u0646\u0628\u0648\u064a\u060c \u0648\u0627\u0644\u0631\u0648\u0636\u0629 \u0627\u0644\u0634\u0631\u064a\u0641\u0629\u060c \u0648\u0645\u0633\u062c\u062f \u0642\u0628\u0627\u0621\u060c \u0648\u062c\u0628\u0644 \u0627\u0654\u062d\u062f\u060c \u0648\u0645\u0642\u0628\u0631\u0629 \u0634\u0647\u062f\u0627\u0621 \u0627\u0654\u062d\u062f\u060c \u0648\u0645\u062c\u0645\u0639 \u0627\u0644\u0645\u0644\u0643 \u0641\u0647\u062f \u0644\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u0645\u0635\u062d\u0641 \u0627\u0644\u0634\u0631\u064a\u0641\u060c \u0627\u0655\u0636\u0627\u0641\u0629 \u0627\u0655\u0644\u0649 \u0627\u0644\u0645\u0639\u0631\u0636 \u0648\u0627\u0644\u0645\u062a\u062d\u0641 \u0627\u0644\u062f\u0648\u0644\u064a \u0644\u0644\u0633\u064a\u0631\u0629 \u0627\u0644\u0646\u0628\u0648\u064a\u0629 \u0648\u0627\u0644\u062d\u0636\u0627\u0631\u0629 \u0627\u0644\u0627\u0655\u0633\u0644\u0627\u0645\u064a\u0629.<br /> <br />\u0648\u0639\u0642\u0628 \u0627\u0646\u062a\u0647\u0627\u0621 \u0628\u0631\u0646\u0627\u0645\u062c\u0647\u0645 \u0641\u064a \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\