646\u060c \u0627\u0644\u064a\u0648\u0645\u060c \u062d\u0643\u0645\u0627\u064b \u0642\u0636\u0627\u064a\u0654\u064a\u0627\u064b \u0635\u0627\u062f\u0631\u0627\u064b \u0639\u0646 \u0645\u062d\u0643\u0645\u0629 \u0627\u0644\u0627\u0633\u062a\u064a\u0654\u0646\u0627\u0641 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u064a\u0629 \u0628\u0645\u0646\u0637\u0642\u0629 \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629\u060c \u0648\u0627\u0646\u062a\u0647\u0649 \u0627\u0644\u062d\u0643\u0645 \u0627\u0644\u0642\u0636\u0627\u064a\u0654\u064a \u0627\u0655\u0644\u0649 \u0627\u0655\u0644\u063a\u0627\u0621 \u0642\u0631\u0627\u0631 \u0645\u0639\u0627\u0642\u0628\u0629 \u0637\u0627\u0644\u0628 \u062c\u0627\u0645\u0639\u064a \u0628\u0627\u0644\u0627\u0655\u064a\u0642\u0627\u0641 \u0644\u0645\u062f\u0629 \u0641\u0635\u0644\u064a\u0646 \u062f\u0631\u0627\u0633\u064a\u064a\u0646.<br /><br />\u0648\u062a\u0639\u0648\u062f \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0642\u0636\u064a\u0629 \u0627\u0655\u0644\u0649 \u062a\u0642\u062f\u0645 \u0627\u0644\u0637\u0627\u0644\u0628 \u0628\u062f\u0639\u0648\u0649 \u064a\u0637\u0639\u0646 \u0641\u064a\u0647\u0627 \u0639\u0644\u0649 \u0642\u0631\u0627\u0631 \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0644\u062a\u064a \u064a\u062f\u0631\u0633 \u0628\u0647\u0627\u060c \u0645\u0637\u0627\u0644\u0628\u0627\u064b \u0628\u0627\u0655\u0644\u063a\u0627\u0621 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u062a\u0627\u0654\u062f\u064a\u0628\u064a \u0627\u0644\u0635\u0627\u062f\u0631 \u0628\u062d\u0642\u0647.<br /><br />\u0648\u0635\u062f\u0631 \u0642\u0631\u0627\u0631 \u0627\u0644\u0627\u0655\u064a\u0642\u0627\u0641 \u0628\u0639\u062f \u0634\u0643\u0648\u0649 \u062a\u0642\u062f\u0645 \u0628\u0647\u0627 \u0627\u0644\u0637\u0627\u0644\u0628 \u0636\u062f \u0627\u0654\u0633\u062a\u0627\u0630 \u0627\u0644\u0645\u0642\u0631\u0631\u060c \u0646\u064f\u0633\u0628 \u0627\u0655\u0644\u064a\u0647 \u0639\u0644\u0649 \u0627\u0655\u062b\u0631\u0647\u0627 \u0627\u0644\u062e\u0631\u0648\u062c \u0639\u0646 \u0627\u0644\u0644\u064a\u0627\u0642\u0629 \u0648\u0627\u0644\u0627\u0654\u062f\u0628. \u0648\u0646\u0638\u0631\u062a \u0627\u0644\u0645\u062d\u0643\u0645\u0629 \u0641\u064a \u0627\u0654\u0633\u0628\u0627\u0628 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u062a\u0627\u0654\u062f\u064a\u0628\u064a \u0648\u0645\u0627 \u0627\u0633\u062a\u0646\u062f \u0627\u0655\u0644\u064a\u0647 \u0645\u0646 \u0648\u0642\u0627\u064a\u0654\u0639 \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0634\u0631\u0648\u0639\u064a\u0629 \u0627\u0644\u0627\u0655\u062c\u0631\u0627\u0621. \u0648\u062a\u0628\u064a\u0646 \u0644\u0644\u0645\u062d\u0643\u0645\u0629 \u0627\u0654\u0646 \u0645\u0636\u0645\u0648\u0646 \u0627\u0644\u0634\u0643\u0648\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0645\u0646 \u0627\u0644\u0637\u0627\u0644\u0628 \u0636\u062f \u0627\u0654\u0633\u062a\u0627\u0630 \u0627\u0644\u0645\u0642\u0631\u0631 \u0644\u0627 \u064a\u0646\u0647\u0636 \u0644\u0627\u0655\u0633\u0646\u0627\u062f \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629 \u0627\u0655\u0644\u064a\u0647.<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d\u062a \u0627\u0644\u0645\u062d\u0643\u0645\u0629 \u0627\u0654\u0646 \u0630\u0644\u0643 \u0627\u0644\u062e\u0644\u0644 \u064a\u062a\u0631\u062a\u0628 \u0639\u0644\u064a\u0647 \u062a\u062e\u0644\u0641 \u0633\u0628\u0628 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u062a\u0627\u0654\u062f\u064a\u0628\u064a \u0627\u0644\u0635\u0627\u062f\u0631 \u0628\u062d\u0642 \u0627\u0644\u0637\u0627\u0644\u0628. \u0648\u0634\u062f\u062f\u062a \u0639\u0644\u0649 \u0627\u0654\u0646 \u0635\u062d\u0629 \u0627\u0644\u0633\u0628\u0628 \u0648\u062b\u0628\u0648\u062a \u0627\u0644\u0648\u0627\u0642\u0639\u0629 \u064a\u064f\u0639\u062f\u0627\u0646 \u0645\u0646 \u0627\u0644\u0636\u0645\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u0654\u0633\u0627\u0633\u064a\u0629 \u0644\u0645\u0634\u0631\u0648\u0639\u064a\u0629 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u062a\u0627\u0654\u062f\u064a\u0628\u064a\u0629.<br /><br />\u0648\u0627\u0646\u062a\u0647\u062a \u0645\u062d\u0643\u0645\u0629 \u0627\u0644\u0627\u0633\u062a\u064a\u0654\u0646\u0627\u0641 \u0627\u0655\u0644\u0649 \u0627\u0655\u0644\u063a\u0627\u0621 \u0627\u0644\u0642\u0631\u0627\u0631 \u0645\u062d\u0644 \u0627\u0644\u062f\u0639\u0648\u0649\u060c \u0645\u0648\u0654\u0643\u062f\u0629 \u0627\u0654\u0647\u0645\u064a\u0629 \u0627\u0633\u062a\u0646\u0627\u062f \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0644\u062a\u0627\u0654\u062f\u064a\u0628\u064a\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0633\u0628\u0627\u0628 \u062b\u0627\u0628\u062a\u0629 \u0648\u0645\u0639\u062a\u0628\u0631\u0629.</div>", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u062c\u0627\u0645\u0639\u064a", "\u063a\u064a\u0631", "\u0637\u0627\u0644\u0628", "\u0627\u0644\u0627\u0633\u062a\u0626\u0646\u0627\u0641", "\u0625\u064a\u0642\u0627\u0641", "\u062b\u0627\u0628\u062a\u0629", "\u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629", "\u062a\u0644\u063a\u064a", "\u0641\u0635\u0644\u064a\u0646..", "\u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629"], "creator": ["\u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0645\u0627\u0631\u064a - \u0627\u0644\u0631\u064a\u0627\u0636"], "language": "arabic", "country": ["saudi arabia"], "category": ["politics", "top"], "datatype": "news", "pubDate": "2026-08-23 10:33:00", "pubDateTZ": "UTC", "fetched_at": "2026-08-23 10:48:28", "image_url": "https://www.alyaum.com/uploads/images/2026/08/23/3094096.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://n.bytvi.com/alyaum.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_