a\u0627\u064a\u0654\u062c.<br /><br />\u0648\u062a\u0643\u0628\u0651\u062f\u062a \"\u0628\u0648\u064a\u0646\u062c\" \u062e\u0633\u0627\u0631\u0629 \u0641\u0635\u0644\u064a\u0629 \u0642\u062f\u0631\u0647\u0627 428 \u0645\u0644\u064a\u0648\u0646 <a href=\"https://www.alyaum.com/articles/6675172/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%B3%D8%B9%D8%B1-%D8%A7%D9%84%D8%AF%D9%88%D9%84%D8%A7%D8%B1-%D9%85%D9%82%D8%A7%D8%A8%D9%84-%D8%A7%D9%84%D8%AC%D9%86%D9%8A%D9%87-%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D8%AB%D9%84%D8%A7%D8%AB%D8%A7%D8%A1-%D8%A7%D8%B3%D8%AA%D9%82%D8%B1%D8%A7%D8%B1-%D9%81%D9%8A-%D8%A7%D9%84%D8%A8%D9%86%D9%88%D9%83-%D8%A7%D9%84%D9%85%D8%B5%D8%B1%D9%8A%D8%A9\" target=\"_blank\">\u062f\u0648\u0644\u0627\u0631 </a>\u0628\u0627\u0654\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u062a\u0648\u0642\u0639\u0627\u062a\u060c \u0645\u0646\u0647\u0627 \u062e\u0633\u0627\u0631\u0629 \u0642\u062f\u0631\u0647\u0627 280 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 \u0641\u064a \u0628\u0631\u0646\u0627\u0645\u062c \u062a\u0633\u0644\u064a\u0645 \u0637\u0627\u064a\u0654\u0631\u062a\u064a\u0646 \u0645\u0646 \u0637\u0631\u0627\u0632 \"747\"\u060c \u0633\u062a\u0643\u0648\u0646\u0627\u0646 \u0628\u0645\u062b\u0627\u0628\u0629 \u0627\u0644\u062c\u064a\u0644 \u0627\u0644\u0642\u0627\u062f\u0645 \u0645\u0646 \u0637\u0627\u064a\u0654\u0631\u0627\u062a \u0627\u0644\u0631\u064a\u0654\u0627\u0633\u0629 \u0627\u0644\u0627\u0654\u0645\u0631\u064a\u0643\u064a\u0629 \"\u0627\u0655\u064a\u0631 \u0641\u0648\u0631\u0633 \u0648\u0646\"\u060c \u0648\u0630\u0644\u0643 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0630\u064a \u0627\u0654\u0639\u0644\u0646\u062a \u0641\u064a\u0647 \u0639\u0646 \u0632\u064a\u0627\u062f\u0629 \u0627\u0633\u062a\u062b\u0645\u0627\u0631\u0627\u062a\u0647\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c\u060c \u0645\u0648\u0654\u0643\