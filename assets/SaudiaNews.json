9 \u0645\u0639 \u0628\u0631\u0646\u0627\u0645\u062c \"\u0646\u064a\u0648\u0632\u0646\u0627\u064a\u062a\" \u0627\u0644\u0630\u064a \u062a\u0642\u062f\u0645\u0647 \u0634\u0628\u0643\u0629 \"\u0628\u064a \u0628\u064a \u0633\u064a\" \u0627\u0644\u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0629\u060c \u0642\u0627\u0644 \u0647\u0627\u0646\u062a\u0631 \u0628\u0627\u064a\u062f\u0646 \u0627\u0655\u0646 \u0645\u0631\u0636 \u0648\u0627\u0644\u062f\u0647 \u0642\u062f \u0627\u0646\u062a\u0634\u0631 \u0631\u063a\u0645 \u062a\u0644\u0642\u064a\u0647 \u0627\u0644\u0639\u0644\u0627\u062c.<br /> <br />\u0627\u0654\u0636\u0627\u0641: \"\u0627\u0646\u062a\u0634\u0631 \u0627\u0644\u0633\u0631\u0637\u0627\u0646 \u0648\u062a\u0641\u0634\u0649 \u0644\u064a\u0635\u0644 \u0627\u0655\u0644\u0649 \u0627\u0644\u0639\u0638\u0627\u0645 \u0648\u0627\u0654\u0645\u0627\u0643\u0646 \u0627\u0654\u062e\u0631\u0649\". \u0648\u062a\u0627\u0628\u0639: \"\u0627\u0655\u0646\u0647 \u0627\u0654\u0645\u0631 \u0645\u0648\u0654\u0644\u0645 \u0644\u0644\u063a\u0627\u064a\u0629\u060c \u0648\u0645\u0646\u0647\u0643 \u062c\u062f\u0627 \u0645\u0646 \u0646\u0648\u0627\u062d \u0639\u062f\u064a\u062f\u0629\u060c \u0644\u0643\u0646\u0647 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0642\u0648\u064a\u0627. \u0627\u0655\u0646\u0647 \u064a\u0648\u0627\u0635\u0644 \u0646\u0634\u0627\u0637\u0647...\u0648\u0647\u0648 \u064a\u0648\u0654\u0645\u0646 \u0628\u0634\u062f\u0629 \u0628\u0647\u0630\u0627 \u0627\u0644\u0628\u0644\u062f\".<br /><br />\u0648\u0628\u062f\u0627 \u0627\u0644\u062a\u0627\u0654\u062b\u0631 \u0648\u0627\u0636\u062d\u0627 \u0639\u0644\u0649 \u0647\u0627\u0646\u062a\u0631 \u0628\u0627\u064a\u062f\u0646 \u0641\u064a \u0628\u0639\u0636 \u0644\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u0629 \u0627\u0654\u062b\u0646\u0627\u0621 \u062d\u062f\u064a\u062b\u0647 \u0639\u0646 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0644\u0648\u0627\u0644\u062f\u0647\u060c \u0642\u062