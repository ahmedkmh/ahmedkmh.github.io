645\u0643\u0627\u0646\u064a\u0629 \u062a\u0631\u0643\u064a\u0628 <a href=\"https://www.alyaum.com/articles/6616001/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%B9%D8%A7%D8%AC%D9%84-10-%D9%82%D9%88%D8%A7%D8%B9%D8%AF-%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9-%D8%AA%D9%86%D8%B8%D9%8A%D9%85-%D8%A7%D9%84%D9%83%D9%87%D8%B1%D8%A8%D8%A7%D8%A1-%D8%AA%D9%84%D8%B2%D9%85-%D9%85%D9%82%D8%AF%D9%85%D9%8A-%D8%A7%D9%84%D8%AE%D8%AF%D9%85%D8%A9-%D8%A8%D8%AA%D8%B1%D9%83%D9%8A%D8%A8-%D8%A3%D8%AC%D9%87%D8%B2%D8%A9-%D9%84%D9%85%D8%B1%D8%A7%D9%82%D8%A8%D8%A9-%D8%AC%D9%88%D8%AF%D8%A9-%D8%A7%D9%84%D8%B7%D8%A7%D9%82%D8%A9\">\u0639\u062f\u0627\u062f\u0627\u062a \u0643\u0647\u0631\u0628\u0627\u064a\u0654\u064a\u0629</a> \u0644\u0644\u0645\u0646\u0627\u0632\u0644 \u062f\u0648\u0646 \u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645\u064a\u0629\u060c \u0648\u0645\u0646 \u0628\u064a\u0646\u0647\u0627 \u0635\u0643 \u0627\u0644\u0645\u0644\u0643\u064a\u0629\u060c \u063a\u064a\u0631 \u0635\u062d\u064a\u062d.<br /><br />\u0648\u0627\u0654\u0648\u0636\u062d\u062a \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0654\u0646 \u0627\u0655\u064a\u0635\u0627\u0644<a href=\"https://www.alyaum.com/articles/6594661/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/158-%D9%85%D9%84%D9%8A%D9%88%D9%86-%D8%B1%D9%8A%D8%A7%D9%84-%D8%AA%D8%B9%D9%88%D9%8A%D8%B6%D8%A7%D8%AA-%D9%84%D9%85%D8%B3%D8%AA%D9%87%D9%84%D9%83%D9%8A-%D8%A7%D9%84%D9%83%D9%87%D8%B1%D8%A8%D8%A7%D8%A1-%D8%AE%D9%84%D8%A7%D9%84-%D8%B9%D8%A7%D9%85\"> \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u064a\u0654\u064a\u0629 </a>\u0648\u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a \u064a\u062a\u0645 \u0648\u0641\u0642 \u0627\u0644\u0636\u0648\u0627\u0628\u0637 \u0648\u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629\u060c \u0648\u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0642\u0646\u0648\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0644\u0645\u0642\u062f\u0645 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u064a\u0654\u064a\u0629\u060c \u062f\u0627\u0639\u064a\u0629\u064b \u0627\u0655\u0644\u0649 \u0639\u062f\u0645 \u0627\u0644\u0627\u0646\u0633\u064a\u0627\u0642 \u0648\u0631\u0627\u0621 \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0654\u0648 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0645\u0648\u062b\u0648\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u0648\u0651\u062c \u0644\u062e\u062f\u0645\u0627\u062a \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0655\u064a\u0635\u0627\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0654\u0648 \u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0627\u0654\u0648 \u062a\u0633\u062a\u062e\u062f\u0645 \u0634\u0639\u0627\u0631 \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0654\u0648 \u0634\u0639\u0627\u0631\u0627\u062a \u0645\u0642\u062f\u0645 \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u064a\u0654\u064a\u0629 \u0644\u0644\u062a\u0631\u0648\u064a\u062c \u0644\u062e\u062f\u0645\u0627\u062a\u0647\u0627.<br /> <h2>\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u064a\u0654\u064a\u0629</h2>\u0648\u0634\u062f\u062f\u062a \u0639\u0644\u0649 \u0627\u0654\u0647\u0645\u064a\u0629 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0645\u0646 \u0645\u0635\u0627\u062f\u0631\u0647\u0627 \u0627\u0644\u0631\u0633\u0645\u064a\u0629\u060c \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u