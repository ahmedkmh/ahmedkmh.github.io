7%D9%84%D8%B9%D8%B1%D8%A8/%D8%A7%D8%B3%D8%AA%D8%B4%D9%87%D8%A7%D8%AF-%D8%B7%D9%81%D9%84-%D9%81%D9%84%D8%B3%D8%B7%D9%8A%D9%86%D9%8A-%D8%A8%D8%B1%D8%B5%D8%A7%D8%B5-%D8%A7%D9%84%D8%A7%D8%AD%D8%AA%D9%84%D8%A7%D9%84-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A6%D9%8A%D9%84%D9%8A-%D9%81%D9%8A-%D8%A7%D9%84%D8%B6%D9%81%D8%A9-%D8%A7%D9%84%D8%BA%D8%B1%D8%A8%D9%8A%D8%A9\" target=\"_blank\">\u0627\u0644\u0636\u0641\u0629 \u0627\u0644\u063a\u0631\u0628\u064a\u0629</a>\u060c \u0628\u0627\u0644\u062a\u0632\u0627\u0645\u0646 \u0645\u0639 \u0645\u0648\u0654\u0634\u0631\u0627\u062a \u0645\u0642\u0644\u0642\u0629 \u0628\u0634\u0627\u0654\u0646 \u0633\u0648\u0621 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u0645\u0632\u0645\u0646 \u0628\u064a\u0646 \u0627\u0644\u0627\u0654\u0637\u0641\u0627\u0644 \u0641\u064a \u0627\u0644\u0642\u0637\u0627\u0639.<br />\u0648\u0627\u0654\u0641\u0627\u062f \u0645\u0643\u062a\u0628 \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0644\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0634\u0648\u0654\u0648\u0646 \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a\u0629 \"\u0627\u0654\u0648\u062a\u0634\u0627\" \u0628\u0648\u0631\u0648\u062f \u062a\u0642\u0627\u0631\u064a\u0631 \u0639\u0646 \u0645\u0642\u062a\u0644 \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0627\u0654\u0634\u062e\u0627\u0635\u060c \u0628\u064a\u0646\u0647\u0645 \u0637\u0641\u0644\u060c \u062c\u0631\u0627\u0621 \u063a\u0627\u0631\u0627\u062a \u062c\u0648\u064a\u0629 \u0639\u0644\u0649 \u063a\u0632\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u064a\u0648\u0645\u064a\u0646 \u0627\u0644\u0645\u0627\u0636\u064a\u064a\u0646\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u063a\u0627\u0631\u0629 \u062c\u0648\u064a\u0629 \u0627\u0654\u0644\u062d\u0642\u062a \u0627\u0654\u0645\u0633 \u0627\u0654\u0636\u0631\u0627\u0631\u064b\u0627 \u0628\u062b\u0644\u0627\u062b\u0629 \u0645\u062e\u0627\u0632\u0646 \u062a\u0627\u0628\u0639\u0629 \u0644\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0641\u064a \u062f\u064a\u0631 \u0627\u0644\u0628\u0644\u062d \u0648\u0633\u0637 \u0627\u0644\u0642\u0637\u0627\u0639.<br />\u0648\u062c\u062f\u062f \u0627\u0644\u0645\u062a\u062d\u062f\u062b \u0628\u0627\u0633\u0645 \u0627\u0644\u0627\u0654\u0645\u064a\u0646 \u0627\u0644\u0639\u0627\u0645 \u0644\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0633\u062a\u064a\u0641\u0627\u0646 \u062f\u0648\u062c\u0627\u0631\u064a\u0643\u060c \u062e\u0644\u0627\u0644 \u0627\u0644\u0645\u0648\u0654\u062a\u0645\u0631 \u0627\u0644\u0635\u062d\u0641\u064a \u0627\u0644\u064a\u0648\u0645\u064a\u060c \u0627\u0644\u062f\u0639\u0648\u0629 \u0627\u0655\u0644\u0649 \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u062f\u0646\u064a\u064a\u0646 \u0648\u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0627\u0644\u0645\u062f\u0646\u064a\u0629\u060c \u0645\u0648\u0654\u0643\u062f\u064b\u0627 \u0636\u0631\u0648\u0631\u0629 \u0639\u062f\u0645 \u0627\u0633\u062a\u0647\u062f\u0627\u0641\u0647\u0645.<h2>\u0633\u0648\u0621 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u0645\u0632\u0645\u0646</h2>\u0648\u0641\u064a \u0633\u064a\u0627\u0642 \u0645\u062a\u0635\u0644\u060c \u0643\u0634\u0641\u062a \u062f\u0631\u0627\u0633\u0629 \u0627\u0633\u062a\u0637\u0644\u0627\u0639\u064a\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0644\u0644\u0637\u0641\u0648\u0644\u0629 \"\u0627\u0644\u064a\u0648\u0646\u064a\u0633\u0641\" \u0639\u0646 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0653\u062b\u0627\u0631 \u0627\u0644\u0635\u0631\u0627\u0639 \u0639\u0644\u0649 \u0627\u0644\u0627\u0654\u0637\u0641\u0627\u0644 \u0648\u0627\u0644\u0627\u0654\u0645\u0647\u0627\u062a \u0641\u064a \u063a\u0632\u0629\u060c \u0644\u0627 \u0633\u064a\u0651\u0645\u0627 \u0645\u0627 \u064a\u062a\u0639\u0644\u0642 \u0628\u0633\u0648\u0621 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u0645\u0632\u0645\u0646 \u0648\u0636\u0639\u0641 \u062c\u0648\u062f\u0629 \u0627\u0644\u0627\u0654\u0646\u0638\u0645\u0629 \u0627\u0644\u063a\u0630\u0627\u064a\u0654\u064a\u0629 \u0648\u0627\u0646\u062a\u0634\u0627\u0631 \u0627\u0654\u0645\u0631\u0627\u0636 \u0627\u0644\u0627\u0654\u0637\u0641\u0627\u0644.<br />\u0648\u0627\u0654\u0638\u0647\u0631\u062a \u0627\u0644\u062f\u0631\u0627\u0633\u0629\u060c \u0627\u0644\u062a\u064a \u0627\u0654\u062c\u0631\u064a\u062a \u0628\u064a\u0646 31 \u0645\u0627\u064a\u0648 \u064815 \u064a\u0648\u0646\u064a\u0648\u060c \u0627\u0654\u0646 \u0633\u0648\u0621 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u0645\u0632\u0645\u0646 \"\u0627\u0644\u062a\u0642\u0632\u0645\" \u064a\u0648\u0654\u062b\u0631 \u0639\u0644\u0649 12.2% \u0645\u0646 \u0627\u0644\u0627\u0654\u0637\u0641\u0627\u0644 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a\u064a\u0646 \u062f\u0648\u0646 \u0633\u0646 \u0627\u0644\u062e\u0627\u0645\u0633\u0629\u060c \u0641\u064a\u0645\u0627 \u0628\u0644\u063a\u062a \u0646\u0633\u0628\u0629 \u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0648\u0632\u0646 \u0628\u064a\u0646\u0647\u0645 4%.<br />\u0648\u0627\u0654\u0634\u0627\u0631\u062a \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0646\u062d\u0648 73% \u0645\u0646 \u0627\u0644\u0627\u0654\u0637\u0641\u0627\u0644 \u0627\u0644\u0630\u064a\u0646 \u062a\u062a\u0631\u0627\u0648\u062d \u0627\u0654\u0639\u0645\u0627\u0631\u0647\u0645 \u0628\u064a\u0646 6 \u064823 \u0634\u0647\u0631\u064b\u0627 \u062a\u0646\u0627\u0648\u0644\u0648\u0627 \u0627\u0654\u063a\u0630\u064a\u0629 \u063a\u064a\u0631 \u0635\u062d\u064a\u0629\u060c \u0641\u064a \u062d\u064a\u0646 \u0644\u0645 \u064a\u062d\u0635\u0644 \u0633\u0648\u0649 22.4% \u0645\u0646\u0647\u0645 \u0639\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u0627\u0654\u062f\u0646\u0649 \u0645\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u063a\u0630\u0627\u064a\u0654\u064a \u0627\u0644\u0645\u0642\u0628\u0648\u0644.<div data-oembed-url=\"https://x.com/alyaum/status/2091982782473920656\"><blockquote align=\"center\" class=\"twitter-tweet\" data-dnt=\"true\"><p dir=\"rtl\" lang=\"ar\">\u0627\u0645\u062a\u062f\u0627\u062f\u064b\u0627 \u0644\u0645\u0648\u0627\u0642\u0641 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a\u0629.. \u0648\u0635\u0648\u0644 \u0642\u0627\u0641\u0644\u0629 \u0645\u0633\u0627\u0639\u062f\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0627\u0655\u0644\u0649 \u063a\u0632\u0629<a href=\"https://x.com/hashtag/%D8%A7%D9%84%D9%8A%D9%88%D9%85?src=hash&ref_src=twsrc%5Etfw\">#\u0627\u0644\u064a\u0648\u0645</a><br />\u0644\u0644\u062a\u0641\u0627\u0635\u064a\u0644 | <a href=\"https://t.co/UDP5581gZv\">https://t.co/UDP5581gZv</a> <a href=\"https://t.co/W7p7AWk7cO\">pic.twitter.com/W7p7AWk7cO</a></p>\u2014 \u0635\u062d\u064a\u0641\u0629 \u0627\u0644\u064a\u0648\u0645 (@alyaum) <a href=\"https://x.com/alyaum/status/2091982782473920656?ref_src=twsrc%5Etfw\">August 24, 2026</a></blockquote> </div><h2>\u0636\u0645\u0627\u0646 \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0627\u062a \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a\u0629</h2>\u0648\u062c\u062f\u062f\u062a \u0627\u0644\u0627\u0654\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0645\u0637\u0627\u0644\u0628\u062a\u0647\u0627 \u0628\u0636\u0645\u0627\u0646 \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0627\u062a \u0627\u0644\u0627\u0655\u0646\u0633\u0627\u0646\u064a\u0629 \u0628\u0635\u0648\u0631\u0629 \u0645\u0633\u062a\u062f\u0627\u0645\u0629 \u0648\u062f\u0648\u0646 \u0639\u0648\u0627\u064a\u0654\u0642 \u0627\u0655\u0644\u0649 \u0642\u0637\u0627\u0639 \u063a\u0632\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0648\u0642\u0648\u062f\u060c \u0648\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u062a\u0645\u0648\u064a\u0644 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0648\u0627\u0644\u0635\u062d\u0629 \u0648\u0627\u0644\u0645\u064a\u0627\u0647 \u0648\u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u0635\u062d\u064a.<br />\u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u0641\u062a\u062d \u0627\u0644\u0627\u0654\u0633\u0648\u0627\u0642 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0644\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0627\u0654\u0637\u0641\u0627\u0644 \u0648\u0627\u0644\u0627\u0654\u0633\u0631 \u0645\u0646 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u063a\u0630\u0627\u0621 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0627\u0654\u0633\u0627\u0633\u064a\u0629.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0633\u0642\u0648\u0637", "\u063a\u0632\u0629", "\u0645\u0646", "\u0627\u0644\u063a\u0631\u0628\u064a\u0629", "\u0627\u0644\u0623\u0645\u0645", "\u0648\u0627\u0644\u0636\u0641\u0629", "\u062a\u062d\u0630\u0631", "\u0641\u064a", "\u0627\u0633\u062a\u0645\u0631\u0627\u0631", "\u0627\u0644\u0645\u062a\u062d\u062f\u0629", "\u0627\u0644\u0645\u062f\u0646\u064a\u064a\u0646"], "creator": ["\u0648\u0627\u0633 - \u0646\u064a\u0648\u064a\u0648\u0631\u0643"], "language": "arabic", "country": ["saudi arabia"], "category": ["crime", "top"], "datatype": "news", "pubDate": "2026-08-25 04:37:00", "pubDateTZ": "UTC", "fetched_at": "2026-08-25 04:48:29", "image_url": "https://www.alyaum.com/uploads/images/2026/08/25/3096150.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://n.bytvi.com/alyaum.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE P