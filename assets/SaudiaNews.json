0631\u0647\u0627 \u0639\u0646\u062f \u062d\u0635\u0648\u0644 \u0648\u0627\u0644\u062f\u0647\u0627 \u0639\u0644\u0649 \u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0639\u0627\u0645 2000. \u0648\u062a\u062a\u0645\u062d\u0648\u0631 \u0627\u0644\u0642\u0636\u064a\u0629 \u062d\u0648\u0644 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062a\u0628\u0644\u063a 17 \u0639\u0627\u0645\u0627\u064b\u060c \u0628\u0645\u0627 \u064a\u0624\u0647\u0644\u0647\u0627 \u0644\u0627\u0643\u062a\u0633\u0627\u0628 \u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0648\u0627\u0644\u062f\u0647\u0627\u060c \u0623\u0645 \u0643\u0627\u0646\u062a \u0642\u062f \u0628\u0644\u063a\u062a 18 \u0639\u0627\u0645\u0627\u064b \u0622\u0646\u0630\u0627\u0643. \u0648\u0641\u064a \u062a\u0637\u0648\u0631 \u0644\u0627\u0641\u062a\u060c \u0641\u062a\u0634 \u0639\u0645\u0644\u0627\u0621 \u0641\u064a\u062f\u0631\u0627\u0644\u064a\u0648\u0646 \u0645\u0646\u0632\u0644 \u0639\u0645\u0631 \u0641\u064a \u0648\u0627\u0634\u0646\u0637\u0646\u060c (\u0627\u0644\u0625\u062b\u0646\u064a\u0646) \u0627\u0644\u0645\u0627\u0636\u064a\u060c \u0628\u0645\u0648\u062c\u0628 \u0625\u0630\u0646 \u0642\u0636\u0627\u0626\u064a\u060c \u0648\u0635\u0627\u062f\u0631\u0648\u0627\u060c \u0648\u0641\u0642\u0627\u064b \u0644\u0645\u0635\u0627\u062f\u0631 \u0645\u0637\u0644\u0639\u0629\u060c \u0647\u0627\u062a\u0641\u0647\u0627 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 \u0648\u062f\u0641\u0627\u062a\u0631 \u0645\u0644\u0627\u062d\u0638\u0627\u062a\u0647\u0627 \u0648\u0623\u062c\u0647\u0632\u0629 \u0643\u0645\u0628\u064a\u0648\u062a\u0631 \u0648\u062c\u0648\u0627\u0632 \u0633\u0641\u0631\u0647\u0627. \u0643\u0645\u0627 \u062a\u0644\u0642\u0649 \u0628\u0639\u0636 \u0623\u0641\u0631\u0627\u062f \u0623\u0633\u0631\u062a\u0647\u0627 \u0645\u0630\u0643\u0631\u0627\u062a \u0627\u0633\u062a\u062f\u0639\u0627\u0621 \u0645\u0646 \u0647\u064a\u0626\u0629 \u0645\u062d\u0644\u0641\u064a\u0646 \u0643\u0628\u0631\u0649 \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0644\u062a\u062d\u0642\u064a\u0642. \u0648\u0648\u0635\u0644\u062a \u0639\u0645\u0631 \u0625\u0644\u0649 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0639\u0627\u0645 1995\u060c \u0628\u0639\u062f\u0645\u0627 \u063a\u0627\u062f\u0631\u062a \u0627\u0644\u0635\u0648\u0645\u0627\u0644 \u0628\u0633\u0628\u0628 \u0627\u0644\u062d\u0631\u0628 \u0627\u0644\u0623\u0647\u0644\u064a\u0629\u060c \u0648\u0623\u0645\u0636\u062a \u0623\u0631\u0628\u0639 \u0633\u0646\u0648\u0627\u062a \u0641\u064a \u0645\u062e\u064a\u0645 \u0644\u0644\u0627\u062c\u0626\u064a\u0646 \u0628\u0643\u064a\u0646\u064a\u0627. \u0648\u062d\u0635\u0644\u062a \u0639\u0644\u0649 \u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0639\u0627\u0645 2000 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u062c\u0646\u0651\u0633 \u0648\u0627\u0644\u062f\u0647\u0627. \u0648\u0623\u062b\u0627\u0631\u062a \u0645\u0632\u0627\u0639\u0645 \u0628\u0634\u0623\u0646 \u0633\u0646\u0629 \u0645\u064a\u0644\u0627\u062f\u0647\u0627 \u062c\u062f\u0644\u0627\u064b \u0645\u0646\u0630 \u0633\u0646\u0648\u0627\u062a\u060c \u062e\u0635\u0648\u0635\u0627\u064b \u0628\u0639\u062f \u062a\u0639\u062f\u064a\u0644 \u0633\u0646\u0629 \u0645\u064a\u0644\u0627\u062f\u0647\u0627 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0645\u0646 1981 \u0625\u0644\u0649 1982. \u0648\u0631\u0641\u0636\u062a \u0627\u0644\u0646\u0627\u0626\u0628\u0629 \u0627\u0644\u0627\u062a\u0647\u0627\u0645\u0627\u062a\u060c \u0648\u0648\u0635\u0641\u062a\u0647\u0627 \u0628\u0623\u0646\u0647\u0627 \u00ab\u0623\u0643\u0627\u0630\u064a\u0628 \u0644\u0627 \u0623\u0633\u0627\u0633 \u0644\u0647\u0627 \u0648\u062d\u0645\u0644\u0627\u062a \u062a\u0634\u0648\u064a\u0647\u00bb\u060c \u0645\u0639\u062a\u0628\u0631\u0629 \u0627\u0644\u062a\u062d\u0642\u064a\u0642 \u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u0627\u0633\u062a\u0647\u062f\u0627\u0641 \u0627\u0644\u062e\u0635\u0648\u0645 \u0627\u0644\u0633\u064a\u0627\u0633\u064a\u064a\u0646 \u0648\u062a\u0648\u0638\u064a\u0641 \u0623\u062c\u0647\u0632\u0629 \u0625\u0646\u0641\u0627\u0630 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0636\u062f\u0647\u0645. \u0648\u0628\u0627\u0644\u062a\u0648\u0627\u0632\u064a\u060c \u062a\u062e\u0636\u0639 \u0639\u0645\u0631 \u0644\u062a\u062d\u0642\u064a\u0642 \u0645\u0627\u0644\u064a \u0645\u0646\u0641\u0635\u0644 \u0628\u0634\u0623\u0646 \u0625\u0642\u0631\u0627\u0631\u0627\u062a \u0623\u0635\u0648\u0644\u0647\u0627 \u0648\u062b\u0631\u0648\u062a\u0647\u0627\u060c \u0628\u0639\u062f\u0645\u0627 \u0623\u0639\u0644\u0646\u062a \u0648\u062b\u0627\u0626\u0642 \u0633\u0627\u0628\u0642\u0629 \u0627\u0645\u062a\u0644\u0627\u0643\u0647\u0627 \u0648\u0632\u0648\u062c\u0647\u0627 \u0623\u0635\u0648\u0644\u0627\u064b \u062a\u062a\u0631\u0627\u0648\u062d \u0642\u064a\u0645\u062a\u0647\u0627 \u0628\u064a\u0646 6 \u064830 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631\u060c \u0642\u0628\u0644 \u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0644\u0627\u062d\u0642\u0627\u064b \u0625\u0644\u0649 \u0645\u0627 \u0628\u064a\u0646 18 \u0623\u0644\u0641\u0627\u064b \u064895 \u0623\u0644\u0641 \u062f\u0648\u0644\u0627\u0631\u060c \u0648\u0639\u0632\u062a \u0627\u0644\u0641\u0627\u0631\u0642 \u0625\u0644\u0649 \u062e\u0637\u0623 \u0645\u062d\u0627\u0633\u0628\u064a. \u0648\u0642\u062f \u062a\u0641\u0636\u064a \u0627\u0644\u062a\u062d\u0642\u064a\u0642\u0627\u062a \u0625\u0644\u0649 \u0627\u062a\u0647\u0627\u0645\u0627\u062a \u0628\u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0644 \u0623\u0648 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0645\u062f\u0646\u064a\u0629 \u0644\u0633\u062d\u0628 \u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0625\u0630\u0627 \u062b\u0628\u062a \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u064a\u0647\u0627 \u0628\u0635\u0648\u0631\