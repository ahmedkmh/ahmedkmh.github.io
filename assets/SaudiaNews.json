iption": "\u062a\u0648\u0627\u0635\u0644 \u0644\u0648\u0646\u063a \u062a\u0634\u0627\u0648 \u062a\u0642\u062f\u064a\u0645 \u0645\u0628\u0627\u062f\u0631\u062a\u0647\u0627 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0634\u0641\u0627\u0641\u064a\u0629 \u0645\u0633\u0627\u0631 \u0627\u0644\u0644\u0642\u0627\u062d \u0625\u0644\u0649 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 \u0627\u0644\u0645\u062d\u0644\u064a\u064a\u0646 \u0648\u0627\u0644\u062f\u0648\u0644\u064a\u064a\u0646. Vietnam.vn \u062d\u0641\u0644 \u062a\u0648\u0632\u064a\u0639 \u062c\u0648\u0627\u0626\u0632 \u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0645\u064a\u0629 \u0644\u0644\u0634\u062e\u0635\u064a\u0627\u062a \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 Vietnam.vn \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u0631\u0628\u0637 \u0628\u064a\u0646 \u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0627\u0644\u062e\u0627\u0635\u0629 \u0644\u0644\u062a\u062e\u0641\u064a\u0641 \u0645\u0646 \u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u0639\u062f\u064a\u0629 \u0627\u0644\u0646\u0627\u0634\u0626\u0629 \u0648\u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629. Vietnam.vn \u062d\u062b \u0646\u0627\u0626\u0628 \u0648\u0632\u064a\u0631 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u0627\u062a\u062e\u0627\u0630 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0648\u0642\u0627\u0626\u064a\u0629 \u0627\u0633\u062a\u0628\u0627\u0642\u064a\u0629 \u0644\u0645\u0646\u0639 \u0627\u0646\u062a\u0634\u0627\u0631 \u0627\u0644\u0645\u0631\u0636 \u0645\u0628\u0643\u0631\u0627\u064b \u0648\u0639\u0646 \u0628\u0639\u062f. Vietnam.vn \u0646\u0634\u0631 \u0642\u064a\u0645\u