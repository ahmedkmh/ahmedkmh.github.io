4\u0627\u0654\u0633\u0641 \u0644\u0645 \u0646\u0633\u062a\u063a\u0644 \u0627\u0644\u0641\u0631\u0635 \u0648\u0631\u0643\u0644\u0629 \u0627\u0644\u062c\u0632\u0627\u0621\u060c\u0648\u0644\u0645 \u062a\u0643\u0646 \u0647\u0630\u0647 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u064a \u0643\u0646\u062a \u0627\u0654\u062a\u0645\u0646\u0627\u0647\u0627\u00bb.<br /><br />\u0648\u0627\u0654\u0628\u062f\u0649 \u0645\u062f\u0631\u0628 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0631\u0636\u0627\u0647 \u0639\u0646 \u0627\u0654\u062f\u0627\u0621 \u0644\u0627\u0639\u0628\u064a\u0647 \u0631\u063a\u0645 \u0627\u0644\u0646\u0642\u0635 \u0627\u0644\u0639\u062f\u062f\u064a\u060c \u0645\u0648\u0654\u0643\u062f\u064b\u0627 \u0627\u0654\u0646\u0647 \u0644\u0645 \u064a\u0631\u064e \u0627\u0654\u064a \u062c\u0627\u0646\u0628 \u0633\u0644\u0628\u064a \u0641\u064a \u0627\u0654\u062f\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642 \u0628\u0639\u062f \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629\u060c \u0645\u0637\u0627\u0644\u0628\u064b\u0627 \u0627\u0644\u062c\u0645\u0627\u0647\u064a\u0631 \u0628\u0645\u0648\u0627\u0635\u0644\u0629 \u062f\u0639\u0645 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0642\u0628\u0644\u0629.<br /><br />\u0648\u0627\u0654\u0636\u0627\u0641: \"\u0627\u0644\u062c\u0645\u0647\u0648\u0631 \u0644\u0647 \u0631\u0627\u0654\u064a\u0647 \u0648\u0646\u062d\u0646 \u0646\u0644\u0639\u0628 \u0645\u0646 \u0627\u0654\u062c\u0644 \u062c\u0645\u0627\u0647\u064a\u0631\u0646\u0627 \u0648\u0646\u062d\u062a\u0627\u062c \u0648\u0642\u0641\u062a\u0647\u0645 \u0645\u0639\u0646\u0627\u060c \u0627\u0654\u0646\u0627 \u0631\u0627\u0636\u064d \u0639\u0645\u0627 \u0642\u062f\u0645\u0647 \u0627\u0644\u0644\u0627\u0639\u0628\u0648\u0646 \u0631\u063a\u0645 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0631\u062f \u0648\u0633\u064a\u0627\u0654\u062a\u064a \u0627\u0644\u064a\u0648\u0645 \u0627