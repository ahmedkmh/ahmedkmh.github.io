8%B1%D8%A9-%D8%B9%D9%84%D9%89-%D8%B7%D8%A7%D9%88%D9%84%D8%A9-LEAP-2026-%D9%81%D9%8A-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6", "title": "14.3 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 \u0627\u0654\u0635\u0648\u0644 \u0639\u0627\u0644\u0645\u064a\u0629 \u0645\u062f\u0627\u0631\u0629 \u0639\u0644\u0649 \u0637\u0627\u0648\u0644\u0629 \u00abLEAP 2026\u00bb \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636", "description": "\u062a\u0646\u0637\u0644\u0642 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u062e\u0627\u0645\u0633\u0629 \u0645\u0646 \u0645\u0648\u0654\u062a\u0645\u0631 LEAP \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636 \u0628\u064a\u0646 31 \u0627\u0654\u063a\u0633\u0637\u0633 \u06483 \u0633\u0628\u062a\u0645\u0628\u0631 \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0627 \u064a\u0632\u064a\u062f \u0639\u0646 1,000 \u0645\u0633\u062a\u062b\u0645\u0631 \u0645\u0646 \u0627\u0654\u0643\u062b\u0631 \u0645\u0646 900 \u0634\u0631\u0643\u0629\u060c \u0648\u0627\u0644\u0630\u064a\u0646 \u064a\u062f\u064a\u0631\u0648\u0646 \u0627\u0654\u0635\u0648\u0644\u0627\u064b \u0628\u0642\u064a\u0645\u0629 \u0627\u0655\u062c\u0645\u0627\u0644\u064a\u0629 \u062a\u0628\u0644\u063a 14.3 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631\u060c \u0645\u0645\u0627 \u064a\u0639\u0632\u0632 \u0645\u0643\u0627\u0646\u0629 \u0627\u0644\u0631\u064a\u0627\u0636 \u0627\u0644\u0645\u062a\u0646\u0627\u0645\u064a\u0629 \u0643\u0648\u062c\u0647\u0629 \u0639\u0627\u0644\u0645\u064a\u0629 \u0644\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0641\u064a \u0642\u0637\u0627\u0639 \u0627\u0644\u062a\u0642\u0646\u064a\u0629.<br /><br />\u0648\u0628\u0639\u062f \u0627\u0654\u0646 \u0634\u0647\u062f \u0645\u0648\u0654\u062a\u0645\u0631 LEAP 2025 \u0627\u0644\u0627\u0655\u0639\u0644\u0627\u0646 \u0639\u0646 \u062d\u0632\u0645\u0629 \u0645\u0646 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631\u0627\u062a \u0628\u0644\u063a\u062a 14.9 \u0