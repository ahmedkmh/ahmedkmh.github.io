um.com/articles/6676734/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D9%82%D9%8A%D8%A7%D8%AF%D8%A9-%D8%AA%D9%87%D9%86%D8%A6-%D8%A7%D9%84%D8%AD%D8%A7%D9%83%D9%85-%D8%A7%D9%84%D8%B9%D8%A7%D9%85-%D9%84%D8%AC%D8%A7%D9%85%D8%A7%D9%8A%D9%83%D8%A7-%D8%A8%D8%B0%D9%83%D8%B1%D9%89-%D8%A7%D8%B3%D8%AA%D9%82%D9%84%D8%A7%D9%84-%D8%A8%D9%84%D8%A7%D8%AF%D9%87\"> \u0648\u0644\u064a \u0627\u0644\u0639\u0647\u062f</a> \u0631\u064a\u0654\u064a\u0633 \u0645\u062c\u0644\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0627\u062a\u0635\u0627\u0644\u064b\u0627 \u0647\u0627\u062a\u0641\u064a\u064b\u0627 \u0645\u0646 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u0627\u0655\u064a\u0645\u0627\u0646\u0648\u064a\u0644 \u0645\u0627\u0643\u0631\u0648\u0646 \u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u062c\u0645\u0647\u0648\u0631\u064a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629.<br /><br />\u0648\u062c\u0631\u0649 \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0645\u0633\u062a\u062c\u062f\u0627\u062a<a href=\"https://www.alyaum.com/articles/6676263/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%81%D9%8A-%D8%A7%D8%AA%D8%B5%D8%A7%D9%84-%D9%85%D8%B9-%D9%88%D9%84%D9%8A-%D8%A7%D9%84%D8%B9%D9%87%D8%AF-%D8%A3%D8%B1%D8%AF%D9%88%D8%BA%D8%A7%D9%86-%D9%8A%D8%AF%D9%8A%D9%86-%D9%87%D8%AC%D9%85%D8%A7%D8%AA-%D9%85%D9%84%D9%8A%D8%B4%D9%8A%D8%A7-%D8%A7%D9%84%D8%AD%D9%88%D8%AB%D9%8A-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%B3%D9%81%D9%86-%D8%A8%D8%A7%D9%84%D8%A8%D8%AD%D8%B1-%D8%A7%D9%84%D8%A3%D8%AD%D9%85%D8%B1\"> \u0627\u0644\u0627\u0654\u062d\u062f\u0627\u062b \u0627\u0644\u0627\u0655\u0642\u0644\u064a\u0645\u064a\u0629</a>\u060c \u0648\u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u0645\u0628\u0630\u0648\u0644\u0629 \u0628\u0634\u0627\u0654\u0646\u0647\u0627\u060c \u0628\u0645\u0627 