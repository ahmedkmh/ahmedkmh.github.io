47\u064a\u064a\u0654\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0627\u0655\u062d\u0635\u0627\u0621</a>\u060c \u0645\u0639 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0654\u0633\u0639\u0627\u0631 11 \u0635\u0646\u0641\u064b\u0627 \u0639\u0646 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642 \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0654\u0633\u0639\u0627\u0631 5 \u0627\u0654\u0635\u0646\u0627\u0641\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0633\u062a\u0642\u0631\u062a \u0627\u0644\u0627\u0654\u0635\u0646\u0627\u0641 \u0627\u0644\u0627\u0654\u062e\u0631\u0649 \u0639\u0646\u062f \u0645\u0633\u062a\u0648\u064a\u0627\u062a\u0647\u0627 \u0627\u0644\u0633\u0627\u0628\u0642\u0629.<h2>\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u062e\u0636\u0627\u0631 \u0641\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629</h2>\u0641\u064a \u0641\u064a\u0654\u0629 \u0627\u0644\u0648\u0631\u0642\u064a\u0627\u062a\u060c \u0627\u0646\u062e\u0641\u0636 \u0633\u0639\u0631 \u0627\u0644\u062e\u0633 \u0627\u0644\u0645\u062d\u0644\u064a \u0628\u0646\u0633\u0628\u0629 4% \u0627\u0655\u0644\u0649 6.3 <a href=\"https://www.alyaum.com/articles/6677846/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%B3%D8%B9%D8%B1-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D9%84-%D9%85%D9%82%D8%A7%D8%A8%D9%84-%D8%A7%D9%84%D8%AC%D9%86%D9%8A%D9%87-%D8%A7%D9%84%D9%8A%D9%88%D9%85-%D8%A7%D9%84%D8%AE%D9%85%D9%8A%D8%B3-%D8%A7%D8%B3%D8%AA%D9%82%D8%B1%D8%A7%D8%B1-%D9%81%D9%8A-%D8%A7%D9%84%D8%A8%D9%86%D9%88%D9%83-%D8%A7%D9%84%D9%85%D8%B5%D8%B1%D9%8A%D8%A9\" target=\"_blank\">\u0631\u064a\u0627\u0644 </a>\u0641\u064a \u064a\u0648\u0644\u064a\u0648 \u0645\u0642\u0627\u0628\u0644 6.6 \u0631\u064a\u0627\u0644 \u0642\u0628\u0644 \u0634\u0647\u0631\u060c \u0648\u0627\u0644\u0645\u0644\u0648\u062e\u064a\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 9.5% \u0627\u0655\u0644\u0649 2.4 \u0631\u064a\u0627\u0644 \u0645\u0642\u0627\u0628\u0644 2.6 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0633\u062a\u0642\u0631 \u0627\u0644\u062c\u0631\u062c\u064a\u0631 \u0639\u0646\u062f \u0631\u064a\u0627\u0644 \u0648\u0627\u062d\u062f \u0644\u0644\u062d\u0632\u0645\u0629\u060c \u0648\u0627\u0644\u0645\u0644\u0641\u0648\u0641 \u0627\u0644\u0627\u0654\u0628\u064a\u0636 \u0639\u0646\u062f 3.7 \u0631\u064a\u0627\u0644\u060c \u0648\u0627\u0644\u0633\u0628\u0627\u0646\u062e \u0639\u0646\u062f 1.3 \u0631\u064a\u0627\u0644 \u062f\u0648\u0646 \u062a\u063a\u064a\u064a\u0631 \u0639\u0646 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642.<h2>\u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0637\u0645\u0627\u0637\u0645 \u0648\u0627\u0644\u0628\u0635\u0644 \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f</h2> <br />\u0633\u062c\u0644 \u0633\u0639\u0631 \u0627\u0644\u0637\u0645\u0627\u0637\u0645 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 7.3 \u0631\u064a\u0627\u0644 \u0644\u0644\u0643\u064a\u0644\u0648 \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 \u0645\u062a\u0631\u0627\u062c\u0639\u064b\u0627 \u0628\u0646\u0633\u0628\u0629 10% \u0639\u0646 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642 (8.1 \u0631\u064a\u0627\u0644)\u060c \u0643\u0645\u0627 \u062a\u0631\u0627\u062c\u0639\u062a \u0627\u0644\u0637\u0645\u0627\u0637\u0645 \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f\u0629 \u0628\u0646\u0633\u0628\u0629 5% \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0627\u0655\u0644\u0649 7.6 \u0631\u064a\u0627\u0644 \u0645\u0642\u0627\u0628\u0644 7.9 \u0631\u064a\u0627\u0644\u060c \u0648\u062a\u0631\u0627\u062c\u0639 \u0633\u0639\u0631 \u0627\u0644\u0628\u0635\u0644 \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f 4% \u0627\u0655\u0644\u0649 4.6 \u0631\u064a\u0627\u0644 \u0645\u0642\u0627\u0628\u0644 4.8 \u0631\u064a\u0627\u0644 \u0642\u0628\u0644 \u0634\u0647\u0631.<br /><br />\u0648\u0627\u0654\u0638\u0647\u0631\u062a \u0646\u0634\u0631\u0629 <a href=\"https://www.alyaum.com/articles/6677841/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D9%84%D8%AA%D8%B6%D8%AE%D9%85-%D9%81%D9%8A-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D9%8A%D8%B3%D8%AC%D9%84-18-%D9%81%D9%8A-%D9%8A%D9%88%D9%84%D9%8A%D9%88-2026-%D8%A8%D8%AF%D8%B9%D9%85-%D9%85%D9%86-%D8%A7%D9%84%D8%B3%D9%83%D9%86\" target=\"_blank\">\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0633\u0644\u0639 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a</a> \u062a\u0631\u0627\u062c\u0639 \u0633\u0639\u0631 \u0627\u0644\u0641\u0644\u0641\u0644 \u0627\u0644\u0628\u0627\u0631\u062f \u0648\u0627\u0644\u062d\u0627\u0631 (\u0645\u062d\u0644\u064a) \u0628\u0646\u0633\u0628\u0629 4.4% \u06482% \u0639\u0644\u0649 \u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648\u060c \u0648\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0628\u0627\u0630\u0646\u062c\u0627\u0646 1.1% \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u062e\u064a\u0627\u0631 \u0628\u0646\u0633\u0628\u0629 2%.<br /><br />\u0648\u0633\u062c\u0644 \u0633\u0639\u0631 \u0627\u0644\u0643\u0648\u0633\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 6.9 \u0631\u064a\u0627\u0644 \u0644\u0644\u0643\u064a\u0644\u0648 \u0641\u064a \u064a\u0648\u0644\u064a\u0648 \u0645\u0631\u062a\u0641\u0639\u064b\u0627 3.1% \u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0634\u0647\u0631\u064a\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0646\u062e\u0641\u0636\u062a \u0627\u0644\u0628\u0627\u0645\u064a\u0629 \u0628\u0646\u0633\u0628\u0629 3% \u0627\u0655\u0644\u0649 16.6 \u0631\u064a\u0627\u0644 \u0645\u0642\u0627\u0628\u0644 17.1 \u0631\u064a\u0627\u0644 \u0642\u0628\u0644 \u0634\u0647\u0631\u060c \u0648\u0627\u0631\u062a\u0641\u0639 \u0627\u0644\u062c\u0632\u0631 \u0627\u0644\u0645\u062d\u0644\u064a 7.4% \u0627\u0655\u0644\u0649 6.7 \u0631\u064a\u0627\u0644.<h2>\u0627\u0644\u062f\u0631\u0646\u0627\u062a \u0648\u0627\u0644\u0628\u0642\u0648\u0644\u064a\u0627\u062a</h2> <br />\u0627\u0654\u0634\u0627\u0631\u062a \u0628\u064a\u0627\u0646\u0627\u062a \"\u0627\u0644\u0627\u0655\u062d\u0635\u0627\u0621\" \u0644\u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 \u0627\u0655\u0644\u0649 \u0627\u0633\u062a\u0642\u0631\u0627\u0631 \u0633\u0639\u0631 \u0627\u0644\u0628\u0635\u0644 \u0627\u0644\u0645\u062d\u0644 \u0639\u0646\u062f 3.9 \u0631\u064a\u0627\u0644 \u062f\u0648\u0646 \u062a\u063a\u064a\u064a\u0631 \u0639\u0646 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0628\u0637\u0627\u0637\u0633 \u0627\u0644\u0645\u062d\u0644\u064a 5% \u0627\u0655\u0644\u0649 4.5 \u0631\u064a\u0627\u0644 \u0645\u0642\u0627\u0628\u0644 4.3 \u0631\u064a\u0627\u0644 \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642. \u0627\u0654\u0645\u0627 \u0627\u0644\u062b\u0648\u0645 \u0627\u0644\u0635\u064a\u0646\u064a \u0641\u0642\u062f \u0627\u0646\u062e\u0641\u0636 \u0628\u0646\u0633\u0628\u0629 4.5% \u0627\u0655\u0644\u0649 12 \u0631\u064a\u0627\u0644\u0627\u064b \u0645\u0642\u0627\u0628\u0644 12.6 \u0631\u064a\u0627\u0644 \u0628\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0633\u0627\u0628\u0642.<br /><br />\u0645\u0646 \u062c\u0627\u0646\u0628 \u0627\u0653\u062e\u0631\u060c \u0627\u0633\u062a\u0642\u0631\u062a \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0641\u0648\u0644 (4.7 \u0631\u064a\u0627\u0644 \u0644\u0644\u0639\u0628\u0648\u0629 \u062d\u062f\u0627\u064a\u0654\u0642 \u0643\u0627\u0644\u064a\u0641\u0648\u0631\u0646\u064a\u0627) \u0648\u0627\u0644\u0639\u062f\u0633 (9.5 \u0631\u064a\u0627\u0644 \u0644\u0644\u0643\u064a\u0644\u0648)\u060c \u0648\u0627\u0644\u0630\u0631\u0629 \u0627\u0644\u062d\u0644\u0648\u0629 (6.2 \u0631\u064a\u0627\u0644 \u0644\u0644\u0639\u0628\u0648\u0629 340 \u062c\u0645)\u060c \u0648\u0627\u0644\u0635\u0644\u0635\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 (\u0631\u064a\u0627\u0644\u0627\u0646) \u0639\u0646\u062f \u0645\u0633\u062a\u0648\u064a\u0627\u062a\u0647\u0627 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u062f\u0648\u0646 \u062a\u063a\u064a\u064a\u0631.<br />", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0634\u0647\u0631\u064a", "\u0627\u0646\u062e\u0641\u0627\u0636", "10%..", "\u0623\u0633\u0627\u0633", "\u0641\u064a", "\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629", "\u0628\u0646\u0633\u0628", "\u0627\u0644\u062e\u0636\u0627\u0631", "\u062a\u0635\u0644", "\u0623\u0633\u0639\u0627\u0631", "\u0639\u0644\u0649"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["business"], "datatype": "news", "pubDate": "2026-08-16 10:31:00", "pubDateTZ": "UTC", "fetched_at": "2026-08-16 10:50:15", "image_url": "https://www.alyaum.com/uploads/images/2026/08/16/3083078.jpg", "video_url": null, "source_id": "alyaum", "source_name": "Alyaum", "source_priority": 933841, "source_url": "https://www.alyaum.com", "source_icon": "https://n.bytvi.com/alyaum.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}, {"article_id": "1b71c0fa0e2ba47a162ac115724494ec", "link": "https://menafn.com/1111549206/Delhi-BJP-Slams-Kejriwal-For-Overlooking-Harassment-Of-Dalit-AAP-Worker", "title": "Delhi BJP Slams Kejriwal For Overlooking Harassment Of Dalit AAP Worker", "description": "(MENAFN - IANS) New Delhi, Aug 16 (IANS) Delhi Bharatiya Janata Party (BJP) Media Head and Spokesperson P