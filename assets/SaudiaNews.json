644 \u0639\u0644\u0649 \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0641\u064a \u0645\u0628\u0627\u0631\u0627\u0629 \u0645\u062b\u064a\u0631\u0629 \u0628\u0640 \u0631\u0648\u0634\u0646", "description": "\u0641\u0631\u0636 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0627\u0644\u062a\u0639\u0627\u062f\u0644 3-3\u060c \u0639\u0644\u0649 \u062c\u0627\u0631\u0647 \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0641\u064a \u0645\u0628\u0627\u0631\u0627\u0629 \u0645\u062b\u064a\u0631\u0629 \u062c\u0645\u0639\u062a\u0647\u0645\u0627 \u0627\u0644\u062c\u0645\u0639\u0629\u060c \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \u0627\u0644\u0627\u0654\u0645\u064a\u0631 \u0645\u062d\u0645\u062f \u0628\u0646 \u0641\u0647\u062f \u0628\u0627\u0644\u062f\u0645\u0627\u0645\u060c \u0641\u064a \u0642\u0645\u0629 \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u062c\u0648\u0644\u0629 \u0627\u0644\u0633\u0627\u0628\u0639\u0629 \u0644\u062f\u0648\u0631\u064a \u0631\u0648\u0634\u0646 \u0627\u0644\u0633\u0639\u0648\u062f\u064a .<br />\u0633\u062c\u0644 \u0644\u0644\u0642\u0627\u062f\u0633\u064a\u0629\u060c \u0627\u0644\u0645\u0643\u0633\u064a\u0643\u064a \u062c\u0648\u0644\u064a\u0627\u0646 \u0643\u064a\u0646\u064a\u0648\u0646\u064a\u0633 (12) \u0648\u0627\u0644\u0627\u0655\u064a\u0637\u0627\u0644\u064a \u0645\u0627\u062a\u064a\u0648 \u0631\u064a\u062a\u064a\u063a\u064a (15) \u0648\u0645\u062d\u0645\u062f \u0627\u0644\u0642\u062d\u0637\u0627\u0646\u064a (82) \u0641\u064a\u0645\u0627 \u0633\u062c\u0644 \u0644\u0644\u0627\u062a\u0641\u0627\u0642\u060c \u0627\u0644\u0643\u0648\u0633\u0648\u0641\u064a \u0628\u064a\u0631\u0633\u0627\u0646\u062a \u0633\u064a\u0644\u064a\u0646\u0627 (26) \u0648\u0627\u0644\u0627\u0655\u0633\u0628\u0627\u0646\u064a \u0627\u0654\u0644\u0641\u0627\u0631\u0648 \u0645\u064a\u062f\u0631\u0627\u0646 (64) \u0648\u0627\u0644\u0633\u0648\u064a\u062f\u064a \u062c\u0648\u0631\u062f\u0627\u0646 \u0644\u0627\u0631\u0633\u0648\u0646 (85) .<br />\u0648\u0631\u0641\u0639 \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0631\u0635\u064a\u062f\u0647 \u0627\u0655\u0644\u0649 16 \u0646\u0642\u0637\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0631\u0641\u0639 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0631\u0635\u064a\u062f\u0647 \u0627\u0655\u0644\u0649 11 \u0646\u0642\u0637\u0629 .<br />\u0648\u062f\u0627\u0646\u062a \u0627\u0644\u0627\u0654\u0641\u0636\u0644\u064a\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u0627\u0654\u0648\u0644 \u0644\u0644\u0642\u0627\u062f\u0633\u064a\u0629\u060c \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u0642\u0631\u064a\u0628\u0627\u064b \u0645\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0644\u0648\u0644\u0627 \u0627\u0644\u0639\u0627\u0631\u0636\u0629 \u0627\u0644\u062a\u064a \u062a\u0635\u062f\u062a \u0644\u0631\u0627\u0654\u0633\u064a\u0629 \u0627\u0644\u0627\u0655\u0633\u0628\u0627\u0646\u064a \u0646\u0627\u062a\u0634\u0648 (7) \u0648\u0645\u0646 \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629 \u0646\u062c\u062d \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0641\u064a \u0642\u0635 \u0634\u0631\u064a\u0637 \u0627\u0644\u0627\u0654\u0647\u062f\u0627\u0641 \u0639\u0646\u062f\u0645\u0627 \u062a\u0627\u0628\u0639 \u0627\u0644\u0645\u0643\u0633\u064a\u0643\u064a \u062c\u0648\u0644\u064a\u0627\u0646 \u0643\u064a\u0646\u064a\u0648\u0646\u064a\u0633 \u0627\u0644\u0643\u0631\u0629 \u0648\u0644\u0639\u0628\u0647\u0627 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0631\u0645\u0649 (12) \u0648\u0628\u0639\u062f \u062b\u0644\u0627\u062b \u062f\u0642\u0627\u064a\u0654\u0642\u060c \u0648\u0645\u0646 \u0647\u062c\u0645\u0629 \u0633\u0631\u064a\u0639\u0629 \u0639\u0645\u0642 \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0627\u0644\u0641\u0627\u0631\u0642 \u0639\u0646\u062f\u0645\u0627 \u0627\u0633\u062a\u0642\u0628\u0644 \u0627\u0644\u0627\u0655\u064a\u0637\u0627\u0644\u064a \u0645\u0627\u062a\u064a\u0648 \u0631\u064a\u062a\u064a\u063a\u064a \u0643\u0631\u0629 \u0639\u0631\u0636\u064a\u0629 \u0648\u0644\u0639\u0628\u0647\u0627 \u0645\u0628\u0627\u0634\u0631\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0631\u0645\u0649 (15) \u0648\u0644\u0627\u062d\u062a \u0641\u0631\u0635\u0629 \u0644\u0644\u0627\u062a\u0641\u0627\u0642 \u0644\u062a\u0642\u0644\u064a\u0635 \u0627\u0644\u0641\u0627\u0631\u0642 \u0644\u0643\u0646 \u0643\u0631\u0629 \u0627\u0644\u0627\u0655\u064a\u0641\u0648\u0627\u0631\u064a \u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0643\u0627\u0646\u062a\u064a \u0645\u0631\u062a \u0628\u062c\u0627\u0646\u0628 \u0627\u0644\u0642\u0627\u064a\u0654\u0645 (18) \u0648\u0645\u0646 \u062a\u0645\u0631\u064a\u0631\u0629 \u0631\u0627\u064a\u0654\u0639\u0629 \u062a\u0645\u0643\u0646 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0645\u0646 \u062a\u0633\u062c\u064a\u0644 \u0647\u062f\u0641\u0647 \u0627\u0644\u0627\u0654\u0648\u0644\u060c \u0639\u0646\u062f\u0645\u0627 \u0627\u0633\u062a\u0644\u0645 \u0627\u0644\u0643\u0648\u0633\u0648\u0641\u064a \u0628\u064a\u0631\u0633\u0627\u0646\u062a \u0633\u064a\u0644\u064a\u0646\u0627 \u0627\u0644\u0643\u0631\u0629 \u0648\u0635\u0648\u0628\u0647\u0627 \u0642\u0648\u064a\u0629 \u0639\u0644\u0649 \u064a\u0633\u0627\u0631 \u0627\u0644\u0628\u0644\u062c\u064a\u0643\u064a \u0643\u0648\u064a\u0646 \u0643\u0627\u0633\u062a\u064a\u0644\u0633 (26) \u0648\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062d\u062a\u0633\u0628 \u0628\u062f\u0644 \u0627\u0644\u0636\u0627\u064a\u0654\u0639 \u0643\u0627\u062f \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0627\u0654\u0646 \u064a\u0639\u0627\u062f\u0644 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0644\u0648\u0644\u0627 \u062a\u062f\u062e\u0644 \u062c\u0647\u0627\u062f \u0630\u0643\u0631\u064a \u0627\u0644\u0630\u064a \u0627\u0628\u0639\u062f \u0627\u0644\u0643\u0631\u0629 \u0644\u0644\u0631\u0643\u0646\u064a\u0629 .<br />\u0648\u0641\u064a \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u062b\u0627\u0646\u064a \u0628\u062d\u062b \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0639\u0646 \u0627\u0644\u062a\u0639\u0627\u062f\u0644 \u0648\u062a\u062d\u0642\u0642 \u0644\u0647 \u0645\u0627 \u0627\u0654\u0631\u0627\u062f \u0639\u0646\u062f\u0645\u0627 \u0635\u0648\u0628 \u0627\u0644\u0627\u0655\u0633\u0628\u0627\u0646\u064a \u0627\u0644\u0641\u0627\u0631\u0648 \u0645\u064a\u062f\u0631\u0627\u0646 \u0643\u0631\u0629 \u0642\u0648\u064a\u0629 \u0627\u0633\u062a\u0642\u0631\u062a \u0639\u0644\u0649 \u064a\u0645\u064a\u0646 \u0643\u0627\u0633\u062a\u064a\u0644\u0633 (64) \u0648\u0644\u0627\u062d\u062a \u0643\u0631\u0629 \u0644\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0644\u0645\u0639\u0627\u0648\u062f\u0629 \u0627\u0644\u062a\u0642\u062f\u0645\u060c \u0644\u0643\u0646 \u0643\u0631\u0629 \u0627\u0644\u063a\u0627\u0646\u064a \u0628\u0648\u0646\u0633\u0648 \u0628\u0627\u0647 \u0645\u0631\u062a \u0628\u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u0642\u0627\u064a\u0654\u0645 (66) \u0631\u062f \u0639\u0644\u064a\u0647 \u0627\u0644\u0627\u062a\u0641\u0627\u0642 \u0628\u0648\u0627\u0633\u0637\u0629 \u0627\u0644\u0633\u0648\u064a\u062f\u064a \u062c\u0648\u0631\u062f\u0627\u0646 \u0644\u0627\u0631\u0633\u0648\u0646 \u0627\u0644\u0630\u064a \u0635\u0648\u0628 \u0643\u0631\u0629 \u0642\u0648\u064a\u0629 \u0645\u0631\u062a \u0628\u062c\u0648\u0627\u0631 \u0627\u0644\u0642\u0627\u064a\u0654\u0645 (69) \u0648\u0645\u0646 \u0647\u062c\u0645\u0629 \u0645\u0646\u0633\u0642\u0629 \u0646\u062c\u062d \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0641\u064a \u062a\u0633\u062c\u064a\u0644 \u0647\u062f\u0641\u0647 \u0627\u0644\u062b\u0627\u0644\u062b \u0639\u0646\u062f\u0645\u0627 \u062a\u0644\u0642\u0649 \u0627\u0644\u0628\u062f\u064a\u0644 \u0645\u062d\u0645\u062f \u0627\u0644\u0642\u062d\u0637\u0627\u0646\u064a \u0643\u0631\u0629 \u062f\u0627\u062e\u0644 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u0632\u0627\u0621\u060c \u0644\u0639\u0628\u0647\u0627 \u0639\u0644\u0649 \u064a\u0645\u064a\u0646 \u062a\u0631\u0643\u064a \u062