062b\u064a\u064a\u0646 \u0628\u0627\u0654\u0646\u0647 \"\u0645\u0634\u0631\u0648\u0639 \u0627\u0655\u064a\u0631\u0627\u0646\u064a\" \u0648\"\u0645\u0634\u0631\u0648\u0639 \u0644\u0644\u062d\u0631\u0633 \u0627\u0644\u062b\u0648\u0631\u064a\"\u060c \u0648\u0627\u0654\u0646 \u0637\u0647\u0631\u0627\u0646 \u062d\u0627\u0648\u0644\u062a \u062a\u0648\u0633\u064a\u0639 \u0647\u0627\u0645\u0634 \u0627\u0644\u0645\u0646\u0627\u0648\u0631\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0645\u0646 \u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632 \u0627\u0655\u0644\u0649 \u0628\u0627\u0628 \u0627\u0644\u0645\u0646\u062f\u0628 \u0639\u0628\u0631 \u062d\u0644\u0641\u0627\u064a\u0654\u0647\u0627 \u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646.<br />\u0648\u0627\u0654\u0643\u062f \u0627\u0654\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u062a\u0645\u0631\u0643\u0632\u0629 \u0641\u064a \u0627\u0644\u0633\u0627\u062d\u0644 \u0627\u0644\u063a\u0631\u0628\u064a \u062a\u0639\u0645\u0644 \u0639\u0644\u0649 \u0645\u0646\u0639 \u0630\u0644\u0643\u060c \u0648\u0627\u0654\u0646 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u062d\u062f\u064a\u062f\u0629 \u0644\u0627 \u062a\u0632\u0627\u0644 \u0636\u0645\u0646 \u0627\u0654\u0647\u062f\u0627\u0641 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629.</p>", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0637\u0627\u0631\u0642", "\u0627\u0644\u062d\u0648\u062b\u064a\u0648\u0646", "\u0641\u0627\u062f\u062d\u0629", "\u0648\u0646\u0633\u062a\u0639\u062f", "\u0644\u0644\u0645\u0639\u0631\u0643\u0629", "\u064a\u062a\u0643\u0628\u062f\u0648\u0646", "\u062e\u0633\u0627\u0626\u0631", "\u0635\u0627\u0644\u062d:", "\u0627\u0644\u0641\u0627\u0635\u0644\u0629"], "creator": ["\u0627\u0644\u064a\u0648\u0645 - \u0627\u0644\u062f\u0645\u0627\u0645"], "language": "arabic", "country": ["saudi arabia"], "category": ["crime", "politics", "top"], "datatype": "n