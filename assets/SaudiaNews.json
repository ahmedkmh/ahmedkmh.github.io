u062a\u0645\u0628\u0631 2026 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u0645\u0646 \u0645\u0644\u062a\u0642\u0649 \u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631 \u0644\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629 2026\u060c \u0627\u0644\u0630\u064a \u062a\u0646\u0638\u0645\u0647 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0642\u0627\u0628\u0636\u0629.<br /><br />\u0648\u064a\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0644\u062a\u0642\u0649 \u0627\u0654\u062d\u062f\u062b \u0627\u0644\u062a\u0648\u062c\u0647\u0627\u062a \u0648\u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631\u0627\u062a \u0641\u064a \u0642\u0637\u0627\u0639<a href=\"https://www.alyaum.com/articles/6638674/%D8%A7%D9%84%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF/%D9%85%D8%A7%D9%84-%D9%88%D8%A3%D8%B9%D9%85%D8%A7%D9%84/%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A%D8%A9-%D8%AA%D8%AA%D8%B5%D8%AF%D8%B1-%D8%A5%D9%82%D9%84%D9%8A%D9%85%D9%8A%D8%A7-%D8%A7%D8%B3%D8%AA%D8%AB%D9%85%D8%A7%D8%B1%D8%A7%D8%AA-%D8%A7%D9%84%D8%B5%D8%AD%D8%A9-%D9%88%D9%86%D9%85%D9%88-%D9%82%D9%8A%D8%A7%D8%B3%D9%8A-%D9%81%D9%8A-%D8%A7%D9%84%D8%B3%D8%AC%D9%84%D8%A7%D8%AA-%D8%A7%D9%84%D8%AA%D8%AC%D8%A7%D8%B1%D9%8A%D8%A9\" target=\"_blank\"> \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629</a>\u060c \u0628\u0645\u0634\u0627\u0631\u0643\u0629 \u0646\u062e\u0628\u0629 \u0645\u0646 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 \u0648\u0627\u0644\u0628\u0627\u062d\u062b\u064a\u0646 \u0648\u0627\u0644\u0645\u062a\u062e\u0635\u0635\u064a\u0646 \u0627\u0644\u0645\u062d\u0644\u064a\u064a\u0646 \u0648\u0627\u0644\u062f\u0648\u0644\u064a\u064a\u0646.</div><h2 style=\"text-align:justify\">\u0633\u0627\u0639\u0627\u062a \u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0645\u0647\u0646\u064a</h2><div style=\"text-align: justify;\"><br />\u0648\u064a\u0642\u062f\u0645 \u0627\u0644\u0645\u0644\u062a\u0642\u0649 30 \u0633\u0627\u0639\u0629 \u062a\u062f\u0631\u064a\u0628\u064a\u0629 \u0636\u0645\u0646 \u0633\u0627\u0639\u0627\u062a \u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0645\u0647\u0646\u064a \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0645\u0646 \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0644\u0644\u062a\u062e\u0635\u0635\u0627\u062a \u0627\u0644\u0635\u062d\u064a\u0629\u060c \u0648\u064a\u0633\u062a\u0647\u062f\u0641 \u0627\u0633\u062a\u0639\u0631\u0627\u0636 <a href=\"https://www.alyaum.com/articles/6622363/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D9%84%D8%A3%D9%88%D9%84-%D9%85%D8%B1%D8%A9-%D8%A7%D9%84%D8%B0%D9%83%D8%A7%D8%A1-%D8%A7%D9%84%D8%A7%D8%B5%D8%B7%D9%86%D8%A7%D8%B9%D9%8A-%D9%8A%D9%82%D9%88%D8%AF-%D8%AA%D8%AD%D9%88%D9%84%D8%A7-%D9%86%D9%88%D8%B9%D9%8A%D8%A7-%D9%81%D9%8A-%D8%A7%D9%84%D9%85%D8%AE%D8%AA%D8%A8%D8%B1%D8%A7%D8%AA-%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%A9-%D8%A8%D8%A7%D9%84%D8%B4%D8%B1%D9%82%D9%8A%D8%A9\" target=\"_blank\">\u0627\u0654\u062d\u062f\u062b \u0627\u0644\u062a\u0637\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0644\u0645\u064a\u0629</a> \u0648\u0627\u0644\u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u062d\u062f\u064a\u062b\u0629 \u0627\u0644\u062a\u064a \u062a\u0633\u0647\u0645 \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u062c\u0648\u062f\u0629 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629\u060c \u0648\u062a\u0633\u0647\u064a\u0644 \u062d\u0635\u0648\u0644 \u0627\u0644\u0645\u0633\u062a\u0641\u064a\u062f\u064a\u0646 \u0639\u0644\u064a\u0647\u0627 \u0648\u0641\u0642 \u0645\u0639\u0627\u064a\u064a\u0631 \u0639\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u062f\u0642\u0629 \u0648\u0627\u0644\u062c\u0648\u062f\u0629\u060c \u0628\u0645\u0627 \u064a\u0639\u0632\u0632 \u0645\u0628\u062f\u0627\u0654 \u0627\u0644\u0648\u0642\u0627\u064a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0639\u0644\u0627\u062c\u060c \u0648\u064a\u062f\u0639\u0645 \u0645\u0633\u062a\u0647\u062f\u0641\u0627\u062a \u0628\u0631\u0646\u0627\u0645\u062c \u062a\u062d\u0648\u0644 \u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0635\u062d\u064a\u060c \u0627\u0654\u062d\u062f \u0628\u0631\u0627\u0645\u062c \u0631\u0648\u0654\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 2030.<br /><br />\u0648\u062a\u062a\u0646\u0648\u0639 \u0627\u0654\u062c\u0646\u062f\u0629 \u0627\u0644\u0645\u0644\u062a\u0642\u0649 \u0628\u064a\u0646 \u0627\u0644\u062c\u0644\u0633\u0627\u062a \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0648\u0648\u0631\u0634 \u0627\u0644\u0639\u0645\u0644 \u0648\u0627\u0644\u0645\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u060c \u0648\u062a\u062a\u0646\u0627\u0648\u0644 \u0639\u062f\u062f\u064b\u0627 \u0645\u0646 \u0627\u0644\u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629\u060c \u0645\u0646 \u0627\u0654\u0628\u0631\u0632\u0647\u0627 \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u0645\u062e\u0628\u0631\u064a\u060c \u0648\u0627\u0644\u0628\u062d\u062b \u0627\u0644\u0639\u0644\u0645\u064a\u060c \u0648\u0627\u0644\u062a\u062d\u0648\u0644 \u0627\u0644\u0631\u0642\u0645\u064a\u060c \u0648\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0648\u0627\u0644\u0627\u0654\u062a\u0645\u062a\u0629\u060c \u0648\u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\u060c \u0648\u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u064a\u0629\u060c \u0628\u0645\u0627 \u064a\u062a\u064a\u062d \u062a\u0628\u0627\u062f\u0644 \u0627\u0644\u062e\u0628\u0631\u0627\u062a \u0648\u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0627\u0654\u0641\u0636\u0644 \u0627\u0644\u0645\u0645\u0627\u0631\u0633\u0627\u062a \u0648\u0628\u0646\u0627\u0621 \u0634\u0631\u0627\u0643\u0627\u062a \u062a\u0633\u0647\u0645 \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0648\u0631\u0641\u0639 \u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0635\u062d\u064a\u0629.</div><h2 style=\"text-align:justify\">\u00ab\u0644\u0627\u0628\u0627\u062b\u0648\u0646\u00bb \u0644\u0644\u0627\u0628\u062a\u0643\u0627\u0631</h2><div style=\"text-align: justify;\"><br />\u0648\u0636\u0645\u0646 \u0627\u0654\u0639\u0645\u0627\u0644 \u0627\u0644\u0645\u0644\u062a\u0642\u0649\u060c \u064a\u0642\u0627\u0645 \u00ab\u0644\u0627\u0628\u0627\u062b\u0648\u0646\u00bb\u060c \u0648\u0647\u0648 \u062a\u062d\u062f\u064d \u0648\u0637\u0646\u064a \u0644\u0644\u0627\u0628\u062a\u0643\u0627\u0631 \u0641\u064a \u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629\u060c \u064a\u0647\u062f\u0641 \u0627\u0655\u0644\u0649 \u062a\u0637\u0648\u064a\u0631 \u062d\u0644\u0648\u0644 \u0645\u0628\u062a\u0643\u0631\u0629 \u0644\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0627\u0644\u0648\u0627\u0642\u0639\u064a\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0654\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0648\u0628\u0646\u064a\u062a\u0647\u0627 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0648\u0627\u0644\u062a\u0634\u062e\u064a\u0635\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629.<br /><br />\u0648\u064a\u062c\u0645\u0639 \u0627\u0644\u062a\u062d\u062f\u064a \u0641\u0631\u0642\u064b\u0627 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u062a\u062e\u0635\u0635\u0627\u062a \u062a\u0636\u0645 \u0627\u0644\u0645\u0637\u0648\u0631\u064a\u0646 \u0648\u0639\u0644\u0645\u0627\u0621 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0645\u0645\u0627\u0631\u0633\u064a\u0646 \u0627\u0644\u0635\u062d\u064a\u064a\u0646 \u0648\u0627\u0644\u0645\u0647\u0646\u062f\u0633\u064a\u0646 \u0648\u0627\u0644\u0645\u062a\u062e\u0635\u0635\u064a\u0646 \u0641\u064a \u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631\u060c \u0644\u0644\u0639\u0645\u0644 \u0639\u0644\u0649 \u062a\u0637\u0648\u064a\u0631 \u0646\u0645\u0627\u0630\u062c \u0627\u0654\u0648\u0644\u064a\u0629 \u0648\u062d\u0644\u0648\u0644 \u0631\u0642\u0645\u064a\u0629 \u0648\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0648\u0633\u0639 \u0648\u0627\u0644\u062a\u0637\u0628\u064a\u0642.<br /><br />\u0643\u0645\u0627 \u064a\u0634\u0647\u062f \u0627\u0644\u0645\u0644\u062a\u0642\u0649 \u0645\u0646\u0627\u0642\u0634\u0629 \u0627\u0654\u062d\u062f\u062b \u0627\u0644\u062a\u0642\u0646\u064a\u0627\u062a \u0648\u0627\u0644\u062d\u0644\u0648\u0644 \u0627\u0644\u0645\u0628\u062a\u0643\u0631\u0629 \u0641\u064a \u0642\u0637\u0627\u0639 \u0627\u0644\u0645\u062e\u062a\u0628\u0631\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0629\u060c \u0628\u0645\u0627 \u064a\u062a\u0645\u0627\u0634\u0649 \u0645\u0639 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0635\u062d\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0628\u0645\u062e\u062a\u0644\u0641 \u0627\u0654\u0646\u0638\u0645\u062a\u0647 \u0648\u0645\u0633\u0627\u0631\u0627\u062a\u0647\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0627\u0644\u062a\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u0634\u062e\u064a\u0635 \u0627\u0644\u062f\u0642\u064a\u0642 \u0648\u0627\u0644\u0637\u0628 \u0627\u0644\u0645\u062e\u0628\u0631\u064a \u0648\u0627\u0644\u0627\u0628\u062a\u0643\u0627\u0631 \u0648\u0627\u0644\u0627\u0633\u062a\u062f\u0627\u0645\u0629\u060c \u0628\u0645\u0627 \u064a\u0639\u0632\u0632 \u062c\u