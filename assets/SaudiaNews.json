u062a\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629.\u0648\u062a\u062a\u064a\u062d \u0627\u0644\u0644\u0627\u0626\u062d\u0629 \u0644\u0644\u0647\u064a\u0626\u0629 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0648\u0642\u0627\u0641 \u0627\u0644\u0645\u062c\u0647\u0648\u0644\u0629 \u0648\u0627\u0644\u0645\u0639\u0637\u0644\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0628\u0644\u0627\u063a\u0627\u062a \u0627\u0644\u0639\u0645\u0648\u0645\u060c \u0623\u0648 \u0645\u062e\u0627\u0637\u0628\u0629 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u064a\u0629 \u0648\u0627\u0644\u0642\u0636\u0627\u0626\u064a\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0648\u0642\u0627\u0641\u060c \u0623\u0648 \u062a\u0644\u0642\u064a \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0645\u0646 \u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629. \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0648\u0642\u0641 \u0627\u0644\u0645\u062c\u0647\u0648\u0644\u0648\u0639\u0631\u0651\u0641\u062a \u0627\u0644\u0644\u0627\u0626\u062d\u0629 \u0627\u0644\u0648\u0642\u0641 \u0627\u0644\u0645\u062c\u0647\u0648\u0644 \u0628\u0623\u0646\u0647 \u0627\u0644\u0648\u0642\u0641 \u0623\u0648 \u0627\u0644\u0648\u0635\u064a\u0629 \u0628\u0648\u0642\u0641 \u0627\u0644\u0630\u064a \u062a\u0639\u0637\u0644 \u0645\u0635\u0631\u0641\u0647 \u0648\u062a\u0646\u0637\u0628\u0642 \u0639\u0644\u064a\u0647 \u062d\u0627\u0644\u0627\u062a \u0645\u062d\u062f\u062f\u0629\u060c \u0645\u0646 \u0623\u0628\u0631\u0632\u0647\u0627 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0646\u0627\u0638\u0631\u060c \u0623\u0648 \u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0646\u0627\u0638\u0631 \u0623\u0648 \u0645\u0646 \u0628\u064a\u062f\u0647 \u0627\u0644\u0648\u0642\u0641 \u0644\u0644\u0648\u0642\u0641\u064a\u0629\u060c \u0623\u0648 \u0639\u062f\u0645 \u0639\u0644\u0645 \u0627\u0644\u0646\u0627\u0638\u0631 \u0628\u0645\u0643\u0627\u0646 \u0627\u0644\u0648\u0642\u0641 \u0623\u0648 \u0628\u0646\u0638\u0627\u0631\u062a\u0647 \u0639\u0644\u064a\u0647 \u0623\u0648 \u0628\u0645\u0633\u062a\u0646\u062f\u0627\u062a\u0647 \u0627\u0644\u062f\u0627\u0644\u0629 \u0639\u0644\u0649 \u0627\u0644\u0648\u0642\u0641\u064a\u0629 \u0623\u0648 \u0627\u0644\u0645\u0644\u0643\u064a\u0629. \u0641\u064a\u0645\u0627 \u0639\u0631\u0651\u0641\u062a \u0627\u0644\u0648\u0642\u0641 \u0627\u0644\u0645\u0639\u0637\u0644 \u0628\u0623\u0646\u0647 \u0627\u0644\u0648\u0642\u0641 \u0627\u0644\u0630\u064a \u0644\u0647 \u0646\u0627\u0638\u0631 \u0648\u062a\u0639\u0637\u0644 \u0631\u064a\u0639 \u0623\u0635\u0644\u0647 \u0643\u0644\u064a\u0627\u064b \u0644\u0645\u062f\u0629 \u0633\u0646\u062a\u064a\u0646 \u0645\u062a\u062a\u0627\u0644\u064a\u062a\u064a\u0646\u060c \u0623\u0648 \u062a\u0639\u0637\u0644 \u0627\u0644\u0627\u0646\u062a\u0641\u0627\u0639 \u0645\u0646 \u0623\u0635\u0644 \u0645\u0648\u0642\u0648\u0641 \u0630\u064a \u0646\u0641\u0639 \u0645\u0628\u0627\u0634\u0631 \u0643\u0644\u064a\u0627\u064b \u0648\u0641\u0642 \u0634\u0631\u0637 \u0627\u0644\u0648\u0627\u0642\u0641 \u0644\u0644\u0645\u062f\u0629 \u0646\u0641\u0633\u0647\u0627.\u0648\u064a\u062c\u0648\u0632 \u0644\u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0635\u0644\u062d\u0629 \u0637\u0644\u0628 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0648\u0642\u0641 \u0645\u062c\u0647\u0648\u0644 \u0623\u0648 \u062a\u0637\u0628\u064a\u0642 \u0635\u0643 \u0627\u0644\u0648\u0642\u0641\u064a\u0629 \u0628\u0634\u0623\u0646\u0647 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0645\u062c\u0647\u0648\u0644 \u0627\u0644\u0645\u0643\u0627\u0646\u060c \u0643\u0645\u0627 \u064a\u0645\u0643\u0646\u0647 \u0637\u0644\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0647\u064a\u0626\u0629 \u0641\u064a \u0625\u062d\u064a\u0627\u0621 \u0648\u0642\u0641 \u0645\u0639\u0637\u0644 \u0648\u062a\u0646\u0645\u064a\u062a\u0647.\u0648\u0627\u0634\u062a\u0631\u0637\u062a \u0627\u0644\u0644\u0627\u0626\u062d\u0629 \u0644\u0642\u0628\u0648\u0644 \u0627\u0644\u0628\u0644\u0627\u063a \u0639\u0646 \u0627\u0644\u0648\u0642\u0641 \u0627\u0644\u0645\u062c\u0647\u0648\u0644 \u0623\u0646 \u064a\u0643\u0648\u0646 \u063a\u064a\u0631 \u0645\u0639\u0644\u0648\u0645 \u0644\u062f\u0649 \u0627\u0644\u0647\u064a\u0626\u0629\u060c \u0648\u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u0624\u064a\u062f\u0627\u064b \u0628\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0645\u0639\u062a\u0628\u0631\u0629 \u0648\u0641\u0642 \u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u062b\u0628\u0627\u062a\u060c \u0648\u0623\u0646 \u064a\u0642\u062f\u0645 \u0639\u0628\u0631 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0647\u064a\u0626\u0629 \u0623\u0648 \u0623\u064a \u0648\u0633\u064a\u0644\u0629 \u062a\u062d\u062f\u062f\u0647\u0627\u060c \u0648\u0623\u0644\u0627 \u064a\u0643\u0648\u0646 \u0642\u062f \u0633\u0628\u0642 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0627\u0644\u0648\u0642\u0641\u060c \u0645\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0628\u0644\u0627\u063a \u0627\u0644\u0644\u0627\u062d\u0642 \u0645\u0646\u062a\u062c\u0627\u064b \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u062f\u0639\u0648\u0649 \u0642\u0627\u0626\u0645\u0629 \u0628\u0634\u0623\u0646 \u0646\u0638\u0627\u0631\u0629 \u0627\u0644\u0648\u0642\u0641 \u0623\u0648 \u0625\u062b\u0628\u0627\u062a\u0647 \u0623\u0648 \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0641\u064a\u0647. \u0627\u0633\u062a\u064a\u0641\u0627\u0621 \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0644\u0627\u0626\u062d\u0629\u0648\u064a\u0633\u062a\u062d\u0642 \u0627\u0644\u0645\u0628\u0644\u0651\u063a \u0639\u0646 \u0627\u0644\u0648\u0642\u0641 \u0627\u0644\u0645\u062c\u0647\u0648\u0644 \u0645\u0643\u0627\u0641\u0623\u0629 \u0648\u0641\u0642 \u0645\u0627 \u062a\u0642\u0631\u0631\u0647 \u0644\u062c\u0646\u0629 \u0627\u0644\u0623\u0648\u0642\u0627\u0641 \u0627\u0644\u0645\u062c\u0647\u0648\u0644\u0629\u060c \u0634\u0631\u064a\u0637\u0629 \u0627\u0633\u062a\u064a\u0641\u0627\u0621 \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0644\u0627\u0626\u062d\u0629 \u0648\u0623\u0644\u0627 \u064a\u0643\u0648\u0646 \u0646\u0627\u0638\u0631 \u0627\u0644\u0648\u0642\u0641 \u0623\u0648 \u0645\u0639\u062a\u062f\u064a\u0627\u064b \u0639\u0644\u064a\u0647.\u0648\u062a\u062d\u062f\u062f \u0627\u0644\u0644\u062c\u0646\u0629 \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629 \u0628\u0639\u062f \u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0648\u0642\u0641 \u0648\u062a\u0642\u064a\u064a\u0645\u0647\u060c \u0645\u0639 \u0645\u0631\u0627\u0639\u0627\u0629 \u062d\u062c\u064a\u0629 \u0648\u0643\u0641\u0627\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0645\u0642\u062f\u0645\u0629\u060c \u0648\u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629\u060c \u0648\u062a\u062d\u0642\u064a\u0642 \u0645\u0635\u0644\u062d\u0629 \u0627\u0644\u0648\u0642\u0641.\u0648\u0641\u064a \u062d\u0627\u0644 \u062a\u0639\u062f\u062f \u0627\u0644\u0645\u0628\u0644\u0651\u063a\u064a\u0646 \u0639\u0646 \u0627\u0644\u0648\u0642\u0641 \u0630\u0627\u062a\u0647\u060c \u062a\u0643\u0648\u0646 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0644\u0644\u0645\u0628\u0644\u0651\u063a \u0627\u0644\u0623\u0633\u0628\u0642\u060c \u0645\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0628\u0644\u0627\u063a \u0627\u0644\u0644\u0627\u062d\u0642 \u0645\u0646\u062a\u062c\u0627\u064b \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u