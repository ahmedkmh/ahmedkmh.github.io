\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u063a\u0631\u0628 \u0641\u064a \u062f\u0648\u0631\u064a \u0623\u0628\u0637\u0627\u0644 \u0622\u0633\u064a\u0627 \u0644\u0644\u0646\u062e\u0628\u0629 2026-2027.\u0648\u062a\u0642\u062f\u0645 \u0627\u0644\u0633\u062f \u0639\u0628\u0631 \u0647\u062f\u0641 \u0623\u0643\u0631\u0645 \u0639\u0641\u064a\u0641 \u0641\u064a \u0627\u0644\u062f\u0642\u064a\u0642\u0629 74\u060c \u0642\u0628\u0644 \u0623\u0646 \u064a\u062f\u0631\u0643 \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0627\u0644\u062a\u0639\u0627\u062f\u0644 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062c\u0648\u0644\u064a\u0627\u0646 \u0643\u064a\u0646\u064a\u0648\u0646\u064a\u0633 (84).\u0648\u0634\u0647\u062f \u0627\u0644\u0644\u0642\u0627\u0621 \u0633\u064a\u0637\u0631\u0629 \u0645\u062a\u0628\u0627\u062f\u0644\u0629 \u0645\u0646 \u0627\u0644\u0641\u0631\u064a\u0642\u064a\u0646\u060c \u0648\u062a\u0645\u0643\u0646 \u0627\u0644\u0633\u062f \u0645\u0646 \u0627\u0644\u062a\u0642\u062f\u0645 \u0628\u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0628\u0639\u062f\u0645\u0627 \u0627\u0633\u062a\u0644\u0645 \u0646\u062c\u0645\u0647 \u0623\u0643\u0631\u0645 \u0639\u0641\u064a\u0641 \u0627\u0644\u0643\u0631\u0629 \u0639\u0644\u0649 \u0645\u0634\u0627\u0631\u0641 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062c\u0632\u0627\u0621\u060c \u0648\u0623\u0637\u0644\u0642 \u062a\u0633\u062f\u064a\u062f\u0629 \u0635\u0627\u0631\u0648\u062e\u064a\u0629 \u0645\u064f\u062a\u0642\u0646\u0629 \u0628\u0642\u062f\u0645\u0647 \u0627\u0644\u064a\u0645\u0646\u0649\u060c \u0627\u0633\u062a\u0642\u0631\u062a \u0641\u064a \u0627\u0644\u0632\u0627\u0648\u064a\u0629 \u0627\u0644\u0639\u0644\u064a\u0627 \u0627\u0644\u064a\u0645\u0646\u0649 \u0644\u0644\u0645\u0631\u0645\u0649 (74). \u0644\u0643\u0646 \u0627\u0644\u0642\u0627\u062f\u0633\u064a\u0629 \u0644\u0645 \u064a\u0646\u062a\u0638\u0631 \u0637\u0648\u064a\u0644\u0627\u064b \u0644\u0625\u062f\u0631\u0627\u0643 \u0627\u0644\u062a\u0639\u0627\u062f\u064