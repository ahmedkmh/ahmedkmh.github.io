u0648\u0645 \u062a\u0639\u0627\u0642\u062f\u0646\u0627 \u0645\u0639 \u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646\u060c \u0648\u0645\u0627 \u0632\u0644\u0646\u0627 \u0646\u0646\u062a\u0638\u0631 \u0648\u0635\u0648\u0644 \u0645\u0647\u0627\u062c\u0645 \u0648\u0644\u0627\u0639\u0628 \u0648\u0633\u0637 \u0627\u0654\u062c\u0646\u0628\u064a\u064a\u0646\u060c \u0627\u0655\u0636\u0627\u0641\u0629 \u0627\u0655\u0644\u0649 \u0645\u062f\u0627\u0641\u0639\u064a\u0646 \u0645\u062d\u0644\u064a\u064a\u0646\u00bb. \u0648\u062a\u0627\u0628\u0639 \u0645\u062f\u0631\u0628 \u0627\u0644\u0631\u0627\u064a\u0654\u062f: \u00ab\u0628\u0639\u0636 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0627\u0644\u062a\u062d\u0642\u0648\u0627 \u0628\u0646\u0627 \u0641\u064a \u0627\u0653\u062e\u0631 \u0627\u0654\u064a\u0627\u0645 \u0627\u0644\u0645\u0639\u0633\u0643\u0631\u060c \u0648\u0627\u0644\u0628\u0639\u0636 \u0627\u0644\u0627\u0653\u062e\u0631 \u0627\u0646\u0636\u0645 \u0641\u064a \u0646\u0647\u0627\u064a\u062a\u0647\u00bb. \u0648\u0627\u0654\u0631\u062f\u0641: \u00ab\u0627\u0654\u0647\u0646\u064a\u0654 \u0627\u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0638\u0647\u0648\u0631 \u0648\u0627\u0644\u0642\u062a\u0627\u0644 \u0627\u0644\u0630\u064a \u0642\u062f\u0645\u0648\u0647\u060c \u0648\u0645\u0627 \u0642\u0635\u0651\u0631\u0648\u0627 \u0627\u0644\u064a\u0648\u0645\u00bb. \u0648\u0627\u0654\u0643\u062f: \u00ab\u0627\u0654\u0648\u0644 \u0645\u0628\u0627\u0631\u0627\u0629 \u0644\u0646\u0627 \u0627\u0654\u0645\u0627\u0645 \u0641\u0631\u064a\u0642 \u0645\u062b\u0644 \u0627\u0644\u0647\u0644\u0627\u0644 \u0628\u0627\u0644\u062a\u0627\u0654\u0643\u064a\u062f \u0635\u0639\u0628\u0629\u060c \u0644\u0643\u0646\u0646\u0627 \u062a\u0639\u0627\u0645\u0644\u0646\u0627 \u0645\u0639\u0647\u0627 \u0628\u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628. \u0628\u0631\u0627\u0641\u0648 \u0644\u0644\u0627\u0639\u0628\u064a\