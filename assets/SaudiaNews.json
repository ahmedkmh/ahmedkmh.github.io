0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0641\u0631\u0636 \u062d\u0635\u0627\u0631 \u0628\u062d\u0631\u064a \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0627\u0646\u0626 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u0629. \u0648\u0623\u0648\u0636\u062d\u062a \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629 \u0641\u064a \u0628\u064a\u0627\u0646\u060c \u0623\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0642\u0627\u0645\u062a, \u062d\u062a\u0649 30 \u0633\u0628\u062a\u0645\u0628\u0631, \u0628\u062a\u063a\u064a\u064a\u0631 \u0645\u0633\u0627\u0631 125 \u0633\u0641\u064a\u0646\u0629 \u062a\u062c\u0627\u0631\u064a\u0629\u061b \u0628\u0647\u062f\u0641 \u0636\u0645\u0627\u0646 \u0627\u0645\u062a\u062b\u0627\u0644\u0647\u0627 \u0644\u0644\u062d\u0635\u0627\u0631 \u0627\u0644\u0628\u062d\u0631\u064a \u0627\u0644\u0645\u0641\u0631\u0648\u0636 \u0639\u0644\u0649 \u0625\u064a\u0631\u0627\u0646.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u062f\u0648\u0644\u064a\u0629"], "creator": ["\u0648\u0627\u0633 - \u0648\u0627\u0634\u0646\u0637\u0646"], "language": "arabic", "country": ["saudi arabia"], "category": ["food"], "datatype": "news", "pubDate": "2026-10-01 06:45:46", "pubDateTZ": "UTC", "fetched_at": "2026-10-01 06:45:46", "image_url": "https://www.al-madina.com/uploads/images/2026/10/01/2667072.jpg", "video_url": null, "source_id": "al_madina", "source_name": "\u0635\u062d\u064a\u0641\u0629 \u0627\u0644\u0645\u062f\u064a\u0646\u0629", "source_priority": 315538, "source_url": "https://www.al-madina.com", "source_icon": "https://i.newsdata.io/al_madina.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": true}, {"article_id": "dd80cec77d3fa78445387b91967a4375", "link": "https://www.okaz.com.sa/local/na/2268728", "title": "\u0646\u0632\u0627\u0647\u0629: \u0627\u0644\u062a\u062d\u0642\u064a\u0642 \u0645\u0639 381 \u0645\u062a\u0647\u0645\u0627\u064b \u0648\u0625\u064a\u0642\u0627\u0641 158 \u0628\u062a\u0647\u0645 \u0627\u0644\u0631\u0634\u0648\u0629 \u0648\u0627\u0633\u062a\u063a\u0644\u0627\u0644 \u0627\u0644\u0646\u0641\u0648\u0630 \u0627\u0644\u0648\u0638\u064a\u0641\u064a", "description": "\u0628\u0627\u0634\u0631\u062a \u0647\u064a\u0626\u0629 \u0627\u0644\u0631\u0642\u0627\u0628\u0629 \u0648\u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u0641\u0633\u0627\u062f \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u0633\u0628\u062a\u0645\u0628\u0631 2026\u0645\u060c \u0623\u0639\u0645\u0627\u0644\u0647\u0627 \u0627\u0644\u0631\u0642\u0627\u0628\u064a\u0629 (1758) \u062c\u0648\u0644\u0629 \u0631\u0642\u0627\u0628\u064a\u0629\u060c \u0648\u062d\u0642\u0642\u062a \u0645\u0639 (381) \u0645\u0634\u062a\u0628\u0647\u064b\u0627 \u0628\u0647 \u0645\u0646 \u0636\u0645\u0646\u0647\u0645 \u0645\u0648\u0638\u0641\u0648\u0646 \u0645\u0646 \u0648\u0632\u0627\u0631\u0627\u062a (\u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629\u060c \u0627\u0644\u0639\u062f\u0644\u060c \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u060c \u0627\u0644\u0628\u0644\u062f\u064a\u0627\u062a \u0648\u0627\u0644\u0625\u0633\u0643\u0627\u0646)\u060c \u0644\u062a\u0648\u0631\u0637\u0647\u0645 \u0628\u062a\u0647\u0645 (\u0627\u0644\u0631\u0634\u0648\u0629\u060c \u0627\u0633\u062a\u063a\u0644\u0627\u0644 \u0627\u0644\u0646\u0641\u0648\u0630 \u0627\u0644\u0648\u0638\u064a\u0641\u064a).\u0648\u0623\u0648\u0642\u0641\u062a \u0627\u0644\u0647\u064a\u0626\u0629 (158) \u0645\u0648\u0627\u0637\u0646\u0627\u064b \u0648\u0645\u0642\u064a\u0645\u0627\u064b\u060c \u0645\u0646\u0647\u0645 \u0645\u0646 \u0623\u0637\u0644\u0642 \u0633\u0631\u0627\u062d\u0647 \u0628\u0627\u0644\u0643\u0641\u0627\u0644\u0629 \u0627\u0644\u0636\u0627\u0645\u0646\u0629 \u0648\u0641\u0642\u0627\u064b \u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062c\u0632\u0627\u0626\u064a\u0629\u060c \u0648\u062c\u0627\u0631\u064d \u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645\u064a\u0629 \u062a\u0645\u0647\u064a\u062f\u0627\u064b \u0644\u0625\u062d\u0627\u0644\u062a\u0647\u0645 \u0644\u0644\u0642\u0636\u0627\u0621. \u0648\u062f\u0639\u062a \u0646\u0632\u0627\u0647\u0629 \u0627\u0644\u062c\u0645\u064a\u0639 \u0625\u0644\u0649 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0623\u064a \u0634\u0628\u0647\u0627\u062a \u0641\u0633\u0627\u062f \u0645\u0627\u0644\u064a \u0623\u0648 \u0625\u062f\u0627\u0631\u064a \u0639\u0628\u0631 \u0642\u0646\u0648\u0627\u062a\u0647\u0627 \u0627\u0644\u0631\u0633\u0645\u064a\u0629\u060c \u0648\u0645\u0646\u0647\u0627 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u062c\u0627\u0646\u064a (980) \u0623\u0648 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0648\u0642\u0639\u0647\u0627 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0622\u062e\u0631 \u0627\u0644\u0627\u062e\u0628\u0627\u0631"], "creator": ["\u0639\u0643\u0627\u0638 (\u062c\u062f\u0629)"], "language": "arabic", "country": ["saudi arabia"], "category": ["crime", "top"], "datatype": "news", "pubDate": "2026-10-01 06:45:33", "pubDateTZ": "UTC", "fetched_at": "2026-10-01 09:10:49", "image_url": "https://www.okaz.com.sa/okaz/uploads/images/2026/10/01/2774069.webp", "video_url": null, "source_id": "okaz", "source_name": "\u0635\u062d\u064a\u0641\u0629 \u0639\u0643\u0627\u0638", "source_priority": 124260, "source_url": "https://www.okaz.com.sa", "source_icon": "https://i.newsdata.io/okaz.png", "sentiment": "ONLY AVAILABLE