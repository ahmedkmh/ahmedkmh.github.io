632\u060c \u0631\u0627\u0654\u0633 \u0627\u0644\u062d\u0631\u0628\u0629\u060c \u0648\u0627\u0644\u063a\u0627\u0646\u064a \u062a\u0648\u0645\u0627\u0633 \u0628\u0627\u0631\u062a\u064a\u060c \u0644\u0627\u0639\u0628 \u0627\u0644\u0648\u0633\u0637. \u0648\u0627\u0654\u062a\u0645 \u0645\u0648\u0631\u064a \u0641\u064a \u064a\u0648\u0646\u064a\u0648 \u0627\u0644\u0645\u0627\u0636\u064a 33 \u0639\u0627\u0645\u064b\u0627\u060c \u0648\u064a\u062a\u0645\u062a\u0639 \u0628\u0642\u0627\u0645\u0629 \u0641\u0627\u0631\u0639\u0629 \u064a\u0628\u0644\u063a \u0637\u0648\u0644\u0647\u0627 197 \u0633\u0645\u060c \u0648\u064a\u062d\u0645\u0644 \u062c\u0646\u0633\u064a\u062a\u064a \u0641\u0631\u0646\u0633\u0627\u060c \u0645\u0633\u0642\u0637 \u0631\u0627\u0654\u0633\u0647\u060c \u0648\u0627\u0644\u0633\u0646\u063a\u0627\u0644\u060c \u0628\u0644\u062f \u0639\u0627\u064a\u0654\u0644\u062a\u0647. \u0648\u062e\u0644\u0627\u0644 \u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u0627\u0654\u0633\u064a\u0633 \u0627\u0646\u062a\u0642\u0644 \u0627\u0644\u062d\u0627\u0631\u0633 \u0645\u0646 \u0646\u0627\u062f\u064a \u0641\u0631\u0633\u0627\u064a \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0627\u0655\u0644\u0649 \u0628\u0627\u0631\u064a\u0633 \u0633\u0627\u0646 \u062c\u064a\u0631\u0645\u0627\u0646 \u0644\u0627\u0655\u0643\u0645\u0627\u0644 \u062a\u0637\u0648\u0631\u0647\u060c \u0648\u0635\u064f\u0639\u0650\u0651\u062f \u0644\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0627\u0654\u0648\u0644 \u0639\u0627\u0645 2014. \u0648\u0641\u064a 2015 \u0627\u0646\u0636\u0645 \u0627\u0655\u0644\u0649 \u062f\u064a\u0628\u0648\u0631\u062a\u064a\u0641\u0648 \u0645\u0627\u0641\u0631\u0627 \u0627\u0644\u0628\u0631\u062a\u063a\u0627\u0644\u064a\u060c \u0648\u0628\u0639\u062f \u0639\u0627\u0645\u064a\u0646 \u0631\u062d\u0644 \u0635\u0648\u0628 \u0644\u0648\u0643\u0648\u0645\u0648\u062a\u064a\u0641 \u0628\u0644\u0648\u0641\u062f\u064a\u0641 \u0627\u0644\u0628\u0644\u063a\u0627\u0631\u064a\u060c \u0648\u0645\u0646\u0647 \u0627\u0655\u0644\u0649 \u0632\u064a\u0648\u0631\u064a\u062e \u064a\u0648\u0646\u0627\u064a\u062a\u062f \u0627\u0644\u0633\u0648\u064a\u0633\u0631\u064a \u0641\u064a \u0641\u0628\u0631\u0627\u064a\u0631 2019. \u0648\u0638\u0644 \u0636\u0645\u0646 \u0635\u0641\u0648\u0641 \u0632\u064a\u0648\u0631\u062e \u0644\u0641\u062a\u0631\u0629 \u0642\u0635\u064a\u0631\u0629 \u0631\u062d\u0644 \u0628\u0639\u062f\u0647\u0627 \u0627\u0655\u0644\u0649 \u0644\u0648\u0632\u0627\u0646 \u0627\u0644\u0633\u0648\u064a\u0633\u0631\u064a \u0641\u064a \u0635\u064a\u0641 2019\u060c \u0648\u0628\u0639\u062f 3 \u0627\u0654\u0639\u0648\u0627\u0645 \u0639\u0627\u062f \u0627\u0655\u0644\u0649 \u0641\u0631\u0646\u0633\u0627 \u0645\u062c\u062f\u062f\u064b\u0627 \u0645\u0646 \u0628\u0648\u0627\u0628\u0629 \u0643\u0644\u064a\u0631\u0645\u0648\u0646 \u0641\u0648\u062a. \u0648\u0644\u0639\u0628 \u0628\u0642\u0645\u064a\u0635 \u0643\u0644\u064a\u0631\u0645\u0648\u0646 \u0641\u0648\u062a 3 \u0645\u0648\u0627\u0633\u0645 \u062a\u062e\u0644\u0644\u062a\u0647\u0627 \u0627\u0655\u0639\u0627\u0631\u0629 \u0644\u0631\u0648\u062f\u064a\u0632 \u0627\u0644\u0641\u0631\u0646\u0633\u064a \u0639\u0627\u0645 2025\u060c \u0648\u0628\u0639\u062f\u0647\u0627 \u0631\u062d\u0644 \u0627\u0655\u0644\u0649 \u0644\u0648\u0647\u0627\u0641\u0631\u060c \u0627\u0653\u062e\u0631 \u0645\u062d\u0637\u0627\u062a\u0647 \u0642\u0628\u0644 \u0627\u0644\u0634\u0628\u0627\u0628. \u0648\u062f\u0648\u0644\u064a\u064b\u0627\u060c \u0627\u062e\u062a\u0627\u0631 \u062a\u0645\u062b\u064a\u0644 \u0627\u0644\u0633\u0646\u063a\u0627\u0644 \u0628\u062f\u0621\u064b\u0627 \u0645\u0646 2022\u060c \u0648\u0643\u0627\u0646 \u0639\u0636\u0648\u064b\u0627 \u0641\u064a \u0642\u0627\u064a\u0654\u0645\u0629 \u00ab\u0627\u0654\u0633\u0648\u062f \u0627\u0644\u062a\u064a\u0631\u0627\u0646\u062c\u0627\u00bb \u0628\u0627\u0644\u0646\u0633\u062e\u062a\u064a\u0646 \u0627\u0644\u0627\u0654\u062e\u064a\u0631\u062a\u064a\u0646 \u0645\u0646 \u0643\u0627\u0654\u063