2c\u0641\u0627\u0641</a>\u060c \u0628\u0639\u062f\u0645\u0627 \u0634\u0647\u062f\u062a \u0627\u0644\u0628\u0644\u0627\u062f \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648 \u0627\u0644\u0627\u0654\u0643\u062b\u0631 \u062c\u0641\u0627\u0641\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0627\u0655\u0637\u0644\u0627\u0642\u060c \u0645\u0639 \u062a\u0648\u0642\u0639 \u0628\u062f\u0621 <a href=\"https://www.alyaum.com/articles/6677154/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D9%85%D9%85%D9%84%D9%83%D8%A9-%D8%A7%D9%84%D9%8A%D9%88%D9%85/%D8%A7%D9%84%D8%A3%D8%B1%D8%B5%D8%A7%D8%AF-%D9%85%D9%88%D8%AC%D8%A9-%D8%AD%D8%A7%D8%B1%D8%A9-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6-%D9%88%D8%A3%D9%85%D8%B7%D8%A7%D8%B1-%D8%B9%D9%84%D9%89-%D8%AC%D8%A7%D8%B2%D8%A7%D9%86-%D9%88%D8%A7%D9%84%D8%A8%D8%A7%D8%AD%D8%A9\" target=\"_blank\">\u0645\u0648\u062c\u0629 \u062d\u0631</a> \u062e\u0627\u0645\u0633\u0629 \u0648\u0627\u0654\u0645\u0637\u0627\u0631 \u0642\u0644\u064a\u0644\u0629 \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639 \u0627\u0644\u0645\u0642\u0628\u0644.<br />\u0648\u0627\u0654\u0638\u0647\u0631\u062a \u0627\u0644\u0635\u0648\u0631 \u0627\u0654\u0646 \u0627\u0644\u0645\u062a\u0646\u0632\u0647\u0627\u062a \u0648\u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u062a\u064a \u062a\u0643\u062a\u0633\u064a \u0639\u0627\u062f\u0629 \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0627\u0654\u062e\u0636\u0631 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u0645\u0646 \u0627\u0644\u0639\u0627\u0645\u060c \u062c\u0641\u0651\u062a \u0648\u0627\u0635\u0641\u0631\u0651 \u0644\u0648\u0646\u0647\u0627\u060c \u0645\u0639 \u0627\u0646\u062e\u0641\u0627\u0636 \u0645\u0646\u0633\u0648\u0628 \u0627\u0644\u0627\u0654\u0646\u0647\u0627\u0631 \u0648\u062a\u062d\u0630\u064a\u0631 \u0645\u0632\u0627\u0631\u0639\u064a\u0646 \u0645\u0646 \u0627\u062d\u062a\u0645\u0627\u0644 \u062d\u062f\u0648\u062b \u0646\u0642\u0635 \u063a\u0630\u0627\u064a\u0654\u064a \u0628\u063