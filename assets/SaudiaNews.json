u0627\u062a \u0627\u0644\u0631\u0627\u0643\u0628 \u0627\u0644\u0628\u0634\u0631\u064a \u0645\u0646 \"\u0627\u0654\u0634\u0648\u0627\u0637 \u0645\u0627\u0631\u0627\u062b\u0648\u0646\u064a\u0629\" \u0645\u062d\u062f\u0648\u062f\u0629 \u0639\u0646\u062f \u0627\u0646\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u0647\u0631\u062c\u0627\u0646 \u0639\u0627\u0645 2018\u060c \u0627\u0655\u0644\u0649 \u0628\u0637\u0648\u0644\u0629 \u062f\u0648\u0644\u064a\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u062a\u062c\u0645\u0639 \u0646\u062e\u0628\u0629 \u0627\u0644\u0647\u062c\u0627\u0646\u0629 \u0645\u0646 \u0645\u062e\u062a\u0644\u0641 \u0642\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u0644\u0645. <br /><br />\u0648\u0639\u0644\u0649 \u0635\u0639\u064a\u062f \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u0631\u062c\u0627\u0644\u060c \u0628\u0644\u063a \u0627\u0655\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064a\u0646 \u0641\u064a \u0627\u0644\u0634\u0648\u0637 \u0627\u0644\u0627\u0654\u0648\u0644 \u0648\u0627\u0644\u062b\u0627\u0646\u064a 35 \u0647\u062c\u0627\u0646\u0627\u064b\u060c \u0645\u0646\u0647\u0645 23 \u0647\u062c\u0627\u0646\u0627\u064b \u0633\u0639\u0648\u062f\u064a\u0627\u064b \u0627\u0655\u0636\u0627\u0641\u0629 \u0644\u0647\u062c\u0627\u0646\u064a\u0646 \u0645\u0646 \u0627\u0644\u0643\u0648\u064a\u062a\u060c \u0627\u0644\u062c\u0632\u0627\u064a\u0654\u0631\u060c \u0648\u0627\u0644\u0627\u0654\u0631\u062f\u0646.<br /><br />\u0648\u0641\u064a \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u0633\u064a\u062f\u0627\u062a\u060c \u0633\u062c\u0644\u062a \u0627\u0644\u0643\u0634\u0648\u0641\u0627\u062a \u062d\u0636\u0648\u0631\u0627\u064b \u0644\u0627\u0641\u062a\u0627\u064b \u0648\u062a\u0646\u0627\u0641\u0633\u0627\u064b \u0642\u0648\u064a\u0627\u064b \u0628\u0645\u0634\u0627\u0631\u0643\u0629 34 \u0647\u062c\u0627\u0646\u0629\u060c \u062c\u0631\u0649 \u062a\u0642\u0633\u0645\u064a\u0647\u0646 \u0628\u0627\u0644