%D8%B7%D8%B1-%D8%AD%D8%B1%D8%A7%D8%A6%D9%82-%D8%A7%D9%84%D8%BA%D8%A7%D8%A8%D8%A7%D8%AA-%D8%A8%D8%B9%D8%AF%D8%A9-%D9%85%D9%86%D8%A7%D8%B7%D9%82\">\u0627\u0644\u0628\u0631\u062a\u063a\u0627\u0644</a>\u060c \u0628\u0639\u062f\u0645\u0627 \u0627\u0645\u062a\u062f\u062a \u0627\u0654\u0644\u0633\u0646\u0629 \u0627\u0644\u0646\u064a\u0631\u0627\u0646 \u0628\u0627\u062a\u062c\u0627\u0647 \u062b\u0644\u0627\u062b \u0642\u0631\u0649\u060c \u0648\u0633\u0637 \u0638\u0631\u0648\u0641 \u062c\u0648\u064a\u0629 \u0635\u0639\u0628\u0629.<br /><br />\u0648\u0627\u0654\u0643\u062f\u062a \u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u062f\u0646\u064a\u0629 \u0627\u0644\u0628\u0631\u062a\u063a\u0627\u0644\u064a\u0629 \u0627\u0654\u0646 <a href=\"https://www.alyaum.com/articles/6678360/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8%A7%D8%B1/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%AD%D8%B1%D8%A7%D8%A6%D9%82-%D8%A7%D9%84%D8%BA%D8%A7%D8%A8%D8%A7%D8%AA-%D8%AA%D9%88%D8%A7%D8%B5%D9%84-%D8%A7%D9%84%D8%AA%D9%87%D8%A7%D9%85-%D8%A7%D9%84%D8%A3%D8%B1%D8%A7%D8%B6%D9%8A-%D9%88%D8%A5%D8%AB%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D8%B1%D8%B9%D8%A8-%D9%81%D9%8A-%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7-%D8%AA%D9%81%D8%A7%D8%B5%D9%8A%D9%84\">\u0627\u0644\u062d\u0631\u064a\u0642</a>\u060c \u0627\u0644\u0630\u064a \u0646\u062a\u062c \u0639\u0646 \u0627\u0646\u062f\u0645\u0627\u062c \u062b\u0644\u0627\u062b\u0629 \u062d\u0631\u0627\u064a\u0654\u0642 \u0627\u0646\u062f\u0644\u0639\u062a \u0641\u064a \u0645\u0646\u0627\u0637\u0642 \u0645\u062a\u0642\u0627\u0631\u0628\u0629\u060c \u064a\u0634\u0647\u062f \u0627\u0646\u062a\u0634\u0627\u0631\u064b\u0627 \u0633\u0631\u064a\u0639\u064b\u0627 \u0628\u0641\u0639\u0644 \u0627\u0644\u0631\u064a\u0627\u062d \u0627\u0644\u0642\u0648\u064a\u0629 \u0648\u0627\u0631\u062a\u0641\u0627\u0639 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0636\u0645 \u0645\u0633\u0627\u062d\u0627\u062a \u0643\u062b\u064a\u0641\u0629 \u0645\u0646 \u0627\u0654\u0634\u062c\u0627\u0631 \u0627\u0644\u0627\u0654\u0648\u0643\u0627\u0644\u0628\u062a\u0648\u0633 \u0648\u0627\u0644\u0635\u0646\u0648\u0628\u0631 \u0648\u0627\u0644\u0627\u0654\u062d\u0631\u0627\u0634.<h2>\u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u062d\u0631\u064a\u0642</h2>\u0648\u0627\u0654\u0648\u0636\u062d \u0642\u0627\u064a\u0654\u062f \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u062f\u0648\u0646 \u0627\u0644\u0627\u0655\u0642\u0644\u064a\u0645\u064a\u0629 \u0644\u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u062f\u0646\u064a\u0629 \u0641\u064a \u0643\u0648\u064a\u0645\u0628\u0631\u0627\u060c \u0643\u0627\u0631\u0644\u0648\u0633 \u062a\u0627\u0641\u0627\u0631\u064a\u0633, \u0627\u0654\u0646 \u0627\u0654\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u0633\u0644\u0637\u0627\u062a \u062a\u062a\u0645\u062b\u0644 \u0641\u064a \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0633\u0643\u0627\u0646\u060c \u0645\u0634\u064a\u0631\u064b\u0627 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0627\u0644\u0642\u0631\u0649 \u0627\u0644\u062b\u0644\u0627\u062b \u062a\u0642\u0639 \u0641\u064a \u0645\u0633\u0627\u0631 \u0627\u0644\u0646\u064a\u0631\u0627\u0646 \u0628\u064a\u0646 \u0627\u0654\u0631\u063a\u0627\u0646\u064a\u0644 \u0648\u063a\u0648\u064a\u0634.<br /> <br />\u0648\u0627\u0654\u0633\u0641\u0631\u062a \u0639\u0645\u0644\u064a\u0627\u062a \u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u062d\u0631\u064a\u0642 \u0639\u0646 \u0627\u0655\u0635\u0627\u0628\u0629 \u062b\u0644\u0627\u062b\u0629 \u0645\u0646 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0627\u0655\u0637\u0641\u0627\u0621 \u0628\u062c\u0631\u0648\u062d \u0637\u0641\u064a\u0641\u0629\u060c \u0645\u0646 \u0628\u064a\u0646\u0647\u0645 \u0642\u0627\u064a\u0654\u062f \u0641\u0631\u0642\u0629 \u0627\u0644\u0627\u0655\u0637\u0641\u0627\u0621 \u0627\u0644\u0645\u