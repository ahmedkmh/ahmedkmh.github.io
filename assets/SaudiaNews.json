0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621\u060c \u062a\u0633\u062a\u0645\u0631 6 \u0633\u0627\u0639\u0627\u062a \u0645\u0646 11 \u0635\u0628\u0627\u062d\u064b\u0627 \u062d\u062a\u0649 5 \u0645\u0633\u0627\u0621.<br />\u064a\u0634\u0645\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647: \u0627\u0644\u062c\u0628\u064a\u0644 \u0648\u0627\u0644\u062e\u0628\u0631 \u0648\u0627\u0644\u062f\u0645\u0627\u0645 \u0648\u0627\u0644\u0638\u0647\u0631\u0627\u0646 \u0648\u0627\u0644\u0642\u0637\u064a\u0641 \u0648\u0631\u0627\u0654\u0633 \u062a\u0646\u0648\u0631\u0629 \u0648\u062d\u0641\u0631 \u0627\u0644\u0628\u0627\u0637\u0646 \u0648\u0642\u0631\u064a\u0629 \u0627\u0644\u0639\u0644\u064a\u0627 \u0648\u0627\u0644\u062e\u0641\u062c\u064a \u0648\u0627\u0644\u0646\u0639\u064a\u0631\u064a\u0629 \u0648\u0627\u0644\u0627\u0654\u062d\u0633\u0627\u0621 \u0648\u0627\u0644\u0639\u062f\u064a\u062f \u0648\u0628\u0642\u064a\u0642 \u0648\u0630\u0639\u0628\u0644\u0648\u062a\u0646 \u0648\u0627\u0644\u0639\u062f\u064a\u062f.<br />\u0648\u062a\u062a\u0645\u062b\u0644 \u0627\u0644\u062a\u0627\u0654\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0635\u0627\u062d\u0628\u0629 \u0641\u064a \u0627\u0631\u062a\u0641\u0627\u0639 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0645\u0646 (47 \u2013 48) \u062f\u0631\u062c\u0629 \u0645\u064a\u0654\u0648\u064a\u0629 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0627\u0654\u0645\u0627\u0643\u0646\u060c \u0648\u0645\u0646 (49 \u2013 50) \u062f\u0631\u062c\u0629 \u0645\u064a\u0654\u0648\u064a\u0629 \u0641\u064a \u0627\u0654\u0645\u0627\u0643\u0646 \u0627\u0654\u062e\u0631\u0649.<h2>\u0636\u0628\u0627\u0628 \u062e\u0641\u064a\u0641 \u0639\u0644\u0649 \u0630\u0639\u0628\u0644\u0648\u062a\u0646</h2>\u0646\u0628\u0647 <a href=\"https://www.alyaum.com/articles/6678419/%D8%A7%D9%84%D8%A3%D8%AE%D8%A8%D8