s"], "datatype": "news", "pubDate": "2026-08-14 07:54:53", "pubDateTZ": "UTC", "fetched_at": "2026-08-14 08:48:38", "image_url": "http://images.euronews.com/articles/stories/09/87/38/89/640x360_cmsv2_76cc8ec4-a557-5b10-ad88-8ee5d28acefd-9873889.jpg?1786657736", "video_url": null, "source_id": "africanews", "source_name": "Africanews", "source_priority": 900530, "source_url": "https://www.africanews.com", "source_icon": "https://n.bytvi.com/africanews.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}, {"article_id": "e0be18fe0c7822abdbe792fba4f54445", "link": "https://www.alarabiya.net/aswaq/special-stories/2026/08/14/%D8%B5%D8%A7%D9%81%D9%8A-%D8%A7%D9%84%D8%A7%D8%B5%D9%88%D9%84-%D8%A7%D9%84%D8%A7%D8%AC%D9%86%D8%A8%D9%8A%D8%A9-%D9%84%D9%84%D8%A8%D9%86%D9%83-%D8%A7%D9%84%D9%85%D8%B1%D9%83%D8%B2%D9%8A-%D8%A7%D9%84%D8%B3%D8%B9%D9%88%D8%AF%D9%8A-%D9%8A%D9%82%D9%81%D8%B2-107-%D8%A8%D9%86%D9%87%D8%A7%D9%8A%D8%A9-%D9%8A%D9%88%D9%84%D9%8A%D9%88", "title": "\u0635\u0627\u0641\u064a \u0627\u0644\u0627\u0654\u0635\u0648\u0644 \u0627\u0644\u0627\u0654\u062c\u0646\u0628\u064a\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u064a\u0642\u0641\u0632 10.7% \u0628\u0646\u0647\u0627\u064a\u0629 \u064a\u0648\u0644\u064a\u0648", "description": "\u0627\u0631\u062a\u0641\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0627\u0654\u0635\u0648\u0644 \u0627\u0644\u0627\u0654\u062c\u0646\u0628\u064a\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \"\u0633\u0627\u0645\u0627\" \u0628\u0646\u0647\u0627\u064a\u0629 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648/\u062a\u0645\u0648\u0632 \u0627\u0644\u0645\u0627\u0636\u064a \u0628\u0646\u0633\u0628\u0629 10.69% \u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0633\u0646\u0648\u064a\u060c \u0648\u0628\u0632\u064a\u0627\u062f\u0629 \u0642\u064a\u0645\u062a\u0647\u0627 44.98 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 (168.7 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644) \u0639\u0646 \u0627\u0644\u0634\u0647\u0631 \u0630\u0627\u062a\u0647 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 2025.\u0648\u0648\u0635\u0644 \u0635\u0627\u0641\u064a \u0627\u0644\u0627\u0654\u0635\u0648\u0644 \u0627\u0644\u0627\u0654\u062c\u0646\u0628\u064a\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0628\u0646\u0647\u0627\u064a\u0629 \u064a\u0648\u0644\u064a\u0648/\u062a\u0645\u0648\u0632 2026 \u0627\u0655\u0644\u0649 465.61 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 (1.746 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644)\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0645\u0639 420.62 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 (1.577 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0645\u0627\u0636\u064a\u060c \u0648\u0641\u0642\u0627\u064b \u0644\u0644\u0645\u0633\u062d \u0627\u0644\u0634\u0647\u0631\u064a \u0627\u0644\u0635\u0627\u062f\u0631 \u0639\u0646 \"\u0633\u0627\u0645\u0627\". \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u0648\u062c\u0648\u062f\u0627\u062a \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0627\u0655\u0644\u0649 524.98 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0628\u0646\u0647\u0627\u064a\u0629 \u064a\u0648\u0646\u064a\u0648\u0648\u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0634\u0647\u0631\u064a\u060c \u0627\u0646\u062e\u0641\u0636 \u0635\u0627\u0641\u064a \u0627\u0644\u0627\u0654\u0635\u0648\u0644 \u0627\u0644\u0627\u0654\u062c\u0646\u0628\u064a\u0629 \u0644\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u062e\u0644\u0627\u0644 \u0634\u0647\u0631 \u064a\u0648\u0644\u064a\u0648/\u062a\u0645\u0648\u0632 \u0628\u0646\u0633\u0628\u0629 1.26% \u0639\u0646 \u0642\u064a\u0645\u062a\u0647 \u0628\u0646\u0647\u0627\u064a\u0629 \u0634\u0647\u0631 \u064a\u0648\u0646\u064a\u0648/\u062d\u0632\u064a\u0631\u0627\u0646 \u0627\u0644\u0645\u0627\u0636\u064a \u0648\u0627\u0644\u0628\u0627\u0644\u063a\u0629 471.55 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 (1.768 \u062a\u0631\u064a\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644).\u0648\u0627\u0631\u062a\u0641\u0639 \u062d\u062c\u0645 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0646\u0642\u062f\u064a\u0629 \u0628\u0646\u062d\u0648 3.6% \u0628\u0646\u0647\u0627\u064a\u0629 \u064a\u0648\u0644\u064a\u0648/\u062a\u0645\u0648\u0632 \u0627\u0644\u0645\u0627\u0636\u064a \u0639\u0644\u0649 \u0627\u0654\u0633\u0627\u0633 \u0633\u0646\u0648\u064a\u060c \u0644\u062a\u0635\u0644 \u0627\u0655\u0644\u0649 118.8 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 (445.53 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644)\u060c \u0645\u0642\u0627\u0628\u0644 114.7 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 (430.12 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644) \u0641\u064a \u0627\u0644\u0634\u0647\u0631 \u0630\u0627\u062a\u0647 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 2025.\u0643\u0645\u0627 \u0632\u0627\u062f\u062a \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0646\u0642\u062f\u064a\u0629 \u0628\u0634\u0643\u0644 \u0637\u0641\u064a\u0641 \u062e\u0644\u0627\u0644 \u064a\u0648\u0644\u064a\u0648/\u062a\u0645\u0648\u0632 \u0645