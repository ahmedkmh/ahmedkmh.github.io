8\u0627\u0644\u0647\u0646\u062f \u0648\u0627\u0655\u0646\u062f\u0648\u0646\u064a\u0633\u064a\u0627 \u0639\u0644\u0649 \u062a\u0648\u0638\u064a\u0641 \u062a\u0642\u0646\u064a\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0641\u064a \u0627\u0655\u0646\u062a\u0627\u062c \u0627\u0644\u0645\u0633\u0644\u0633\u0644\u0627\u062a\u060c \u0644\u062e\u0641\u0636 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0648\u062a\u0633\u0631\u064a\u0639", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": null, "creator": ["\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627"], "language": "arabic", "country": ["egypt"], "category": ["technology"], "datatype": "news", "pubDate": "2026-08-12 07:16:16", "pubDateTZ": "UTC", "fetched_at": "2026-08-12 07:17:45", "image_url": "https://www.shorouknews.com/uploadedimages/Other/original/ima5555555555555555ges.jpeg", "video_url": null, "source_id": "shorouknews", "source_name": "El Shorouk", "source_priority": 436620, "source_url": "https://www.shorouknews.com", "source_icon": "https://n.bytvi.com/shorouknews.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": true}, {"article_id": "8ef82bb68578164a6708dd3ee8e43efa", "link": "https://www.alarabiya.net/aswaq/companies/2026/08/12/%D8%A7%D8%B1%D8%A8%D8%A7%D8%AD-%D9%84%D9%85%D8%B3%D8%A7%D8%AA-%D8%AA%D9%86%D8%AE%D9%81%D8%B6-13-%D9%81%D9%8A-%D8%A7%D9%84%D9%86%D8%B5%D9%81-%D8%A7%D9%84%D8%A7%D9%88%D9%84-%D8%A7%D9%84%D9%89-5-%D9%85%D9%84%D8%A7%D9%8A%D9%8A%D9%86-%D8%AF%D9%88%D9%84%D8%A7%D8%B1", "title": "\u0627\u0654\u0631\u0628\u0627\u062d \"\u0644\u0645\u0633\u0627\u062a\" \u062a\u0646\u062e\u0641\u0636 1.3% \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644 \u0627\u0655\u0644\u0649 5 \u0645\u0644\u0627\u064a\u064a\u0646 \u062f\u0648\u0644\u0627\u0631", "description": "\u0633\u062c\u0644\u062a \u0634\u0631\u0643\u0629 \u0644\u0645\u0633\u0627\u062a \u0635\u0627\u0641\u064a \u0631\u0628\u062d \u0642\u062f\u0631\u0647 \u0646\u062d\u0648 5 \u0645\u0644\u0627\u064a\u064a\u0646 \u062f\u0648\u0644\u0627\u0631 (18.68 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 \u0639\u0627\u0645 2026\u060c \u0628\u0627\u0646\u062e\u0641\u0627\u0636 \u0646\u0633\u0628\u062a\u0647 1.3% \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0646\u062d\u0648 5.05 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (18.93 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642.\u0648\u0642\u0627\u0644\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0641\u064a \u0628\u064a\u0627\u0646 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\" \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u0627\u0655\u0646 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0627\u0631\u062a\u0641\u0639\u062a \u0628\u0646\u0633\u0628\u0629 4.3% \u0644\u062a\u0635\u0644 \u0627\u0655\u0644\u0649 \u0646\u062d\u0648 20.57 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (77.16 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u0641\u064a \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u062d\u0627\u0644\u064a\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0646\u062d\u0648 19.73 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (73.98 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u0627\u062b\u0644\u0629 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642 \u0646\u062a\u064a\u062c\u0629 \u0627\u0641\u062a\u062a\u0627\u062d \u0641\u0631\u0639 \u0635\u0627\u0644\u0648\u0646 \u064a\u0646\u0628\u0639 \u2013 \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629\u060c \u0648\u0627\u0644\u0630\u064a \u0633\u0627\u0647\u0645 \u0641\u064a \u062a\u062d\u0642\u064a\u0642 \u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0628\u0646\u062d\u0648 0.59 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (2.2 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644)\u060c \u0627\u0655\u0636\u0627\u0641\u0629 \u0627\u0655\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0641\u0631\u0648\u0639 \u0627\u0644\u0627\u0654\u062e\u0631\u0649 \u0628\u0646\u062d\u0648 0.27 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (1.0 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644)\u060c \u0642\u0627\u0628\u0644 \u0630\u0644\u0643 \u0627\u0646\u062e\u0641\u0627\u0636 \u0641\u064a \u0645\u0628\u064a\u0639\u0627\u062a \u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0645\u064a\u0644 \u0628\u0646\u062d\u0648 271 \u0627\u0654\u0644\u0641 \u0631\u064a\u0627\u0644 (72.3 \u0627\u0654\u0644\u0641 \u062f\u0648\u0644\u0627\u0631).\u0648\u0627\u0654\u0634\u0627\u0631\u062a \"\u0644\u0645\u0633\u0627\u062a\" \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u062a\u0631\u0627\u062c\u0639 \u0635\u0627\u0641\u064a \u0627\u0644\u0631\u0628\u062d \u064a\u0639\u0648\u062f \u0628\u0634\u0643\u0644 \u0631\u064a\u0654\u064a\u0633\u064a \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0641\u0631\u0639 \u064a\u0646\u0628\u0639 \u2013 \u0627\u0644\u0647\u064a\u064a\u0654\u0629 \u0627\u0644\u0645\u0644\u0643\u064a\u0629\u060c \u0627\u0644\u0630\u064a \u0628\u062f\u0627\u0654 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0641\u0639\u0644\u064a \u0641\u064a \u064a\u0646\u0627\u064a\u0631 2026\u060c \u0644\u0627 \u064a\u0632\u0627\u0644 \u0641\u064a \u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0627\u0654\u0648\u0644\u064a\u060c \u0645\u0627 \u0627\u0654\u062f\u0649 \u0627\u0655\u0644\u0649 \u062a\u062d\u0645\u0644 \u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062a\u0627\u0654\u0633\u064a\u0633 \u0648\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0642\u0628\u0644 \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0655\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u062a\u062f\u0627\u0648\u0644", "\u0634\u0631\u0643\u0629 \u0644\u0645\u0633\u0627\u062a", "\u0623\u0631\u0628\u0627\u062d \u0644\u0645\u0633\u0627\u062a", "\u0633\u0648\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629"], "creator": ["\u0627\u0644\u0631\u064a\u0627\u0636- \u0627\u0644\u0639\u0631\u0628\u064a\u0629business"], "language": "arabic", "country": ["egypt"], "category": ["business"], "datatype": "news", "pubDate": "2026-08-12 07:16:09", "pubDateTZ": "UTC", "fetched_at": "2026-08-12 07:27:42", "image_url": "https://vid.alarabiya.net/images/2025/02/05/2ea13389-542b-4706-9d80-a3c62172c47f/2ea13389-542b-4706-9d80-a3c62172c47f_16x9_1200x676.jpg", "video_url": null, "source_id": "alarabiya", "source_name": "Alarabiya", "source_priority": 13507, "source_url": "https://www.alarabiya.net", "source_icon": "https://n.bytvi.com/alarabiya.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment