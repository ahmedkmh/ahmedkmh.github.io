\u064a\u0654\u064a RAM \u0628\u0633\u0639\u0629 12 \u063a\u064a\u063a\u0627\u0628\u0627\u064a\u062a\u060c \u0645\u0639 \u062e\u064a\u0627\u0631\u064a\u0646 \u0644\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0628\u0633\u0639\u0629 256 \u063a\u064a\u063a\u0627\u0628\u0627\u064a\u062a \u0627\u0654\u0648 512 \u063a\u064a\u063a\u0627\u0628\u0627\u064a\u062a.\u0648\u064a\u0645\u0646\u062d \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u0646 \u0645\u0633\u0627\u062d\u0629 \u0643\u0627\u0641\u064a\u0629 \u0644\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648\u060c \u0644\u0643\u0646 \u0627\u0644\u0647\u0627\u062a\u0641 \u0644\u0627 \u064a\u062f\u0639\u0645 \u062a\u0648\u0633\u0639\u0629 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0639\u0628\u0631 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0630\u0627\u0643\u0631\u0629\u060c \u0628\u062d\u0633\u0628 \u062a\u0642\u0631\u064a\u0631 \u0646\u0634\u0631\u0647 \u0645\u0648\u0642\u0639 \"androidheadlines\" \u0648\u0627\u0637\u0644\u0639\u062a \u0639\u0644\u064a\u0647 \"\u0627\u0644\u0639\u0631\u0628\u064a\u0629 Business\".\u0642\u0641\u0632\u0629 \u0641\u064a \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627 \u0627\u0644\u0631\u064a\u0654\u064a\u0633\u064a\u0629\u062a\u062d\u0635\u0644 \u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0639\u0644\u0649 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0627\u0654\u0628\u0631\u0632 \u0627\u0644\u062a\u0631\u0642\u064a\u0627\u062a \u0641\u064a \u0628\u064a\u0643\u0633\u0644 11\u060c \u0628\u0641\u0636\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0633\u062a\u0634\u0639\u0631 \u0631\u064a\u0654\u064a\u0633\u064a \u0627\u0654\u0643\u