": "https://www.alarabiya.net/arab-and-world/2026/08/25/%D9%86%D8%AA%D9%86%D9%8A%D8%A7%D9%87%D9%88-%D9%8A%D8%AA%D9%87%D9%85-%D8%A7%D9%8A%D8%B1%D8%A7%D9%86-%D8%A8%D9%85%D8%AD%D8%A7%D9%88%D9%84%D8%A9-%D9%82%D8%AA%D9%84-%D8%A7%D8%AD%D8%AF-%D8%A7%D8%A8%D9%86%D8%A7%D8%A6%D9%87", "title": "\u0646\u062a\u0646\u064a\u0627\u0647\u0648 \u064a\u062a\u0647\u0645 \u0627\u0655\u064a\u0631\u0627\u0646 \u0628\u0645\u062d\u0627\u0648\u0644\u0629 \u0642\u062a\u0644 \u0627\u0654\u062d\u062f \u0627\u0654\u0628\u0646\u0627\u064a\u0654\u0647", "description": "\u0627\u062a\u0647\u0645 \u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u0648\u0632\u0631\u0627\u0621 \u0627\u0644\u0627\u0655\u0633\u0631\u0627\u064a\u0654\u064a\u0644\u064a \u0628\u0646\u064a\u0627\u0645\u064a\u0646 \u0646\u062a\u0646\u064a\u0627\u0647\u0648\u060c \u0627\u0644\u0627\u062b\u0646\u064a\u0646\u060c \u0627\u0655\u064a\u0631\u0627\u0646 \u0628\u0645\u062d\u0627\u0648\u0644\u0629 \u0642\u062a\u0644 \u0627\u0654\u062d\u062f \u0627\u0654\u0628\u0646\u0627\u064a\u0654\u0647\u060c \u0645\u0646 \u062f\u0648\u0646 \u0627\u0654\u0646 \u064a\u0643\u0634\u0641 \u0639\u0646 \u062a\u0648\u0642\u064a\u062a \u0627\u0644\u0645\u062e\u0637\u0637 \u0627\u0654\u0648 \u0647\u0648\u064a\u0629 \u0627\u0644\u0627\u0628\u0646 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 \u0627\u0654\u0648 \u0645\u062f\u0649 \u0627\u0642\u062a\u0631\u0627\u0628\u0647 \u0645\u0646 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0641\u0639\u0644\u064a.\u062c\u0627\u0621\u062a \u062a\u0635\u0631\u064a\u062d\u0627\u062a \u0646\u062a\u0646\u064a\u0627\u0647\u0648 \u062e\u0644\u0627\u0644 \u0645\u0642\u0627\u0628\u0644\u0629 \u0647\u0627\u062a\u0641\u064a\u0629 \u0645\u0639 \"\u0627\u0644\u0642\u0646\u0627\u0629 14\" \u0627\u0644\u0627\u0655\u0633\u0631\u0627\u064a\u0654\u064a\u0644\u064a\u0629\u060c \u0631\u062f\u0627\u064b \u0639\u0644\u0649 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0655\u0639\u0644\u0627\u0645\u064a\u0629 \u0627\u0654\u0641\u0627\u062f\u062a \u0628\u0627\u0654\u0646 \u062c\u0647\u0627\u0632\u0627\u064b \u0627\u0654\u0645\u0646\u064a\u0627\u064b \u0627\u0655\u0633\u0631\u0627\u064a\u0654\u064a\u0644\u064a\u0627\u064b \u0631\u0641\u0636 \u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0644\u0645\u0646\u0627\u0641\u0633 \u0633\u064a\u0627\u0633\u064a \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u0645\u0642\u0631\u0631\u0629 \u0641\u064a 27 \u0627\u0654\u0643\u062a\u0648\u0628\u0631 (\u062a\u0634\u0631\u064a\u0646 \u0627\u0644\u0627\u0654\u0648\u0644). \u0648\u062a\u064f\u0638\u0647\u0631 \u0627\u0633\u062a\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u0644\u0631\u0627\u0654\u064a \u062a\u0631\u0627\u062c\u0639 \u0627\u064a\u0654\u062a\u0644\u0627\u0641 \u0646\u062a\u0646\u064a\u0627\u0647\u0648 \u0642\u0628\u0644 \u0646\u062d\u0648 \u0634\u0647\u0631\u064a\u0646 \u0645\u0646 \u0645\u0648\u0639\u062f \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0639.\u0648\u0642\u0627\u0644 \u0646\u062a\u0646\u064a\u0627\u0647\u0648: \"\u0627\u0655\u064a\u0631\u0627\u0646 \u0627\u0633\u062a\u0647\u062f\u0641\u062a \u0627\u0654\u062d\u062f \u0627\u0654\u0628\u0646\u0627\u064a\u0654\u064a\u060c \u0648\u062d\u0627\u0648\u0644\u062a \u0642\u062a\u0644\u0647\"\u060c \u0645\u0636\u064a\u0641\u0627\u064b \u0627\u0654\u0646 \"\u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0627\u0654\u0645\u0646\u064a\u0629 \u0644\u064a\u0633\u062a \u062a\u0631\u0641\u0627\u064b\"\u060c \u0645\u0646 \u062f\u0648\u0646 \u0627\u0654\u0646 \u064a\u0642\u062f\u0645 \u0627\u0654\u064a \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0655\u0636\u0627\u0641\u064a\u0629 \u0639\u0646 \u0627\u0644\u0645\u062e\u0637\u0637 \u0627\u0654\u0648 \u0645\u062f\u0649 \u0627\u0642\u062a\u0631\u0627\u0628 \u0627\u0644\u0627\u0654\u0645\u0631 \u0645\u0646 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0641\u0639\u0644\u064a.\u0643\u0645\u