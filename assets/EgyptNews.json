%AF-%D9%82%D8%A7%D8%AF%D8%B1-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%B0%D9%87%D8%A7%D8%A8-%D8%A8%D8%B9%D9%8A%D8%AF%D8%A7-", "title": "\u0643\u0627\u0631\u064a\u0643 \u064a\u062a\u062d\u062f\u0649 \u0643\u0628\u0627\u0631 \u0627\u0654\u0648\u0631\u0648\u0628\u0627: \u0645\u0627\u0646\u0634\u0633\u062a\u0631 \u064a\u0648\u0646\u0627\u064a\u062a\u062f \u0642\u0627\u062f\u0631 \u0639\u0644\u0649 \u0627\u0644\u0630\u0647\u0627\u0628 \u0628\u0639\u064a\u062f\u0627\u064b", "description": "\u064a\u0639\u062a\u0642\u062f \u0645\u0627\u064a\u0643\u0644 \u0643\u0627\u0631\u064a\u0643 \u0627\u0654\u0646 \u0641\u0631\u064a\u0642\u0647 \u0645\u0627\u0646\u0634\u0633\u062a\u0631 \u064a\u0648\u0646\u0627\u064a\u062a\u062f \u064a\u0645\u0644\u0643 \u0645\u0646 \u0627\u0644\u0642\u0648\u0629 \u0645\u0627 \u064a\u0648\u0654\u0647\u0644\u0647 \u0644\u0645\u0646\u0627\u0641\u0633\u0629 \u0627\u0654\u0641\u0636\u0644 \u0627\u0654\u0646\u062f\u064a\u0629 \u0627\u0654\u0648\u0631\u0648\u0628\u0627\u060c \u0648\u0630\u0644\u0643 \u0645\u0639 \u0639\u0648\u062f\u062a\u0647 \u0627\u0655\u0644\u0649 \u062f\u0648\u0631\u064a \u0627\u0654\u0628\u0637\u0627\u0644 \u0627\u0654\u0648\u0631\u0648\u0628\u0627 \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0645\u0646\u0630 \u062b\u0644\u0627\u062b\u0629 \u0627\u0654\u0639\u0648\u0627\u0645.\u0648\u062d\u0635\u0644 \u0643\u0627\u0631\u064a\u0643 \u0639\u0644\u0649 \u0645\u0646\u0635\u0628 \u0627\u0644\u0645\u062f\u0631\u0628 \u0627\u0644\u062f\u0627\u064a\u0654\u0645 \u0644\u0645\u0627\u0646\u0634\u0633\u062a\u0631 \u064a\u0648\u0646\u0627\u064a\u062a\u062f \u0628\u0639\u062f\u0645\u0627 \u0642\u0627\u062f \"\u0627\u0644\u0634\u064a\u0627\u0637\u064a\u0646 \u0627\u0644\u062d\u0645\u0631\" \u0627\u0655\u0644\u0649 \u0627\u062d\u062a\u0644\u0627\u0644 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u062b\u0627\u0644\u062b \u0641\u064a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0627\u0655\u0646\u0643\u0644\u064a\u0632\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632 \u062e\u0644\u0627\u0644 \u0641\u062a\u0631\u0629 \u062a\u0648\u0644\u064a\u0647 \u0627\u0644\u0645\u0647\u0645\u0629 \u0628\u0634\u0643\u0644 \u0645\u0648\u0654\u0642\u062a \u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u0645\u0627\u0636\u064a.\u0648\u0628\u0639\u062f \u0636\u0645\u0627\u0646 \u0645\u0642\u0639\u062f \u0641\u064a \u0646\u062e\u0628\u0629 \u0645\u0633\u0627\u0628\u0642\u0627\u062a \u0627\u0644\u0627\u0654\u0646\u062f\u064a\u0629 \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a\u0629\u060c \u064a\u0633\u062a\u0647\u0644 \u064a\u0648\u0646\u0627\u064a\u062a\u062f \u0645\u0634\u0648\u0627\u0631\u0647 \u0641\u064a \u0645\u0631\u062d\u0644\u0629 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u062e\u0645\u064a\u0633 \u0639\u0646\u062f\u0645\u0627 \u064a\u0633\u062a\u0636\u064a\u0641 \u0641\u0631\u064a\u0642 \u0635\u0628\u0627\u062d \u0628\u0637\u0644 \u0627\u0654\u0630\u0631\u0628\u064a\u062c\u0627\u0646 \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \u0627\u0654\u0648\u0644\u062f \u062a\u0631\u0627\u0641\u0648\u0631\u062f.\u0648\u0642\u0627\u0644 \u0643\u0627\u0631\u064a\u0643 \u0644\u0644\u0635\u062d\u0627\u0641\u064a\u064a\u0646 \u0627\u0644\u0627\u0654\u0631\u0628\u0639\u0627\u0621: \u0627\u0655\u0646\u0647\u0627 \u0628\u0637\u0648\u0644\u0629 \u0633\u0627\u062d\u0631\u0629. \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0645\u0643\u0627\u0646 \u0627\u0644\u0630\u064a \u0646\u0631\u064a\u062f \u062c\u0645\u064a\u0639\u0627 \u0627\u0654\u0646 \u0646\u0643\u0648\u0646 \u0641\u064a\u0647. \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u062e\u0627\u0631\u062c\u0647\u0627 \u062a\u062f\u0631\u0643 \u0645\u062f\u0649 \u062e\u0635\u0648\u0635\u064a\u062a\u0647\u0627\u060c \u0648\u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0636\u0645\u0646\u0647\u0627 \u062a\u0631\u063a\u0628 \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0641\u062