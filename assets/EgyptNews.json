7\u0644\u0627\u0655\u0645\u062f\u0627\u062f\u0627\u062a \u0648\u0627\u062d\u062a\u0645\u0627\u0644\u0627\u062a \u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0627\u0654\u0633\u0639\u0627\u0631 \u0642\u0628\u0644 \u0645\u0648\u0633\u0645 \u0627\u0644\u062a\u062f\u0641\u064a\u0654\u0629 \u0627\u0644\u0634\u062a\u0648\u064a. \u0648\u0627\u0654\u0638\u0647\u0631\u062a \u0628\u064a\u0627\u0646\u0627\u062a \"Gas Infrastructure Europe\" \u0627\u0654\u0646 \u0645\u0631\u0627\u0641\u0642 \u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u063a\u0627\u0632 \u0641\u064a \u062f\u0648\u0644 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a \u0643\u0627\u0646\u062a \u0645\u0645\u062a\u0644\u064a\u0654\u0629 \u0628\u0646\u0633\u0628\u0629 57% \u062d\u062a\u0649 5 \u0627\u0654\u063a\u0633\u0637\u0633\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0646\u062d\u0648 70% \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0646\u0641\u0633\u0647\u0627 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0645\u0627\u0636\u064a. \u0648\u062c\u0627\u0621\u062a \u0648\u062a\u064a\u0631\u0629 \u0627\u0655\u0639\u0627\u062f\u0629 \u0645\u0644\u0621 \u0627\u0644\u0645\u062e\u0632\u0648\u0646\u0627\u062a \u0627\u0654\u0628\u0637\u0627\u0654 \u0645\u0646 \u0627\u0644\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0628\u0639\u062f \u0634\u062a\u0627\u0621 2025-2026\u060c \u0641\u064a \u0638\u0644 \u062a\u0634\u062f\u064a\u062f \u0627\u0655\u0645\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u063a\u0627\u0632 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0627\u0644\u0645\u0633\u0627\u0644 \u0639\u0627\u0644\u0645\u064a\u064b\u0627\u060c \u0648\u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0654\u0632\u0645\u0629 \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0627\u0654\u0648\u0633\u0637\u060c \u0627\u0644\u062a\u064a \u0642\u0644\u0635\u062a \u062a\u0648\u0627\u0641\u0631 \u0627\u0644\u0634\u062d\u0646\u0627\u062a \u0627\u0644\u0645\u062a\u062c\u0647\u0629 \u0627\u0655\u0644\u0649 \u0627\u0654\u0648\u0631\u0648\u0628\u0627 \u0648\u0632\u0627\u062f\u062a \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0629 \u0645\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0646 \u0641\u064a \u0627\u0653\u0633\u064a\u0627. \u0648\u0627\u0654\u062b\u0627\u0631\u062a \u0648\u062a\u064a\u0631\u0629 \u0627\u0655\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0628\u0637\u064a\u064a\u0654\u0629 \u0634\u0643\u0648\u0643\u064b\u0627 \u062d\u0648\u0644 \u0642\u062f\u0631\u0629 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0627\u0654\u0648\u0631\u0648\u0628\u064a \u0639\u0644\u0649 \u0628\u0644\u0648\u063a \u0647\u062f\u0641\u0647 \u0627\u0644\u0627\u0633\u062a\u0631\u0634\u0627\u062f\u064a \u0627\u0644\u0645\u062a\u0645\u062b\u0644 \u0641\u064a \u0631\u0641\u0639 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0655\u0644\u0649 80% \u0628\u062d\u0644\u0648\u0644 \u0628\u062f\u0627\u064a\u0629 \u062f\u064a\u0633\u0645\u0628\u0631. \u0648\u062d\u0630\u0631 \u0645\u062d\u0644\u0644\u0648\u0646 \u0645\u0646 \u0627\u0654\u0646 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0645\u062e\u0632\u0648\u0646\u0627\u062a \u0642\u062f \u064a\u062c\u0639\u0644 \u0633\u0648\u0642 \u0627\u0644\u063a\u0627\u0632 \u0627\u0654\u0643\u062b\u0631 \u0639\u0631\u0636\u0629 \u0644\u062a\u0642\u0644\u0628\u0627\u062a \u0627\u0644\u0627\u0654\u0633\u0639\u0627\u0631 \u062e\u0644\u0627\u0644 \u0641\u0635\u0644 \u0627\u0644\u0634\u062a\u0627\u0621\u060c \u062e\u0627\u0635\u0629 \u0627\u0655\u0630\u0627 \u0627\u0654\u062f\u0649 \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u0627\u0654\u0643\u062b\u0631 \u0628\u0631\u0648\u062f\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u062a\u0627\u062f \u0627\u0655\u0644\u0649 \u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0637\u0644\u0628 \u0639\u0644\u0649 \u0627\u0644\u062a\u062f\u0641\u064a\u0654\u0629. \u0645\u0646 \u062c\u0647\u062a\u0647\u0627\u060c \u0642\u0627\u0644\u062a \u0634\u0631\u0643\u0629 \"Wood Mackenzie\" \u0627\u0655\u0646 \u0627\u0646\u062e\u0641\u0627\u0636 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0641\u064a \u0627\u0654\u0648\u0631\u0648\u0628\u0627 \u0632\u0627\u062f \u0645\u0646 \u0645\u062e\u0627\u0637\u0631 \u0627\u0654\u0645\u0646 \u0627\u0644\u0627\u0655\u0645\u062f\u0627\u062f\u0627\u062a \u062e\u0644\u0627\u0644 \u0634\u062a\u0627\u0621 2026-2027\u060c \u0645\u0636\u064a\u0641\u0629 \u0627\u0654\u0646 \u0645\u062d\u062f\u0648\u062f\u064a\u0629 \u0646\u0645\u0648 \u0627\u0655\u0645\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u063a\u0627\u0632 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0627\u0644\u0645\u0633\u0627\u0644 \u0639\u0627\u0644\u0645\u064a\u064b\u0627\u060c \u0627\u0655\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0642\u0648\u0629 \u0627\u0644\u0637\u0644\u0628 \u0641\u064a \u0627\u0653\u0633\u064a\u0627\u060c \u0645\u0646 \u0627\u0644\u0645\u0631\u062c\u062d \u0627\u0654\u0646 \u064a\u0628\u0642\u064a\u0627 \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u063a\u0627\u0632 \u0639\u0646\u062f \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0645\u0631\u062a\u0641\u0639\u0629 \u0637\u0648\u0627\u0644 \u0627\u0644\u0645\u0648\u0633\u0645. \u0648\u0642\u062f \u064a\u0647\u0645\u0643 \u0627\u0654\u064a\u0636\u064b\u0627 : \u062a\u0631\u0627\u062c\u0639 \u0648\u0627\u0631\u062f\u0627\u062a \u0627\u0655\u0633\u0628\u0627\u0646\u064a\u0627 \u0645\u0646 \u0627\u0644\u063a\u0627\u0632 \u0627\u0644\u0637\u0628\u064a\u0639\u064a 1% \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0653\u0633\u064a\u0627 \u0645\u0646 \u0627\u0644\u063a\u0627\u0632 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0648\u0633\u0637 \u062a\u0631\u0627\u062c\u0639 \u062