 \u062d\u064a\u062b \u0643\u0627\u0646 \u062e\u062a\u0627\u0645 \u0627\u0644\u062c\u0648\u0644\u0629 \u0628\u0645\u0648\u0627\u062c\u0647\u0629 \u0645\u062b\u064a\u0631\u0629 \u062c\u0645\u0639\u062a \u0628\u064a\u0646 \u0627\u0644\u0627\u0654\u0647\u0644\u064a \u0648\u0645\u0646\u0627\u0641\u0633\u0647 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0655\u0646\u0628\u064a\u060c \u0648\u0627\u0644\u062a\u064a \u0627\u0646\u062a\u0647\u062a \u0628\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0641\u0648\u0632 \u0644\u0635\u0627\u0644\u062d \"\u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0627\u0654\u062d\u0645\u0631\" \u0628\u0646\u062a\u064a\u062c\u0629 (3-2). \u0648\u0643\u0627\u0646\u062a \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062c\u0648\u0644\u0629 \u0627\u0646\u0637\u0644\u0642\u062a \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629 \u0627\u0644\u0645\u0627\u0636\u064a \u0628\u0645\u0648\u0627\u062c\u0647\u0629 \u0628\u064a\u0646 \u0641\u0631\u064a\u0642 \u0648\u0627\u062f\u064a \u062f\u062c\u0644\u0629 \u0648\u0645\u0646\u0627\u0641\u0633\u0647 \u0632\u062f\u060c \u0648\u0627\u0646\u062a\u0647\u062a \u0628\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u062a\u0639\u0627\u062f\u0644 \u0627\u0644\u0633\u0644\u0628\u064a \u0641\u064a \u0644\u0642\u0627\u0621 \u0627\u0654\u0642\u064a\u0645 \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \"\u0627\u0644\u0633\u0644\u0627\u0645\". \u0648\u0634\u0647\u062f \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0627\u0654\u0648\u0644 \u0645\u0646 \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0628\u0637\u0648\u0644\u0629 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0655\u0642\u0627\u0645\u0629 \u062b\u0644\u0627\u062b \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0629\u060c \u0627\u0646\u062a\u0647\u062a \u0628\u064a\u0646\u0647\u0627 \u0645\u0628\u0627\u0631\u0627\u062a\u0627\u0646 \u0628\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u062a\u0639\u0627\u062f\u0644 \u0627\u0644\u0633\u0644\u0628\u064a\u060c \u0648\u062a\u062d\u062f\u064a\u062f\u064b\u0627 \u0648\u0627\u062f\u064a \u062f\u062c\u0644\u0629 \u0636\u062f \u0632\u062f\u060c \u0648\u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0627\u0654\u0645\u0627\u0645 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0633\u0643\u0646\u062f\u0631\u064a. \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0641\u0648\u0632 \u0627\u0644\u0627\u0654\u0648\u0644 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062c\u0648\u0644\u0629 \u062a\u062d\u0642\u0642 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0635\u0627\u0639\u062f \u062d\u062f\u064a\u062b\u064b\u0627 \u0641\u0631\u064a\u0642 \u0627\u0654\u0628\u0648 \u0642\u064a\u0631 \u0644\u0644\u0627\u0654\u0633\u0645\u062f\u0629 \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0641\u0631\u064a\u0642 \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0627\u0654\u0647\u0644\u064a \u0628\u0647\u062f\u0641 \u062f\u0648\u0646 \u0631\u062f\u060c \u0641\u064a \u0644\u0642\u0627\u0621 \u0627\u0654\u0642\u064a\u0645 \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \"\u0627\u0633\u062a\u0627\u062f \u0627\u0644\u0627\u0655\u0633\u0643\u0646\u062f\u0631\u064a\u0629\". \u0648\u0628\u0627\u0644\u0639\u0648\u062f\u0629 \u0644\u0646\u062a\u064a\u062c\u0629 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0648\u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0633\u0643\u0646\u062f\u0631\u064a\u060c \u0648\u0631\u063a\u0645 \u0641\u0642\u062f\u0627\u0646 \"\u0627\u0644\u0641\u0627\u0631\u0633 \u0627\u0644\u0627\u0654\u0628\u064a\u0636\" \u0646\u0642\u0637\u062a\u064a\u0646 \u0641\u064a \u0633\u0628\u0627\u0642 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0644\u0642\u0628 \u0627\u0644\u0645\u062d\u0644\u064a \u0644\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u062b\u0627\u0646\u064a \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a\u060c \u0644\u0643\u0646\u0647 \u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0633\u062c\u0644 \u062e\u0627\u0644\u064d \u0645\u0646 \u0627\u0644\u0647\u0632\u0627\u064a\u0654\u0645 \u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u064011 \u062a\u0648\u0627\u0644\u064a\u064b\u0627. \u0648\u064a\u0645\u062a\u0644\u0643 \u0641\u0631\u064a\u0642 \u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0628\u0642\u064a\u0627\u062f\u0629 \u0645\u062f\u0631\u0628\u0647 \u0645\u0639\u062a\u0645\u062f \u062c\u0645\u0627\u0644 \u0633\u062c\u0644\u064b\u0627 \u0645\u0645\u064a\u0632\u064b\u0627 \u0641\u064a \u0627\u0644\u062c\u0648\u0644\u0629 \u0627\u0644\u0627\u0654\u0648\u0644\u0649\u060c \u0645\u0646 \u062e\u0644\u0627\u0644 \u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0641\u0648\u0632 \u0641\u064a \u0633\u0628\u0639 \u0645\u0646\u0627\u0633\u0628\u0627\u062a \u0633\u0627\u0628\u0642\u0629\u060c \u0628\u062e\u0644\u0627\u0641 \u0627\u0644\u062a\u0639\u0627\u062f\u0644 \u0641\u064a \u0627\u0654\u0631\u0628\u0639 \u0645\u0628\u0627\u0631\u064a\u0627\u062a\u060c \u0643\u0627\u0646 \u0627\u0653\u062e\u0631\u0647\u0627 \u0627\u0654\u0645\u0627\u0645 \"\u0632\u0639\u064a\u0645 \u0627\u0644\u062b\u063a\u0631\". \u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u0635\u0627\u0639\u062f\u0629 \u0627\u0654\u064a\u0636\u064b\u0627 \u0627\u0633\u062a\u0637\u0627\u0639\u062a \u0627\u0644\u0635\u0645\u0648\u062f \u0627\u0654\u0645\u0627\u0645 \u0643\u0628\u0627\u0631 \u0627\u0644\u062f\u0648\u0631\u064a\u060c \u0641\u0628\u062e\u0644\u0627\u0641 \u0641\u0648\u0632 \u0641\u0631\u064a\u0642 \u0627\u0654\u0628\u0648 \u0642\u064a\u0631 \u0644\u0644\u0627\u0654\u0633\u0645\u062f\u0629\u060c \u0646\u062c\u062d \u0641\u0631\u064a\u0642 \u0627\u0644\u0642\u0646\u0627\u0629 \u0641\u064a \u0627\u0644\u0641\u0648\u0632 \u0639\u0644\u0649 \u0633\u064a\u0631\u0627\u0645\u064a\u0643\u0627 \u0643\u0644\u064a\u0648\u0628\u0627\u062a\u0631\u0627 \u0628\u0646\u062a\u064a\u062c\u0629 (2-1)\u060c \u0648\u062a\u0639\u0627\u062f\u0644 \u0628\u062a\u0631\u0648\u0644 \u0627\u0654\u0633\u064a\u0648\u0637 \u0645\u0639 \u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0633\u0648\u064a\u0633 \u0628\u062a\u0631\u0648\u062c\u062a (1-1). \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0627\u0654\u0643\u0628\u0631 \u0641\u064a \u0627\u0644\u0627\u0654\u0633\u0628\u0648\u0639 \u0627\u0644\u0627\u0654\u0648\u0644 \u0643\u0627\u0646\u062a \u0645\u0646 \u062e\u0644\u0627\u0644 \u0641\u0631\u064a\u0642 \u0628\u064a\u0631\u0627\u0645\u064a\u062f\u0632\u060c \u0648\u0627\u0644\u0630\u064a \u062c\u0627\u0621 \u0639\u0644\u0649 \u0645\u0644\u0639\u0628 \"\u0627\u0644\u0645\u062d\u0644\u0629\" \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0641\u0631\u064a\u0642 \u063a\u0632\u0644 \u0627\u0644\u0645\u062d\u0644\u0629 \u0628\u062b\u0644\u0627\u062b\u0629 \u0627\u0654\u0647\u062f\u0627\u0641 \u062f\u0648\u0646 \u0631\u062f\u060c \u0644\u064a\u0643\u0648\u0646 \u0627\u0644\u0641\u0648\u0632 \u0627\u0644\u0627\u0654\u0643\u0628\u0631 \u062d\u062a\u0649 \u0627\u0644\u0627\u0653\u0646 \u0628\u0639\u062f \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u062c\u0648\u0644\u0629. \u0641\u064a \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u060c \u0634\u0647\u062f \u0644\u0642\u0627\u0621 \u0627\u0644\u0627\u0654\u0647\u0644\u064a \u0648\u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0655\u0646\u0628\u064a \u0645\u0639\u062f\u0644\u064b\u0627 \u062a\u0647\u062f\u064a\u0641\u064a\u064b\u0627 \u0647\u0648 \u0627\u0644\u0627\u0654\u0643\u0628\u0631 \u062d\u062a\u0649 \u0627\u0644\u0627\u0653\u0646\u060c \u0628\u0639\u062f \u062a\u0633\u062c\u064a\u0644 \u062e\u0645\u0633\u0629 \u0627\u0654\u0647\u062f\u0627\u0641\u060c \u0628\u0648\u0627\u0642\u0639 \u062b\u0644\u0627\u062b\u0629 \u0627\u0654\u0647\u062f\u0627\u0641 \u0645\u0646 \u062c\u0627\u0646\u0628 \"\u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0627\u0654\u062d\u0645\u0631\" \u0648\u0647\u062f\u0641\u064a\u0646 \u0645\u0646 \u062c\u0627\u0646\u0628 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0646\u062f\u0645\u062c \u0628\u064a\u0646 \u0627\u0655\u0646\u0628\u064a \u0648\u0627\u0644\u0634\u0631\u0642\u064a\u0629.", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": ["\u0627\u0644\u0632\u0645\u0627\u0644\u0643", "\u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0645\u0635\u0631\u064a", "\u0627\u0644\u0623\u0647\u0644\u064a"], "creator": ["\u0645\u062d\u0645\u062f \u0647\u0645\u0627\u0645"], "language": "arabic", "country": ["egypt"], "category": ["sports", "top"], "datatype": "news", "pubDate": "2026-08-24 10:38:00", "pubDateTZ": "UTC", "fetched_at": "2026-08-24 11:04:51", "image_url": "https://mediayk.gemini.media/img/yallakora/xlarge/2026/8/21/%D8%AD%D9%852026_8_21_21_34.webp", "video_url": null, "source_id": "yallakora", "source_name": "\u064a\u0644\u0627\u0643\u0648\u0631\u0629", "source_priority": 26290, "source_url": "https://www.yallakora.com", "source_icon": "https://n.bytvi.com/yallakora.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}], "nextPage": "1787567880228824597"}