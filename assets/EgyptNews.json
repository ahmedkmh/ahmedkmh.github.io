\u0635\u062f\u0631\u0647\u0627 \u0645\u0646\u0630 \u0635\u062f\u0648\u0631 \u0642\u0631\u0627\u0631 \u0625\u062f\u0627\u0646\u0629 \u0627\u0644\u0646\u0627\u062f\u064a \u0628\u0627\u0631\u062a\u0643\u0627\u0628 \u0627\u0646\u062a\u0647\u0627\u0643\u0627\u062a \u0648\u0627\u0633\u0639\u0629 \u0627\u0644\u0646\u0637\u0627\u0642 \u0644\u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0631\u0627\u0628\u0637\u0629 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632 \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645. \u0648\u064a\u062d\u0644 \u0645\u0627\u0646\u0634\u0633\u062a\u0631 \u0633\u064a\u062a\u064a \u0636\u064a\u0641\u0627\u064b \u062b\u0642\u064a\u0644\u0627\u064b \u0639\u0644\u0649 \u0646\u0627\u062f\u064a \u0644\u064a\u0641\u0631\u0628\u0648\u0644 \u064a\u0648\u0645 \u0627\u0644\u0623\u062d\u062f \u0627\u0644\u0645\u0642\u0628\u0644\u060c \u0641\u064a \u0645\u0628\u0627\u0631\u0627\u062a\u0647 \u0627\u0644\u0623\u0648\u0644\u0649 \u0627\u0644\u062a\u064a \u064a\u062e\u0648\u0636\u0647\u0627 \u0645\u0646\u0630 \u0635\u062f\u0648\u0631 \u0642\u0631\u0627\u0631 \u0644\u062c\u0646\u0629 \u0627\u0644\u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0645\u0633\u062a\u0642\u0644\u0629\u060c \u0648\u0627\u0644\u062a\u064a \u062e\u0644\u0635\u062a \u0646\u062a\u0627\u0626\u062c\u0647\u0627 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u0646\u0627\u062f\u064a \u0642\u0627\u0645 \u0628\u062a\u0636\u062e\u064a\u0645 \u0625\u064a\u0631\u0627\u062f\u0627\u062a\u0647 \u0628\u0634\u0643\u0644 \u0645\u0635\u0637\u0646\u0639 \u0628\u0623\u0643\u062b\u0631 \u0645\u0646 (\u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631) \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0645\u0645\u062a\u062f\u0629 \u0645\u0627 \u0628\u064a\u0646 \u0639\u0627\u0645\u064e\u064a (2009) \u0648(2018)\u060c \u0648\u0630\u0644\u0643 \u0628\u0647\u062f\u0641 \u0627\u0644\u0627\u0644\u062a\u0641\u0627\u0641 \u0639\u0644\u0649 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0644\u0639\u0628 \u0627\u0644\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0638\u064a\u0641 \u0627\u0644\u062a\u064a \u0643\u0627\u0646\u062a \u062a\u0641\u0631\u0636 \u0642\u064a\u0648\u062f\u0627\u064b \u0648\u0636\u0648\u0627\u0628\u0637 \u0635\u0627\u0631\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0646\u062f\u064a\u0629 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0629 \u062e\u0644\u0627\u0644 \u062a\u0644\u0643 \u0627\u0644\u0641\u062a\u0631\u0629. \u0648\u0623\u062f\u0627\u0646\u062a \u0627\u0644\u0644\u062c\u0646\u0629 \u0627\u0644\u0645\u0633\u062a\u0642\u0644\u0629 \u0646\u0627\u062f\u064a \u0645\u0627\u0646\u0634\u0633\u062a\u0631 \u0633\u064a\u062a\u064a \u0628\u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u0647\u0645 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u062e\u0637\u064a\u0631\u0629 \u0627\u0644\u0628\u0627\u0644\u063a \u0639\u062f\u062f\u0647\u0627 (80) \u062a\u0647\u0645\u0629\u060c \u0648\u0627\u0644\u062a\u064a \u0643\u0627\u0646\u062a \u0642\u062f \u0648\u062c\u0651\u0647\u062a\u0647\u0627 \u0631\u0633\u0645\u064a\u0627\u064b \u0631\u0627\u0628\u0637\u0629 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u060c \u0648\u0647\u0648 \u0627\u0644\u0623\u0645\u0631 \u0627\u0644\u0630\u064a \u0642\u062f \u064a\u0639\u0631\u0636 \u0627\u0644\u0646\u0627\u062f\u064a \u0644\u062e\u0637\u0631 \u0639\u0642\u0648\u0628\u0627\u062a \u0635\u0627\u0631\u0645\u0629 \u0648\u0631\u0627\u062f\u0639\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u062d\u062a\u0645\u0627\u0644 \u0627\u0633\u062a\u0628\u0639\u0627\u062f\u0647 \u0628\u0634\u0643\u0644 \u0643\u0627\u0645\u0644 \u0645\u0646 \u0645\u0646\u0627\u0641\u0633\u0627\u062a \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u060c \u0639\u0644\u0645\u0627\u064b \u0628\u0623\u0646 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0646\u0627\u062f\u064a \u0628\u0627\u062f\u0631\u062a \u0628\u0627\u0644\u062a\u0642\u062f\u0645 \u0628\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0631\u0633\u0645\u064a \u0636\u062f \u0647\u0630\u0647 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0648\u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a. \u0648\u0641\u064a \u0645\u0642\u0627\u0628\u0644\u0629 \u0635\u062d\u0641\u064a\u0629 \u062e\u0635\u0651 \u0628\u0647\u0627 \u0634\u0628\u0643\u0629 (\u0633\u0643\u0627\u064a \u0633\u0628\u0648\u0631\u062a\u0633) \u0648\u0646\u064f\u0634\u0631\u062a \u064a\u0648\u0645 \u0627\u0644\u062e\u0645\u064a\u0633\u060c \u0642\u0627\u0644 \u0647\u0627\u0644\u0627\u0646\u062f: (\u064a\u0646\u0628\u063a\u064a \u0639\u0644\u064a\u0646\u0627 \u0623\u0646 \u0646\u062a\u0643\u0627\u062a\u0641\u060c \u0648\u0623\u0646 \u0646\u062a\u0628\u0627\u062f\u0644 \u0645\u0634\u0627\u0639\u0631 \u0627\u0644\u0645\u062d\u0628\u0629 \u0648\u0627\u0644\u062f\u0639\u0645 \u0641\u064a\u0645\u0627 \u0628\u064a\u0646\u0646\u0627. \u0644\u0630\u0627\u060c \u0646\u0639\u0645\u060c \u064a\u062c\u0628 \u0623\u0646 \u0646\u062a\u0643\u0627\u062a\u0641 \u0648\u0646\u0633\u062a\u0645\u062a\u0639 \u0628\u0627\u0644\u0631\u062d\u0644\u0629 \u0648\u0646\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0628\u062a\u0633\u0627\u0645\u062a\u0646\u0627). \u0648\u0631\u062f\u0627\u064b \u0639\u0644\u0649 \u0633\u0624\u0627\u0644 \u0648\u064f\u062c\u0651\u0647 \u0625\u0644\u064a\u0647 \u0628\u0634\u0623\u0646 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062a\u064a \u064a\u0648\u062f \u062a\u0648\u062c\u064a\u0647\u0647\u0627 \u0644\u062c\u0645\u0627\u0647\u064a\u0631 \u0645\u0627\u0646\u0634\u0633\u062a\u0631 \u0633\u064a\u062a\u064a \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u0629 \u0644\u0645\u0633\u0627\u0646\u062f\u0629 \u0627\u0644\u0641\u0631\u064a\u0642 \u0641\u064a \u0645\u0644\u0639\u0628 (\u0623\u0646\u0641\u064a\u0644\u062f)\u060c \u062d\u064a\u062b \u064a\u064f\u0646\u062a\u0638\u0631 \u0623\u0646 \u064a\u0648\u0627\u062c\u0647 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0633\u062a\u0642\u0628\u0627\u0644\u0627\u064b \u062c\u0645\u0627\u0647\u064a\u0631\u064a\u0627\u064b \u0642\u062f \u064a\u062a\u0633\u0645 \u0628\u0627\u0644\u0639\u062f\u0627\u0626\u064a\u0629 \u0648\u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0634\u062f\u064a\u062f\u060c \u0642\u0627\u0644 \u0647\u0627\u0644\u0627\u0646\u062f: (\u064a\u0646\u0628\u063a\u064a \u0639\u0644\u064a\u0646\u0627 \u0623\u0646 \u0646\u062a\u0643\u0627\u062a\u0641\u060c \u0648\u0623\u0646 \u0646\u0628\u0642\u0649 \u0645\u062a\u062d\u062f\u064a\u0646\u060c \u0648\u0623\u0646 \u0646\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0646\u0638\u0631\u0629 \u0625\u064a\u062c\u0627\u0628\u064a\u0629). \u0648\u0627\u062e\u062a\u062a\u0645 \u0647\u0627\u0644\u0627\u0646\u062f \u062a\u0635\u0631\u064a\u062d\u0627\u062a\u0647 \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0639\u0644\u0649 \u0627\u0644\u0631\u0648\u062d \u0627\u0644\u0645\u0639\u0646\u0648\u064a\u0629 \u0642\u0627\u0626\u0644\u0627\u064b: (\u0645\u0647\u0645\u0627 \u062d\u062f\u062b \u0641\u064a \u0627\u0644\u062d\u064a\u0627\u0629\u060c \u064a\u062c\u0628 \u0623\u0646 \u0646\u062d\u0627\u0641\u0638 \u062f\u0627\u0626\u0645\u0627\u064b \u0639\u0644\u0649 \u0627\u0628\u062a\u0633\u0627\u0645\u062a\u0646\u0627. \u0644\u0630\u0627\u060c \u064a\u062a\u0639\u064a\u0646 \u0639\u0644\u064a\u0646\u0627 \u0623\u0646 \u0646\u062a\u062d\u0644\u0649 \u0628\u0627\u0644\u0625\u064a\u062c\u0627\u0628\u064a\u0629\u060c \u0648\u0646\u062a\u0637\u0644\u0639 \u0644\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u060c \u0648\u0646\u0633\u0639\u0649 \u0644\u0644\u0641\u0648\u0632 \u0628\u0627\u0644\u0645\u0628\u0627\u0631\u064a\u0627\u062a\u060c \u062b\u0645 \u0646\u062d\u0627\u0648\u0644 \u0627\u0644\u