.\u0648\u0627\u0654\u0638\u0647\u0631 \u062a\u062d\u0644\u064a\u0644 \u0627\u0654\u062c\u0631\u062a\u0647 \u0635\u062d\u064a\u0641\u0629 \"\u0641\u0627\u064a\u0646\u0627\u0646\u0634\u0627\u0644 \u062a\u0627\u064a\u0645\u0632\" \u0627\u0633\u062a\u0646\u0627\u062f\u0627\u064b \u0627\u0655\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0634\u0631\u0643\u0629 Solve \u0627\u0644\u0645\u062a\u062e\u0635\u0635\u0629 \u0641\u064a \u0627\u0654\u0633\u0648\u0627\u0642 \u0627\u0644\u062f\u062e\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u060c \u0627\u0654\u0646 \u0642\u064a\u0645\u0629 \u0627\u0644\u0642\u0631\u0648\u0636 \u0627\u0644\u0645\u062a\u0639\u062b\u0631\u0629 \u0644\u062f\u0649 \u0639\u062f\u062f \u0645\u0646 \u0627\u0654\u0643\u0628\u0631 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646 \u0641\u064a \u0627\u0644\u062f\u064a\u0648\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0639\u0627\u062f\u062a \u0627\u0655\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0634\u0648\u0647\u062f\u062a \u0627\u0653\u062e\u0631 \u0645\u0631\u0629 \u0639\u0642\u0628 \u062a\u062f\u0627\u0639\u064a\u0627\u062a \u0627\u0646\u0647\u064a\u0627\u0631 \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0646\u0641\u0637 \u0641\u064a 2017.\u0648\u0627\u0631\u062a\u0641\u0639\u062a \u0627\u0644\u0642\u0631\u0648\u0636 \u0630\u0627\u062a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \"\u063a\u064a\u0631 \u0645\u062f\u0631\u0629 \u0644\u0644\u0639\u0627\u064a\u0654\u062f\" \u0644\u062f\u0649 \u0627\u0654\u0643\u0628\u0631 20 \u0634\u0631\u0643\u0629 \u062a\u0637\u0648\u064a\u0631 \u0627\u0654\u0639\u0645\u0627\u0644 \u0645\u062f\u0631\u062c\u0629 (BDCs)\u060c \u0648\u0647\u064a \u0635\u0646\u0627\u062f\u064a\u0642 \u062a\u0633\u062a\u062b\u0645\u0631 \u0641\u064a \u0627\u0644\u0627\u064a\u0654\u062a\u0645\u0627\u0646 \u0627\u0644\u062e\u0627\u0635\u060c \u0627\u0655\u0644\u0649 \u0645\u062a\u0648\u0633\u0637 2.8% \u0645\u0646 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\