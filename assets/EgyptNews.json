0646 \u0627\u0655\u064a\u0647 \u0627\u0653\u064a\" \u0639\u0646 \u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0627\u0654\u0631\u0628\u0627\u062d\u060c \u0641\u064a \u0648\u0642\u062a \u062a\u0633\u062a\u0639\u062f \u0641\u064a\u0647 \u0627\u0644\u0634\u0631\u0643\u0629 \u0644\u0637\u0631\u062d \u0639\u0627\u0645 \u0627\u0654\u0648\u0644\u064a \u0645\u062d\u062a\u0645\u0644 \u064a\u062d\u0638\u0649 \u0628\u0627\u0647\u062a\u0645\u0627\u0645 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0627\u0654\u0633\u0648\u0627\u0642.\u0648\u0641\u064a \u0627\u0644\u0645\u0642\u0627\u0628\u0644\u060c \u0633\u062c\u0644\u062a \u0634\u0631\u0643\u0629 \u0627\u0654\u0646\u062b\u0631\u0648\u0628\u064a\u0643 \u0627\u0654\u062f\u0627\u0621\u064b \u0627\u0654\u0642\u0648\u0649 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0646\u0641\u0633\u0647\u0627\u060c \u0627\u0655\u0630 \u0632\u0627\u062f\u062a \u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a\u0647\u0627 \u0628\u0627\u0654\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0636\u0639\u0641 \u0627\u0655\u0644\u0649 11.6 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631\u060c \u0644\u062a\u062a\u062c\u0627\u0648\u0632 \u0644\u0644\u0645\u0631\u0629 \u0627\u0644\u0627\u0654\u0648\u0644\u0649 \u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \"\u0627\u0654\u0648\u0628\u0646 \u0627\u0655\u064a\u0647 \u0627\u0653\u064a\"\u060c \u0643\u0645\u0627 \u062a\u062d\u0648\u0644\u062a \u0627\u0655\u0644\u0649 \u062a\u062d\u0642\u064a\u0642 \u0631\u0628\u062d \u062a\u0634\u063a\u064a\u0644\u064a \u0645\u062d\u062f\u0648\u062f.\u0648\u062a\u0639\u0643\u0633 \u0627\u0644\u0646\u062a\u0627\u064a\u0654\u062c \u0627\u0644\u062a\u0628\u0627\u064a\u0646 \u0627\u0644\u0645\u062a\u0632\u0627\u064a\u062f \u0641\u064a \u0633\u0628\u0627\u0642 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0628\u0639\u062f \u062a\u0628\u0627\u0637\u0648\u0654 \u0646\u0645\u0648 \u0634\u0627\u062a 