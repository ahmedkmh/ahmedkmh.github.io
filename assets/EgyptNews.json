u0627\u0628\u064a\u0639. \u0648\u062a\u062f\u0647\u0648\u0631\u062a \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0628\u0644\u062f\u064a\u0646 \u0645\u0646\u0630 \u0627\u0646\u0636\u0645\u0627\u0645 \u0643\u0648\u0631\u064a\u0627 \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 \u0627\u0655\u0644\u0649 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0644\u063a\u0631\u0628\u064a\u0629 \u0639\u0642\u0628 \u0627\u0644\u063a\u0632\u0648 \u0627\u0644\u0631\u0648\u0633\u064a \u0644\u0627\u0654\u0648\u0643\u0631\u0627\u0646\u064a\u0627\u060c \u0648\u0645\u0646\u0630 \u0639\u0632\u0632\u062a \u0645\u0648\u0633\u0643\u0648 \u0639\u0644\u0627\u0642\u0627\u062a\u0647\u0627 \u0645\u0639 \u0643\u0648\u0631\u064a\u0627 \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629.\u0648\u0627\u0654\u0641\u0627\u062f\u062a \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0641\u064a \u0633\u064a\u0648\u0644 \u0628\u0627\u0654\u0646 \u0637\u0627\u064a\u0654\u0631\u0627\u062a \u0631\u0648\u0633\u064a\u0629 \u062f\u062e\u0644\u062a \u0645\u0646\u0637\u0642\u0629 \u062a\u062d\u062f\u064a\u062f \u0647\u0648\u064a\u0629 \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u062c\u0648\u064a \u0627\u0644\u062a\u0627\u0628\u0639\u0629 \u0644\u0647\u0627 \u0641\u0648\u0642 \u0628\u062d\u0631 \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0628\u0627\u0633\u0645 \u0628\u062d\u0631 \u0627\u0644\u064a\u0627\u0628\u0627\u0646 \u062b\u0645 \u063a\u0627\u062f\u0631\u062a\u0647\u0627.\u0648\u0630\u0643\u0631\u062a \u0641\u064a \u0628\u064a\u0627\u0646\u0647\u0627 \u0627\u0654\u0646 \"\u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0643\u0648\u0631\u064a \u0627\u0644\u062c\u0646\u0648\u0628\u064a \u0631\u0635\u062f \u0627\u0644\u0637\u0627\u064a\u0654\u0631\u0627\u062a \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0642\u0628\u0644 \u062f\u062e\u0648\u0644\u0647\u0627 \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u0648\u064