 \u0627\u0644\u062a\u0648\u062a\u0631\u0627\u062a \u0627\u0644\u062c\u064a\u0648\u0633\u064a\u0627\u0633\u064a\u0629 \u0648\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u0629 \u0648\u0627\u0644\u0627\u0654\u0633\u0648\u0627\u0642 \u0627\u0644\u062a\u064a \u062a\u0634\u0647\u062f\u0647\u0627 \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u0628\u0627\u0644\u062a\u0648\u0627\u0632\u064a \u0645\u0639 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0646\u0645\u0648 \u0627\u0644\u0627\u0654\u0646\u0634\u0637\u0629 \u063a\u064a\u0631 \u0627\u0644\u0646\u0641\u0637\u064a\u0629 \u0648\u0627\u0644\u0627\u0655\u0646\u0641\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u0642\u0637\u0627\u0639\u0627\u062a \u0630\u0627\u062a \u0627\u0644\u0627\u0654\u0648\u0644\u0648\u064a\u0629. \u0648\u0628\u0644\u063a\u062a \u0627\u0644\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0646\u064a 373.1 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 (99.5 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631)\u060c \u0644\u064a\u0633\u062c\u0644 \u0627\u0644\u0639\u062c\u0632 34.3 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 (9.1 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631). \u0648\u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0635\u0641 \u0627\u0644\u0627\u0654\u0648\u0644\u060c \u0627\u0631\u062a\u0641\u0639\u062a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a 6 \u0641\u064a \u0627\u0644\u0645\u0627\u064a\u0654\u0629 \u0627\u0655\u0644\u0649 599.8 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 (159.9 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631)\u060c \u0645\u0642\u0627\u0628\u0644 \u0627\u0655\u0646\u0641\u0627\u0642 \u0628\u0644\u063a 759.8 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 (202.6 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631)\u060c \u0648\u0639\u062c\u0632 \u062a\u0631\u0627\u0643\u0645\u064a \u0642\u062f\u0631\u0647 160 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 (42.7 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631)\u060c \u062c\u0631\u0649 \u062a\u0645\u0648\u064a\u0644\u0647 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0628\u0631 \u0627\u0644\u062f\u064a\u0646. \u0642\u062f \u064a\u0647\u0645\u0643 \u0627\u0654\u064a\u0636\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0627 80 \u0645\u0644\u064a\u0627\u0631 \u0631\u064a\u0627\u0644 \u0639\u062c\u0632 \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0641\u064a 2023 \u0648\u0627\u0644\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u063a\u064a\u0631 \u0627\u0644\u0646\u0641\u0637\u064a\u0629 \u062a\u0631\u062a\u0641\u0639 11 % \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u064a\u062a\u062d\u062f\u0649 \u0627\u0644\u0636\u063a\u0648\u0637 \u0648\u064a\u0646\u0645\u0648 2.8 % \u0628\u0631\u0627\u0641\u0639\u0629 \u0627\u0644\u0627\u0654\u0646\u0634\u0637\u0629 \u063a\u064a\u0631 \u0627\u0644\u0646\u0641\u0637\u064a\u0629", "content": "ONLY AVAILABLE IN PAID PLANS", "keywords": null, "creator": ["\u0627\u0644\u0631\u064a\u0627\u0636  \u0645\u0635\u0631 \u0627\u0644\u064a\u0648\u0645"], "language": "arabic", "country": ["egypt"], "category": ["business"], "datatype": "news", "pubDate": "2026-07-30 22:47:33", "pubDateTZ": "UTC", "fetched_at": "2026-07-30 22:47:33", "image_url": "https://www.egypt-today.com/img/2026/04/exlarge/phofghfgh.jpg", "video_url": null, "source_id": "egypt_today", "source_name": "Egypt Today", "source_priority": 477098, "source_url": "https://www.egypt-today.com", "source_icon": "https://n.bytvi.com/egypt_today.png", "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE