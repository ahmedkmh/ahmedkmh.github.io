627\u0644\u0646\u0641\u0637 \u060c \u0645\u0636\u064a\u0641\u0627\u064b \u0627\u0654\u0646 \u0627\u0644\u0645\u0633\u062a\u062b\u0645\u0631\u064a\u0646 \u0644\u0627 \u064a\u0631\u063a\u0628\u0648\u0646 \u0641\u064a \u0627\u0641\u062a\u0631\u0627\u0636 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0644\u062a\u0635\u0639\u064a\u062f \u062f\u0648\u0646 \u0627\u0654\u0641\u0642 \u0644\u0644\u062d\u0644. \u0648\u062c\u0627\u0621 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0628\u0639\u062f \u0627\u0654\u0646 \u0630\u0643\u0631\u062a \u0645\u0635\u0627\u062f\u0631 \u0627\u0654\u0646 \u0627\u0644\u0635\u064a\u0646 \u0627\u0654\u0637\u0644\u0642\u062a \u062a\u062d\u0631\u0643\u0627\u064b \u0644\u0627\u0633\u062a\u064a\u0654\u0646\u0627\u0641 \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0633\u0644\u0627\u0645 \u0628\u064a\u0646 \u0627\u0654\u0645\u064a\u0631\u0643\u0627 \u0648\u0627\u0655\u064a\u0631\u0627\u0646\u060c \u0641\u064a \u0648\u0642\u062a \u062a\u0648\u0639\u062f \u0641\u064a\u0647 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u0628 \u0627\u0655\u064a\u0631\u0627\u0646 \u0648\u0627\u0644\u062d\u0648\u062b\u064a\u064a\u0646 \u0628\u0640\"\u0639\u0642\u0627\u0628 \u0639\u0633\u0643\u0631\u064a \u0642\u0627\u0633\" \u0639\u0642\u0628 \u0627\u0644\u0647\u062c\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u0647\u062f\u0641\u062a \u0646\u0627\u0642\u0644\u0627\u062a \u0646\u0641\u0637 \u0641\u064a \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0627\u0654\u062d\u0645\u0631. \u0648\u0627\u0654\u0638\u0647\u0631\u062a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0654\u0648\u0644\u064a\u0629 \u0635\u0627\u062f\u0631\u0629 \u0639\u0646 \u0634\u0631\u0643\u0629 \"\u0643\u0628\u0644\u0631\" \u0644\u062a\u062a\u0628\u0639 \u0627\u0644\u0633\u0641\u0646 \u0627\u0654\u0646 \u0645\u062a\u0648\u0633\u0637 \u0639\u062f\u062f \u0627\u0644\u0633\u0641\u0646 \u0627\u0644\u0639\u0627\u0628\u0631\u0629 \u0644\u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632 \u0628\u0644\u063a \u062b\u0644\u0627\u062b \u0633\u0641\u0646 \u064a\u0648\u0645\u064a\u0627\u064b \u062e\u0644\u0627\u0644 \u0627\u0644\u0627\u0654\u064a\u0627\u0645 \u0627\u0644\u062b\u0644\u0627\u062b\u0629 \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0631\u062a\u0641\u0639 \u0639\u062f\u062f \u0627\u0644\u0633\u0641\u0646 \u0627\u0644\u0639\u0627\u0628\u0631\u0629 \u0644\u0645\u0636\u064a\u0642 \u0628\u0627\u0628 \u0627\u0644\u0645\u0646\u062f\u0628 \u0627\u0655\u0644\u0649 32 \u0633\u0641\u064a\u0646\u0629 \u064a\u0648\u0645 \u0627\u0644\u062e\u0645\u064a\u0633\u060c \u0645\u0642\u0627\u0628\u0644 26 \u0633\u0641\u064a\u0646\u0629 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0627\u0628\u0642. \u0648\u0642\u0627\u0644 \u062c\u064a\u0648\u0641\u0627\u0646\u064a \u0633\u062a\u0648\u0646\u0648\u0641\u0648\u060c \u0627\u0644\u0645\u062d\u0644\u0644 \u0644\u062f\u0649 \"\u064a\u0648 \u0628\u064a \u0627\u0655\u0633\"\u060c \u0627\u0655\u0646 \u062d\u0631\u0643\u0629 \u0627\u0644\u0633\u0641\u0646 \u0644\u0627 \u062a\u0632\u0627\u0644 \u0645\u0633\u062a\u0645\u0631\u0629 \u0639\u0628\u0631 \u0627\u0644\u0645\u0645\u0631\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629\u060c \u0645\u0627 \u064a\u0634\u064a\u0631 \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0627\u0644\u0648\u0636\u0639 \u0644\u0627 \u064a\u0631\u0642\u0649 \u0627\u0655\u0644\u0649 \u062d\u0635\u0627\u0631 \u0643\u0627\u0645\u0644 \u0643\u0645\u0627 \u0643\u0627\u0646\u062a \u062a\u062e\u0634\u0649 \u0627\u0644\u0627\u0654\u0633\u0648\u0627\u0642. \u0648\u0627\u0654\u0634\u0627\u0631 \u0645\u062d\u0644\u0644\u0648\u0646 \u0641\u064a \"\u062c\u064a\u0647 \u0628\u064a \u0645\u0648\u0631\u063a\u0627\u0646\" \u0627\u0655\u0644\u0649 \u0627\u0654\u0646 \u0643\u0644 \u0634\u0647\u0631 \u0627\u0655\u0636\u0627\u0641\u064a \u0645\u