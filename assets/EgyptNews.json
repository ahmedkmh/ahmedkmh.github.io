27\u0655\u0644\u0649 110\u2013120 \u062c\u0646\u064a\u0647\u0627\u064b (2.12 \u2013 2.31 \u062f\u0648\u0644\u0627\u0631) \u062d\u0627\u0644\u064a\u0627\u064b \u0644\u062f\u0649 \u0627\u0644\u0645\u0646\u062a\u062c\u064a\u0646\u060c \u0641\u064a \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0627\u0654\u0633\u0631\u0639 \u0627\u0644\u062a\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0633\u0639\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u062e\u0644\u0627\u0644 \u0627\u0644\u0641\u062a\u0631\u0629 \u0627\u0644\u0627\u0654\u062e\u064a\u0631\u0629.\u0648\u0648\u0635\u0644 \u0633\u0639\u0631 \u0627\u0644\u0637\u0628\u0642 \u0644\u0644\u0645\u0633\u062a\u0647\u0644\u0643 ( 30 \u0628\u064a\u0636\u0629) \u0627\u0655\u0644\u0649 \u0646\u062d\u0648 130 \u062c\u0646\u064a\u0647\u0627\u064b (2.50 \u062f\u0648\u0644\u0627\u0631) \u0644\u0644\u0628\u064a\u0636 \u0627\u0644\u0627\u0654\u0628\u064a\u0636 \u0648140 \u062c\u0646\u064a\u0647\u0627\u064b (2.69 \u062f\u0648\u0644\u0627\u0631) \u0644\u0644\u0627\u0654\u062d\u0645\u0631\u060c \u0628\u062d\u0633\u0628 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0648\u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u0639\u0631\u0636 \u0648\u0627\u0644\u0637\u0644\u0628\u060c \u0641\u064a\u0645\u0627 \u0627\u0654\u0639\u0627\u062f\u062a \u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0655\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u062a\u0642\u062a\u0631\u0628 \u0645\u0646 \u0627\u0654\u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a\u0647\u0627 \u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u062e\u0644\u0627\u0644 \u0646\u062d\u0648 14 \u0634\u0647\u0631\u0627\u064b.\u0648\u062a\u0627\u0654\u062a\u064a \u0627\u0644\u0642\u0641\u0632\u0629 \u0628\u0639\u062f \u0627\u0654\u0634\u0647\u0631 \u0645\u0646 \u062a\u0631\u0627\u062c\u0639 \u0627\u0654\u0633\u0639\u0627\u0631 \u0627\u0644\u0628\u064a\u0636 \u0627\u0655\u0644\u0649 \u0645\u0633\u062a\u06