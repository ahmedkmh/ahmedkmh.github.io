u0627\u0633\u0644\u0645\" \u062a\u0641\u0631\u0636 \u062a\u0643\u0627\u0644\u064a\u0641 \u0628\u0627\u0647\u0638\u0629 \u0639\u0644\u0649 \u0627\u0644\u0634\u0639\u0628 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a \u0648\u062d\u062f\u0647. \u0643\u0645\u0627 \u0632\u0639\u0645 \u0623\u0646 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u062a\u062a\u0643\u0628\u062f \u062a\u0643\u0627\u0644\u064a\u0641 \u0645\u0627\u0644\u064a\u0629 \u0648\u0633\u064a\u0627\u0633\u064a\u0629 \u0639\u0627\u0644\u064a\u0629 \u0646\u062a\u064a\u062c\u0629 \u0641\u0631\u0636 \u0627\u0644\u062d\u0635\u0627\u0631 \u0627\u0644\u0628\u062d\u0631\u064a\u060c \u0645\u0634\u064a\u0631\u0627\u064b \u0625\u0644\u0649 \u0623\u0646 \u0625\u063a\u0644\u0627\u0642 \u0645\u0636\u064a\u0642 \u0647\u0631\u0645\u0632 \u062a\u0633\u0628\u0628 \u0641\u064a \u0636\u063a\u0648\u0637 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0648\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629\u060c \u0648\u0647\u0648 \u0645\u0627 \u0627\u0646\u0639\u0643\u0633\u062a \u0622\u062b\u0627\u0631\u0647 \u0628\u0648\u0636\u0648\u062d \u0639\u0644\u0649 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0623\u0645\u064a\u0631\u0643\u064a. \u0648\u0623\u0636\u0627\u0641 \u0627\u0644\u0642\u064a\u0627\u062f\u064a \u0641\u064a \u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u062b\u0648\u0631\u064a \u0623\u0646 \"\u0627\u0644\u0631\u0623\u064a \u0627\u0644\u0639\u0627\u0645 \u0641\u064a \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u064a\u0648\u0627\u062c\u0647 \u0627\u0644\u064a\u0648\u0645 \u0636\u063a\u0648\u0637\u0627\u064b \u0634\u062f\u064a\u062f\u0629 \u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0623\u0632\u0645\u0627\u062a \u0648\u0627\u0644\u062a\u0636\u062e\u0645 \u0627\u0644\u0646\u0627\u062c\u0645\u064a\u0646 \u0639\u0646 \u0627\u0644\u062d\u0631\u0628\u060c \u0645\u0627 \u0623\u062f\u0649 \u0625\u0644\u0649 \u062a\u0632\u0627\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u064a\u0627\u0621 \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\". \u0648\u0631\u0623\u0649 \u062c\u0648\u0627\u0646\u064a \u0623\u0646 \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u0645\u064a\u0631\u0643\u064a \u064a\u0633\u0639\u0649 \u0644\u0648\u0636\u0639 \u062d\u062f \u0644\u0647\u0630\u0627 \u0627\u0644\u0646\u0632\u0627\u0639 \u0644\u0643\u0646\u0647 \u0644\u064a\u0633 \u0645\u0633\u062a\u0639\u062f\u0627\u064b \u0644\u0644\u0627\u0639\u062a\u0631\u0627\u0641 \u0628\u0627\u0644\u0647\u0632\u064a\u0645\u0629\u060c \u0645\u062a\u0647\u0645\u0627\u064b \u0648\u0627\u0634\u0646\u0637\u0646 \u0628\u0645\u062d\u0627\u0648\u0644\u0629 \u062a\u063a\u064a\u064a\u0631 \u0638\u0631\u0648\u0641 \u0627\u0644\u062d\u0631\u0628 \u0644\u0635\u0627\u0644\u062d\u0647\u0627 \u0639\u0628\u0631 \u0645\u0648\u0627\u0635\u0644\u0629 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0648\u0645\u0624\u0643\u062f\u0627\u064b \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0630\u0627\u062a\u0647 \u0623\u0646 \u0625\u064a\u0631\u0627\u0646 \"\u0645\u0633\u062a\u0639\u062f\u0629 \u0644\u0644\u0631\u062f \u0639\u0644\u0649 \u0623\u064a \u0639\u0645\u0644 \u0639\u0633\u0643\u0631\u064a \u062c\u062f\u064a\u062f \u0628\u0634\u0643\u0644 \u062d\u0627\u0633\u0645 \u0648\u0623\u0643\u062b\u0631 \u0642\u0648\u0629\". \u062a\u0623\u062a\u064a \u062a\u0635\u0631\u064a\u062d\u0627\u062a \u062c\u0648\u0627\u0646\u064a \u0631\u062f\u0627\u064b \u0639\u0644\u0649 \u062a\u0635\u0631\u064a\u062d\u0627\u062a \u0644\u0644\u0631\u0626\u064a\u0633 \u0627\u0644\u0623\u0645\u064a\u0631\u0643\u064a \u062f\u