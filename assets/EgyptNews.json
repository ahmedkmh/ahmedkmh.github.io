629.\u0648\u0642\u0627\u0644 \u062a\u0631\u0627\u0645\u0628\u060c \u0641\u064a \u0645\u0646\u0634\u0648\u0631 \u0639\u0628\u0631 \u062d\u0633\u0627\u0628\u0647 \u0639\u0644\u0649 \u0645\u0646\u0635\u0629 \"\u062a\u0631\u0648\u062b \u0633\u0648\u0634\u064a\u0627\u0644\"\u060c \u0627\u0655\u0646 \u0631\u0627\u064a\u062f\u0627\u0648\u062a \"\u062a\u0645 \u062a\u0633\u0644\u064a\u0645\u0647 \u0627\u0655\u0644\u0649 \u0627\u0644\u0633\u0644\u0637\u0627\u062a \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a\u0629\"\u060c \u0645\u0646 \u062f\u0648\u0646 \u0627\u0654\u0646 \u064a\u0643\u0634\u0641 \u062a\u0641\u0627\u0635\u064a\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0627\u0655\u0641\u0631\u0627\u062c \u0639\u0646\u0647 \u0627\u0654\u0648 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u062a\u064a \u062a\u0648\u0633\u0637\u062a \u0644\u0644\u062a\u0648\u0635\u0644 \u0627\u0655\u0644\u0649 \u0627\u0644\u0627\u062a\u0641\u0627\u0642.\u0643\u0645\u0627 \u0627\u0654\u0636\u0627\u0641 \u062a\u0631\u0627\u0645\u0628: \"\u064a\u0633\u0639\u062f\u0646\u064a \u0627\u0654\u0646 \u0627\u0654\u0639\u0644\u0646 \u0627\u0654\u0646 \u0643\u064a\u0641\u0646 \u0631\u0627\u064a\u062f\u0627\u0648\u062a \u0639\u0627\u062f \u0645\u062c\u062f\u062f\u0627\u064b \u0627\u0655\u0644\u0649 \u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629\".\u0643\u0627\u0646 \u0631\u0627\u064a\u062f\u0627\u0648\u062a \u0642\u062f \u0627\u062e\u062a\u064f\u0637\u0641 \u0641\u064a \u0627\u0654\u0643\u062a\u0648\u0628\u0631 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0645\u0627\u0636\u064a \u0627\u0654\u0645\u0627\u0645 \u0645\u0646\u0632\u0644\u0647 \u0641\u064a \u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0646\u064a\u062c\u0631\u064a\u0629 \u0646\u064a\u0627\u0645\u064a\u060c \u0648\u0641\u0642 \u0645\u0627 \u0627\u0654\u0641\u0627\u062f\u062a \u062a\u0642\u0627\u0631\u064a\u0631 \u0633\u0627\u0628\u0642\u0