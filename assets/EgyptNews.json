29 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u062d\u064a\u062b \u0643\u0634\u0641 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0623\u0631\u062c\u0646\u062a\u064a\u0646\u064a \u0639\u0646 \u0644\u0627\u0641\u062a\u0629 \u0639\u064f\u0631\u0636\u062a \u0623\u0645\u0627\u0645 \u0627\u0644\u062c\u0645\u064a\u0639 \u0643\u062a\u0628 \u0639\u0644\u064a\u0647\u0627: (\u062c\u0632\u0631 \u0641\u0648\u0643\u0644\u0627\u0646\u062f \u0623\u0631\u062c\u0646\u062a\u064a\u0646\u064a\u0629) \u0643\u0645\u0627 \u062c\u0631\u0649 \u062f\u0639\u0648\u0629 \u0627\u0644\u0645\u062d\u0627\u0631\u0628 \u0627\u0644\u0642\u062f\u064a\u0645 \u0641\u064a \u062d\u0631\u0628 \u0641\u0648\u0643\u0644\u0627\u0646\u062f \u0641\u0627\u0628\u064a\u0648 \u0633\u0627\u0646\u062a\u0627\u0646\u0627 \u0648\u0627\u0644\u0630\u064a \u0648\u0636\u0639 \u0639\u0644\u0645 \u0627\u0644\u062c\u0632\u0631 \u0639\u0644\u0649 \u0643\u062a\u0641\u064a\u0647 \u0644\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0623\u0631\u0636 \u0627\u0644\u0645\u0644\u0639\u0628 \u0644\u063a\u0646\u0627\u0621 \u0627\u0644\u0646\u0634\u064a\u062f \u0627\u0644\u0648\u0637\u0646\u064a \u0627\u0644\u0623\u0631\u062c\u0646\u062a\u064a\u0646\u064a \u0642\u0628\u0644 \u0627\u0646\u0637\u0644\u0627\u0642 \u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0644\u064a\u0642\u0641 \u0628\u0639\u062f\u0647\u0627 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0648\u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0641\u0646\u064a \u0628\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0645\u062f\u0631\u0628 \u0644\u064a\u0648\u0646\u064a\u0644 \u0633\u0643\u0627\u0644\u0648\u0646\u064a \u0644\u0627\u0644\u062a\u0642\u0627\u0637 \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u062a\u0630\u0643\u0627\u0631\u064a\u0629 \u0645\u0639 \u0627\u0644\u0644\u0627\u0641\u062a\u0629 \u0627\u0644\u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u062c\u062f\u0644 \u0648\u0627\u0644\u062a\u064a \u0638\u0647\u0631\u062a \u0623\u064a\u0636\u0627\u064b \u0628\u0643\u062b\u0627\u0641\u0629 \u0641\u064a \u0645\u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062c\u0645\u0627\u0647\u064a\u0631. \u0648\u0628\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u062e\u0628 \u0627\u0644\u0623\u0631\u062c\u0646\u062a\u064a\u0646\u064a \u0645\u0647\u062f\u062f\u0627\u064b \u0628\u062a\u0644\u0642\u064a \u0639\u0642\u0648\u0628\u0629 \u0627\u0646\u0636\u0628\u0627\u0637\u064a\u0629 \u062c\u062f\u064a\u062f\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u062f\u0648\u0644\u064a \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 (\u0641\u064a\u0641\u0627) \u062d\u064a\u062b \u062a\u0623\u062a\u064a \u0647\u0630\u0647 \u0627\u0644\u0648\u0627\u0642\u0639\u0629 \u0628\u0639\u062f \u0623\u064a\u0627\u0645 \u0642\u0644\u064a\u0644\u0629 \u0645\u0646 \u0641\u0631\u0636 \u063a\u0631\u0627\u0645\u0629 \u0645\u0627\u0644\u064a\u0629 \u0636\u062e\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0623\u0631\u062c\u0646\u062a\u064a\u0646\u064a \u0628\u0644\u063a\u062a (313) \u0623\u0644\u0641 \u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u064a\u0631\u0643\u064a \u062e\u0644\u0627\u0644 \u0628\u0637\u0648\u0644\u0629 \u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 (2026) \u0639\u0644\u0649 \u062e\u0644\u0641\u064a\u0629 \u0627\u062a\u0647\u0627\u0645\u0627\u062a \u062a\u062a\u0639\u0644\u0642 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062d\u062f\u062b \u0627\u0644\u0631\u064a\u0627\u0636\u064a \u0644\u0625\u0642\u0627\u0645\u0629 \u0645\u0638\u0627\u0647\u0631\u0627\u062a \u063a\u064a\u0631 \u0631\u064a\u0627\u0636\u064a\u0629 \u0648\u0633\u0648\u0621 \u0633\u0644\u0648\u0643 \u0627\u0644\u0641\u0631\u064a\u0642 \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0635\u062f\u0648\u0631 \u0647\u062a\u0627\u0641\u0627\u062a \u0639\u0646\u0635\u0631\u064a\u0629 \u0645\u0646 \u0627\u0644\u062c\u0645\u0627\u0647\u064a\u0631 \