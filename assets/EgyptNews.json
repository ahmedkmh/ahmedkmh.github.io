u064a\u0642 \u0647\u0631\u0645\u0632\u060c \u0628\u0639\u062f\u0645\u0627 \u0642\u0627\u0644 \u0627\u0655\u0646\u0647\u0627 \u0643\u0627\u0646\u062a \u062a\u062d\u0627\u0648\u0644 \u0639\u0628\u0648\u0631 \u0645\u0646\u0637\u0642\u0629 \"\u0645\u062d\u0638\u0648\u0631\u0629 \u0648\u063a\u064a\u0631 \u0627\u0653\u0645\u0646\u0629\" \u0641\u064a \u0627\u0644\u0645\u0636\u064a\u0642 \u0627\u0644\u062d\u064a\u0648\u064a\u060c \u0648\u0630\u0644\u0643 \u0628\u0639\u062f \u0647\u062c\u0648\u0645 \u0627\u0654\u0645\u064a\u0631\u0643\u064a \u0627\u0633\u062a\u0647\u062f\u0641 5 \u0646\u0627\u0642\u0644\u0627\u062a \u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629.\u0648\u0646\u0642\u0644\u062a \u0648\u0633\u0627\u064a\u0654\u0644 \u0627\u0655\u0639\u0644\u0627\u0645 \u0631\u0633\u0645\u064a\u0629 \u0641\u064a \u0627\u0655\u064a\u0631\u0627\u0646\u060c \u0639\u0646 \u0627\u0644\u062d\u0631\u0633 \u0627\u0644\u062b\u0648\u0631\u064a \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a \u062a\u0627\u0654\u0643\u064a\u062f\u0647 \u0645\u0647\u0627\u062c\u0645\u0629 \u0633\u0641\u064a\u0646\u062a\u064a\u0646 \u0627\u0654\u0645\u064a\u0631\u0643\u064a\u062a\u064a\u0646 \u06488 \u0646\u0627\u0642\u0644\u0627\u062a \u0646\u0641\u0637 \u0641\u064a \u0627\u0644\u062e\u0644\u064a\u062c\u060c \u0628\u064a\u0646\u0645\u0627 \u0644\u0645 \u062a\u0648\u0654\u0643\u062f \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0635\u062d\u0629 \u0630\u0644\u0643.\u0648\u0642\u0628\u0644 \u0630\u0644\u0643\u060c \u0627\u0654\u0639\u0644\u0646 \u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a\u060c \u0645\u0633\u0627\u0621 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621\u060c \u062a\u062f\u0645\u064a\u0631 \u062e\u0645\u0633 \u0646\u0627\u0642\u0644\u0627\u062a \u0646\u0641\u0637 \u0627\u0655\u064a\u0631\u0627\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u062b\u0627\u0645\u0646 \u0645\u0646 \u0633\u0628\u062a\u0645\u062