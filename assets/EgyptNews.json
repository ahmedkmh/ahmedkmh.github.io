064a\u064a\u0631. \u0648\u0635\u0639\u062f \u0627\u0644\u0630\u0647\u0628 \u0641\u064a \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0641\u0648\u0631\u064a\u0629 0.1 %\u0625\u0644\u0649 4061.86 \u062f\u0648\u0644\u0627\u0631 \u0644\u0644\u0623\u0648\u0642\u064a\u0629 (\u0627\u0644\u0623\u0648\u0646\u0635\u0629) \u0628\u062d\u0644\u0648\u0644 \u0627\u0644\u0633\u0627\u0639\u0629 00:36 \u0628\u062a\u0648\u0642\u064a\u062a \u063a\u0631\u064a\u0646\u062a\u0634\u060c \u0628\u0639\u062f \u0623\u0646 \u0627\u0631\u062a\u0641\u0639 \u0628\u0623\u0643\u062b\u0631 \u0645\u0646 1 % \u0623\u0645\u0633 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621. \u0648\u0627\u0633\u062a\u0642\u0631\u062a \u0627\u0644\u0639\u0642\u0648\u062f \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0627\u0644\u0622\u062c\u0644\u0629 \u0644\u0644\u0630\u0647\u0628 \u062a\u0633\u0644\u064a\u0645 \u062f\u064a\u0633\u0645\u0628\u0631/ \u0643\u0627\u0646\u0648\u0646 \u0627\u0644\u0623\u0648\u0644 \u0639\u0646\u062f 4075.60 \u062f\u0648\u0644\u0627\u0631. \u0648\u062a\u062a\u0631\u0642\u0628 \u0627\u0644\u0623\u0633\u0648\u0627\u0642 \u0642\u0631\u0627\u0631 \u0645\u062c\u0644\u0633 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a \u0627\u0644\u0641\u064a\u062f\u0631\u0627\u0644\u064a \u0628\u0634\u0623\u0646 \u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0646\u0642\u062f\u064a\u0629 \u0627\u0644\u0645\u0642\u0631\u0631 \u0635\u062f\u0648\u0631\u0647 \u0639\u0646\u062f \u0627\u0644\u0633\u0627\u0639\u0629 18:00 \u0628\u062a\u0648\u0642\u064a\u062a \u063a\u0631\u064a\u0646\u062a\u0634\u060c \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0628\u064a\u0627\u0646\u0627\u062a \u0646\u0641\u0642\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0634\u062e\u0635\u064a \u063a\u062f\u0627 \u0627\u0644\u062e\u0645\u064a\u0633\u060c \u0648\u0647\u064a \u0645\u0624\u0634\u0631 \u0631\u0626\u064a\u0633\u064a \u064a\u0631\u0627\u0642\u0628\u064