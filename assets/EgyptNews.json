\u062a \u0627\u0654\u0631\u0628\u0627\u062d \u0627\u0644\u0634\u0631\u0643\u0629 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0646\u064a \u0628\u0646\u0633\u0628\u0629 0.53% \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0654\u0631\u0628\u0627\u062d\u0647\u0627 \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0627\u0654\u0648\u0644 \u0627\u0644\u0628\u0627\u0644\u063a\u0629 2 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (7.43 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644).\u0648\u0627\u0654\u0641\u0635\u062d\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0641\u064a \u0628\u064a\u0627\u0646 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\" \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0627\u0654\u062d\u062f \u0639\u0646 \u062a\u062d\u0642\u064a\u0642 \u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0628\u0644\u063a\u062a 4.2 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (15.8 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u062e\u0644\u0627\u0644 \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u062b\u0627\u0646\u064a\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0627\u0655\u064a\u0631\u0627\u062f\u0627\u062a \u0633\u0627\u0644\u0628\u0629 \u0642\u062f\u0631\u0647\u0627 28.4 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 (106.3 \u0645\u0644\u064a\u0648\u0646 \u0631\u064a\u0627\u0644) \u0641\u064a \u0627\u0644\u0631\u0628\u0639 \u0627\u0644\u0645\u0645\u0627\u062b\u0644 \u0645\u0646 \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0646\u062a\u064a\u062c\u0629 \u0627\u0631\u062a\u0641\u0627\u0639 \u062d\u0635\u062a\u0647\u0627 \u0645\u0646 \u0627\u0654\u0631\u0628\u0627\u062d \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0627\u0644\u0632\u0645\u064a\u0644\u0629\u060c \u0648\u0632\u064a\u0627\u062f\u0629 \u062a\u0648\u0632\u064a\u0639\u0627\u062a \u0627\u0644\u0627\u0654\u0631\u0628\u0627\