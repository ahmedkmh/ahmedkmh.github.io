u0644\u0649 \u0627\u0644\u062d\u0631\u0628 \u0627\u0644\u0623\u0645\u064a\u0631\u0643\u064a\u0629 \u0627\u0644\u0623\u0637\u0648\u0644.\u0648\u0641\u064a 26 \u0633\u0628\u062a\u0645\u0628\u0631 2001\u060c \u0648\u0635\u0644 \u0641\u0631\u064a\u0642 \u0645\u0643\u0648\u0646 \u0645\u0646 \u0633\u0628\u0639\u0629 \u0636\u0628\u0627\u0637\u060c \u062d\u0645\u0644 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0631\u0645\u0632\u064a \"JAWBREAKER\"\u060c \u0625\u0644\u0649 \u0648\u0627\u062f\u064a \u0628\u0646\u062c\u0634\u064a\u0631\u060c \u062d\u0627\u0645\u0644\u064b\u0627 \u0645\u0644\u0627\u064a\u064a\u0646 \u0627\u0644\u062f\u0648\u0644\u0627\u0631\u0627\u062a \u0646\u0642\u062f\u064b\u0627 \u0644\u062a\u062c\u0646\u064a\u062f \u0648\u062a\u062c\u0647\u064a\u0632 \u062d\u0644\u0641\u0627\u0621 \u0623\u0641\u063a\u0627\u0646 \u0648\u062c\u0645\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u0628\u0627\u0631\u0627\u062a\u064a\u0629\u060c \u062a\u0645\u0647\u064a\u062f\u0627\u064b \u0644\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0636\u062f \u062a\u0646\u0638\u064a\u0645 \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0648\u062d\u0631\u0643\u0629 \u0637\u0627\u0644\u0628\u0627\u0646 \u0648\u0641\u0642\u0627 \u0644\u0634\u0628\u0643\u0629 CBS \u0646\u064a\u0648\u0632 \u0627\u0644\u0623\u0645\u064a\u0631\u0643\u064a\u0629.\u0648\u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0641\u0631\u064a\u0642 \u0645\u0631\u0648\u062d\u064a\u0629 \u0645\u0646 \u0637\u0631\u0627\u0632 \"Mi-17\"\u060c \u0627\u062e\u062a\u0627\u0631\u062a\u0647\u0627 CIA \u0628\u0633\u0628\u0628 \u0642\u062f\u0631\u062a\u0647\u0627 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u062f\u0645\u0627\u062c \u0641\u064a \u0627\u0644\u0628\u064a\u0626\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629\u061b \u0641\u0642\u062f \u0643\u0627\u0646\u062a \u0627\u0644\u0645\u0631\u0648\u062d\u064a\u0627\u062a \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0645\u0646 \u0647