 \u062a\u062f\u0627\u0639\u064a\u0627\u062a \u062a\u0635\u0631\u064a\u062d\u0627\u062a \u062c\u0648\u0632\u064a\u0647 \u0645\u0648\u0631\u064a\u0646\u064a\u0648\u060c \u0645\u062f\u0631\u0628 \u0631\u064a\u0627\u0644 \u0645\u062f\u0631\u064a\u062f\u060c \u0627\u0644\u062a\u064a \u062d\u0645\u0644 \u0641\u064a\u0647\u0627 \u0627\u0644\u062d\u0643\u0627\u0645 \u0645\u0633\u0648\u0654\u0648\u0644\u064a\u0629 \u0627\u0631\u062a\u0643\u0627\u0628 \u0627\u0654\u062e\u0637\u0627\u0621 \u0645\u0648\u0654\u062b\u0631\u0629 \u062e\u0644\u0627\u0644 \u062e\u0633\u0627\u0631\u0629 \u0641\u0631\u064a\u0642\u0647 1 - 2 \u0627\u0654\u0645\u0627\u0645 \u0627\u0654\u062a\u0644\u062a\u064a\u0643\u0648 \u0645\u062f\u0631\u064a\u062f\u060c \u064a\u0648\u0645 \u0627\u0644\u0627\u0654\u062d\u062f \u0627\u0644\u0645\u0627\u0636\u064a.\u0648\u0643\u0627\u0646 \u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0642\u062f \u0627\u0654\u062d\u0636\u0631 \u0646\u0633\u062e\u0629 \u0645\u0637\u0628\u0648\u0639\u0629 \u0645\u0646 \u0648\u0627\u0642\u0639\u062a\u064a\u0646 \u0631\u0627\u0654\u0649 \u0627\u0654\u0646\u0647\u0645\u0627 \u0643\u0627\u0646\u062a\u0627 \u062a\u0633\u062a\u062d\u0642\u0627\u0646 \u0627\u0655\u0634\u0647\u0627\u0631 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062d\u0645\u0631\u0627\u0621\u060c \u0648\u0647\u0645\u0627 \u0627\u062d\u062a\u0643\u0627\u0643 \u0628\u064a\u0646 \u0643\u0631\u064a\u0633\u062a\u064a\u0627\u0646 \u0631\u0648\u0645\u064a\u0631\u0648 \u0648\u062c\u0648\u062f \u0628\u064a\u0644\u0646\u063a\u0647\u0627\u0645\u060c \u0648\u062a\u062f\u062e\u0644 \u0645\u0646 \u0644\u064a \u0643\u0627\u0646\u063a \u0627\u0655\u0646 \u0636\u062f \u0641\u064a\u062f\u064a\u0631\u064a\u0643\u0648 \u0641\u0627\u0644\u0641\u064a\u0631\u062f\u064a.\u0648\u064a\u0634\u0639\u0631 \u0645\u0648\u0631\u064a\u0646\u064a\u0648 \u0627\u0654\u0646\u0647 \u0643\u0627\u0646 \u064a\u0646\u0628\u063a\u064a \u0627\u0654\u0646 \u064a\u0644\u0639\u0628 \u0627\u0654\u062a\u0644