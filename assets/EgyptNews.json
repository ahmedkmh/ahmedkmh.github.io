633\u062a\u0647\u062f\u0641 \u0634\u0631\u0643\u0627\u0621 \u0627\u0655\u064a\u0631\u0627\u0646 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u064a\u0646. \u0648\u0633\u064a\u0639\u0642\u062f \u0648\u0632\u064a\u0631 \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a \u0633\u0643\u0648\u062a \u0628\u064a\u0633\u0646\u062a \u0645\u0648\u0654\u062a\u0645\u0631\u0627\u064b \u0635\u062d\u0641\u064a\u0627\u064b \u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0628\u0639\u062f \u0627\u0644\u0638\u0647\u0631 \u0628\u062a\u0648\u0642\u064a\u062a \u0634\u0631\u0642 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 (1800 \u0628\u062a\u0648\u0642\u064a\u062a \u063a\u0631\u064a\u0646\u062a\u0634) \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0633\u0637 \u062a\u0647\u062f\u064a\u062f\u0627\u062a \u0628\u0627\u0644\u0643\u0634\u0641 \u0639\u0646 \u0627\u0655\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0654\u0643\u062b\u0631 \u0635\u0631\u0627\u0645\u0629 \u0636\u062f \u062f\u0648\u0644\u0629 \u0639\u0627\u0646\u062a \u0645\u0646 \u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0634\u0628\u0647 \u0645\u0633\u062a\u0645\u0631\u0629 \u0645\u0646\u0630 \u0627\u0644\u062b\u0648\u0631\u0629 \u0627\u0644\u0627\u0655\u0633\u0644\u0627\u0645\u064a\u0629 \u0639\u0627\u0645 1979.\u0648\u0643\u062a\u0628 \u0628\u064a\u0633\u0646\u062a \u0641\u064a \u0645\u0642\u0627\u0644 \u0631\u0627\u0654\u064a \u0646\u064f\u0634\u0631 \u0641\u064a \u0635\u062d\u064a\u0641\u0629 \"\u0641\u0627\u064a\u0646\u0627\u0646\u0634\u0627\u0644 \u062a\u0627\u064a\u0645\u0632\" \u0627\u0654\u0645\u0633 \u0627\u0644\u0627\u0654\u062d\u062f \"\u0645\u0639 \u0628\u0632\u0648\u063a \u0627\u0644\u0641\u062c\u0631 \u064a\u0628\u062f\u0627\u0654 \u064a\u0648\u0645 \u0627\u0644\u062d\u0633\u0645 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a -\u0627\u0654\u0643\u