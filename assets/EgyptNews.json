"world"], "datatype": "news", "pubDate": "2026-08-23 22:41:03", "pubDateTZ": "UTC", "fetched_at": "2026-08-23 23:02:12", "image_url": "https://cdnv.russiatoday.com/media/pics/2026.08/thumbnail/6a8b73b54236046be50b7686.jpg", "video_url": null, "source_id": "arabic.rt", "source_name": "Arabic", "source_priority": 2951, "source_url": "https://arabic.rt.com", "source_icon": null, "sentiment": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "sentiment_stats": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_tag": "ONLY AVAILABLE IN PROFESSIONAL AND CORPORATE PLANS", "ai_region": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_org": "ONLY AVAILABLE IN CORPORATE PLANS", "ai_summary": "ONLY AVAILABLE IN PAID PLANS", "duplicate": false}, {"article_id": "cf1f01cb334e40832b5d810c59d6d39b", "link": "https://www.alarabiya.net/arab-and-world/american-elections-2016/2026/08/24/%D9%88%D8%B2%D9%8A%D8%B1-%D8%A7%D9%84%D8%AE%D8%B2%D8%A7%D9%86%D8%A9-%D8%A7%D9%84%D8%A7%D9%85%D9%8A%D8%B1%D9%83%D9%8A-%D8%B3%D9%86%D8%A8%D8%AF%D8%A7-%D8%A7%D9%83%D8%A8%D8%B1-%D8%AD%D8%B5%D8%A7%D8%B1-%D9%85%D8%A7%D9%84%D9%8A-%D8%B9%D9%84%D9%89-%D8%A7%D9%84%D8%A7%D8%B7%D9%84%D8%A7%D9%82-%D8%B6%D8%AF-%D8%A7%D9%8A%D8%B1%D8%A7%D9%86", "title": "\u0627\u0654\u0645\u064a\u0631\u0643\u0627: \u0633\u0646\u0628\u062f\u0627\u0654 \u0627\u0654\u0643\u0628\u0631 \u062d\u0635\u0627\u0631 \u0645\u0627\u0644\u064a \u0639\u0644\u0649 \u0627\u0644\u0627\u0655\u0637\u0644\u0627\u0642 \u0636\u062f \u0627\u0655\u064a\u0631\u0627\u0646", "description": "\u0627\u0654\u0639\u0644\u0646 \u0648\u0632\u064a\u0631 \u0627\u0644\u062e\u0632\u0627\u0646\u0629 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a \u0633\u0643\u0648\u062a \u0628\u064a\u0633\u0646\u062a \u0627\u0654\u0646 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0633\u062a\u0628\u062f\u0627\u0654 \"\u0627\u0654\u0643\u0628\u0631 \u062d\u0635\u0627\u0631 \u0645\u0627\u0644\u064a \u0639\u0644\u0649 \u0627\u0644\u0627\u0655\u0637\u0644\u0627\u0642\" \u0636\u062f \u0627\u0655\u064a\u0631\u0627\u0646.\u0648\u0642\u0627\u0644 \u0628\u064a\u0633\u0646\u062a\u060c \u0641\u064a \u0645\u0642\u0627\u0644 \u0631\u0627\u0654\u064a \u0646\u064f\u0634\u0631 \u0641\u064a \u0635\u062d\u064a\u0641\u0629 \"\u0641\u0627\u064a\u0646\u0627\u0646\u0634\u0627\u0644 \u062a\u0627\u064a\u0645\u0632\" \u0627\u0644\u0627\u0654\u062d\u062f\u060c \u0627\u0655\u0646 \u0627\u0654\u064a \u062f\u0648\u0644\u0629 \u062a\u0634\u0643\u0644 \u0634\u0631\u064a\u0627\u0646\u0627\u064b \u0645\u0627\u0644\u064a\u0627\u064b \u0644\u0627\u0655\u064a\u0631\u0627\u0646 \u0627\u0654\u0648 \u062a\u0633\u0647\u0651\u0644 \u062a\u062f\u0641\u0642 \u0627\u0644\u0627\u0654\u0645\u0648\u0627\u0644 \u0627\u0655\u0644\u064a\u0647\u0627 \"\u0633\u062a\u0634\u0627\u0631\u0643\u0647\u0627 \u0639\u0632\u0644\u062a\u0647\u0627 \u0648\u0639\u0644\u064a\u0647\u0627 \u0627\u0654\u0646 \u062a\u0641\u0643\u0631 \u0641\u064a \u0627\u0644\u0639\u0648\u0627\u0642\u0628\"\u060c \u0645\u0636\u064a\u0641\u0627\u064b \u0627\u0654\u0646 \"\u0627\u0654\u064a \u062f\u0648\u0644\u0629 \u062a\u062f\u0639\u0645 \u0637\u0647\u0631\u0627\u0646 \u0633\u062a\u0643\u0648\u0646 \u0641\u064a \u0646\u0638\u0631 \u0648\u0627\u0634\u0646\u0637\u0646 \u0645\u0646\u0628\u0648\u0630\u0629 \u0639\u0627\u0644\u0645\u064a\u0627\u064b\".\u0643\u0645\u0627 \u0634\u062f\u062f \u0639\u0644\u0649 \u0627\u0654\u0646 \"\u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u062a\u064a \u062a\u0648\u0627\u0635\u0644 \u062f\u0639\u0645 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a \u062a\u062a\u062c\u0627\u0648\u0632 \u062d\u062f\u0648\u062f \u062a\u0633\u0627\u0645\u062d \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629\"\u060c \u0645\u062a\u0633\u0627\u064a\u0654\u0644\u0627\u064b \u0639\u0645\u0627 \u0627\u0655\u0630\u0627 \u0643\u0627\u0646 \u062d\u0644\u0641\u0627\u0621 \u0637\u0647\u0631\u0627\u0646 \"\u0645\u0633\u062a\u0639\u062f\u064a\u0646 \u0644\u0644\u0631\u0647\u0627\u0646 \u0639\u0644\u064a\u0647\u0627\".\u0643\u0630\u0644\u0643 \u0645\u0636\u0649 \u0642\u0627\u064a\u0654\u0644\u0627\u064b \u0627\u0655\u0646 \u0627\u0644\u0639\u0632\u0644\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u062a\u0632\u0645 \u0627\u0654\u0645\u064a\u0631\u0643\u0627 \u0641\u0631\u0636\u0647\u0627 \u0639\u0644\u0649 \u0627\u0655\u064a\u0631\u0627\u0646 \"\u0633\u062a\u063a\u0646\u064a \u0648\u0627\u0634\u0646\u0637\u0646 \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0642\u0648\u0629 (\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629)\".\"\u0642\u0637\u0639 \u0643\u0644 \u0634\u0631\u064a\u0627\u0646 \u062d\u064a\u0627\u0629 \u0627\u0642\u062a\u0635\u0627\u062f\u064a\"\u0648\u0627\u0654\u0648\u0636\u062d \u0628\u064a\u0633\u0646\u062a \u0627\u0654\u0646 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u0628 \u062f\u0645\u0631 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f \u0627\u0644\u0627\u0655\u064a\u0631\u0627\u0646\u064a \u0644\u062f\u0631\u062c\u0629 \u0644\u0645 \u064a\u0633\u0628\u0642 \u0644\u0647\u0627 \u0645\u062b\u064a\u0644\u060c \u0645\u0648\u0654\u0643\u062f\u0627\u064b \u0627\u0654\u0646 \u0627\u0644\u0647\u062f\u0641 \u0627\u0644\u0627\u0654\u0645\u064a\u0631\u0643\u064a \u064a\u062a\u0645\u062b\u0644 \u0641\u064a \"\u0642\u0637\u0639 \u0643\u0644 \u0634\u0631\u064a\u0627\u0646 \u062d\u064a\u0627\u0629 \u0627\u0642\u062a\u0635\u0627\u062f\u064a\" \u0644\u0627\u0655\u064a\u0631\u0627\u0646.\u0641\u064a\u0645\u0627 \u062d\u0630\u0631 \u0645\u0646 \u0627\u0654\u0646 \u062a\u0631\u0627\u0645\u0628 \u0633\u064a\u0631\u062f \"\u0628\u0633\u0631\u0639\u0629 \u0648\u062d\u0632\u0645\" \u0627\u0655\u0630\u0627 \u0627\u0654\u0642\u062f\u0645\u062a \u0627\u0655\u064a\u0631\u0627\u0646 \u0639\u0644\u0649 \u0645\u0647\u0627\u062c\u0645\u0629 \u0627\u