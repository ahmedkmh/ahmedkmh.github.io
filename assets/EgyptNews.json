 \u0627\u0654\u063a\u0633\u0637\u0633 \u0627\u0644\u062d\u0627\u0644\u064a \u0639\u0644\u0649 \u0627\u0633\u062a\u0642\u0627\u0644\u0629 \u0627\u0644\u062f\u0643\u062a\u0648\u0631 \u0627\u0654\u062d\u0645\u062f \u0628\u0646 \u0635\u0627\u0644\u062d \u0628\u0627\u0628\u0639\u064a\u0631 \u0645\u0646 \u0645\u0646\u0635\u0628\u0647 \u0643\u0631\u064a\u0654\u064a\u0633 \u062a\u0646\u0641\u064a\u0630\u064a \u0644\u0644\u0634\u0631\u0643\u0629 \u0648\u0645\u0646 \u0639\u0636\u0648\u064a\u062a\u0647 \u0641\u064a \u0644\u062c\u0646\u0629 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0648\u0627\u0644\u062a\u0645\u0648\u064a\u0644\u060c \u0639\u0644\u0649 \u0627\u0654\u0646 \u062a\u0633\u0631\u064a \u0627\u0644\u0627\u0633\u062a\u0642\u0627\u0644\u0629 \u0627\u0639\u062a\u0628\u0627\u0631\u0627\u064b \u0645\u0646 1 \u0633\u0628\u062a\u0645\u0628\u0631 2026\u060c \u0648\u0630\u0644\u0643 \u0644\u0638\u0631\u0648\u0641\u0647 \u0627\u0644\u0634\u062e\u0635\u064a\u0629.\u0648\u0627\u0654\u0641\u0627\u062f\u062a \u0627\u0644\u0634\u0631\u0643\u0629 \u0641\u064a \u0628\u064a\u0627\u0646 \u0639\u0644\u0649 \"\u062a\u062f\u0627\u0648\u0644 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\" \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062e\u0645\u064a\u0633 \u0627\u0654\u0646 \u0645\u062c\u0644\u0633 \u0627\u0644\u0627\u0655\u062f\u0627\u0631\u0629 \u0642\u0631\u0631 \u062a\u0643\u0644\u064a\u0641 \u0627\u0644\u0645\u0647\u0646\u062f\u0633 \u0645\u062a\u0639\u0628 \u0628\u0646 \u0639\u0628\u062f\u0627\u0644\u0644\u0647 \u0627\u0644\u0637\u062e\u064a\u0633 \u0628\u0645\u0646\u0635\u0628 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a \u0644\u0644\u0634\u0631\u0643\u0629\u060c \u0648\u062a\u0639\u064a\u064a\u0646\u0647 \u0639\u0636\u0648\u0627\u064b \u0641\u064a \u0644\u062c\u0646\u0629 \u0627\u0644\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0648\u0627\u0644\u062a\u0645\u0648\u064a\u0644\u060c \u0627\u0639\u062a\u0628\u0627\u0631\u0