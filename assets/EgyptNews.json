4a\u0627\u062f\u0629 \u0627\u0644\u0645\u063a\u0631\u0628 \u0639\u0644\u0649 \u0627\u0644\u0635\u062d\u0631\u0627\u0621\u060c \u0648\u062f\u0639\u0645 \u0627\u0644\u0645\u0642\u062a\u0631\u062d \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0644\u0644\u062d\u0643\u0645 \u0627\u0644\u0630\u0627\u062a\u064a. \u0648\u0642\u0627\u0644 \u0627\u0644\u0631\u064a\u0654\u064a\u0633 \u062a\u0631\u0627\u0645\u0628 \u0641\u064a \u0631\u0633\u0627\u0644\u0629 \u0648\u062c\u0647\u0647\u0627 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0633\u0628\u062a\u060c \u0627\u0655\u0644\u0649 \u0627\u0644\u0639\u0627\u0647\u0644 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0627\u0644\u0645\u0644\u0643 \u0645\u062d\u0645\u062f \u0627\u0644\u0633\u0627\u062f\u0633 \u0628\u0645\u0646\u0627\u0633\u0628\u0629 \u0639\u064a\u062f \u0627\u0644\u0639\u0631\u0634: \"\u0646\u062f\u0639\u0645 \u0627\u0644\u0645\u0642\u062a\u0631\u062d \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0644\u0644\u062d\u0643\u0645 \u0627\u0644\u0630\u0627\u062a\u064a \u0627\u0644\u062c\u0627\u062f\u060c \u0648 \u0627\u0644\u0630\u064a \u064a\u062a\u0645\u062a\u0639 \u0628\u0627\u0644\u0645\u0635\u062f\u0627\u0642\u064a\u0629 \u0648\u0627\u0644\u0648\u0627\u0642\u0639\u064a\u0629 \u0628\u0627\u0639\u062a\u0628\u0627\u0631\u0647 \u0627\u0644\u0627\u0654\u0633\u0627\u0633 \u0627\u0644\u0648\u062d\u064a\u062f \u0644\u0644\u062a\u0648\u0635\u0644 \u0627\u0655\u0644\u0649 \u062d\u0644 \u062f\u0627\u064a\u0654\u0645 \". \u0648\u062c\u0627\u0621 \u0641\u064a \u0628\u064a\u0627\u0646 \u0644\u0644\u062f\u064a\u0648\u0627\u0646 \u0627\u0644\u0645\u0644\u0643\u064a: \"\u0628\u0645\u0646\u0627\u0633\u0628\u0629 \u0627\u0644\u0630\u0643\u0631\u0649 \u0627\u0644\u064027 \u0644\u0639\u064a\u062f \u0627\u0644\u0639\u0631\u0634 \u0627\u0644\u0645\u062c\u064a\u062f\u060c \u0627\u0654\u0646 \u0627\u0644\u0639\u0627\u0647\u0644 \u0627\u0644\u0645\u063a\u0631\u0628\u064a \u0627\u0644\u0645\u0644\u0643 \u0645\u062d\u0645\u062f \u0627\u0644\u0633\u062