\u0634\u064a\u0643\u0648 \u0628\u0627\u0646\u0632\u0627 \u0648\u0645\u062d\u0645\u062f \u0634\u0631\u064a\u0641", "description": "\u0623\u0639\u0644\u0646 \u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0641\u0646\u064a \u0644\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0623\u0648\u0644 \u0644\u0643\u0631\u0629 \u0627\u0644\u0642\u062f\u0645 \u0628\u0646\u0627\u062f\u064a \u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0628\u0642\u064a\u0627\u062f\u0629 \u0645\u0639\u062a\u0645\u062f \u062c\u0645\u0627\u0644\u060c \u0627\u0644\u062a\u0634\u0643\u064a\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u062e\u0648\u0636 \u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0623\u0647\u0644\u064a \u0627\u0644\u0645\u0642\u0631\u0631 \u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u062b\u0627\u0645\u0646\u0629 \u0645\u0633\u0627\u0621 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0623\u062d\u062f \u0639\u0644\u0649 \u0633\u062a\u0627\u062f \u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0627\u0644\u062f\u0648\u0644\u064a \u0641\u064a \u0625\u0637\u0627\u0631 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u0627\u0644\u062c\u0648\u0644\u0629 \u0627\u0644\u0633\u0627\u062f\u0633\u0629 \u0644\u0645\u0633\u0627\u0628\u0642\u0629 \u0627\u0644\u062f\u0648\u0631\u064a \u0627\u0644\u0645\u0645\u062a\u0627\u0632. \u062c\u0627\u0621 \u062a\u0634\u0643\u064a\u0644 \u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0623\u0645\u0627\u0645 \u0627\u0644\u0623\u0647\u0644\u064a \u0643\u0627\u0644\u062a\u0627\u0644\u064a: - \u062d\u0631\u0627\u0633\u0629 \u0627\u0644\u0645\u0631\u0645\u0649 : \u0645\u0647\u062f\u064a \u0633\u0644\u064a\u0645\u0627\u0646. - \u062e\u0637 \u0627\u0644\u062f\u0641\u0627\u0639 : \u0645\u062d\u0645\u0648\u062f \u0628\u0646\u062a\u0627\u064a\u062c \u2013 \u0645\u062d\u0645\u0648\u062f \u062d\u0645\u062f\u064a \"\u0627\u0644\u0648\u0646\u0634\" \u2013 \u0645\u062d\u0645\u062f \u0625\u0633\u0645\u0627\u0639\u064a\u0644 \u2013 \u0639\u0645\u0631 \u062c\u0627\u0628\u0631. - \u062e\u0637 \u0627\u0644\u0648\u0633\u0637 : \u0645\u062d\u0645\u062f \u0634\u062d\u0627\u062a\u0629 \u2013 \u0623\u062d\u0645\u062f \u0631\u0628\u064a\u0639 \u2013 \u0623\u062d\u0645\u062f \u0641\u062a\u0648\u062d - \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0639\u064a\u062f. - \u062e\u0637 \u0627\u0644\u0647\u062c\u0648\u0645 : \u0634\u064a\u0643\u0648 \u0628\u0627\u0646\u0632\u0627 \u2013 \u0623\u062d\u0645\u062f \u0634\u0631\u064a\u0641. - \u0648\u064a\u062a\u0648\u0627\u062c\u062f \u0639\u0644\u0649 \u0645\u0642\u0627\u0639\u062f \u0627\u0644\u0628\u062f\u0644\u0627\u0621\u060c \u0645\u062d\u0645\u062f \u0639\u0648\u0627\u062f \u0648\u0645\u0635\u0637\u0641\u0649 \u0627\u0644\u0632\u0646\u0627\u0631\u064a \u0648\u0645\u062d\u0645\u0648\u062f \u062c\u0647\u0627\u062f \u0648\u0623\u062d\u0645\u062f \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u064a\u0645 \"\u0625\u064a\u0634\u0648\" \u0648\u0622\u062f\u0645 \u0643\u0627\u064a\u062f \u0648\u0645\u062d\u0645\u062f \u062d\u0645\u062f \u0648\u0646\u0627\u0635\u0631 \u0645\u0646\u0633\u064a \u0648\u062d\u0633\u0627\u0645 \u0623\u0634\u0631\u0641 \u0648\u0639\u062f\u064a \u0627\u0644\u062f\u0628\u0627\u063a. \u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0623\u0647\u0644\u064a \u0648\u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0642\u0628\u0644 \u0627\u0644\u0642\u0645\u0629 \u064a\u062f\u062e\u0644 \u0627\u0644\u0641\u0631\u064a\u0642\u0627\u0646 \u0627\u0644\u0645\u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0635\u064a\u062f 13 \u0646\u0642\u0637\u0629 \u0644\u0643\u0644 \u0645\u0646\u0647\u0645\u0627 \u0628\u0639\u062f \u0645\u0631\u0648\u0631 \u062e\u0645\u0633 \u062c\u0648\u0644\u0627\u062a\u060c \u0645\u0639 \u062a\u0642\u062f\u0645 \u0627\u0644\u0623\u0647\u0644\u064a \u0641\u064a \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u062b\u0627\u0646\u064a \u0628\u0641\u0627\u0631\u0642 \u0627\u0644\u0623\u0647\u062f\u0627\u0641 \u0639\u0646 \u0627\u0644\u0632\u0645\u0627\u0644\u0643 \u0635\u0627\u062d\u0628